#!/usr/bin/ucode
// Resume an unmet data request after EPS registration, preserving user intent.
import * as fs from 'fs';
import * as ubus from 'ubus';
import * as uci from 'uci';
import * as uloop from 'uloop';
import * as policy from '../lib/network-recovery.uc';
import * as roaming from '../lib/roaming.uc';

const wan = getenv('MU300_WAN') || 'wan';
if (!match(wan, /^[A-Za-z0-9_]+$/))
    die('Invalid cellular interface name\n');
const root = getenv('MU300_REGISTRATION_DIR') || '/run/mu300-registration';
const cfg = uci.cursor();
const runtime = '/run/mu300';
const previous = { key: null, attempted: false };
const sim_changes = {};
function read_json(path) {
    try { return json(fs.readfile(path)); } catch (e) { return null; }
}
function selected_slot() {
    let value = cfg.get('unisoc_modem', 'main', 'data_sim') || '0';
    return value == '0' ? 0 : value == '1' ? 1 : null;
}
function radio_busy() {
    for (let path in [
        runtime + '/sim-switching', runtime + '/sim-active-unknown',
        '/run/unisoc-data-sim-switch',
        '/run/unisoc-modem-early-hook-pending'
    ])
        if (fs.stat(path)) return true;
    return policy.radio_blocked(!!fs.stat('/run/mu300-radio-freeze'),
                                !!fs.stat(runtime + '/sim-radio-ready'));
}
function blocked() {
    return radio_busy() || !!fs.stat('/run/mu300-mobile-data-manual-down');
}
uloop.init();
const bus = ubus.connect(null, 2);
if (!bus) die('Cellular recovery: ubus unavailable\n');
function evaluate() {
    // Only an actual stock SIM-change event queues CPIN. The persistent AT
    // broker records its confirmed result before exposing the reply.
    // Never queue CPIN ahead of the original SMMSWAP/radio/lock sequence.
    // Retain hints while that sequence or a native SIM switch owns the CP.
    let initialized = !!fs.stat('/run/mu300-ril-handshake') || !!fs.stat(runtime + '/sim-radio-ready');
    for (let changed in initialized && !radio_busy() ? keys(sim_changes) : []) {
        delete sim_changes[changed];
        let directory = changed == '1' ? '/run/mu300-at4' : '/run/mu300-at';
        let command = sprintf("MU300_AT_DIR=%s MU300_AT_DAEMON_ONLY=1 MU300_AT_BUDGET=6 /opt/mu300/bin/mu300-at -t 3 'AT+SPACTCARD=%s;+CPIN?' 2>/dev/null", directory, changed);
        let pipe = fs.popen(command, 'r');
        if (pipe) { pipe.read('all'); pipe.close(); }
    }
    cfg.unload('unisoc_modem');
    let slot = selected_slot();
    if (slot == null) return;
    let flags=fs.readfile('/etc/mu300/sim-radio');
    if (flags != null) {
        flags=trim(flags);
        if (index(['0 0','0 1','1 0','1 1'],flags)<0 || substr(flags,slot*2,1)!='1') return;
    }
    let wait = trim(fs.readfile('/run/mu300cell-' + wan + '.registration-wait') || '');
    let wait_slot = wait == '0' ? 0 : wait == '1' ? 1 : null;
    let sim = read_json(root + '/sim' + slot + '.json');
    let registration=roaming.registration(read_json(root+'/slot'+slot+'.json'),read_json(root+'/slot'+slot+'-nr.json'),slot);
    let denied=roaming.blocked(registration,cfg.get('unisoc_modem','main','allow_roaming'+slot)=='1');
    if (denied && !blocked()) {
        previous.key=null; previous.attempted=false;
        roaming.suspend((method,data)=>{
            if (method=='notify_proto' && data.action==5)
                fs.writefile('/run/mu300cell-'+wan+'.registration-wait',''+slot+'\n');
            return bus.call('network.interface.'+wan,method,data);
        },registration,false,false);
        return;
    }
    // A late CPIN completion must not turn a deliberately powered-off SIM
    // into a physical-removal verdict and block its next power-on.
    if (sim?.state == 'absent' && !fs.stat(root + '/sim-power' + slot)) sim = null;
    policy.recovery(
        (method, data) => {
            if (method == 'notify_proto' && data.available === false)
                fs.writefile('/run/mu300cell-' + wan + '.registration-wait', '' + slot + '\n');
            return bus.call('network.interface.' + wan, method, data);
        },
        registration, wait_slot, slot, blocked() || denied, previous,
        sim
    );
}
// The short one-shot only coalesces event bursts. No timer runs while idle.
let pending = false;
const deferred = uloop.timer(-1, function() {
    pending = false;
    evaluate();
});
function schedule() {
    if (!pending) { pending = true; deferred.set(50); }
}
const registration = bus.listener('mu300.registration', (name, data) => schedule());
const roaming_policy = bus.listener('mu300.roaming-policy', (name, data) => schedule());
const sim_state = bus.listener('mu300.sim-state', (name, data) => schedule());
const sim_change = bus.listener('mu300.sim-change', (name, data) => {
    if (data?.slot === 0 || data?.slot === 1) {
        sim_changes['' + data.slot] = true;
        schedule();
    }
});
const network = bus.listener('network.interface', (name, data) => {
    if (data?.interface == wan) schedule();
});
if (!registration || !network || !sim_state || !sim_change || !roaming_policy) die('Cellular recovery: event subscription failed\n');
const term = uloop.signal(15, () => uloop.end());
const intr = uloop.signal(2, () => uloop.end());
evaluate();
uloop.run();
