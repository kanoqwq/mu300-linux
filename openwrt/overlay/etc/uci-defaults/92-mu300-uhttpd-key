# KEY CERT: KEY goes, with CERT, when it is one of the shipped keys
drop_shipped() {
	[ -f "$1" ] || return 0
	sum=$(sha256sum "$1" 2>/dev/null) || return 0
	sum=${sum%% *}
	case $sum in ''|*[!0-9a-f]*) return 0 ;; esac
	printf '%s\n' "$shipped" | grep -q "^$sum " || return 0
	rm -f "$1" "$2"
	logger -t mu300 "removed the TLS key a release shipped ($1) and its certificate: uhttpd makes the device its own" 2>/dev/null
	return 0
}

drop_shipped /etc/uhttpd.key /etc/uhttpd.crt
# and wherever an instance of uhttpd takes its key from
for sec in $(uci -q show uhttpd 2>/dev/null | sed -n "s/^uhttpd\.\([A-Za-z0-9_]*\)\.key=.*/\1/p"); do
	key=$(uci -q get "uhttpd.$sec.key")
	crt=$(uci -q get "uhttpd.$sec.cert")
	[ -z "$key" ] || drop_shipped "$key" "${crt:-/etc/uhttpd.crt}"
done
exit 0
