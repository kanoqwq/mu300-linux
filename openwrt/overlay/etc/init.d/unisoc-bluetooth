#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
START=65
STOP=15
USE_PROCD=1
start_service() {
	procd_open_instance gateway
	procd_set_param command /usr/sbin/unisoc-bluetooth
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance events
	procd_set_param command /usr/bin/ucode /usr/lib/unisoc-bluetooth/events.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
