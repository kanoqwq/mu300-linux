#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Not enabled at boot; the gateway starts it only for an explicit power request.
START=64
STOP=16
USE_PROCD=1
start_service() {
	# Preserve a transport already owned by this service.
	procd_running unisoc-bt-transport && return 0
	/usr/bin/python3 /usr/lib/unisoc-bluetooth/transport.py || return 1
	case "$(cat /etc/unisoc-bluetooth/platform)" in
		mu300-pcie) device=/dev/ttyBT0; speed=3000000 ;;
		u30pro-aic-uart) device=/dev/ttyS0; speed=1500000 ;;
		*) return 1 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/bin/btattach -B "$device" -P h4 -S "$speed"
	# A failed transport is reported, not recovered by cycling the combo chip.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
