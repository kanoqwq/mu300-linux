#!/bin/sh /etc/rc.common
# After boot: keep mobile data up across modem resets, and mark the boot successful (re-arm slot b if Linux is default)
START=99
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

service_triggers() {
	procd_add_reload_trigger system
	# Config events, not a polling loop. NFC sync keeps custom text/URL tags.
	if /opt/mu300/bin/mu300-nfc supported >/dev/null 2>&1; then
		procd_add_config_trigger "config.change" wireless /opt/mu300/bin/mu300-nfc sync
	fi
}

reload_service() {
	/opt/mu300/bin/led-status refresh
}

start_service() {
	procd_open_instance auto-default
	procd_set_param command /usr/bin/ucode /usr/libexec/unisoc-boot-default /opt/mu300/bin/mu300-next-boot /etc/mu300/default-boot
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# START=99 means the web/LAN services have been started. End the initramfs
	# chase now; if WAN is not ready yet the specified steady state is red.
	case "$(/opt/mu300/bin/led-status current 2>/dev/null)" in
		boot|modem|registering|'') /opt/mu300/bin/led-status offline ;;
	esac
	procd_open_instance led-events
	procd_set_param command /opt/mu300/bin/mu300-led-events
	procd_set_param respawn 3600 5 0
	procd_close_instance

	# The initramfs answers the host's first DHCP request immediately. On this
	# DWC3 gadget, the NCM TX endpoint can still wedge during switch_root: RX
	# counts grow and dnsmasq logs DHCPOFFER, but Windows receives nothing.
	# One tracked 100 ms rebind after br-lan/dnsmasq are ready restores TX and
	# makes Windows renew the same reserved lease without a physical replug.
	if [ "$(cat /sys/class/usb_role/25100000.dwc3-role-switch/role 2>/dev/null)" != host ]; then
		# netifd may have emitted lan/ifup before the gadget's early address
		# became visible to hotplug. Repeat the idempotent LAN handoff here;
		# do not wait or poll for readiness.
		ACTION=ifup INTERFACE=lan /etc/hotplug.d/iface/10-mu300-usb
		procd_open_instance usb-ready
		procd_set_param command /opt/mu300/bin/mu300-usb-reset --fast-run
		procd_set_param oneshot 1
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# U30 Air exposes a second function on some kernels. Keep it in the LAN;
	# PDP and IPv4/IPv6 lease changes themselves never re-enumerate the gadget.
	[ -e /sys/class/net/usb1 ] && ip link set usb1 master br-lan 2>/dev/null && ip link set usb1 up

	procd_open_instance cellwatch
	procd_set_param command /opt/mu300/bin/mobile-data watch
	procd_set_param env MU300_NETIFD=1 PATH="$PATH"
	procd_set_param respawn 3600 30 0
	procd_close_instance
	procd_open_instance bootok
	procd_set_param command /bin/sh -c "sleep 30; exec /opt/mu300/bin/mu300-next-boot --rearm"
	procd_set_param env PATH="$PATH"
	procd_close_instance
}
