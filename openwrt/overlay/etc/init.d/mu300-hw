#!/bin/sh /etc/rc.common
# Hardware bring-up before netifd: vendor drivers, zram, Wi-Fi (SC2355), first-boot Wi-Fi config, Bluetooth off
START=12
export PATH="$PATH:/opt/mu300/busybox-bin"

# Everything here runs in the background on purpose. busybox init only spawns the consoles after sysinit has
# finished, so anything slow (or hanging) in here costs the device its serial console *and* its network - which
# is exactly what a hanging wifi-start did on the mainline kernel, leaving no way in at all.
boot() {
	/opt/mu300/bin/mu300-lowlatency
	/opt/mu300/bin/mu300-led power on
	/opt/mu300/bin/mu300-usb boot
	hw_bringup > /tmp/mu300-hw.log 2>&1 &
}

hw_bringup() {
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-hw-enter
	# Preinit already starts the chase. This idempotent notification also
	# covers direct service starts; mu300-post or WAN success hands it off.
	/opt/mu300/bin/led-status boot 2>/dev/null
	/opt/mu300/bin/openwrt-board-check >>/tmp/mu300-wifi-start.log 2>&1 || return 1
	if [ "$(/opt/mu300/bin/mu300-device --model)" = m3 ]; then
		mkdir -p /tmp/sysinfo
		printf '%s\n' 'ZTE M3 (MU5352)' > /tmp/sysinfo/model
	fi
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-board-ready
	# Set regulatory rules before the PHY appears and netifd starts APs.
	/opt/mu300/bin/regdb-load >>/tmp/mu300-wifi-start.log 2>&1
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-regdb-ready
	country=$(uci -q get wireless.radio0.country)
	[ -z "$country" ] || iw reg set "$country"
	/opt/mu300/bin/wifi-start >>/tmp/mu300-wifi-start.log 2>&1
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-driver-ready
	/opt/mu300/bin/extra-modules >/tmp/mu300-extra-modules.log 2>&1
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-extra-modules-done
	/opt/mu300/bin/zram-start >/dev/null 2>&1
	cfg=$(sha256sum /etc/config/wireless 2>/dev/null)
	/opt/mu300/bin/openwrt-wifi-config >>/tmp/mu300-wifi-start.log 2>&1
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-config-ready
	# Supported NFC tags (U30 Air / V50): retain custom text/URLs, synchronize Wi-Fi.
	/opt/mu300/bin/mu300-nfc supported 2>/dev/null && /opt/mu300/bin/mu300-nfc sync >/tmp/mu300-nfc.log 2>&1
	[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-nfc-done
	reg_ready=1
	# apply the country before netifd starts hostapd, otherwise 5 GHz channels are still NO-IR under world rules
	country=$(uci -q get wireless.radio0.country)
	if [ -n "$country" ]; then
		iw reg set "$country"
		reg_ready=0
		for n in $(seq 1 10); do
			if iw reg get | grep -q "country $country:"; then reg_ready=1; break; fi
			sleep 1
		done
	fi
	# Keep working APs when netifd already applied unchanged settings.
	if [ "$reg_ready" = 1 ] && [ -n "$cfg" ] && [ "$cfg" = "$(sha256sum /etc/config/wireless 2>/dev/null)" ] &&
	   /opt/mu300/bin/wifi-ready; then
		echo 'configured wireless interfaces already ready; retaining them' >>/tmp/mu300-wifi-start.log
		return 0
	fi
	# netifd may have scanned before the late, external SC2355 driver created
	# phy0.  Reconcile once immediately when firmware and regulatory data are
	# ready; this is readiness-driven and does not leave a polling worker.
	# A reload does not restart a hostapd interface that already entered
	# AP-DISABLED while the world regulatory domain was still active.  One
	# down/up transition does, immediately after the requested country is live.
	wifi down >>/tmp/mu300-wifi-start.log 2>&1
	wifi up >>/tmp/mu300-wifi-start.log 2>&1
}

start() {
	boot
}
