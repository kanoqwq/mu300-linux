#!/bin/sh
# mu300-dash-cell -- the dashboard's cellular collector: modem/cell/SIM readings into ONE
# cached JSON in the package runtime directory, written by whoever refreshes it.
#
# The web page NEVER runs this directly and never waits for it: the rpcd backend
# (/usr/libexec/rpcd/mu300dash) serves the cache and kicks a background refresh
# (setsid) whenever it is older than the TTL. That separation is the one hard rule
# the V50 panel learned in the field: a synchronous AT round inside a web request
# starves the AT channel, the dial watchdog then sees a dead modem and the box
# ends up rebooting itself (docs/FINDINGS.md, V50 archive "45g").
#
# Everything goes through the configured AT adapter, which is responsible for
# serializing access with the platform dialer and SMS implementation.
#
# Commands per round (about 10, roughly one second on this modem):
#   AT+CFUN?            radio on/off - the honest state for the toggle
#   AT+CSCS?;+COPS?            operator name + access technology
#   AT+CEREG?           LTE registration, TAC, cell ID
#   AT+C5GREG?          NR registration - CEREG alone still reports LTE-style AcT on n78
#   AT+CESQ             RSRP/RSRQ indexes - the fallback when the engineering mode below says nothing
#   AT+SPENGMD=0,6,0    Unisoc engineering: LTE serving cell (band/EARFCN/PCI/RSRP/RSRQ/bandwidth/ECI/TAC)
#   AT+SPENGMD=0,14,1   NR serving cell (band/ARFCN/PCI/RSRP/RSRQ/SINR/MCS/BLER)
#   AT+SPENGMD=0,6,6    LTE neighbour slots (8 x 12 fields, first 4 per slot are the reading)
#   AT+SPENGMD=0,14,2   NR neighbour arrays with per-cell band and SINR
#   AT+SPQ5GNCELLEX     fallback NR neighbour table (no per-cell band)
#   AT+CGEQOSRDP=1      QCI + up/down AMBR of the active bearer
# AT+SPENGMD=0,1,0 is NEVER sent: it switches the AT port into streaming mode and
# kills the channel until the next reboot (V50 archive; blacklisted in the rpcd
# AT terminal too).
#
# SIM/module identity (IMEI/IMSI/ICCID/model/firmware) changes only when the SIM
# or the firmware changes, so it lives in the configured state directory and is re-read
# once per boot and at most every 6 hours thereafter, never inside a page request.
# The own number can become available later through IMS. Query it on every
# full round, not from the persistent identity cache or the fast signal tier.

# Two rounds share this script:
#   mu300-dash-cell          full: everything below, ~11 commands, neighbours included
#   mu300-dash-cell fast     serving-cell tier: CFUN/CEREG/C5GREG/CESQ + the two
#                            SPENGMD serving reads (~6 commands, well under a second),
#                            written to sig.json only - the page polls this at 2 s
#                            and the slow tier (neighbours, operator, QoS, identity)
#                            rides the 5 s full cache. A fast round yields to a full
#                            round in flight (the full round writes sig.json too).

export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/libexec/unisoc-modem:/usr/sbin:/sbin"

MODE=${1:-full}
DIR=${MU300_DASH_DIR:-/tmp/unisoc-modem}
CELL=$DIR/cell.json
SIGF=$DIR/sig.json
STATE_DIR=${MU300_STATE_DIR:-$(uci -q get unisoc_modem.main.state_dir 2>/dev/null)}
IDENT_DIR=${MU300_DASH_IDENT_DIR:-${STATE_DIR%/lock-state.d}}
[ -n "$IDENT_DIR" ] || IDENT_DIR=/etc/unisoc-modem
IDENT=$IDENT_DIR/sim.json
AT=${MU300_AT:-/usr/libexec/unisoc-modem/at}
IDENT_MAXAGE=21600   # seconds; a SIM change goes through a reboot, 6 h is plenty
BOOT_ID=
[ ! -r /proc/sys/kernel/random/boot_id ] || IFS= read -r BOOT_ID < /proc/sys/kernel/random/boot_id

mkdir -p "$DIR" "$IDENT_DIR" 2>/dev/null

# nr3/nr4/nr5 belong to SIM slot 1 and return the wrong state for slot 0.
# The dashboard therefore uses the two verified slot-0-capable optional
# channels nr6/nr7; nr1 is only the final fallback for a failed pool channel.
ATC=${MU300_DASH_AT_DIR:-}
at() {
    local cmd=$1 timeout=${2:-5} d out seen=
    if [ "${MU300_SIM_SLOT:-0}" = 1 ]; then
        out=$(MU300_AT_LOCK_WAIT=0 "$AT" -t "$timeout" "$cmd" 2>/dev/null) || return 1
        printf '%s\n' "$out" | tr -d '\r'; return 0
    fi
    # The assigned regular channel is first. A silent channel fails in about
    # timeout+1 seconds; only then touch the two unpolled disaster channels.
    for d in "$ATC" /run/mu300-at6 /run/mu300-at7 /run/mu300-at; do
        [ -n "$d" ] && [ -p "$d/cmd" ] || continue
        case " $seen " in *" $d "*) continue ;; esac
        seen="$seen $d"
        out=$(MU300_AT_LOCK_WAIT=0 MU300_AT_DIR=$d "$AT" -t "$timeout" "$cmd" 2>/dev/null) || continue
        printf '%s\n' "$out" | tr -d '\r'
        return 0
    done
    out=$("$AT" -t "$timeout" "$cmd" 2>/dev/null) || return 1
    printf '%s\n' "$out" | tr -d '\r'
}
now() { date +%s; }
n_or_null() { case "$1" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }
qs() { [ -n "$1" ] && printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n')" || echo null; }
cnum_number() {
    # +CNUM: "alpha","number",type[,speed,service,...]. Ignore the label,
    # echoes and empty entries; an unprovisioned SIM legitimately has no number.
    awk -F '"' '/^\+CNUM:/ {
        n=$4; gsub(/[ ()-]/, "", n)
        if (n !~ /^\+?[0-9]+$/ || length(n) > 32) next
        if ($5 ~ /^[[:space:]]*,[[:space:]]*145([[:space:]]*,|[[:space:]]*$)/ && n !~ /^\+/) n="+" n
        print n; exit
    }'
}
ims_number() {
    # The stock F50 RIL's getPAU request uses AT+SPPAURI?. Prefer an explicit
    # tel URI, otherwise an international SIP user part. A numeric SIP IMSI
    # without '+' is not sufficient evidence of a telephone number.
    awk '/^\+SPPAURI:/ {
        sub(/^\+SPPAURI:[[:space:]]*/, "")
        count=split($0, fields, /[[:space:]",<>]+/)
        for (i=1; i<=count; i++) {
            uri=fields[i]; lower=tolower(uri)
            if (lower !~ /^(tel|sips?):/) continue
            n=uri; sub(/^[^:]*:/, "", n); sub(/[@;?].*$/, "", n)
            gsub(/[().-]/, "", n)
            digits=n; sub(/^\+/, "", digits)
            if (digits !~ /^[0-9]+$/ || length(digits)<3 || length(digits)>15) continue
            if (lower ~ /^tel:/) { found=1; print n; exit }
            if (n ~ /^\+/ && sip == "") sip=n
        }
    } END { if (!found && sip != "") print sip }'
}

# --------------------------------------------------------------- one collector
# the same "one owner, spare waits/takes over" pattern mu300-atd uses, so two
# kicks (page reload while a refresh runs) cannot interleave AT replies
alive() { [ -n "$1" ] && [ -d "/proc/$1" ] && tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q '/unisoc-modem/cell'; }
take_lock() {  # take_lock DIRVAR - drop overlap, take over a dead holder
    local lock=$1 owner
    while ! mkdir "$lock" 2>/dev/null; do
        owner=$(cat "$lock/pid" 2>/dev/null || true)
        if alive "$owner"; then
            exit 0
        fi
        # mkdir and writing pid are two operations. An empty pid here is the
        # acquisition window of a live peer, not proof of a stale lock.
        [ -n "$owner" ] || exit 0
        rm -rf "$lock"
    done
    echo $$ > "$lock/pid"
}
# One writer for a given output directory. Live RPCs have private output dirs,
# while full/fast status refreshes share DIR and therefore never race a cache.
LOCK=$DIR/collect.lck
take_lock "$LOCK"

# Claim one of two physical dashboard channels without waiting. This caps
# work even when browsers overlap polls: a third collector is discarded and
# the next 2 s refresh retries. Stale slots are reclaimed by PID ownership.
POOL=${MU300_DASH_POOL_DIR:-/run/unisoc-modem-at-pool}
mkdir -p "$POOL" 2>/dev/null
SLOT=
channels='6 7'
[ "${MU300_SIM_SLOT:-0}" != 1 ] || channels=4
for n in $channels; do
    s=$POOL/nr$n
    if mkdir "$s" 2>/dev/null; then
        SLOT=$s; ATC=/run/mu300-at$n; break
    fi
    owner=$(cat "$s/pid" 2>/dev/null || true)
    if [ -n "$owner" ] && ! alive "$owner"; then
        rm -rf "$s"
        if mkdir "$s" 2>/dev/null; then SLOT=$s; ATC=/run/mu300-at$n; break; fi
    fi
done
[ -n "$SLOT" ] || exit 0
echo $$ > "$SLOT/pid"
trap 'rm -rf "$LOCK" "$SLOT" 2>/dev/null' EXIT INT TERM

# ------------------------------------------------------------------- identity
IDENT_JSON=null

# ------------------------------------------------------------- SPENGMD decode
# Unisoc separates fields with "-" and writes negatives as "+<abs>":
# "1-300-211--11747--654" = band 1, EARFCN 300, PCI 211, RSRP -117.47, RSRQ -6.54.
# Normalize ",-" -> ",+" and "--" -> "-+" first, then split on "-". A token may
# carry a comma list (bandwidth codes, CA flags); the scalar is the first field.
# dB values are centi-units and are divided by 100 inside the awk fragments below.
# (No backslash line continuations inside the awk: comma-newline is portable,
# busybox awk does not promise the GNU one.)
sp_fragment() {  # sp_fragment MODE LINE [PHYLINE]  (MODE: lte | nr | ltenb)
    [ -n "$2" ] || { [ "$1" = ltenb ] || echo null; return; }
    awk -v mode="$1" -v line="$2" -v phy="${3:-}" '
        function norm(l, arr,   s, n, i) {
            s = l; gsub(/\r/, "", s)
            gsub(/,-/, ",+", s); gsub(/--/, "-+", s); sub(/^-/, "+", s)
            n = split(s, raw, "-")
            # Prefix before storing: BusyBox awk tags an all-digit field as a
            # numeric string and may wrap a 36-bit cell id before fs() sees it.
            for (i = 1; i <= n; i++) {
                arr[i-1] = "x" raw[i]; gsub(/ /, "", arr[i-1]); arr[i-1] = substr(arr[i-1], 2)
            }
            return n
        }
        # scalar part of a token, sign restored ("+11747" -> -11747)
        function f(x,   v) { v = x; sub(/,.*/, "", v); gsub(/\+/, "-", v); return (v == "" || v == "NA" || v == "N/A") ? "" : v+0 }
        function num(x) { return (x == "") ? "null" : x }
        function c1(x) { if (x == "") return "null"; return sprintf("%.1f", x/100) }
        # large ids (NR cell id is 36 bits) must never go through arithmetic:
        # busybox awk wraps integers at 32 bits (measured: 2579463431 came out
        # negative through both %d and %.0f). fs() passes the token as a string.
        function u32(neg,   top,b,out,i,borrow,d) {
            top = "4294967296"; b = neg
            while (length(b) < 10) b = "0" b
            out = ""; borrow = 0
            for (i = 10; i > 0; i--) {
                d = substr(top,i,1) - substr(b,i,1) - borrow
                if (d < 0) { d += 10; borrow = 1 } else borrow = 0
                out = d out
            }
            sub(/^0+/, "", out); return (out == "") ? "0" : out
        }
        function fs(x,   v) {
            v = x; sub(/,.*/, "", v)
            if (v ~ /^\+/) v = u32(substr(v, 2))
            return (v == "" || v == "NA" || v == "N/A") ? "null" : "\"" v "\""
        }
        function lteband(fr,   a,b,r,i,n) {
            n = split("1:0-599 2:600-1199 3:1200-1949 4:1950-2399 5:2400-2649 6:2650-2749 7:2750-3449 8:3450-3799 9:3800-4149 10:4150-4749 11:4750-4949 12:5010-5179 13:5180-5279 14:5280-5379 17:5730-5849 18:5850-5999 19:6000-6149 20:6150-6449 21:6450-6599 22:6600-7399 23:7500-7699 24:7700-8039 25:8040-8689 26:8690-9039 27:9040-9209 28:9210-9659 29:9660-9769 30:9770-9869 31:9870-9919 32:9920-10359 33:36000-36199 34:36200-36349 35:36350-36949 36:36950-37549 37:37550-37749 38:37750-38249 39:38250-38649 40:38650-39649 41:39650-41589 42:41590-43589 43:43590-45589 44:45590-46589 45:46590-46789 46:46790-54539 47:54540-55239 48:55240-56739 49:56740-58239 50:58240-59089 51:59090-59139 52:59140-60139 65:65536-66435 66:66436-67335 67:67336-67535 68:67536-67835 69:67836-68335 70:68336-68585 71:68586-68935 72:68936-68985 73:68986-69035 74:69036-69465 75:69466-70315 76:70316-70365 85:70366-70545", a, " ")
            for (i = 1; i <= n; i++) { split(a[i], b, ":"); split(b[2], r, "-")
                if (fr >= r[1] && fr <= r[2]) return b[1] }
            return 0
        }
        BEGIN {
            n = norm(line, t)
            if (mode == "lte") {
                band = f(t[0]); earfcn = f(t[1]); pci = f(t[2])
                if ((band == 0 || band == "") && earfcn == 0 && pci == 0) { print "null"; exit }
                bw = ""; m = split(t[7], c, ",")
                for (i = 1; i <= m; i++) { v = c[i]+0
                    w = (v==0)?1.4:(v==1)?3:(v==2)?5:(v==3)?10:(v==4)?15:(v==5)?20:0
                    if (w) bw = bw (bw==""?"":"+") w "M" }
                enb = f(t[11]); cidl = f(t[12])
                tac = f(t[28]); if (tac == "" || tac == 0) tac = f(t[29])
                ca = t[13]
                # 0,0,6 carries the LTE PHY: token 2 = SINR (centi-dB), 3/4 = the UL/DL
                # MCS histograms (the dominant index is the live MCS), 5/6 = BLER.
                # Layout per ufi_tools, range-guarded: this device answers all zeros
                # while camped on 5G SA (no LTE anchor), and an idle histogram is all
                # zeros too - both mean "no reading", not "0 dB".
                psinr = pmcs = pumcs = publer = pdbler = ""
                if (phy != "") {
                    np = norm(phy, u)
                    s2 = f(u[2])
                    if (s2 != "" && s2 >= -2000 && s2 <= 4000) psinr = sprintf("%.1f", s2/100)
                    publer = c1(f(u[5])); pdbler = c1(f(u[6]))
                    for (dir = 3; dir <= 4; dir++) {
                        m2 = split(u[dir], h, ","); best = -1; bestn = 0; total = 0
                        for (i = 1; i <= m2; i++) { hv = h[i]+0; total += hv
                            if (hv > bestn) { bestn = hv; best = i - 1 } }
                        if (total > 0 && best >= 0) {
                            if (dir == 4) pmcs = best; else pumcs = best
                        }
                    }
                }
                printf "{\"band\":%d,\"earfcn\":%d,\"pci\":%d,\"rsrp\":%s,\"rsrq\":%s,\"bw\":\"%s\",\"enb\":%s,\"cid\":%s,\"tac\":\"%s\",\"ca\":\"%s\",\"sinr\":%s,\"dl_mcs\":%s,\"ul_mcs\":%s,\"dl_bler\":%s,\"ul_bler\":%s}",
                    band, earfcn, pci, c1(f(t[3])), c1(f(t[4])), bw, num(enb), num(cidl),
                    (tac=="")?"":sprintf("%x",tac), (index(ca,"DL_CA")?"DL_CA":""),
                    (psinr == "" ? "null" : psinr),
                    (pmcs == "" ? "null" : pmcs), (pumcs == "" ? "null" : pumcs), pdbler, publer
            } else if (mode == "nr") {
                band = f(t[0]); arfcn = f(t[1]); pci = f(t[2])
                if ((band == 0 || band == "") && arfcn == 0 && pci == 0) { print "null"; exit }
                bw = f(t[7])
                printf "{\"band\":%d,\"arfcn\":%d,\"pci\":%d,\"rsrp\":%s,\"rsrq\":%s,\"sinr\":%s,\"bw_mhz\":%s,\"gnb\":%s,\"cid\":%s,\"ul_mcs\":%s,\"dl_mcs\":%s,\"ul_bler\":%s,\"dl_bler\":%s}",
                    band, arfcn, pci, c1(f(t[3])), c1(f(t[4])), c1(f(t[15])), num(bw),
                    fs(t[8]), fs(t[9]), num(f(t[16])), num(f(t[17])), c1(f(t[18])), c1(f(t[19]))
            } else {   # ltenb: up to eight dash-delimited 12-field CSV blocks
                out = ""
                for (s = 0; s < n && s < 8; s++) {
                    fields = split(t[s], row, ","); if (fields < 4) continue
                    earfcn = f(row[1]); pci = f(row[2])
                    if (earfcn == 0 && pci == 0) continue
                    out = out sprintf("{\"rat\":\"lte\",\"band\":%d,\"arfcn\":%d,\"pci\":%d,\"rsrp\":%s,\"rsrq\":%s},",
                        lteband(earfcn), earfcn, pci, c1(f(row[3])), c1(f(row[4])))
                }
                sub(/,$/, "", out); print (out == "" ? "" : out)
            }
        }'
}

nr_neighbours() {  # SPENGMD: band/ARFCN/PCI/RSRP/RSRQ/SINR arrays; SPQ fallback has no band
    [ -n "$1" ] || { echo ""; return; }
    awk -v line="$1" -v source="$2" '
        function signed(v) { gsub(/\+/, "-", v); return v+0 }
        function nrband(fr,   a,b,r,i,n) {
            # n78 is contained in n77. The fallback does not report the band,
            # so their shared ARFCNs must remain ambiguous rather than n77.
            if (fr >= 620000 && fr <= 653333) return "null"
            n = split("1:422000-434000 3:361000-376000 5:173800-178800 8:185000-192000 28:151600-160600 40:460000-480000 41:499200-537999 77:653334-680000 79:693334-733333", a, " ")
            for (i = 1; i <= n; i++) { split(a[i], b, ":"); split(b[2], r, "-")
                if (fr >= r[1] && fr <= r[2]) return b[1] }
            return "null"
        }
        BEGIN {
            if (source == "spengmd") {
                # Unisoc uses "-" between arrays but "+" for negative values.
                # Restore the signs before splitting; do not infer band from ARFCN.
                gsub(/\r/, "", line)
                gsub(/,-/, ",+", line); gsub(/--/, "-+", line); sub(/^-/, "+", line)
                n = split(line, field, "-")
                if (n < 6) exit
                count = split(field[1], bands, ",")
                a = split(field[2], arfcns, ","); if (a < count) count = a
                a = split(field[3], pcis, ","); if (a < count) count = a
                a = split(field[4], rsrps, ","); if (a < count) count = a
                a = split(field[5], rsrqs, ","); if (a < count) count = a
                a = split(field[6], sinrs, ","); if (a < count) count = a
                for (i = 1; i <= count; i++) {
                    if (bands[i] !~ /^[0-9]+$/ || arfcns[i] !~ /^[0-9]+$/ || pcis[i] !~ /^[0-9]+$/) continue
                    if (rsrps[i] !~ /^\+?[0-9]+$/ || rsrqs[i] !~ /^\+?[0-9]+$/ || sinrs[i] !~ /^\+?[0-9]+$/) continue
                    if (bands[i]+0 == 0 || arfcns[i]+0 == 0) continue
                    out = out sprintf("{\"rat\":\"nr\",\"band\":%d,\"arfcn\":%d,\"pci\":%d,\"rsrp\":%.1f,\"rsrq\":%.1f,\"sinr\":%.1f},",
                        bands[i], arfcns[i], pcis[i], signed(rsrps[i])/100, signed(rsrqs[i])/100, signed(sinrs[i])/100)
                }
                sub(/,$/, "", out); print out
                exit
            }
            # SPQ5GNCELLEX CSV: serving 8-tuple, count at index 8, then
            # 8-tuples (arfcn,pci,rsrp,rsrq,sinr,...). It has no band field.
            m = split(line, a, ","); cnt = a[9]+0
            out = ""
            for (i = 0; i < cnt && i < 8; i++) {
                b = 9 + i*8; if (b+5 > m) break
                fr = a[b+1]+0; pci = a[b+2]+0
                if (fr == 0 && pci == 0) continue
                out = out sprintf("{\"rat\":\"nr\",\"band\":%s,\"band_candidates\":%s,\"arfcn\":%d,\"pci\":%d,\"rsrp\":%.1f,\"rsrq\":%.1f,\"sinr\":%.1f},",
                    nrband(fr), (fr >= 620000 && fr <= 653333) ? "[77,78]" : "[]",
                    fr, pci, a[b+3]/100, a[b+4]/100, a[b+5]/100)
            }
            sub(/,$/, "", out); print out
        }'
}

# registration line "+CEREG: 2,1,\"01F0\",\"0ABCD123\",13" -> fragment
reg_fragment() {  # reg_fragment LINE
    [ -n "$1" ] || { echo null; return; }
    printf '%s\n' "$1" | sed 's/^+C[5]*EREG: *//' | tr -d '"' | awk -F',' '
        { act = ($5 == "") ? "null" : $5
          printf "{\"stat\":%s,\"tac\":%s,\"cid\":%s,\"act\":%s}",
              (($2=="")?"null":$2), (($3=="")?"null":"\""$3"\""), (($4=="")?"null":"\""$4"\""), act }'
}

cops_fragment() {
    ucode "$(dirname "$0")/operator.uc" "$1" 2>/dev/null || echo null
}

cesq_fragment() {  # "+CESQ: 24,99,55,255,36,98"
    [ -n "$1" ] || { echo null; return; }
    printf '%s\n' "$1" | sed 's/^+CESQ: *//' | awk -F',' '
        { if ($6 != "" && $6 != 255) rsrp = $6 - 140; else rsrp = "null"
          if ($5 != "" && $5 != 255) rsrq = sprintf("%.1f", -19.5 + $5*0.5); else rsrq = "null"
          printf "{\"rsrp\":%s,\"rsrq\":%s}", rsrp, rsrq }'
}

qos_fragment() {  # "+CGEQOSRDP: 1,9,..OK" (this modem glues OK onto the line)
    [ -n "$1" ] || { echo null; return; }
    printf '%s\n' "$1" | sed 's/OK$//; s/^+CGEQOSRDP: *//' | awk -F',' '
        { if ($2 == "") { print "null"; exit }
          printf "{\"qci\":%s,\"dl\":%s,\"ul\":%s}", $2,
              ($7 != "" && $7 > 0) ? sprintf("%.1f", $7/1000) : "null",
              ($8 != "" && $8 > 0) ? sprintf("%.1f", $8/1000) : "null" }'
}

# ---------------------------------------------------------- staged AT round
# Publish the cheap, universally available core first. The UI can show radio,
# registration and CESQ while the optional engineering/identity tier continues.
CFUN=$(at 'AT+CFUN?' 2 | sed -n 's/^+CFUN: *//p' | head -n1)
CEREG=$(at 'AT+CEREG?' 2 | grep '^+CEREG:' | head -n1)
C5GREG=$(at 'AT+C5GREG?' 2 | grep '^+C5GREG:' | head -n1)
CESQ=$(at 'AT+CESQ' 2 | grep '^+CESQ:' | head -n1)
REG=$(reg_fragment "$CEREG"); REG5=$(reg_fragment "$C5GREG")
CESQJ=$(cesq_fragment "$CESQ"); CFUNN=$(n_or_null "$CFUN")
printf '{"ts":%d,"partial":1,"cfun":%s,"reg":%s,"reg5g":%s,"sig_src":"cesq","sig":%s,"lte":null,"nr":null}\n' \
    "$(now)" "$CFUNN" "$REG" "$REG5" "$CESQJ" > "$SIGF.part" && mv "$SIGF.part" "$SIGF"

# Engineering reads, neighbours and bearer QoS have no useful answer while the
# modem is searching/no-service. Skipping them avoids a chain of AT timeouts.
R4=$(printf '%s\n' "$CEREG" | tr -d '"' | awk -F',' '{ gsub(/ /,"",$2); print $2 }')
R5=$(printf '%s\n' "$C5GREG" | tr -d '"' | awk -F',' '{ gsub(/ /,"",$2); print $2 }')
REGISTERED=0
case "$R4:$R5" in 1:*|5:*|10:*|*:1|*:5|*:10) REGISTERED=1 ;; esac
SP_LTE=; SP_LTEPHY=; SP_NR=; SP_LN=; SP_NRNB=; SP_NRNB_SOURCE=; QOS=; COPS=
if [ "$REGISTERED" = 1 ]; then
    SP_LTE=$(at 'AT+SPENGMD=0,6,0' 2 | grep -v '^AT' | grep -- '-' | head -n1)
    SP_LTEPHY=$(at 'AT+SPENGMD=0,0,6' 2 | grep -v '^AT' | grep -- '-' | head -n1)
    SP_NR=$(at 'AT+SPENGMD=0,14,1' 2 | grep -v '^AT' | grep -- '-' | head -n1)
fi

# "no answer at all" is a modem/daemon problem, not "no signal".
if [ -z "$CFUN$CEREG$CESQ$SP_LTE$SP_NR$COPS" ]; then
    ERR="AT backend did not answer (radio off, modem restarting, or adapter unavailable)"
    printf '{"ts":%d,"error":%s}\n' "$(now)" "$(qs "$ERR")" > "$SIGF.part" && mv "$SIGF.part" "$SIGF"
    [ "$MODE" = full ] && cp "$SIGF" "$CELL"
    exit 0
fi

LTE=$(sp_fragment lte "$SP_LTE" "$SP_LTEPHY")
NR=$(sp_fragment nr "$SP_NR")
REG=$(reg_fragment "$CEREG")
REG5=$(reg_fragment "$C5GREG")
CESQJ=$(cesq_fragment "$CESQ")
CFUNN=$(n_or_null "$CFUN")

# preferred signal source: NR (NSA/SA), then LTE, then the CESQ fallback
if [ "$NR" != null ]; then SIG="$NR"; SRC=nr
elif [ "$LTE" != null ]; then SIG="$LTE"; SRC=lte
else SIG="$CESQJ"; SRC=cesq; fi

# the fast tier: serving cell + registration only (both modes write it; the page
# polls this at 2 s and overlays it on the slower full cache)
printf '{"ts":%d,"cfun":%s,"reg":%s,"reg5g":%s,"sig_src":"%s","sig":%s,"lte":%s,"nr":%s}\n' \
    "$(now)" "$CFUNN" "$REG" "$REG5" "$SRC" "$SIG" "$LTE" "$NR" > "$SIGF.part" && mv "$SIGF.part" "$SIGF"

[ "$MODE" = fast ] && exit 0

# Each atomic publication has an explicit completion state. Frontends retain
# old QoS/identity/neighbours only while that particular stage is pending.
publish_cell() {
    printf '{"ts":%d,"partial":%s,"neigh_pending":%s,"cfun":%s,"reg":%s,"reg5g":%s,"operator":%s,"sig_src":"%s","sig":%s,"lte":%s,"nr":%s,"qos":%s,"neigh":%s,"ident":%s}\n' \
        "$(now)" "$1" "$2" "$CFUNN" "$REG" "$REG5" "$COPSJ" "$SRC" "$SIG" "$LTE" "$NR" "$QOSJ" "$NEIGH" "$IDENT_JSON" > "$CELL.part" && mv "$CELL.part" "$CELL"
}

if [ "$MODE" = full ]; then
    # One serialized transaction: do not let an SMS charset change interleave.
    COPS=$(at 'AT+CSCS?;+COPS?' 2)
    COPSJ=$(cops_fragment "$COPS")
    NEIGH=null; QOSJ=null
    publish_cell 1 1
    if [ "$REGISTERED" = 1 ]; then
        SP_LN=$(at 'AT+SPENGMD=0,6,6' 2 | grep -v '^AT' | grep -- '-' | head -n1)
        SP_NRNB=$(at 'AT+SPENGMD=0,14,2' 2 | grep -v '^AT' | grep -- '-' | head -n1)
        SP_NRNB_SOURCE=spengmd
        if [ -z "$SP_NRNB" ]; then
            SP_NRNB=$(at 'AT+SPQ5GNCELLEX' 2 | sed -n 's/^+SPQ5GNCELLEX: *//p' | head -n1)
            SP_NRNB_SOURCE=spq
        fi
    fi
    LN=$(sp_fragment ltenb "$SP_LN")
    NN=$(nr_neighbours "$SP_NRNB" "$SP_NRNB_SOURCE")
    # one neighbour list, NR first (the page shows NR cells at the top)
    if [ -n "$NN" ] && [ -n "$LN" ]; then NEIGH="[$NN,$LN]"
    elif [ -n "$NN" ]; then NEIGH="[$NN]"
    elif [ -n "$LN" ]; then NEIGH="[$LN]"
    else NEIGH=null; fi

    publish_cell 1 0
    if [ "$REGISTERED" = 1 ]; then
        QOS=$(at 'AT+CGEQOSRDP=1' 2 | sed -n 's/^+CGEQOSRDP: *//p' | head -n1)
    fi
    QOSJ=$(qos_fragment "$QOS")
    IDENT_AGE=999999
    [ -s "$IDENT" ] && IDENT_AGE=$(( $(now) - $(date -r "$IDENT" +%s 2>/dev/null || echo 0) ))
    if [ "$IDENT_AGE" -ge 0 ] && [ "$IDENT_AGE" -le "$IDENT_MAXAGE" ] &&
       [ -n "$BOOT_ID" ] && grep -Fq "\"boot_id\":\"$BOOT_ID\"" "$IDENT" &&
       ! grep -q '"msisdn"[[:space:]]*:' "$IDENT"; then
        IDENT_JSON=$(cat "$IDENT" 2>/dev/null || echo null)
    else
        i_mfg=$(at 'AT+CGMI' 2 | grep -v '^OK' | head -n1)
        i_model=$(at 'AT+CGMM' 2 | grep -v '^OK' | head -n1)
        i_fw=$(at 'AT+CGMR' 2 | grep -v '^OK' | head -n1)
        i_imei=$(at 'AT+CGSN' 2 | tr -cd '0-9' | cut -c1-15)
        i_imsi=$(at 'AT+CIMI' 2 | tr -cd '0-9' | cut -c1-15)
        i_iccid=$(at 'AT+CCID' 2 | tr -d '\r' | sed -n 's/^+CCID:[[:space:]]*"\{0,1\}\([A-Za-z0-9]*\)"\{0,1\}[[:space:]]*$/\1/p' | head -n1)
        if [ -n "$i_imei$i_imsi$i_iccid" ]; then
            # Persist static identity only; legacy caches with an own-number
            # field are rebuilt once so they cannot leak a stale number.
            IDENT_JSON=$(printf '{"ts":%d,"boot_id":%s,"mfg":%s,"model":%s,"fw":%s,"imei":%s,"imsi":%s,"iccid":%s}' \
                "$(now)" "$(qs "$BOOT_ID")" "$(qs "$i_mfg")" "$(qs "$i_model")" "$(qs "$i_fw")" "$(qs "$i_imei")" "$(qs "$i_imsi")" "$(qs "$i_iccid")")
            printf '%s\n' "$IDENT_JSON" > "$IDENT.part" 2>/dev/null && mv "$IDENT.part" "$IDENT"
        elif [ -s "$IDENT" ] && ! grep -q '"msisdn"[[:space:]]*:' "$IDENT"; then
            IDENT_JSON=$(cat "$IDENT")
        fi
    fi
    # Fresh lookup, even after an empty startup response. Use the existing
    # serialized AT adapter; no new worker, disk write or fast-tier query.
    i_msisdn=$(at 'AT+CNUM' 2 | cnum_number)
    i_msisdn_source=sim
    if [ -z "$i_msisdn" ]; then
        i_msisdn=$(at 'AT+SPPAURI?' 2 | ims_number)
        i_msisdn_source=ims
    fi
    [ -n "$i_msisdn" ] || i_msisdn_source=
    case "$IDENT_JSON" in
        null|'{}') IDENT_JSON='{' ;;
        *) IDENT_JSON="${IDENT_JSON%?}," ;;
    esac
    IDENT_JSON=$(printf '%s"msisdn":%s,"msisdn_source":%s}' \
        "$IDENT_JSON" "$(qs "$i_msisdn")" "$(qs "$i_msisdn_source")")
fi

publish_cell 0 0
