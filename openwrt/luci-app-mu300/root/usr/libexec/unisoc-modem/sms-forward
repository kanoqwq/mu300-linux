    while [ "$last_id" -lt "$_max" ] && [ "$_processed" -lt 1 ]; do
        _id=$((last_id + 1))
        _file=$(message_file "$_id")
        # next_id is written before the message rename. Keep the newest
        # missing ID pending until the next poll; older missing IDs were
        # deleted, so those may be skipped.
        if [ ! -f "$_file" ]; then
            if [ "$_id" -eq "$_max" ]; then
                [ "$last_id" = "$_start_id" ] || save_state
                return 0
            fi
            last_id=$_id
            continue
        fi
        _dir=$(msg_field "$_file" dir)
        _from=$(msg_field "$_file" from)
        _received=$(msg_field "$_file" received)
        _scts=$(msg_field "$_file" scts)
        _source=$(msg_field "$_file" source)
        _coding=$(msg_field "$_file" coding)
