        smtp) _include=$smtp_forward_device_info ;;
        dingtalk) _include=$dingtalk_forward_device_info ;;
        sms) _include=$sms_forward_device_info ;;
    esac
    if [ "$_include" = 1 ]; then
        if [ "$method" = sms ]; then _content="$_content$NL$(device_info_sms)"
