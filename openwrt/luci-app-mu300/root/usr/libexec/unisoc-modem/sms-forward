    if [ "${2:-}" != locked ]; then
        exec 8> "$BASE/state.lock"
        flock -n 8 || exit 1
    fi
    select_profile "${1:-shared}" || exit 1
    if [ "$profile" = sim1 ]; then
        export MU300_SIM_SLOT=1 MU300_SMS_POOL=$POOL MU300_AT_DIR=/run/mu300-at4
        export MU300_SMS_OP_LOCK=/tmp/mu300-sms-op-sim1.lock MU300_SMS_DIRECT_FLAG=/run/mu300-sms-direct-sim1
    else
        export MU300_SIM_SLOT=0 MU300_SMS_POOL=$ROOT_POOL MU300_AT_DIR=/run/mu300-at
        export MU300_SMS_OP_LOCK=/tmp/mu300-sms-op.lock MU300_SMS_DIRECT_FLAG=/run/mu300-sms-direct
    fi
    load_config || exit 1
    load_state; read_result
    deliver test NMS '' || :
    record_delivery test || :
    write_result "$DELIVER_RESULT" "$power_last_result" || :
}
start_test() {
    ensure_base && select_profile "${1:-shared}" && load_config || { reply_error invalid_config; return; }
    [ "$enabled" = 1 ] || { reply_error disabled; return; }
    exec 8> "$BASE/state.lock"
    flock -n 8 || { reply_error forward_busy; return; }
    test_gate || { reply_error forward_test_wait; return; }
    # The child inherits the admission lock; repeated clicks cannot enqueue
    # an unbounded group of workers or occupy an RPC for a slow HTTP timeout.
    setsid "$0" test-run "$profile" locked </dev/null >/dev/null 2>&1 &
    printf '{"ok":1,"started":1}\n'
}
run_daemon() {
    ensure_base || exit 1
    # procd owns the process. A second manual start exits without stealing work.
    exec 9> "$BASE/daemon.lock"
    flock -n 9 || exit 0
    while :; do
        exec 8> "$BASE/state.lock"
        flock -x 8 || exit 1
        if read_mode && select_profile shared && load_config; then
            process_first_sim || :
            load_state; read_result
            ( STATE=$BASE/state.power; load_state; process_power ) || :
            process_second_sim || :
        fi
        flock -u 8
        # Idle sleep must not retain the singleton lock after procd stops us.
        sleep "${MU300_FORWARD_POLL:-5}" 8>&- 9>&-
    done
}
case "${1:-}" in
    get) get_view "${2:-shared}" ;;
    status) status_only "${2:-shared}" ;;
    set) set_config ;;
    test-run) test_send "${2:-shared}" "${3:-}" ;;
    test-start) start_test "${2:-shared}" ;;
    log-clear) clear_history ;;
    run) run_daemon ;;
    *) echo 'usage: sms-forward {get|status|set|test-run|run}' >&2; exit 2 ;;
esac
