            [ "$_kind" = power ] && json_add_string kind power
            json_add_string from "$_from"
            json_add_string text "$_text"
            json_add_string date "$_date"
            [ "$_include" = 1 ] && json_add_string device_info "$(device_info)"
            _url=$webhook_url
        fi
