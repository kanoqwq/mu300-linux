#!/bin/sh
# Standalone, opt-in SMS forwarding. Never polls the modem: the platform SMS
# adapter owns AT and writes complete, atomically-renamed files to the pool.
umask 077
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
. /usr/share/libubox/jshn.sh

BASE=${MU300_FORWARD_DIR:-/etc/unisoc-modem/forward}
. "${MU300_SMS_POOL_LIB:-/opt/mu300/lib/sms-pool.sh}" || exit 1
POOL=$(mu300_sms_pool adapter)
ROOT_POOL=$POOL
CONFIG=$BASE/config.json
STATE=$BASE/state
RESULT=${MU300_FORWARD_RESULT:-/run/unisoc-modem-forward-result}
HISTORY=${MU300_FORWARD_HISTORY:-$RESULT.history}
ROOT_RESULT=$RESULT
RENDERER=${MU300_FORWARD_RENDERER:-/usr/libexec/unisoc-modem/forward-template.uc}
SMS=${MU300_SMS_BIN:-$(uci -q get unisoc_modem.main.sms_command 2>/dev/null)}
[ -n "$SMS" ] || SMS=$(command -v mu300-sms 2>/dev/null || true)
case "$SMS" in */*) ;; *) SMS=$(command -v "$SMS" 2>/dev/null || true) ;; esac
POWER_LIB=${MU300_POWER_LIB:-${0%/*}/power-supply.sh}
[ -r "$POWER_LIB" ] || POWER_LIB=${RENDERER%/*}/power-supply.sh
[ -r "$POWER_LIB" ] || POWER_LIB=/usr/libexec/unisoc-modem/power-supply.sh
. "$POWER_LIB"
NL='
'
CR=$(printf '\r')

reply_error() {
    json_init
    json_add_int ok 0
    json_add_string error "$1"
    json_dump
}
reply_ok() { printf '{"ok":1}\n'; }
number() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
bool() { [ "$1" = 0 ] || [ "$1" = 1 ]; }
read_mode() {
    forward_mode=shared
    [ ! -r "$BASE/mode" ] || read -r forward_mode < "$BASE/mode"
    case "$forward_mode" in shared|per_sim) ;; *) return 1 ;; esac
}
select_profile() {
    profile=${1:-shared}
    CONFIG=$BASE/config.json STATE=$BASE/state POOL=$ROOT_POOL RESULT=$ROOT_RESULT
    case "$profile" in
        shared) ;;
        sim0) CONFIG=$BASE/config.sim0.json; RESULT=$ROOT_RESULT.sim0 ;;
        sim1)
            [ "$(uci -q get unisoc_modem.main.sim_slots 2>/dev/null)" = 2 ] || return 1
            CONFIG=$BASE/config.sim1.json STATE=$BASE/state.sim1 POOL=$ROOT_POOL/sim1 RESULT=$ROOT_RESULT.sim1 ;;
        *) return 1 ;;
    esac
}
webhook_fields() {
    json_add_string webhook_method "$webhook_method"
    json_add_string webhook_content_type "$webhook_content_type"
    json_add_string webhook_body "$webhook_body"
    json_add_string webhook_headers "$webhook_headers"
    json_add_int webhook_timeout "$webhook_timeout"
    json_add_string webhook_expect "$webhook_expect"
}
render_webhook() { # JSON input, no eval or shell expansion of templates
    json_init; json_add_object config
    json_add_string webhook_url "$webhook_url"; webhook_fields; json_close_object
    json_add_object values
    json_add_string from "${_from:-}"; json_add_string text "${_text:-}"
    json_add_string time "${_date:-}"
    json_add_string sim "SIM$((${MU300_SIM_SLOT:-0} + 1))"
    json_add_string device "${nickname:-$(cat /proc/sys/kernel/hostname 2>/dev/null)}"
    json_add_string kind "${_kind:-sms}"; json_close_object
    json_dump | ucode "$RENDERER" 2>/dev/null
}
one_line() {
    case "$1" in *"$NL"*|*"$CR"*) return 1 ;; esac
    [ -z "$(printf '%s' "$1" | LC_ALL=C tr -d '\040-\176\200-\377')" ]
}
phone() {
    _digits=${1#+}
    number "$_digits" && [ ${#_digits} -ge 3 ] && [ ${#_digits} -le 32 ]
}
host_name() {
    case "$1" in ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*|-*|*-|*.-*|*-.*|localhost|*.localhost|*.local|*.internal) return 1 ;; esac
    case "$1" in *.*) ;; *) return 1 ;; esac
    # Literal IPv4 addresses and numeric pseudo-hostnames are not destinations.
    case "$1" in *[a-zA-Z]*) return 0 ;; *) return 1 ;; esac
}
mailbox() {
    case "$1" in *'@'*) ;; *) return 1 ;; esac
    _local=${1%%@*}; _domain=${1#*@}
    case "$_local" in ''|.*|*.|*..*|*[!a-zA-Z0-9._%+-]*) return 1 ;; esac
    [ ${#1} -le 254 ] && host_name "$_domain"
}
public_ip() {
    case "$1" in
        *:*)
            _ip_lc=$(printf '%s' "$1" | tr 'A-F' 'a-f')
            case "$_ip_lc" in 2001:db8:*|2001:0db8:*) return 1 ;; esac
            case "$_ip_lc" in [23]*) return 0 ;; *) return 1 ;; esac ;;
        *)
            _oldifs=$IFS; IFS=.; set -- $1; IFS=$_oldifs
            [ "$#" -eq 4 ] || return 1
            for _octet in "$@"; do
                number "$_octet" && [ "$_octet" -le 255 ] || return 1
            done
            case "$1" in 0|10|127|224|225|226|227|228|229|230|231|232|233|234|235|236|237|238|239|24[0-9]|25[0-5]) return 1 ;; esac
            [ "$1" = 169 ] && [ "$2" = 254 ] && return 1
            [ "$1" = 192 ] && { [ "$2" = 168 ] || [ "$2" = 0 ]; } && return 1
            [ "$1" = 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ] && return 1
            [ "$1" = 100 ] && [ "$2" -ge 64 ] && [ "$2" -le 127 ] && return 1
            [ "$1" = 198 ] && { [ "$2" = 18 ] || [ "$2" = 19 ]; } && return 1
            [ "$1" = 198 ] && [ "$2" = 51 ] && [ "$3" = 100 ] && return 1
            [ "$1" = 192 ] && [ "$2" = 0 ] && [ "$3" = 2 ] && return 1
            [ "$1" = 203 ] && [ "$2" = 0 ] && [ "$3" = 113 ] && return 1
            return 0 ;;
    esac
}
resolve_public() { # hostname, port -> pinned curl --resolve argument
    _resolved=$(nslookup "$1" 2>/dev/null | awk '/^Name:/ {answer=1} answer && /^Address:/ {print $2}')
    [ -n "$_resolved" ] || return 1
    _picked=
    while IFS= read -r _ip || [ -n "$_ip" ]; do
        public_ip "$_ip" || return 1
        case "$_ip" in *:*) [ -n "$_picked" ] || { _picked="[$_ip]"; PICKED_IP=$_ip; } ;;
            *) _picked=$_ip; PICKED_IP=$_ip ;;
        esac
    done <<EOF_RESOLVED
$_resolved
EOF_RESOLVED
    [ -n "$_picked" ] || return 1
    RESOLVE="$1:$2:$_picked"
}
https_url() {
    case "$1" in https://*) ;; *) return 1 ;; esac
    case "$1" in *'#'*) return 1 ;; esac
    _authority=${1#https://}; _authority=${_authority%%/*}; _authority=${_authority%%\?*}
    case "$_authority" in *'@'*|'') return 1 ;; esac
    _url_host=${_authority%%:*}
    _url_port=443
    if [ "$_authority" != "$_url_host" ]; then
        _url_port=${_authority#*:}
        number "$_url_port" && [ "$_url_port" -gt 0 ] && [ "$_url_port" -le 65535 ] || return 1
    fi
    host_name "$_url_host" && [ ${#1} -le 2048 ] && one_line "$1"
}
list_valid() { # newline-delimited list, max count, kind
    [ -z "$1" ] && return 0
    _count=0; _seen=$NL
    while IFS= read -r _entry || [ -n "$_entry" ]; do
        [ -n "$_entry" ] || return 1
        _count=$((_count + 1)); [ "$_count" -le "$2" ] || return 1
        case "$3" in
            phone) phone "$_entry" || return 1; _key=${_entry#+} ;;
            keyword)
                [ ${#_entry} -le 128 ] && one_line "$_entry" || return 1
                _key=$_entry ;;
        esac
        case "$_seen" in *"$NL$_key$NL"*) return 1 ;; esac
        _seen="$_seen$_key$NL"
    done <<EOF_LIST
$1
EOF_LIST
}
# PR #211: optional top-level JSON success rule; no eval or response in logs.
answer_rule_valid() {
    [ -z "$1" ] && return 0
    [ ${#1} -le 128 ] && one_line "$1" || return 1
    _answer_key=${1%%=*}; _answer_value=${1#*=}
    case "$_answer_key" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac
    [ ${#_answer_key} -le 64 ] || return 1
    case "$_answer_value" in
        ''|*=*) return 1 ;;
        *[!0-9-]*)
            [ ${#_answer_value} -le 16 ] || return 1
            case "$_answer_value" in *[!a-z]*) return 1 ;; esac ;;
        *) _answer_digits=${_answer_value#-}
            number "$_answer_digits" && [ ${#_answer_digits} -le 16 ] || return 1 ;;
    esac
}
answer_check() {
    _expect=${webhook_expect:-}
    [ "$method" != dingtalk ] || _expect=errcode=0
    [ -n "$_expect" ] || return 0
    answer_rule_valid "$_expect" || { DELIVER_RESULT=invalid_forward_config; return 1; }
    _verdict=$(MU300_FORWARD_EXPECT="$_expect" ucode "${MU300_FORWARD_ANSWER:-/usr/libexec/unisoc-modem/forward-answer.uc}" "$1" 2>/dev/null) || _verdict=none
    case "$_verdict" in
        ok) return 0 ;;
        differs) DELIVER_RESULT=service_rejected ;;
        *) DELIVER_RESULT=service_answer_missing ;;
    esac
    return 1
}
clear_history() {
    ensure_base || { reply_error forward_storage_failed; return; }
    exec 8> "$BASE/state.lock"
    flock -n 8 || { reply_error forward_busy; return; }
    # Only remove the log name: never truncate a symlink's target or touch cursors.
    rm -f -- "$HISTORY" || { reply_error forward_storage_failed; return; }
    reply_ok
}
test_gate() {
    local uptime idle last=0
    read -r uptime idle < /proc/uptime || return 1
    uptime=${uptime%%.*}
    [ ! -r "$ROOT_RESULT.test-at" ] || read -r last < "$ROOT_RESULT.test-at"
    number "$last" && number "$uptime" || return 1
    [ "$uptime" -lt "$last" ] || [ "$last" = 0 ] || [ "$((uptime - last))" -ge 5 ] || return 1
    printf '%s\n' "$uptime" > "$ROOT_RESULT.test-at"
}

load_config() {
    enabled=0 method=webhook webhook_url= dingtalk_webhook= dingtalk_secret=
    sms_to_phone= smtp_host= smtp_port=465 smtp_username= smtp_to= smtp_password=
    power_forward_enabled=0 blacklist_phone= blacklist_keywords= nickname= template_language=
    smtp_forward_device_info=0 dingtalk_forward_device_info=0 sms_forward_device_info=0
    webhook_method=POST webhook_content_type=application/json webhook_body= webhook_headers= webhook_timeout=12 webhook_expect=
    [ -s "$CONFIG" ] || return 0
    json_load_file "$CONFIG" 2>/dev/null || return 1
    json_get_vars enabled method webhook_url dingtalk_webhook dingtalk_secret sms_to_phone
    json_get_vars smtp_host smtp_port smtp_username smtp_to smtp_password
    json_get_vars power_forward_enabled blacklist_phone blacklist_keywords nickname
    json_get_vars smtp_forward_device_info dingtalk_forward_device_info sms_forward_device_info
    json_get_var template_language template_language ''
    json_get_var webhook_method webhook_method POST
    json_get_var webhook_content_type webhook_content_type application/json
    json_get_var webhook_body webhook_body ''
    json_get_var webhook_headers webhook_headers ''
    json_get_var webhook_timeout webhook_timeout 12
    json_get_var webhook_expect webhook_expect ''
}
load_state() {
    last_id=0 since=0 power_percent=-1 power_status=none
    [ -s "$STATE" ] || return 0
    # Ignore the trailing quota fields from older releases.
    IFS='|' read -r last_id since power_percent power_status _legacy < "$STATE" || :
    number "$last_id" || last_id=0
    number "$since" || since=0
}
ensure_base() { mkdir -p "$BASE" && chmod 700 "$BASE"; }
save_state() {
    ensure_base || return 1
    printf '%s|%s|%s|%s\n' "$last_id" "$since" "$power_percent" "$power_status" > "$STATE.tmp.$$" || return 1
    mv -f "$STATE.tmp.$$" "$STATE"
}
save_config() {
    ensure_base || return 1
    json_init
    json_add_boolean enabled "$enabled"
    json_add_string method "$method"
    json_add_string template_language "$template_language"
    json_add_string webhook_url "$webhook_url"
    webhook_fields
    json_add_string dingtalk_webhook "$dingtalk_webhook"
    json_add_string dingtalk_secret "$dingtalk_secret"
    json_add_string sms_to_phone "$sms_to_phone"
    json_add_string smtp_host "$smtp_host"
    json_add_int smtp_port "$smtp_port"
    json_add_string smtp_username "$smtp_username"
    json_add_string smtp_to "$smtp_to"
    json_add_string smtp_password "$smtp_password"
    json_add_boolean power_forward_enabled "$power_forward_enabled"
    json_add_string blacklist_phone "$blacklist_phone"
    json_add_string blacklist_keywords "$blacklist_keywords"
    json_add_string nickname "$nickname"
    json_add_boolean smtp_forward_device_info "$smtp_forward_device_info"
    json_add_boolean dingtalk_forward_device_info "$dingtalk_forward_device_info"
    json_add_boolean sms_forward_device_info "$sms_forward_device_info"
    json_dump > "$CONFIG.tmp.$$" || return 1
    mv -f "$CONFIG.tmp.$$" "$CONFIG"
}
write_result() { printf '%s|%s\n' "$1" "$2" > "$RESULT.tmp.$$" && mv -f "$RESULT.tmp.$$" "$RESULT"; }
record_delivery() { # kind only; never store destination, source or message content
    case "$1" in sms|power|test) ;; *) return 1 ;; esac
    case "$method" in webhook|dingtalk|smtp|sms) ;; *) return 1 ;; esac
    case "$DELIVER_RESULT" in sent|disabled|self_forward_blocked|message_too_long|storage_failed|source_unavailable|power_unavailable|invalid_config|invalid_forward_config|invalid_destination|delivery_failed|smtp_auth_failed|service_rejected|service_answer_missing) ;; *) return 1 ;; esac
    # Writers already hold state.lock. Keep 30 small records in RAM, newest first.
    {
        printf '%s|%s|%s|%s' "$(date +%s)" "$1" "$method" "$DELIVER_RESULT"
        case "${MU300_SIM_SLOT:-}" in 0|1)
            case "${HTTP_CODE:-0}" in [1-5][0-9][0-9]) _http=$HTTP_CODE ;; *) _http=0 ;; esac
            printf '|%s|%s' "$MU300_SIM_SLOT" "$_http" ;;
        esac
        printf '\n'
        [ ! -r "$HISTORY" ] || head -n 29 "$HISTORY"
    } > "$HISTORY.tmp.$$" && mv -f "$HISTORY.tmp.$$" "$HISTORY"
}
add_history() {
    json_add_array history
    if [ -r "$HISTORY" ]; then
        _history_n=0
        while IFS='|' read -r _when _kind _method _result _slot _http _extra; do
            _history_n=$((_history_n + 1)); [ "$_history_n" -le 30 ] || break
            number "$_when" && [ ${#_when} -le 11 ] || continue
            case "$_kind" in sms|power|test) ;; *) continue ;; esac
            case "$_method" in webhook|dingtalk|smtp|sms) ;; *) continue ;; esac
            case "$_result" in sent|disabled|self_forward_blocked|message_too_long|storage_failed|source_unavailable|power_unavailable|invalid_config|invalid_forward_config|invalid_destination|delivery_failed|smtp_auth_failed|service_rejected|service_answer_missing) ;; *) continue ;; esac
            [ -z "$_extra" ] || continue
            case "$_slot" in ''|0|1) ;; *) continue ;; esac
            case "$_http" in ''|0|[1-5][0-9][0-9]) ;; *) continue ;; esac
            json_add_object ''
            json_add_int time "$_when"
            json_add_string kind "$_kind"
            json_add_string method "$_method"
            json_add_string result "$_result"
            [ -z "$_slot" ] || json_add_int slot "$_slot"
            [ -z "$_http" ] || json_add_int http_code "$_http"
            json_close_object
        done < "$HISTORY"
    fi
    json_close_array
}
read_result() {
    last_result=idle power_last_result=idle
    [ -r "$RESULT" ] && IFS='|' read -r last_result power_last_result < "$RESULT" || :
}
power_read() {
    power_ok=0 current_percent=-1 current_status=none
    local battery
    battery=$(power_battery_dir "${MU300_FORWARD_BATTERY:-}") || return 0
    current_percent=$(power_supply_read "$battery/capacity")
    current_status=$(power_supply_read "$battery/status")
    number "$current_percent" && [ "$current_percent" -le 100 ] || return 0
    case "$current_status" in Charging|Discharging|Not\ charging|Full) power_ok=1 ;; esac
}
add_status() {
    power_read; read_result
    json_add_object status
    json_add_boolean supported 1
    json_add_boolean enabled "$enabled"
    json_add_string method "$method"
    json_add_boolean power_supported "$power_ok"
    json_add_boolean power_forward_enabled "$power_forward_enabled"
    json_add_string last_result "$last_result"
    json_add_string power_last_result "$power_last_result"
    add_history
    json_close_object
}
get_view() {
    read_mode && select_profile "${1:-shared}" || { reply_error invalid_config; return; }
    load_config || { reply_error invalid_config; return; }
    load_state
    json_init
    json_add_string mode "$forward_mode"
    json_add_string profile "$profile"
    json_add_int sim_slots "$([ "$(uci -q get unisoc_modem.main.sim_slots 2>/dev/null)" = 2 ] && echo 2 || echo 1)"
    json_add_object config
    json_add_boolean enabled "$enabled"
    json_add_string method "$method"
    json_add_string template_language "$template_language"
    json_add_string webhook_url "$webhook_url"
    webhook_fields
    json_add_string dingtalk_webhook "$dingtalk_webhook"
    json_add_boolean dingtalk_secret_configured "$([ -n "$dingtalk_secret" ] && echo 1 || echo 0)"
    json_add_string sms_to_phone "$sms_to_phone"
    json_add_object smtp
    json_add_string host "$smtp_host"
    json_add_int port "$smtp_port"
    json_add_string username "$smtp_username"
    json_add_string to "$smtp_to"
    json_add_boolean password_configured "$([ -n "$smtp_password" ] && echo 1 || echo 0)"
    json_close_object
    json_add_boolean power_forward_enabled "$power_forward_enabled"
    json_add_string blacklist_phone "$blacklist_phone"
    json_add_string blacklist_keywords "$blacklist_keywords"
    json_add_string nickname "$nickname"
    json_add_boolean smtp_forward_device_info "$smtp_forward_device_info"
    json_add_boolean dingtalk_forward_device_info "$dingtalk_forward_device_info"
    json_add_boolean sms_forward_device_info "$sms_forward_device_info"
    json_close_object
    add_status
    json_dump
}
status_only() {
    read_mode && select_profile "${1:-shared}" || { reply_error invalid_config; return; }
    load_config || { reply_error invalid_config; return; }
    load_state
    json_init
    json_add_string mode "$forward_mode"
    json_add_string profile "$profile"
    add_status
    json_dump
}
set_config() {
    ensure_base || { reply_error forward_storage_failed; return; }
    exec 8> "$BASE/state.lock"
    flock -n 8 || { reply_error forward_busy; return; }
    _payload=$(cat)
    [ ${#_payload} -le 32768 ] && json_load "$_payload" 2>/dev/null ||
        { reply_error invalid_config; return; }
    json_get_var new_profile profile shared
    json_get_var new_mode mode ''
    read_mode && select_profile "$new_profile" || { reply_error invalid_config; return; }
    old_mode=$forward_mode
    new_mode=${new_mode:-$old_mode}
    case "$new_mode" in shared|per_sim) ;; *) reply_error invalid_config; return ;; esac
    json_get_var new_webhook_method webhook_method POST
    json_get_var new_webhook_content_type webhook_content_type application/json
    json_get_var new_webhook_body webhook_body ''
    json_get_var new_webhook_headers webhook_headers ''
    json_get_var new_webhook_timeout webhook_timeout 12
    json_get_var new_webhook_expect webhook_expect '__keep__'
    json_get_var new_enabled enabled
    json_get_var new_method method
    json_get_var new_template_language template_language
    json_get_var new_webhook_url webhook_url
    json_get_var new_dingtalk_webhook dingtalk_webhook
    json_get_var new_dingtalk_secret dingtalk_secret
    json_get_var new_sms_to_phone sms_to_phone
    json_get_var new_smtp_host smtp_host
    json_get_var new_smtp_port smtp_port
    json_get_var new_smtp_username smtp_username
    json_get_var new_smtp_to smtp_to
    json_get_var new_smtp_password smtp_password
    json_get_var new_power_forward_enabled power_forward_enabled
    json_get_var new_blacklist_phone blacklist_phone
    json_get_var new_blacklist_keywords blacklist_keywords
    json_get_var new_nickname nickname
    json_get_var new_smtp_forward_device_info smtp_forward_device_info
    json_get_var new_dingtalk_forward_device_info dingtalk_forward_device_info
    json_get_var new_sms_forward_device_info sms_forward_device_info
    json_get_vars clear_smtp_password clear_dingtalk_secret
    load_config || { reply_error invalid_config; return; }
    old_enabled=$enabled old_method=$method
    enabled=${new_enabled:-0}; method=${new_method:-webhook}
    # Older clients omit this field; retain the saved language in that case.
    template_language=${new_template_language:-${template_language:-zh}}
    webhook_url=${new_webhook_url:-}; dingtalk_webhook=${new_dingtalk_webhook:-}
    webhook_method=$new_webhook_method webhook_content_type=$new_webhook_content_type
    webhook_body=$new_webhook_body webhook_headers=$new_webhook_headers webhook_timeout=$new_webhook_timeout
    [ "$new_webhook_expect" = __keep__ ] || webhook_expect=$new_webhook_expect
    sms_to_phone=${new_sms_to_phone:-}; smtp_host=${new_smtp_host:-}
    smtp_port=${new_smtp_port:-465}; smtp_username=${new_smtp_username:-}; smtp_to=${new_smtp_to:-}
    power_forward_enabled=${new_power_forward_enabled:-0}
    blacklist_phone=${new_blacklist_phone:-}; blacklist_keywords=${new_blacklist_keywords:-}
    nickname=${new_nickname:-}
    smtp_forward_device_info=${new_smtp_forward_device_info:-0}
    dingtalk_forward_device_info=${new_dingtalk_forward_device_info:-0}
    sms_forward_device_info=${new_sms_forward_device_info:-0}
    if [ "${clear_smtp_password:-0}" = 1 ]; then
        smtp_host= smtp_username= smtp_to= smtp_password=
        smtp_port=465
    fi
    [ -n "${new_smtp_password:-}" ] && smtp_password=$new_smtp_password
    [ "${clear_dingtalk_secret:-0}" = 1 ] && dingtalk_secret=
    [ -n "${new_dingtalk_secret:-}" ] && dingtalk_secret=$new_dingtalk_secret
    for _bit in "$enabled" "$power_forward_enabled" "$smtp_forward_device_info" \
        "$dingtalk_forward_device_info" "$sms_forward_device_info"; do
        bool "$_bit" || { reply_error invalid_config; return; }
    done
    case "$method" in webhook|dingtalk|smtp|sms) ;; *) reply_error invalid_config; return ;; esac
    case "$template_language" in zh|en|tr) ;; *) reply_error invalid_config; return ;; esac
    [ -z "$webhook_url" ] || https_url "$webhook_url" || { reply_error invalid_destination; return; }
    answer_rule_valid "$webhook_expect" || { reply_error invalid_forward_config; return; }
    number "$webhook_timeout" && [ "$webhook_timeout" -ge 1 ] && [ "$webhook_timeout" -le 120 ] &&
        render_webhook >/dev/null || { reply_error invalid_forward_config; return; }
    [ -z "$dingtalk_webhook" ] || {
        https_url "$dingtalk_webhook" &&
        case "$dingtalk_webhook" in https://oapi.dingtalk.com/robot/send*) true ;; *) false ;; esac
    } || { reply_error invalid_destination; return; }
    list_valid "$sms_to_phone" 3 phone &&
    list_valid "$blacklist_phone" 64 phone &&
    list_valid "$blacklist_keywords" 32 keyword ||
        { reply_error invalid_forward_config; return; }
    [ ${#nickname} -le 255 ] && one_line "$nickname" &&
    [ ${#dingtalk_secret} -le 256 ] && one_line "$dingtalk_secret" &&
    [ ${#smtp_password} -le 512 ] && one_line "$smtp_password" ||
        { reply_error invalid_forward_config; return; }
    case "$smtp_port" in 465|587) ;; *) reply_error invalid_forward_config; return ;; esac
    if [ -n "$smtp_host$smtp_username$smtp_to$smtp_password" ]; then
        host_name "$smtp_host" && mailbox "$smtp_username" && mailbox "$smtp_to" &&
        [ -n "$smtp_password" ] ||
            { reply_error invalid_forward_config; return; }
    fi
    if [ "$enabled" = 1 ]; then
        case "$method" in
            webhook) [ -n "$webhook_url" ] ;;
            dingtalk) [ -n "$dingtalk_webhook" ] ;;
            smtp) [ -n "$smtp_host$smtp_username$smtp_to$smtp_password" ] ;;
            sms) [ -n "$sms_to_phone" ] ;;
        esac || { reply_error invalid_forward_config; return; }
        [ -r "$POOL/next_id" ] || { reply_error sms_list_unavailable; return; }
    fi
    power_read
    [ "$profile" = shared ] || power_forward_enabled=0
    [ "$power_forward_enabled" = 0 ] || [ "$power_ok" = 1 ] ||
        { reply_error power_unavailable; return; }
    load_state
    if [ "$enabled" = 1 ] && { [ "$old_enabled" != 1 ] || [ "$old_method" != "$method" ]; }; then
        _max=$(cat "$POOL/next_id" 2>/dev/null)
        number "$_max" || { reply_error sms_list_unavailable; return; }
        last_id=$_max
        since=$(date +%s)
        # A channel/enable change establishes a separate barrier for SIM 2,
        # before the new configuration becomes visible to the single worker.
        if [ "$profile" = shared ]; then
            reset_second_barrier || { reply_error forward_storage_failed; return; }
        fi
    fi
    # Switching routing never replays the backlog from either inbox. Publish
    # routing last, under the same lock as the worker and all profile writes.
    if [ "$new_mode" != "$old_mode" ]; then
        ( POOL=$ROOT_POOL; reset_second_barrier ) || { reply_error forward_storage_failed; return; }
        ( STATE=$BASE/state; last_id=$(cat "$ROOT_POOL/next_id" 2>/dev/null)
          if number "$last_id"; then since=$(date +%s); save_state; else rm -f "$STATE"; fi
        ) || { reply_error forward_storage_failed; return; }
        load_state
    fi
    if [ "$power_forward_enabled" = 1 ] && [ "$power_ok" = 1 ]; then
        power_percent=$current_percent; power_status=$current_status
        ( STATE=$BASE/state.power; save_state ) || { reply_error forward_storage_failed; return; }
    fi
    # Save the replay barrier before making the new enabled configuration visible.
    # A not-yet-initialized inbox must stay without a cursor: the first ready
    # worker pass will baseline it. Saving 0|0 here would legitimize imports.
    if [ -r "$POOL/next_id" ] || [ -s "$STATE" ]; then
        save_state || { reply_error forward_storage_failed; return; }
    fi
    save_config || { reply_error forward_storage_failed; return; }
    printf '%s\n' "$new_mode" > "$BASE/mode.tmp.$$" && mv -f "$BASE/mode.tmp.$$" "$BASE/mode" ||
        { reply_error forward_storage_failed; return; }
    write_result idle idle || :
    reply_ok
}
message_file() { printf '%s/msg/%06d' "$POOL" "$1"; }
msg_field() { sed -n "1,/^$/s/^$2: //p" "$1" | head -n1; }
msg_body() { sed -n '1,/^$/!p' "$1"; }
blocked() {
    _peer=${1#+}
