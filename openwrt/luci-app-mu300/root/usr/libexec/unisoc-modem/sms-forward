        # A raw SIM PDU has no trustworthy original timestamp; the importer
        # uses local time only as a display fallback. Keep it local, not mail.
        [ "$_source" = direct ] || [ "$_coding" != raw-pdu ] || continue
        sms_is_new "$_source" "$_scts" "$_received" || continue
        blocked "$_from" "$_body" && continue
        deliver sms "$_from" "$_body" "$_scts" || :
        record_delivery sms || :
        write_result "$DELIVER_RESULT" "$power_last_result" || :
    done
    [ "$_processed" -gt 0 ] || [ "$last_id" = "$_start_id" ] || save_state
}
