#!/bin/sh
# mu300-dash-info -- the dashboard's system/network snapshot: ONE line of JSON on stdout.
#
# The LuCI home page (luci-app-mu300) polls this through the rpcd backend
# /usr/libexec/rpcd/mu300dash every few seconds. It reads only files and asks
# ubus/uci/iw, so it never touches the modem's AT channel - the cell readings
# live in mu300-dash-cell, which has its own cache and its own pace.
#
# CPU time and interface byte counters are "since boot" cumulative values; the
# page subtracts two consecutive snapshots to get CPU% and live rates, so the
# poll interval never skews the numbers.
#
# Every external call is wrapped in a hard timeout: netifd mid-reload or a wedged
# driver must not void the whole snapshot (the same lesson the V50 panel learned
# in the field - one hung call used to blank every readout on the page).
#
# Known traps this deliberately works around (docs/FINDINGS.md and the V50
# research archive):
#   * loadavg is meaningless here - three vendor kernel threads sit in D state
#     and pin it around 3.5 forever. It is not reported at all.
#   * iw/iwinfo never report tx-power or a sane channel on the sprd WCN driver;
#     SSID/channel come from uci instead.
#   * thermal zones are matched by type, never by zone number.

export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/libexec/unisoc-modem:/usr/sbin:/sbin"

DASH_NET_BIN=${MU300_DASH_BIN:-${0%/*}}
. "$DASH_NET_BIN/dashboard-network.sh"

BB=/opt/mu300/bin/busybox
[ -x "$BB" ] || BB=busybox
t3() { "$BB" timeout -s KILL 3 "$@" 2>/dev/null; }   # external asks: netifd, uci, iw...
t2() { "$BB" timeout -s KILL 2 "$@" 2>/dev/null; }

# All callers except the device-tree fallback read one-line proc/sysfs text.
# A shell builtin avoids starting cat for every thermal zone, battery and
# interface counter (dozens of short-lived processes per snapshot).
rd() {
    [ -r "$1" ] || return 0
    IFS= read -r _rd < "$1" || :
    printf '%s\n' "$_rd"
}
n_or_null() { case "$1" in ''|*[!0-9.-]*) echo null ;; *) echo "$1" ;; esac; }
f_or_null() { case "$1" in ''|*[!0-9.-]*) echo null ;; *) echo "$1" ;; esac; }
# JSON string escaping (and drop newlines: the output is one line).
# Avoid a sed+tr process pair for every hostname, address and client field.
CR=$(printf '\r')
NL=$(printf '\nx'); NL=${NL%x}
esc() {
    local value=$1 out= ch
    while [ -n "$value" ]; do
        ch=${value%"${value#?}"}; value=${value#?}
        case "$ch" in
            "\\") out="$out\\\\" ;;
            '"') out="$out\\\"" ;;
            "$CR"|"$NL") ;;
            *) out=$out$ch ;;
        esac
    done
    printf '%s' "$out"
}
qs() { [ -n "$1" ] && { printf '"'; esc "$1"; printf '"'; } || printf 'null'; }

# ------------------------------------------------------------- temperature
# type -> label, the four zones this SoC actually has; hottest covers the rest
# Read all zone types in one pass instead of rescanning every zone four times.
named_temps() {
    local z type temp seen_soc= seen_cpu= seen_nr= seen_brd=
    local raw_soc= raw_cpu= raw_nr= raw_brd=
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/type" ] || continue
        type=; IFS= read -r type < "$z/type" || :
        case "$type" in
            soc-thmzone) [ -z "$seen_soc" ] || continue; seen_soc=1 ;;
            apcpu0-thmzone) [ -z "$seen_cpu" ] || continue; seen_cpu=1 ;;
            nr0-thmzone) [ -z "$seen_nr" ] || continue; seen_nr=1 ;;
            board-thmzone) [ -z "$seen_brd" ] || continue; seen_brd=1 ;;
            *) continue ;;
        esac
        temp=; [ -r "$z/temp" ] && IFS= read -r temp < "$z/temp" || :
        case "$type" in
            soc-thmzone) raw_soc=$temp ;;
            apcpu0-thmzone) raw_cpu=$temp ;;
            nr0-thmzone) raw_nr=$temp ;;
            board-thmzone) raw_brd=$temp ;;
        esac
    done
    awk -v soc="$raw_soc" -v cpu="$raw_cpu" -v nr="$raw_nr" -v brd="$raw_brd" '
        BEGIN {
            printf "%s %s %s %s", soc=="" ? "null" : sprintf("%.1f", soc/1000),
                cpu=="" ? "null" : sprintf("%.1f", cpu/1000),
                nr=="" ? "null" : sprintf("%.1f", nr/1000),
                brd=="" ? "null" : sprintf("%.1f", brd/1000)
        }'
}
temp_hottest() {
    rd /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -n1 | awk '{printf "%.1f", $1/1000}'
}

# ------------------------------------------------------- a ubus scalar field
# the ubus CLI pretty-prints with spaces, so sed on the literal key; first match
# wins (the fields used here appear once, ipv4 before ipv6 in the address blocks)
jval() { printf '%s' "$1" | sed -n "s/.*\"$2\": *\"\{0,1\}\([^,\"}\]*\).*/\1/p" | head -n1; }

# ----------------------------------------------------------------- WAN (ubus)
cfg() { uci -q get "unisoc_modem.main.$1" 2>/dev/null || true; }
DATA_IFACE=$(cfg data_interface); DATA_IFACE=${DATA_IFACE:-wan}
DATA_IFACE6=$(cfg data_interface_v6); DATA_IFACE6=${DATA_IFACE6:-wan6}
WANJSON=$(t3 ubus call "network.interface.$DATA_IFACE" status)
WAN6JSON=$(t3 ubus call "network.interface.$DATA_IFACE6" status)
DATA_DEVICE=$(dash_data_device "$WANJSON" "$(cfg data_device)")
LAN_DEVICE=$(cfg lan_device); LAN_DEVICE=${LAN_DEVICE:-br-lan}
WIFI_DEVICE=$(cfg wifi_device); WIFI_DEVICE=${WIFI_DEVICE:-wlan0}
USB_DEVICE=$(cfg usb_device); USB_DEVICE=${USB_DEVICE:-usb0}
jaddr4() { printf '%s' "$1" | sed -n 's/.*"address": *"\([^"]*\)".*/\1/p' | head -n1; }
wan_dns_servers() {
    # ubus pretty-prints arrays over multiple lines. Parse only the top-level
    # active DNS list, never inactive.dns-server or the loopback resolv.conf.
    # Reuse the two status snapshots: no additional RPC, AT request or cache.
    local snapshot
    for snapshot in "$@"; do
        [ -n "$snapshot" ] || continue
        jsonfilter -s "$snapshot" -e '@["dns-server"][*]' 2>/dev/null || :
    done | awk 'NF && !seen[$0]++ { printf "%s%s", sep, $0; sep=", " }'
}

wan_up=$(dash_json "$WANJSON" '@.up')
[ "$wan_up" = "true" ] && wan_up=1 || wan_up=0
wan_uptime=$(dash_json "$WANJSON" '@.uptime')
wan_proto=$(dash_json "$WANJSON" '@.proto')
wan_ip4=$(jaddr4 "$WANJSON")
wan6_up=$(dash_json "$WAN6JSON" '@.up')
[ "$wan6_up" = "true" ] && wan6_up=1 || wan6_up=0
wan6_ip=$(t2 ip -6 addr show "$DATA_DEVICE" 2>/dev/null | awk '/inet6 [23]/{split($2,s,"/"); print s[1]; exit}')
wan_dns=$(wan_dns_servers "$WANJSON" "$WAN6JSON")
apn=$(dash_apn "$DASH_NET_BIN/apn" "${MU300_SIM_SLOT:-}")

# ------------------------------------------------------------------- system
NOW=$(date +%s)
read -r UPTIME _ < /proc/uptime
UPTIME=${UPTIME%%.*}
HOST=$(t3 uci -q get system.@system[0].hostname)
[ -n "$HOST" ] || HOST=$(rd /proc/sys/kernel/hostname)
MODEL=$(rd /tmp/sysinfo/model 2>/dev/null)
[ -n "$MODEL" ] || MODEL=$(cat /proc/device-tree/model 2>/dev/null | tr -d '\0')
FW=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'$/\1/p" /etc/openwrt_release 2>/dev/null)
[ -n "$FW" ] || FW=$(uname -sr)
PRIVATE_FW=$(jval "$(rd /etc/unisoc-ota/current.json 2>/dev/null)" version)
[ -n "$PRIVATE_FW" ] || PRIVATE_FW=$(rd /etc/mu300/image-version 2>/dev/null)
[ -z "$PRIVATE_FW" ] || FW="$PRIVATE_FW ($FW)"

# /proc/stat first line: cpu user nice system idle iowait irq softirq steal ...
# busy = everything except idle+iowait; the page deltas this against the last poll
read -r _cpu _u _n _s _i _w _irq _sirq _st _rest < /proc/stat
CPU_TOTAL=$(( _u + _n + _s + _i + _w + _irq + _sirq + _st ))
CPU_IDLE=$(( _i + _w ))
CPUN=$(grep -c '^processor' /proc/cpuinfo)
# one freq pair per policy (big.LITTLE shows two; the page averages or shows both)
FREQS=
for p in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
    [ -r "$p" ] || continue
    d=${p%/*}
    FREQS="$FREQS{\"cur\":$(n_or_null "$(rd "$p")"),\"max\":$(n_or_null "$(rd "$d/cpuinfo_max_freq")")},"
done
FREQS=${FREQS%,}

MEM_T=$(awk '/^MemTotal/{print $2}' /proc/meminfo)
MEM_A=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)

# df on / (the ext4 mu300root loop device)
DF=$(df -k / 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
set -- $DF; DISK_T=$1; DISK_U=$2; DISK_A=$3

set -- $(named_temps)
T_SOC=$1; T_CPU=$2; T_NR=$3; T_BRD=$4
T_HOT=$(temp_hottest)

# ------------------------------------------------------------------- power
# Vendor kernels use battery; mainline UMP9620 uses sc27xx-fgu. The shared
# selector also excludes F50/V50's synthetic FGU, and validates 0..100 percent.
POWER_LIB=${MU300_POWER_LIB:-${0%/*}/power-supply.sh}
[ -r "$POWER_LIB" ] || POWER_LIB=/usr/libexec/unisoc-modem/power-supply.sh
. "$POWER_LIB"
PSY=${MU300_POWER_SUPPLY_DIR:-/sys/class/power_supply}
P_DIR=$(power_battery_dir) || P_DIR=
P_PRESENT=0 P_CAP= P_STATUS= P_V= P_I= P_USB=
if [ -n "$P_DIR" ]; then
    P_PRESENT=1
    P_CAP=$(rd "$P_DIR/capacity")
    P_STATUS=$(rd "$P_DIR/status")
    P_V=$(rd "$P_DIR/voltage_now")
    P_I=$(rd "$P_DIR/current_now")
fi
# Mainline reports external power on bq256xx-charger, rather than usb/ac.
for d in "$PSY/usb" "$PSY/ac" "$PSY/bq256xx-charger" "$PSY"/*; do
    case "${d##*/}" in usb|ac|bq256xx-charger) ;; *) case "$(rd "$d/type")" in USB*|Mains) ;; *) continue ;; esac ;; esac
    case "$(rd "$d/online")" in 1) P_USB=1; break ;; 0) P_USB=0 ;; esac
done
P_V=$(n_or_null "$(awk -v v="$P_V" 'BEGIN{if(v+0>0)printf "%.2f",v/1000000}')")
P_I=$(n_or_null "$(awk -v v="$P_I" 'BEGIN{if(v!="")printf "%d",v}')")

# ------------------------------------------------------- interface counters
net_obj() {  # net_obj IFACE -> {"rx":N,"tx":N,"up":0|1} or null
    case "$1" in ''|*[!a-zA-Z0-9_.:-]*|.|..) echo null; return ;; esac
    local d=/sys/class/net/$1
    [ -d "$d" ] || { echo null; return; }
    local rx tx up
    rx=$(rd "$d/statistics/rx_bytes"); tx=$(rd "$d/statistics/tx_bytes")
    case "$(rd "$d/operstate")" in up) up=1 ;; *) up=0 ;; esac
    printf '{"rx":%s,"tx":%s,"up":%d}' "$(n_or_null "$rx")" "$(n_or_null "$tx")" "$up"
}

# ------------------------------------------------------------------- Wi-Fi
# configuration truth is uci (the driver reports nothing useful); per-client detail
# comes from the driver's station table, names and addresses from the DHCP leases.
# One ucode process selects the same AP as the switch and reads its radio.
# Key/value lines preserve quotes without evaluating untrusted SSID text.
W_SSID= W_CH= W_BAND= W_HT= W_COUNTRY= W_ENC= W_HIDDEN=
W_AVAILABLE=0 W_ENABLED=0 W_PENDING=0 W_ERROR= W_SECTION= W_RADIO= W_UP=0
WFIELDS=$(t3 "${MU300_DASH_BIN:-/usr/libexec/unisoc-modem}/hotspot" fields)
while IFS= read -r key && IFS= read -r val; do
    case "$key" in
        available) W_AVAILABLE=$val ;; enabled) W_ENABLED=$val ;;
        pending) W_PENDING=$val ;; up) W_UP=$val ;; error) W_ERROR=$val ;;
        section) W_SECTION=$val ;; radio) W_RADIO=$val ;;
        device) WIFI_DEVICE=$val ;; ssid) W_SSID=$val ;;
        channel) W_CH=$val ;; band) W_BAND=$val ;; htmode) W_HT=$val ;;
        country) W_COUNTRY=$val ;; enc) W_ENC=$val ;; hidden) W_HIDDEN=$val ;;
    esac
done <<EOF_WIFI
$WFIELDS
EOF_WIFI
# HE80 / VHT40 / HT20: retain the first two digits, as before.
W_WIDTH=; digits=$W_HT
while [ -n "$digits" ] && [ "${#W_WIDTH}" -lt 2 ]; do
    ch=${digits%"${digits#?}"}; digits=${digits#?}
    case "$ch" in [0-9]) W_WIDTH=$W_WIDTH$ch ;; esac
done
[ -n "$W_WIDTH" ] && W_WIDTH="$W_WIDTH MHz"
[ -n "$W_ENC" ] || W_ENC=none
W_HOSTAPD=0
HAPD=
[ -n "$WIFI_DEVICE" ] && [ "$W_AVAILABLE" = 1 ] && HAPD=$(t3 ubus call "hostapd.$WIFI_DEVICE" get_status 2>/dev/null)
printf '%s' "$HAPD" | grep -q '"status": *"ENABLED"' && W_HOSTAPD=1
[ -d "/sys/class/net/$WIFI_DEVICE" ] || W_UP=0
[ "$W_HOSTAPD" = 1 ] || W_UP=0
# SC2355 may report only associated MACs, with no station metrics. Count the
# association regardless of RSSI and emit after the COMPLETE block, not at
# the signal line. Whitespace splitting leaves the colons inside a MAC intact.
station_rows() {
    awk '
    function emit(    a, n, i) {
        n = split(mac, a, ":")
        if (n != 6) return
        for (i = 1; i <= n; i++)
            if (a[i] !~ /^[[:xdigit:]][[:xdigit:]]$/) return
        if (seen[mac]++) return
        printf "%s|%s|%s|%s|%s\n", mac, sig, tx, rx, ct
    }
    /^Station[ \t]+/ { emit(); mac = tolower($2); sig = tx = rx = ct = ""; next }
    /^[ \t]+signal:/ && $2 ~ /^-?[0-9]+([.][0-9]+)?$/ { sig = $2 + 0 }
    /^[ \t]+tx bitrate:/ && $3 ~ /^[0-9]+([.][0-9]+)?$/ { tx = $3 " Mbit/s" }
    /^[ \t]+rx bitrate:/ && $3 ~ /^[0-9]+([.][0-9]+)?$/ { rx = $3 " Mbit/s" }
    /^[ \t]+connected time:/ && $3 ~ /^[0-9]+$/ { ct = sprintf("%d min", int($3 / 60)) }
    END { emit() }'
}
W_CN=null; W_CLIST=; W_CLIENTS=
if W_STATIONS=$(t3 iw dev "$WIFI_DEVICE" station dump 2>/dev/null); then
    W_CLIENTS=$(printf '%s\n' "$W_STATIONS" | station_rows)
    W_CN=0
elif [ ! -d "/sys/class/net/$WIFI_DEVICE" ]; then
    W_CN=0
fi
# Empty successful dumps also need hostapd on older SC2355 modules.
if [ -z "$W_CLIENTS" ] && [ -d "/sys/class/net/$WIFI_DEVICE" ] &&
   [ -x /usr/libexec/unisoc-modem/wifi-hostapd-clients ]; then
    if W_ASSOC=$(t3 ubus call "hostapd.$WIFI_DEVICE" get_clients 2>/dev/null); then
        if W_FALLBACK=$(printf '%s' "$W_ASSOC" | /usr/libexec/unisoc-modem/wifi-hostapd-clients); then
            W_CLIENTS=$W_FALLBACK
            W_CN=0
        fi
    fi
fi
while IFS='|' read -r mac sig txr rxr ct; do
    [ -n "$mac" ] || continue
    line=$(awk -v m="$mac" 'tolower($2) == m { print $3 "|" $4; exit }' /tmp/dhcp.leases 2>/dev/null)
    ip=${line%%|*}; host=${line#*|}
    { [ "$host" = "$line" ] || [ "$host" = '*' ]; } && host=
    W_CLIST="$W_CLIST{\"mac\":\"$mac\",\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"signal\":$(n_or_null "$sig"),\"tx\":$(qs "$txr"),\"rx\":$(qs "$rxr"),\"conn\":$(qs "$ct")},"
    W_CN=$((W_CN + 1))
done <<EOF2
$(printf '%s\n' "$W_CLIENTS")
EOF2
W_CLIST=${W_CLIST%,}
LAN_LEASES=$(cat /tmp/dhcp.leases 2>/dev/null | wc -l)
# recent DHCP leases (host/ip/mac + remaining time) - shows devices that were
# here even when nobody is associated right now
NOWS=$NOW
LEASES=
while read -r exp mac ip host _cid; do
    [ -n "$mac" ] || continue
    [ "$host" = "*" ] && host=
    left=$(( exp - NOWS ))
    [ "$left" -lt 0 ] && left=0
    LEASES="$LEASES{\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"mac\":$(qs "$mac"),\"left\":$left},"
done < /tmp/dhcp.leases 2>/dev/null
LEASES=${LEASES%,}
LAN_IP=$(t2 ip -4 addr show "$LAN_DEVICE" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')

# ---------------------------------------------------------------- modem/path
# the same liveness rule mu300-atd uses: the URC log on nr0 is written to as
# long as the modem is running, whatever it thinks of our commands
URCLOG=/run/mu300-at/urc/stty_nr0.log
if [ -f "$URCLOG" ]; then
    AGE=$(( NOW - $(date -r "$URCLOG" +%s 2>/dev/null || echo 0) ))
    [ "$AGE" -lt 240 ] && MODEM_ALIVE=1 || MODEM_ALIVE=0
else
    MODEM_ALIVE=0
fi
ATD_OK=0; /usr/libexec/unisoc-modem/at --available >/dev/null 2>&1 && ATD_OK=1
[ "$MODEM_ALIVE" = 1 ] || MODEM_ALIVE=$ATD_OK
DATA_PAUSED=0; [ -e /run/mu300-mobile-data-down ] && DATA_PAUSED=1
# Constant-size counter works without CONFIG_NF_CONNTRACK_PROCFS. Only older
# platforms lacking this counter need the connection-table fallback.
# Missing/failed reads are unknown (null), never a made-up zero.
conntrack_count() {
    local counter=${1:-/proc/sys/net/netfilter/nf_conntrack_count}
    local table=${2:-/proc/net/nf_conntrack} count=
    # sysctl proc handlers may return EOF after the first small read; ash's
    # byte-at-a-time read can truncate this value. Read it in one cat buffer.
    if [ -r "$counter" ] && count=$(cat "$counter" 2>/dev/null); then
        case "$count" in ''|*[!0-9]*) ;; *) printf '%s\n' "$count"; return ;; esac
    fi
    if [ -r "$table" ] && count=$(wc -l < "$table" 2>/dev/null); then
        count=$((count + 0))
        printf '%s\n' "$count"
        return
    fi
    printf 'null\n'
}
CONNS=$(conntrack_count)

# --------------------------------------------------------------------- VPN
VPN_ENABLED=0; VPN_ENGINE=""; VPN_UP=0
if [ -r /etc/mu300/vpn.conf ]; then
    grep -q '^ENABLE=1' /etc/mu300/vpn.conf && VPN_ENABLED=1
    VPN_ENGINE=$(sed -n 's/^ENGINE=//p' /etc/mu300/vpn.conf | tail -n1)
fi
if ip link show xtun >/dev/null 2>&1 || ip link show sbtun >/dev/null 2>&1; then VPN_UP=1; fi
CAP_VPN=0; [ -x /etc/init.d/mu300-vpn ] && CAP_VPN=1
CAP_DUALBOOT=0; [ -x /opt/mu300/bin/mu300-next-boot ] && CAP_DUALBOOT=1

# ------------------------------------------------------------------ output
printf '{"ts":%d,"uptime":%d,"host":%s,"model":%s,"fw":%s,"kernel":%s,' \
    "$NOW" "$UPTIME" "$(qs "$HOST")" "$(qs "$MODEL")" "$(qs "$FW")" "$(qs "$(uname -r)")"
printf '"cpu":{"n":%d,"total":%d,"idle":%d,"freqs":[%s]},' "$CPUN" "$CPU_TOTAL" "$CPU_IDLE" "${FREQS:-}"
printf '"mem":{"total_kb":%s,"avail_kb":%s},' "$(n_or_null "$MEM_T")" "$(n_or_null "$MEM_A")"
printf '"storage":{"total_kb":%s,"used_kb":%s,"avail_kb":%s},' "$(n_or_null "$DISK_T")" "$(n_or_null "$DISK_U")" "$(n_or_null "$DISK_A")"
printf '"temps":{"soc":%s,"cpu":%s,"modem":%s,"board":%s,"hottest":%s},' \
    "$(f_or_null "$T_SOC")" "$(f_or_null "$T_CPU")" "$(f_or_null "$T_NR")" "$(f_or_null "$T_BRD")" "$(f_or_null "$T_HOT")"
printf '"power":{"present":%d,"capacity":%s,"status":%s,"volt":%s,"ua":%s,"usb":%s},' \
    "$P_PRESENT" "$(n_or_null "$P_CAP")" "$(qs "$P_STATUS")" "$P_V" "$P_I" "$(n_or_null "$P_USB")"
MOBILE_NET=$(net_obj "$DATA_DEVICE")
printf '"net":{"mobile":%s,"sipa_eth0":%s,"brlan":%s,"wlan0":%s,"usb0":%s},' \
    "$MOBILE_NET" "$MOBILE_NET" "$(net_obj "$LAN_DEVICE")" "$(net_obj "$WIFI_DEVICE")" "$(net_obj "$USB_DEVICE")"
printf '"wan":{"up":%d,"uptime":%s,"proto":%s,"device":%s,"apn":%s,"ip4":%s,"ip6":%s,"dns":%s},' \
    "$wan_up" "$(n_or_null "$wan_uptime")" "$(qs "$wan_proto")" "$(qs "$DATA_DEVICE")" "$(qs "$apn")" "$(qs "$wan_ip4")" "$(qs "$wan6_ip")" "$(qs "$wan_dns")"
printf '"wifi":{"available":%d,"enabled":%d,"pending":%d,"section":%s,"radio":%s,"error":%s,"up":%d,"ssid":%s,"channel":%s,"band":%s,"width":%s,"country":%s,"enc":%s,"hidden":%s,"hostapd":%d,"clients":[%s],"clients_n":%s},' \
    "$W_AVAILABLE" "$W_ENABLED" "$W_PENDING" "$(qs "$W_SECTION")" "$(qs "$W_RADIO")" "$(qs "$W_ERROR")" "$W_UP" "$(qs "$W_SSID")" "$(qs "$W_CH")" "$(qs "$W_BAND")" "$(qs "$W_WIDTH")" "$(qs "$W_COUNTRY")" "$(qs "$W_ENC")" "$(n_or_null "$W_HIDDEN")" "$W_HOSTAPD" "${W_CLIST:-}" "$W_CN"
printf '"lan":{"leases":%s,"ip":%s,"list":[%s]},' "$(n_or_null "$LAN_LEASES")" "$(qs "$LAN_IP")" "${LEASES:-}"
printf '"modem":{"alive":%d,"atd":%d,"data_paused":%d},' "$MODEM_ALIVE" "$ATD_OK" "$DATA_PAUSED"
# Source a builtin-only boot snapshot; this never changes startup intent.
BOOT_STATUS_LIBRARY=1
. "${MU300_DASH_BIN:-/usr/libexec/unisoc-modem}/boot-status"
printf '"boot":'; boot_status; printf ','
printf '"capabilities":{"vpn":%d,"dualboot":%d},' "$CAP_VPN" "$CAP_DUALBOOT"
printf '"conns":%s,' "$(n_or_null "$CONNS")"
# The accounting worker publishes one atomic JSON line; no extra RPC or AT
# requests on the dashboard's fast refresh path.
TRAFFIC=null
if [ -r /run/unisoc-modem-traffic/view.json ]; then
    IFS= read -r TRAFFIC < /run/unisoc-modem-traffic/view.json || TRAFFIC=null
fi
printf '"traffic":%s,' "${TRAFFIC:-null}"
printf '"vpn":{"enabled":%d,"engine":%s,"up":%d}}\n' "$VPN_ENABLED" "$(qs "$VPN_ENGINE")" "$VPN_UP"
