#!/bin/sh
# Independent UI job adapter; platform-specific switching lives outside LuCI.
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
LIB=${MU300_DASH_BIN:-/usr/libexec/unisoc-modem}
RUNDIR=${MU300_DATA_SIM_RUN:-/tmp/unisoc-data-sim}
adapter=${MU300_DATA_SIM_ADAPTER:-$(uci -q get unisoc_modem.main.data_sim_command 2>/dev/null)}
[ -n "$adapter" ] || adapter=/opt/mu300/bin/mu300-data-sim
qs() { [ -n "$1" ] && printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g' | tr -d '\r\n')" || echo null; }
validate_apply() {
    [ "$1" = data ] || { echo invalid_sim >&2; return 1; }
    case "$2" in
        0|1) ;;
        v50-card-[0-3])
            [ "$(mu300-device 2>/dev/null)" = v50 ] || { echo v50_card_unsupported >&2; return 1; }
            /opt/mu300/bin/mu300-v50-sim validate "${2#v50-card-}" || return 1
            return 0;;
        u30pro-card-[0-3])
            [ "$(mu300-device 2>/dev/null)" = u30pro ] || { echo physical_card_unsupported >&2; return 1; }
            /opt/mu300/bin/mu300-u30pro-sim validate "${2#u30pro-card-}" || return 1
            return 0;;
        radio-[01]-[01])
            [ -x /opt/mu300/bin/mu300-sim-radio ] || { echo dual_sim_unavailable >&2; return 1; }
            case "$2" in radio-1-*)
                [ "$(uci -q get unisoc_modem.main.sim_slots)" = 2 ] || { echo dual_sim_unavailable >&2; return 1; };;
            esac
            return 0;;
        dsds-[01])
            case "$(mu300-device 2>/dev/null)" in f50|u30air) ;; *) echo dsds_unsupported >&2; return 1;; esac
            return 0;;
        *) echo invalid_sim >&2; return 1 ;;
    esac
    [ "$(uci -q get unisoc_modem.main.sim_slots)" = 2 ] && [ -x "$adapter" ] || { echo dual_sim_unavailable >&2; return 1; }
}
. "$LIB/lock-jobs.sh"
case ${1:-} in
get) [ -x "$adapter" ] && "$adapter" get || printf '{"ok":0,"error":"dual_sim_unavailable"}\n' ;;
start) job_start data "${2:-}" ;;
status) job_status "${2:-}" ;;
worker) job_worker "$2" "$3" "$4" ;;
apply)
    validate_apply "$2" "$3" || exit 1
    case "$3" in
        radio-[01]-[01]) value=${3#radio-}; exec /opt/mu300/bin/mu300-sim-radio apply "${value%-*}" "${value#*-}";;
        dsds-[01]) exec /opt/mu300/bin/mu300-sim-radio dsds "${3#dsds-}";;
        v50-card-[0-3]) exec /opt/mu300/bin/mu300-v50-sim apply "${3#v50-card-}";;
        u30pro-card-[0-3]) exec /opt/mu300/bin/mu300-u30pro-sim apply "${3#u30pro-card-}";;
        *) exec "$adapter" apply "$3";;
    esac;;
*) exit 2 ;;
esac
