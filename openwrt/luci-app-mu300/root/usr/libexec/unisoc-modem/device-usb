#!/bin/sh
# Portable USB-role adapter and persistent gadget-mode policy.
# A platform may provide MU300_USB_ROLE_COMMAND (or UCI usb.role_command) with
# the contract: COMMAND host|device. F50 uses the requested raw role switch;
# other known platforms retain their power-sequencing helper.
set -u
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"

CFG=unisoc_modem.usb
ROLE_FILE=${MU300_USB_ROLE_FILE:-/sys/class/usb_role/25100000.dwc3-role-switch/role}
BOOT_FILE=${MU300_USB_BOOT_FILE:-/etc/unisoc-modem/usb-boot.conf}
NET_CLASS=${MU300_USB_NET_CLASS:-/sys/class/net}
USB_BUS=${MU300_USB_BUS:-/sys/bus/usb/devices}
BLOCK_CLASS=${MU300_USB_BLOCK_CLASS:-/sys/class/block}
RESCAN_MARKER=${MU300_USB_RESCAN_MARKER:-/run/unisoc-usb-host-rescan-done}
GADGET_DIR=${MU300_USB_GADGET_DIR:-/sys/kernel/config/usb_gadget}
ROLE_STATE=${MU300_USB_ROLE_STATE:-/run/unisoc-usb-role-state}
NETWORK_SERVICE=${MU300_USB_NETWORK_SERVICE:-/etc/init.d/network}
IP=${MU300_USB_IP_BIN:-ip}
NET_LOCK=${MU300_USB_NET_LOCK:-/var/lock/unisoc-usb-net.lock}
ROLE_LOCK=${MU300_USB_ROLE_LOCK:-/var/lock/unisoc-usb-role.lock}
LANE_PARAM=${MU300_USB_LANE_PARAM:-/sys/module/phy_sprd_ums9620_ssphy/parameters/tca_flip_override}
LANE_STATE=${MU300_USB_LANE_STATE:-/run/unisoc-usb-lane-probe}
LANE_BOS_TOOL=${MU300_USB_LANE_BOS_TOOL:-/usr/libexec/unisoc-modem/usb-superspeed-capable}
LANE_WAIT=${MU300_USB_LANE_WAIT:-sleep}
get() { uci -q get "$CFG.$1" 2>/dev/null || true; }
put() { uci -q set "$CFG.$1=$2"; }
error() { printf '{"ok":0,"error":"%s"}\n' "$1"; exit 1; }
role_now() {
    current=$(cat "$ROLE_FILE" 2>/dev/null)
    case $current in host|device) printf '%s\n' "$current" ;; *) echo unavailable ;; esac
}
role_apply_needed() {
    # An unattached Type-C port can still report DWC3's old data role. U30 Air
    # must apply the requested CC/PD policy even if that readback matches it,
    # e.g. cancelling a pending source-only request back to device/sink.
    [ "$(role_now)" != "$1" ] || [ "$(device_name)" = u30air ]
}
role_result() {
    # Only the latest request may publish its asynchronous result.
    [ "${4:-}" = "$(sed -n '1p' "$ROLE_STATE" 2>/dev/null)" ] || return 0
    printf '%s\n%s\n%s\n%s\n' "$4" "$1" "$2" "$3" > "$ROLE_STATE.$$" &&
        mv "$ROLE_STATE.$$" "$ROLE_STATE"
}
network_status() {
    net_current=unknown
    if [ "$role" = host ]; then net_current=none
    else
        detected=
        for gadget in "$GADGET_DIR"/*; do
            [ -n "$(cat "$gadget/UDC" 2>/dev/null)" ] || continue
            for link in "$gadget"/configs/*/*; do
                [ -L "$link" ] || continue
                function=$(readlink "$link"); function=${function##*/}
                case $function in ncm.*) found=ncm ;; ecm.*) found=ecm ;; rndis.*) found=rndis ;; *) continue ;; esac
                if [ -z "$detected" ]; then detected=$found
                elif [ "$detected" != "$found" ]; then detected=mixed; fi
            done
        done
        [ -z "$detected" ] || net_current=$detected
    fi
    net_next=ncm; boot_scope=; boot_mode=; net_policy_error=0
    if [ -f "$BOOT_FILE" ]; then
        while IFS='=' read -r key value; do
            case $key in mode) boot_mode=$value ;; scope) boot_scope=$value ;; esac
        done < "$BOOT_FILE"
        case $boot_mode:$boot_scope in
            ncm:once|ecm:once|rndis:once|ncm:permanent|ecm:permanent|rndis:permanent) net_next=$boot_mode ;;
            *) net_policy_error=1 ;;
        esac
        [ "$saved_net_auto" = 1 ] && [ "$mode" = "$boot_mode" ] && [ "$scope" = "$boot_scope" ] || net_policy_error=1
    elif [ "$saved_net_auto" = 1 ]; then net_policy_error=1
    fi
    [ "$role_auto" != 1 ] || net_next=none
}
device_name() {
    if [ -n "${MU300_USB_DEVICE:-}" ]; then echo "$MU300_USB_DEVICE"
    elif command -v mu300-device >/dev/null 2>&1; then mu300-device
    else echo generic; fi
}
role_command() {
    cmd=${MU300_USB_ROLE_COMMAND:-$(get role_command)}
    if [ -n "$cmd" ]; then
        [ -x "$cmd" ] || error 'USB role adapter is not executable'
        "$cmd" "$1" || error 'USB role adapter failed'
    elif [ "$(device_name)" = f50 ] || [ "$(device_name)" = v50 ]; then
        [ -w "$ROLE_FILE" ] || error 'USB role switch is unavailable'
        printf '%s\n' "$1" > "$ROLE_FILE" || error 'USB role switch failed'
    elif command -v mu300-usb >/dev/null 2>&1; then
        mu300-usb "$1" || error 'USB role switch was refused by platform safety checks'
    else
        [ -w "$ROLE_FILE" ] || error 'USB role switch is unavailable'
        printf '%s\n' "$1" > "$ROLE_FILE" || error 'USB role switch failed'
    fi
}
role_lock() {
    # Serialize only the battery-less raw-role platforms. No extra lock or
    # power-policy changes for the U30 Air or other platform adapters.
    role_lock_held=0
    case $(device_name) in
        f50|v50) exec 8>"$ROLE_LOCK" && flock 8 && role_lock_held=1 ;;
        *) return 0 ;;
    esac
}
role_unlock() {
    if [ "${role_lock_held:-0}" = 1 ]; then
        flock -u 8 2>/dev/null || true
        exec 8>&-
    fi
}
lane_release() {
    # Retire only a choice written by this probe, never a different manual
    # override. Called before an explicit role change while holding role lock.
    choice=$(cat "$LANE_STATE" 2>/dev/null)
    case $choice in
        0|1) [ "$(cat "$LANE_PARAM" 2>/dev/null)" != "$choice" ] ||
                printf '%s\n' -1 > "$LANE_PARAM" || return 1 ;;
    esac
    rm -f "$LANE_STATE"
}
lane_owned() {
    [ -z "${MU300_USB_ROLE_COMMAND:-$(get role_command)}" ] || return 1
    [ "$(role_now)" = host ] &&
        [ "$lane_request" = "$(sed -n '1p' "$ROLE_STATE" 2>/dev/null)" ] || return 1
    target=$(sed -n '2p' "$ROLE_STATE" 2>/dev/null)
    [ -z "$target" ] || [ "$target" = host ]
}
lane_empty_reader() {
    # A dock may contain an empty removable-card reader. Permit it only when
    # all its interfaces are storage and every registered disk has no medium.
    # Unknown/probing devices and readers with any medium remain excluded.
    reader=$1
    reader_seen=0
    for reader_iface in "$reader"/*:*; do
        [ -f "$reader_iface/bInterfaceClass" ] || continue
        [ "$(cat "$reader_iface/bInterfaceClass")" = 08 ] || return 1
        case $(readlink -f "$reader_iface/driver") in
            */bus/usb/drivers/usb-storage) ;;
            *) return 1 ;;
        esac
        reader_seen=1
    done
    [ "$reader_seen" = 1 ] || return 1
    reader_seen=0
    for reader_block in "$BLOCK_CLASS"/*; do
        reader_real=$(readlink -f "$reader_block/device")
        case $reader_real in "$reader"/*) ;; *) continue ;; esac
        [ "$(cat "$reader_block/removable" 2>/dev/null)" = 1 ] &&
            [ "$(cat "$reader_block/size" 2>/dev/null)" = 0 ] || return 1
        for reader_holder in "$reader_block"/holders/*; do
            [ ! -e "$reader_holder" ] || return 1
        done
        reader_seen=1
    done
    [ "$reader_seen" = 1 ]
}
lane_peers_safe() {
    # Re-enumeration must not interrupt another peripheral (e.g. mounted
    # storage or USB audio). Hubs and their Billboard function carry no user
    # data; a proven empty removable reader has no medium to interrupt.
    # Check again immediately before each controller operation.
    for entry in "$USB_BUS"/*; do
        [ -f "$entry/idVendor" ] || continue
        real=$(readlink -f "$entry")
        case $real in "$lane_controller"/*) ;; *) continue ;; esac
        [ "$real" != "$lane_device" ] || continue
        if [ "$(cat "$entry/devpath" 2>/dev/null)" = "$lane_port" ] &&
           [ "$(cat "$entry/idVendor" 2>/dev/null)" = "$lane_vid" ] &&
           [ "$(cat "$entry/idProduct" 2>/dev/null)" = "$lane_pid" ]; then continue; fi
        case $(cat "$entry/bDeviceClass" 2>/dev/null) in
            09|11) ;;
            00|08) lane_empty_reader "$real" || return 1 ;;
            *) return 1 ;;
        esac
    done
}
lane_superspeed_present() {
    for entry in "$USB_BUS"/*; do
        [ -f "$entry/idVendor" ] || continue
        real=$(readlink -f "$entry")
        case $real in "$lane_controller"/*) ;; *) continue ;; esac
        [ "$(cat "$entry/devpath" 2>/dev/null)" = "$lane_port" ] &&
            [ "$(cat "$entry/idVendor" 2>/dev/null)" = "$lane_vid" ] &&
            [ "$(cat "$entry/idProduct" 2>/dev/null)" = "$lane_pid" ] || continue
        speed=$(cat "$entry/speed" 2>/dev/null)
        case $speed in ''|*[!0-9]*) continue ;; esac
        [ "$speed" -lt 5000 ] || return 0
    done
    return 1
}
lane_cleanup() {
    # A newer explicit UI request wins. Its apply-role worker holds the same
    # lock and will run next; do not submit another host request over it.
    lane_release || true
    if lane_owned && lane_peers_safe; then role_command host >/dev/null 2>&1 || true; fi
}
probe_lanes() {
    case $(device_name) in f50|v50) ;; *) return 0 ;; esac
    [ -z "${MU300_USB_ROLE_COMMAND:-$(get role_command)}" ] || return 0
    [ "$(role_now)" = host ] && [ -w "$LANE_PARAM" ] || return 0
    usb_net "${1:-}" || return 0
    # Never queue a second worker behind a running probe or explicit request.
    exec 8>"$ROLE_LOCK" || return 1
    flock -n 8 || return 0
    [ ! -e "$LANE_STATE" ] && [ "$(cat "$LANE_PARAM")" = -1 ] || return 0
    lane_device=$(readlink -f "$NET_CLASS/$1/device")
    lane_device=${lane_device%/*}
    [ "$(cat "$lane_device/speed" 2>/dev/null)" = 480 ] || return 0
    lane_controller=${MU300_USB_CONTROLLER_ROOT:-$(readlink -f "${ROLE_FILE%/*}/device")}
    [ -n "$lane_controller" ] || return 0
    case $lane_device in "$lane_controller"/*) ;; *) return 0 ;; esac
    # USB 2-only devices must retain normal operation. Require a BOS SS
    # capability, not a product/vendor allowlist. BOS cannot identify the
    # cable: an SS device on a USB2 cable may fail both bounded attempts.
    ucode "$LANE_BOS_TOOL" "$lane_device/bos_descriptors" || return 0
    lane_request=$(sed -n '1p' "$ROLE_STATE" 2>/dev/null)
    lane_port=$(cat "$lane_device/devpath")
    lane_vid=$(cat "$lane_device/idVendor"); lane_pid=$(cat "$lane_device/idProduct")
    lane_owned && lane_peers_safe || return 0
    # One finite probe per host session, started by netdev add. There is no
    # recurring scan, idle timer, daemon, persisted orientation or UCI change.
    printf '%s\n' pending > "$LANE_STATE" || return 1
    trap lane_cleanup EXIT
    for choice in 0 1; do
        lane_owned && lane_peers_safe || return 0
        [ "$(cat "$LANE_PARAM")" = -1 ] ||
            [ "$(cat "$LANE_PARAM")" = "$(cat "$LANE_STATE")" ] || return 0
        printf '%s\n' "$choice" > "$LANE_STATE"
        printf '%s\n' "$choice" > "$LANE_PARAM" || return 1
        role_command host >/dev/null || return 1
        # A one-shot enumeration deadline, not periodic monitoring. Correct
        # SuperSpeed devices never enter this path at all.
        "$LANE_WAIT" "${MU300_USB_LANE_SETTLE:-5}"
        lane_owned || return 0
        if lane_superspeed_present; then
            trap - EXIT
            logger -t unisoc-usb "USB3 lane $choice confirmed for port $lane_port"
            return 0
        fi
        # The old USB2 object may have been replaced on the same port.
        for entry in "$USB_BUS"/*; do
            real=$(readlink -f "$entry")
            case $real in "$lane_controller"/*) ;; *) continue ;; esac
            [ "$(cat "$entry/devpath" 2>/dev/null)" = "$lane_port" ] &&
                [ "$(cat "$entry/idVendor" 2>/dev/null)" = "$lane_vid" ] &&
                [ "$(cat "$entry/idProduct" 2>/dev/null)" = "$lane_pid" ] || continue
            lane_device=$real; break
        done
    done
    lane_release || return 1
    lane_owned && role_command host >/dev/null
    # Keep an attempted marker, even if the cable has no working SS lanes.
    printf '%s\n' attempted > "$LANE_STATE"
    trap - EXIT
    logger -t unisoc-usb 'USB3 lane probe finished without SuperSpeed; automatic direction restored'
}
ensure_section() {
    uci -q get "$CFG" >/dev/null 2>&1 || uci -q set "$CFG=device"
}
sync_boot_file() {
    mode=$(get net_mode); scope=$(get net_scope); auto=$(get net_auto)
    [ "$auto" = 1 ] || { rm -f "$BOOT_FILE"; return; }
    case $mode in ecm|ncm|rndis) ;; *) error 'Invalid USB network mode' ;; esac
    case $scope in once|permanent) ;; *) error 'Invalid USB network scope' ;; esac
    mkdir -p "${BOOT_FILE%/*}" || error 'Cannot create USB boot settings directory'
    tmp="$BOOT_FILE.$$"
    printf 'mode=%s\nscope=%s\n' "$mode" "$scope" > "$tmp" || error 'Cannot write USB boot settings'
    chmod 600 "$tmp"
    mv "$tmp" "$BOOT_FILE" || error 'Cannot save USB boot settings'
}
usb_net() {
    name=$1
    case $name in ''|*[!a-zA-Z0-9_.:-]*) return 1 ;; esac
    [ -d "$NET_CLASS/$name" ] || return 1
    [ "$(cat "$NET_CLASS/$name/type" 2>/dev/null)" = 1 ] || return 1
    [ ! -d "$NET_CLASS/$name/wireless" ] && [ ! -e "$NET_CLASS/$name/phy80211" ] || return 1
    sub=$(readlink -f "$NET_CLASS/$name/device/subsystem" 2>/dev/null)
    # Configfs gadget interfaces (usb0/rndis0) are not host-side USB NICs.
    # Their parent belongs to the gadget bus, even if their names contain usb.
    case $sub in */bus/gadget) return 1 ;; esac
    case $sub in */bus/usb) return 0 ;; esac
    path=$(readlink -f "$NET_CLASS/$name/device" 2>/dev/null)
    case $path in */usb[0-9]*/*) return 0 ;; esac
    return 1
}
bridge_section() {
    bridge=$(uci -q get unisoc_modem.main.lan_device 2>/dev/null)
    [ -n "$bridge" ] || bridge=br-lan
    case $bridge in *[!a-zA-Z0-9_:-]*) return 1 ;; esac
    uci -q show network | sed -n "s/^\(network\.[^.]*\)\.name='$bridge'$/\1/p" | head -n1
}
bridge_has() {
    section=$1; name=$2
    ports=$(uci -q get "$section.ports" 2>/dev/null)
    case " $ports " in *" $name "*) return 0 ;; esac
    return 1
}
net_snapshot() {
    # One snapshot per event, not one ubus call per adapter. Fail closed if
    # netifd cannot tell us which dynamically configured devices it owns.
    network_config=$(uci -q show network) || return 1
    runtime=$(ubus -t 2 call network.interface dump 2>/dev/null) || return 1
    jsonfilter -s "$runtime" -e '@.interface' >/dev/null 2>&1 || return 1
    runtime_devices=$(jsonfilter -s "$runtime" -e '@.interface[*].device' -e '@.interface[*].l3_device' 2>/dev/null)
    section=$(bridge_section)
    [ -n "$section" ] && [ "$(uci -q get "$section.type")" = bridge ] || return 1
    bridge=$(uci -q get unisoc_modem.main.lan_device 2>/dev/null)
    bridge=${bridge:-br-lan}
}
nic_ownership() {
    # Names originate from sysfs and have already passed usb_net validation.
    # Never evaluate UCI output as shell code. Also protect VLAN references
    # (eth0.10) and ports configured on an inactive WAN/other bridge.
    owner=; eligible=1; joined=0
    bridge_has "$section" "$name" && joined=1
    master=
    if [ -L "$NET_CLASS/$name/master" ]; then master=$(readlink -f "$NET_CLASS/$name/master" 2>/dev/null); master=${master##*/}; fi
    configured=$(printf '%s\n' "$network_config" | awk -v nic="$name" -v lan="$section" '
        /^[^=]+\.(device|ifname|ports)=/ {
            key=$0; sub(/=.*/, "", key); value=$0; sub(/^[^=]*=/, "", value)
            if (key == lan ".ports") next
            gsub(/\047/, "", value); n=split(value, fields, /[ \t]+/)
            for (i=1; i<=n; i++) if (fields[i]==nic || index(fields[i], nic ".")==1 || index(fields[i], nic ":")==1) {
                sub(/\.[^.]+$/, "", key); print key; exit
            }
        }')
    case $configured in *[!a-zA-Z0-9_.:@\[\]-]*) configured=network ;; esac
    runtime_owner=$(printf '%s\n' "$runtime_devices" | awk -v nic="$name" '$0==nic || index($0, nic ".")==1 { print "netifd"; exit }')
    if [ -n "$master" ] && [ "$master" != "$bridge" ]; then owner=$master; eligible=0
    elif [ -n "$configured" ]; then owner=$configured; eligible=0
    elif [ -n "$runtime_owner" ]; then owner=netifd; eligible=0
    elif [ "$master" = "$bridge" ] || [ "$joined" = 1 ]; then owner=$bridge
    fi
    # Sysfs names cannot contain quotes in Linux, but keep JSON fields strict.
    case $owner in *[!a-zA-Z0-9_.:@\[\]-]*) owner=network ;; esac
}
net_lock() {
    # flock is released by the kernel, including on process death. Bounded
    # contention, no stale mkdir lock or retry daemon.
    exec 9>"$NET_LOCK" || return 1
    # OpenWrt BusyBox flock has no -w, and timeout may not be installed.
    # Only contending events back off; the normal boot path never sleeps.
    for attempt in 1 2; do
        flock -n 9 && return 0
        sleep 1
    done
    flock -n 9
}
save_port() {
    [ -z "$(uci -q changes network)" ] || return 1
    # Isolate our delta from LuCI's pending edits. A failed commit must not
    # leave an automatic port addition queued in the user's staging area.
    delta=$(mktemp -d /tmp/unisoc-usb-uci.XXXXXX) || return 1
    saved=0
    uci -t "$delta" -q add_list "$section.ports=$name" && uci -t "$delta" -q commit network && saved=1
    rm -f "$delta/network"
    rmdir "$delta" 2>/dev/null || true
    [ "$saved" = 1 ]
}
sync_host_nic() {
    name=$1
    usb_net "$name" || return 0
    nic_ownership
    [ "$eligible" = 1 ] || return 0
    if [ "$joined" != 1 ]; then
        [ "$(role_now)" = host ] && [ "$(get lan_auto)" = 1 ] || return 0
        save_port || return 1
    fi
    "$IP" link set dev "$name" up >/dev/null 2>&1 || return 1
    "$IP" link set dev "$name" master "$bridge" >/dev/null 2>&1
}
host_nic_present() {
    for dir in "$NET_CLASS"/*; do
        [ -d "$dir" ] && usb_net "${dir##*/}" && return 0
    done
    return 1
}
start_host_rescan() {
    # The first hub may enumerate before its downstream Ethernet dongle has
    # power. Run one non-blocking rescan; never hold up boot or poll forever.
    ( "$0" host-rescan </dev/null >/dev/null 2>&1 ) &
}
case ${1:-} in
    get)
        role=$(role_now); role_auto=$(get role_auto); net_auto=$(get net_auto)
        mode=$(get net_mode); scope=$(get net_scope)
        case $role_auto in 1) ;; *) role_auto=0 ;; esac
        case $net_auto in 1) ;; *) net_auto=0 ;; esac
        saved_net_auto=$net_auto
        lan_auto=$(get lan_auto); case $lan_auto in 1) ;; *) lan_auto=0 ;; esac
        case $mode in ecm|ncm|rndis) ;; *) mode=ncm ;; esac
        case $scope in once|permanent) ;; *) scope=permanent ;; esac
        [ "$role_auto" = 0 ] || net_auto=0
        [ "$role" != host ] || net_auto=0
        available=1
        if [ "$role" = host ] || [ "$role_auto" = 1 ]; then available=0; fi
        host_supported=1
        [ -e "$ROLE_FILE" ] || host_supported=0
        network_status
        role_target=$(sed -n '2p' "$ROLE_STATE" 2>/dev/null)
        case $role_target in host|device) ;; *) role_target= ;; esac
        role_error=0; role_pending=0
        if [ -n "$role_target" ] && [ "$role" != "$role_target" ]; then
            case $(sed -n '3p' "$ROLE_STATE" 2>/dev/null) in pending) role_pending=1 ;; error) role_error=1 ;; esac
        fi
        link=$("${MU300_USB_UCODE:-ucode}" "${MU300_USB_LINK_HELPER:-/usr/libexec/unisoc-modem/usb-link.uc}" \
            "$role" "$ROLE_FILE" "$GADGET_DIR" "$USB_BUS" \
            "${MU300_USB_UDC_CLASS:-/sys/class/udc}" "${MU300_USB_ROLE_CLASS:-/sys/class/usb_role}" 2>/dev/null) || link='{"state":"unavailable","links":[]}'
        printf '{"ok":1,"role":"%s","role_auto":%s,"host_supported":%s,"role_target":"%s","role_pending":%s,"role_error":%s,"net_mode":"%s","net_scope":"%s","net_auto":%s,"net_available":%s,"net_current":"%s","net_next":"%s","net_policy_error":%s,"lan_auto":%s,"usb_link":%s}\n' \
            "$role" "$role_auto" "$host_supported" "$role_target" "$role_pending" "$role_error" "$mode" "$scope" "$net_auto" "$available" "$net_current" "$net_next" "$net_policy_error" "$lan_auto" "$link"
        ;;
    set-role)
        role=${2:-}; auto=${3:-}
        case $role in host|device) ;; *) error 'Invalid USB role' ;; esac
        case $auto in 0|1) ;; *) error 'Invalid boot-auto value' ;; esac
        [ "$role" = host ] || [ "$auto" = 0 ] || error 'Device is the boot default; host auto-apply is the only persistent role'
        [ -e "$ROLE_FILE" ] || error 'USB role switch is unavailable'
        # Persist and acknowledge before dropping the USB management link.
        # A synchronous role write can tear down the very RPC carrying its
        # response, leading the browser to report failure after success.
        ensure_section
        put role_auto "$auto" || error 'Cannot save USB role policy'
        if [ "$role" = host ] && [ "$auto" = 1 ]; then
            put net_auto 0 || error 'Cannot disable USB network boot policy'
            rm -f "$BOOT_FILE"
        fi
        uci commit unisoc_modem || error 'Cannot commit USB role policy'
        request="$(date +%s)-$$"
        printf '%s\n%s\npending\n\n' "$request" "$role" > "$ROLE_STATE.$$" && mv "$ROLE_STATE.$$" "$ROLE_STATE" || error '无法记录 USB 角色切换结果'
        pending=0
        if role_apply_needed "$role"; then
            pending=1
            # Give rpcd/uhttpd a brief chance to flush the acknowledgement
            # before the USB gadget carrying that response disappears.
            ( sleep 0.25 2>/dev/null || sleep 1; "$0" apply-role "$role" "$request" </dev/null >/dev/null 2>&1 ) &
        else
            role_result "$role" done '' "$request"
        fi
        printf '{"ok":1,"pending":%s}\n' "$pending"
        ;;
    apply-role)
        role=${2:-}
        request=${3:-}
        case $role in host|device) ;; *) exit 2 ;; esac
        [ -z "$request" ] || [ "$request" = "$(sed -n '1p' "$ROLE_STATE" 2>/dev/null)" ] || exit 0
        role_lock || exit 1
        [ -z "$request" ] || [ "$request" = "$(sed -n '1p' "$ROLE_STATE" 2>/dev/null)" ] || exit 0
        [ "$role" != device ] || lane_release || exit 1
        ! role_apply_needed "$role" || ( role_command "$role" ) || {
            role_result "$role" error '' "$request"
            logger -t unisoc-usb "role switch to $role failed"
            exit 1
        }
        [ "$(role_now)" != "$role" ] || role_result "$role" done '' "$request"
        role_unlock
        if [ "$role" = host ]; then
            start_host_rescan
            "$0" net-sync >/dev/null 2>&1 || true
        else
            rmdir "$RESCAN_MARKER" 2>/dev/null || true
        fi
        ;;
    probe-lanes)
        probe_lanes "${2:-}"
        ;;
    set-net)
        mode=${2:-}; scope=${3:-}; auto=${4:-}
        case $mode in ecm|ncm|rndis) ;; *) error 'Invalid USB network mode' ;; esac
        case $scope in once|permanent) ;; *) error 'Invalid USB network scope' ;; esac
        case $auto in 0|1) ;; *) error 'Invalid boot-auto value' ;; esac
        [ "$(role_now)" != host ] || error 'USB network mode is unavailable in host role'
        [ "$(get role_auto)" != 1 ] || error 'Disable host boot-auto before configuring USB network'
        ensure_section
        put net_mode "$mode" && put net_scope "$scope" && put net_auto "$auto" || error 'Cannot save USB network policy'
        sync_boot_file
        uci commit unisoc_modem || error 'Cannot commit USB network policy'
        printf '{"ok":1}\n'
        ;;
    boot)
        # initramfs applies the selected gadget mode before enumeration. A
        # one-shot mode is consumed only after userspace has actually booted.
        if [ "$(get role_auto)" = 1 ] && [ "$(get net_auto)" = 1 ]; then
            ensure_section
            put net_auto 0 && uci commit unisoc_modem
            rm -f "$BOOT_FILE"
        fi
        if [ "$(get net_auto)" = 1 ] && [ "$(get net_scope)" = once ] &&
           [ -f "${MU300_USB_APPLIED_FILE:-/run/unisoc-usb-net-applied}" ]; then
            ensure_section
            put net_auto 0 && uci commit unisoc_modem
            rm -f "$BOOT_FILE"
        fi
        if [ "$(get role_auto)" = 1 ]; then
            [ "$(role_now)" = host ] || role_command host
            start_host_rescan
        fi
        "$0" net-sync || true
        ;;
    host-rescan)
        sleep "${MU300_USB_RESCAN_DELAY:-2}"
        [ "$(role_now)" = host ] || exit 0
        host_nic_present && exit 0
        mkdir "$RESCAN_MARKER" 2>/dev/null || exit 0
        # Reset only the first external hub, once. Re-authorizing its USB
        # device causes a fresh downstream port scan without touching the
        # DWC3 role or rebooting the device.
        for hub in "$USB_BUS"/[0-9]*-[0-9]*; do
            [ -f "$hub/bDeviceClass" ] || continue
            [ "$(cat "$hub/bDeviceClass" 2>/dev/null)" = 09 ] || continue
            [ -w "$hub/authorized" ] || continue
            case ${hub##*/} in *.*|*:*) continue ;; esac
            printf '0\n' > "$hub/authorized" || exit 1
            printf '1\n' > "$hub/authorized" || exit 1
            logger -t unisoc-usb "rescanned host hub ${hub##*/} after missing USB NIC"
            break
        done
        ;;
    set-lan-auto)
        case ${2:-} in 0|1) ;; *) error 'Invalid boot-auto value' ;; esac
        [ "${2:-}" = 0 ] || [ "$(role_now)" = host ] || error 'USB host mode is required'
        net_lock || error 'USB 网卡配置正忙，请稍后重试'
        [ -z "$(uci -q changes unisoc_modem)" ] || error '配置有未保存更改，请先处理后重试'
        ensure_section
        put lan_auto "$2" && uci -q commit unisoc_modem || error '无法保存 USB 网卡自动加入设置'
        # Policy only: new adapters are enrolled on a netdev/ifup event.
        # Existing adapters keep the explicit manual Add action.
        printf '{"ok":1}\n'
        ;;
    net-sync)
        # The role readback can lag behind host netdev events. Only physical
        # USB NICs explicitly saved as LAN ports are eligible, so attaching
        # them does not require waiting for the role sysfs state to settle.
        net_lock && [ -z "$(uci -q changes network)" ] && net_snapshot || exit 0
        for dir in "$NET_CLASS"/*; do
            [ -d "$dir" ] || continue
            sync_host_nic "${dir##*/}" || logger -t unisoc-usb "could not save or attach LAN adapter ${dir##*/}"
        done
        ;;
    net-list)
        [ "$(role_now)" = host ] || { printf '{"ok":1,"devices":[],"host_only":1}\n'; exit 0; }
        net_lock && net_snapshot || error '无法确认网卡归属，请稍后重试'
        printf '{"ok":1,"devices":['
        first=1
        for dir in "$NET_CLASS"/*; do
            [ -d "$dir" ] || continue
            name=${dir##*/}
            usb_net "$name" || continue
            nic_ownership
            [ "$eligible" != 1 ] || "$IP" link set dev "$name" up >/dev/null 2>&1 || true
            [ "$first" = 1 ] || printf ','
            first=0
            # A scan does not enroll adapters or steal an occupied interface.
            carrier=$(cat "$dir/carrier" 2>/dev/null); case $carrier in 1) ;; *) carrier=0 ;; esac
            mac=$(cat "$dir/address" 2>/dev/null); case $mac in *[!a-fA-F0-9:]*) mac= ;; esac
            driver=
            if [ -L "$dir/device/driver" ]; then driver=$(readlink -f "$dir/device/driver" 2>/dev/null); driver=${driver##*/}; fi
            case $driver in *[!a-zA-Z0-9_.-]*) driver= ;; esac
            printf '{"name":"%s","carrier":%s,"in_lan":%s,"eligible":%s,"owner":"%s","mac":"%s","driver":"%s","attached":%s}' "$name" "$carrier" "$joined" "$eligible" "$owner" "$mac" "$driver" "$([ "$master" = "$bridge" ] && echo 1 || echo 0)"
        done
        printf ']}\n'
        ;;
    net-add)
        name=${2:-}
        [ "$(role_now)" = host ] || error 'USB host mode is required'
        usb_net "$name" || error 'Not a USB network interface'
        net_lock && net_snapshot || error '无法确认网卡归属，请稍后重试'
        nic_ownership
        [ "$eligible" = 1 ] || error '网卡已被其他网络占用，不可加入 LAN'
        [ -z "$(uci -q changes network)" ] || error '配置有未保存更改，请先处理后重试'
        "$IP" link set dev "$name" up || error 'Cannot bring USB network interface up'
        if ! bridge_has "$section" "$name"; then
            save_port || error 'Cannot save LAN bridge'
            "$NETWORK_SERVICE" reload >/dev/null 2>&1 || error 'Network reload failed'
        fi
        bridge=$(uci -q get unisoc_modem.main.lan_device 2>/dev/null)
        [ -n "$bridge" ] || bridge=br-lan
        "$IP" link set dev "$name" master "$bridge" >/dev/null 2>&1 || error 'Cannot attach USB interface to LAN bridge'
        printf '{"ok":1}\n'
        ;;
    *) echo "usage: $0 {get|set-role ROLE AUTO|apply-role ROLE|set-net MODE SCOPE AUTO|set-lan-auto 0|1|boot|host-rescan|net-sync|net-list|net-add IFACE}" >&2; exit 2 ;;
esac
