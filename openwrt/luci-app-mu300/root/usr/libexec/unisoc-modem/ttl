#!/bin/sh
# Panel adapter for the shared explicit nftables engine; replies are JSON.
#   ttl get        {"ok":1,"enabled":0|1,"value":N|null,"backend":"nft"|"none","offload":0|1|null,"iface":[...]}
#   ttl set N|off  {"ok":1}, or {"ok":0,"error":...}; N from 1 to 255, checked here again
set -u
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
json_str() { ucode -e 'import * as fs from "fs"; print(sprintf("%J", fs.readfile("/dev/stdin")));'; }
TTL_CMD=${MU300_TTL_CMD:-/usr/libexec/unisoc-modem/ttl-engine}

error() { printf '{"ok":0,"error":%s}\n' "$(printf '%s' "$1" | json_str)"; exit 0; }
num() { case $1 in ''|0*|*[!0-9]*) return 1 ;; esac; }

do_get() {
    st=$("$TTL_CMD" state 2>/dev/null) || error '无法读取 TTL 设置'
    v=$(printf '%s\n' "$st" | sed -n 's/^TTL=//p' | head -n1)
    b=$(printf '%s\n' "$st" | sed -n 's/^BACKEND=//p' | head -n1)
    o=$(printf '%s\n' "$st" | sed -n 's/^OFFLOAD=//p' | head -n1)
    mode=$(printf '%s\n' "$st" | sed -n 's/^MODE=//p' | head -n1)
    hw=$(printf '%s\n' "$st" | sed -n 's/^OFFLOAD_HW=//p' | head -n1)
    paused=$(printf '%s\n' "$st" | sed -n 's/^HW_PAUSED=//p' | head -n1)
    case $mode in egress|legacy) ;; *) mode=none ;; esac
    case $hw in 0|1) ;; *) hw=null ;; esac
    case $paused in 1) ;; *) paused=0 ;; esac
    ifs=$(printf '%s\n' "$st" | sed -n 's/^IFACES=//p' | head -n1)
    case $b in nft) ;; *) b=none ;; esac
    if num "$v" && [ "${#v}" -le 3 ] && [ "$v" -ge 1 ] && [ "$v" -le 255 ]; then en=1; else en=0; v=null; fi
    case $o in 0|1) ;; *) o=null ;; esac
    list= sep=
    for i in $ifs; do
        case $i in sipa_eth[0-9]|sipa_eth[0-9][0-9]) list="$list$sep\"$i\""; sep=, ;; esac
    done
    printf '{"ok":1,"enabled":%s,"value":%s,"backend":"%s","mode":"%s","offload":%s,"offload_hw":%s,"hw_paused":%s,"iface":[%s]}\n' "$en" "$v" "$b" "$mode" "$o" "$hw" "$paused" "$list"
}

do_set() {
    case ${1:-} in
        off) set -- off ;;
        0*) error 'TTL 无效' ;;
        *) { num "${1:-}" && [ "${#1}" -le 3 ] && [ "$1" -ge 1 ] && [ "$1" -le 255 ]; } || error 'TTL 无效'
           set -- set "$1" ;;
    esac
    if out=$("$TTL_CMD" "$@" 2>&1 >/dev/null); then
        echo '{"ok":1}'
    else
        code=$?
        [ "$code" != 75 ] || error '另一项 TTL 操作正在执行，请稍后重试'
        printf '{"ok":0,"error":"无法应用 TTL 设置","detail":%s}\n' "$(printf '%s\n' "$out" | tail -n1 | json_str)"
    fi
}

case ${1:-} in
    get) do_get ;;
    set) do_set "${2:-}" ;;
    *) error 'Unknown TTL operation' ;;
esac
