        lang_get)     run_m lang_get     m_lang_get ;;
        lang_set)     run_m lang_set     m_lang_set ;;
        power_get)    run_m power_get    m_power_get ;;
        power_set)    run_m power_set    m_power_set ;;
        sim_get)      run_m sim_get m_sim_get ;;
        sim_set)      run_m sim_set m_sim_set ;;
        simcard_get)  run_m simcard_get  m_simcard_get ;;
        simcard_set)  run_m simcard_set  m_simcard_set ;;
        ttl_get)      run_m ttl_get      m_ttl_get ;;
        ttl_set)      run_m ttl_set      m_ttl_set ;;
        traffic_get)  run_m traffic_get  m_traffic_get ;;
        traffic_set)  run_m traffic_set  m_traffic_set ;;
        forward_get)  run_m forward_get  m_forward_get ;;
        forward_set)  run_m forward_set  m_forward_set ;;
        forward_test) run_m forward_test m_forward_test ;;
        forward_log_clear) run_m forward_log_clear m_forward_log_clear ;;
        cpu_get)      run_m cpu_get      m_cpu_get ;;
        cpu_set)      run_m cpu_set      m_cpu_set ;;
        cpu_tune)     run_m cpu_tune     m_cpu_tune ;;
        cpu_voltage_get) run_m cpu_voltage_get m_cpu_voltage_get ;;
        cpu_voltage_set) run_m cpu_voltage_set m_cpu_voltage_set ;;
        packages_get) run_m packages_get m_packages_get ;;
        packages_act) run_m packages_act m_packages_act ;;
        update_get)   run_m update_get   m_update_get ;;
        update_job)   run_m update_job   m_update_job ;;
        update_act)   run_m update_act   m_update_act ;;
        backup_export) run_m backup_export m_backup_export ;;
        backup_import) run_m backup_import m_backup_import ;;
        backup_job)   run_m backup_job   m_backup_job ;;
        *)           refuse 'No such method' ;;
    esac
    ;;
# not methods (rpcd runs only list and call): the detached scan m_at starts, the detached send m_sms_send starts,
# and the service's stop
at-job)
    [ "$DIR_OK" = 1 ] && run_at_job
    ;;
sms-job)
    [ "$DIR_OK" = 1 ] && run_sms_job
    ;;
flush-ops)
    [ "$DIR_OK" = 1 ] && { ops_reap; ops_flush now; }
    ;;
*)
    echo "usage: $0 {list|call <method>}" >&2
    exit 2
    ;;
esac
