	"forward_log_clear": { },
	"traffic_get": { "slot": "String" },
	"traffic_set": { "payload": "String", "slot": "String" },
	"traffic_clear": { "confirm": false, "slot": "String" },
	"usb_get": { },
	"usb_set": { "kind": "String", "value": "String", "scope": "String", "auto": "String" },
	"apn_get": { },
	"apn_set": { "action": "String", "payload": "String" },
	"usb_net_list": { },
	"usb_net_add": { "iface": "String" }
}
EOF
}

# Forensics for the rpcd crash (2026-09-28): rpcd segfaulted while parsing a
# script reply during a lock apply, wiping every session (LuCI bounced to the
# login page). Every method's raw stdout is appended here, so the last entry
# at the moment of a crash is the input that killed the parser.
LASTLOG=$DIR/last-outputs.log
run_m() {
    local out
    out=$(eval "$2" 2>/dev/null)
    printf '=== %s %s len=%s\n%s\n' "$(date '+%m-%d %H:%M:%S')" "$1" "${#out}" "$out" >> "$LASTLOG" 2>/dev/null
    tail -n 400 "$LASTLOG" > "$LASTLOG.t" 2>/dev/null && mv "$LASTLOG.t" "$LASTLOG"
    printf '%s\n' "$out"
}

case "${1:-}" in
sms-job)
    run_sms_job
    ;;
list)
    do_list
    ;;
call)
    case ${2:-} in
        sysinfo)    run_m sysinfo    'm_sysinfo' ;;
        sim_get)
            slots=$(uci -q get unisoc_modem.main.sim_slots); [ "$slots" = 2 ] || slots=1
            card=$(uci -q get unisoc_modem.main.data_sim); [ "$card" = 1 ] || card=0
            printf '{"ok":1,"slots":%s,"saved_sim":%s}\n' "$slots" "$card"
            ;;
        apn_get) "$DASH/apn" get ;;
        apn_set)
            case $(inp '@.action') in
                save|delete|apply|auto) inp '@.payload' | "$DASH/apn" "$(inp '@.action')" ;;
                *) printf '{"ok":0,"error":"apn_invalid"}\n' ;;
            esac ;;
        data_sim_get) "$DASH/data-sim" get ;;
        v50_sim_get) /opt/mu300/bin/mu300-v50-sim status ;;
        data_sim_set) "$DASH/data-sim" start "$(inp '@.target')" ;;
        data_sim_status) "$DASH/data-sim" status "$(inp '@.id')" ;;
        sim_radio_get) /opt/mu300/bin/mu300-sim-radio get ;;
        sim_radio_set)
            slot=$(inp '@.slot'); enabled=$(inp '@.enabled'); confirmed=$(inp '@.confirm')
            case "$slot:$enabled:$confirmed" in
                [01]:true:true) "$DASH/data-sim" start "radio-$slot-1";;
                [01]:false:true) "$DASH/data-sim" start "radio-$slot-0";;
                *) printf '{"ok":0,"error":"Invalid radio request"}\n';;
            esac;;
        sim_radio_status) "$DASH/data-sim" status "$(inp '@.id')" ;;
        status)     run_m status     'm_status' ;;
        cells)      m_status cells ;;
        # Avoid the forensic log's fork/tail/rewrite on every speed sample.
        rates)      "$DASH/dashboard-rates" ;;
        signal)     run_m signal     'm_signal' ;;
        act)        run_m act        'm_act' ;;
        at)         run_m at         'm_at' ;;
        at_history) run_m at_history 'm_at_history' ;;
        lock_get)
            # default serves the lock cache instantly (a real read is seven AT
            # round trips, about a second each); fresh=1 does the real read -
            # the page uses it only behind the manual refresh button
            if [ "$(inp '@.fresh')" = "1" ]; then
                run_m lock_get:fresh '"$DASH/lock" get fresh 2>/dev/null || printf "{\"error\":\"lock read failed\"}\n"'
            else
                run_m lock_get '"$DASH/lock" get 2>/dev/null || printf "{\"error\":\"lock read failed\"}\n"'
            fi
            ;;
        lock_set)   run_m lock_set   'm_lock_set' ;;
        lock_status) "$DASH/lock" status "$(inp '@.id')" ;;
        sms_list)   run_m sms_list   'm_sms_list' ;;
        sms_show)   run_m sms_show   'm_sms_show' ;;
        sms_send)   run_m sms_send   'm_sms_send' ;;
        sms_job)    m_sms_job ;;
        sms_delete) run_m sms_delete 'm_sms_delete' ;;
        sms_sync)   run_m sms_sync   'm_sms_sync' ;;
        forward_get) "$DASH/sms-forward" get "$(inp '@.profile' shared)" ;;
        cpu_get) "$DASH/cpu" get ;;
        cpu_apply) inp '@.payload' | "$DASH/cpu" apply ;;
        cpu_voltage_get) "$DASH/cpu-voltage" get ;;
        cpu_voltage_save) inp '@.payload' | "$DASH/cpu-voltage" save ;;
        forward_log_clear) "$DASH/sms-forward" log-clear ;;
        forward_status) "$DASH/sms-forward" status "$(inp '@.profile' shared)" ;;
        forward_set)
            payload=$(inp '@.payload')
            printf '%s' "$payload" | "$DASH/sms-forward" set
            ;;
        forward_test)
            profile=$(inp '@.profile' shared)
            case "$profile" in shared|sim0) ;; sim1)
                [ "$(uci -q get unisoc_modem.main.sim_slots 2>/dev/null)" = 2 ] || { printf '{"ok":0,"error":"invalid_config"}\n'; exit 0; } ;;
                *) printf '{"ok":0,"error":"invalid_config"}\n'; exit 0 ;; esac
            # The backend admits one worker, then returns without holding RPC.
            "$DASH/sms-forward" test-start "$profile"
            ;;
        traffic_get)
            ubus -t 3 call unisoc.traffic get "{\"slot\":${MU300_SIM_SLOT:-0}}" 2>/dev/null || printf '{"error":"traffic_unavailable"}\n'
            ;;
        traffic_set)
            # Do not forward the browser session into the private service.
            # Use the validated per-request SIM scope, not another copy of it.
            params=$(printf '%s' "$INPUT" | ucode -e 'import * as fs from "fs"; let i=json(fs.readfile("/dev/stdin")); print(sprintf("%J", {payload:i.payload,slot:int(getenv("MU300_SIM_SLOT") || 0)}));' 2>/dev/null) || { printf '{"ok":0,"error":"invalid_config"}\n'; exit 0; }
            ubus -t 5 call unisoc.traffic set "$params" 2>/dev/null || printf '{"ok":0,"error":"traffic_unavailable"}\n'
            ;;
        traffic_clear)
            # Forward only the validated argument, not LuCI's ubus_rpc_session:
            # the internal service is intentionally not exposed by the UI ACL.
            case $(inp '@.confirm') in true) confirm=true ;; *) confirm=false ;; esac
            ubus -t 5 call unisoc.traffic clear "{\"confirm\":$confirm,\"slot\":${MU300_SIM_SLOT:-0}}" 2>/dev/null || printf '{"ok":0,"error":"traffic_unavailable"}\n'
            ;;
        usb_get)    run_m usb_get    '"$DASH/device-usb" get' ;;
        usb_set)
            kind=$(inp '@.kind'); value=$(inp '@.value'); scope=$(inp '@.scope'); auto=$(inp '@.auto')
            case $kind in
                role) run_m usb_set:role '"$DASH/device-usb" set-role "$value" "$auto"' ;;
                net)  run_m usb_set:net  '"$DASH/device-usb" set-net "$value" "$scope" "$auto"' ;;
                lan-auto) run_m usb_set:lan-auto '"$DASH/device-usb" set-lan-auto "$value"' ;;
                *)    printf '{"ok":0,"error":"unknown USB setting"}\n' ;;
            esac ;;
        usb_net_list) run_m usb_net_list '"$DASH/device-usb" net-list' ;;
        usb_net_add)  iface=$(inp '@.iface'); run_m usb_net_add '"$DASH/device-usb" net-add "$iface"' ;;
        *)          printf '{"ok":0,"error":"no such method"}\n' ;;
    esac
    ;;
*)
    echo "usage: $0 {list|call <method>}" >&2
    exit 2
    ;;
esac
