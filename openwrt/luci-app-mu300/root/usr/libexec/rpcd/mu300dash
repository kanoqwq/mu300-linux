# System > Backup of settings: the request goes on to mu300-api as it came, which checks every field (and refuses any
# other); the reply carries the backup (export) or what a restore would change (import), so run_m does not keep it
APIB=${MU300_DASH_API:-/opt/mu300/bin/mu300-api}
m_backup_export() { reply_obj "$(printf '%s' "$INPUT" | "$APIB" backup.export 2>/dev/null)" 'The backup tool gave no valid reply'; }
m_backup_import() { reply_obj "$(printf '%s' "$INPUT" | "$APIB" backup.import 2>/dev/null)" 'The backup tool gave no valid reply'; }
m_backup_job() { reply_obj "$(printf '{"from":0}' | "$APIB" job.status 2>/dev/null)" 'The backup tool gave no valid reply'; }

# Cellular > SIM settings: per card, the radio on or off (mu300-sim-radio, FINDINGS 185) and VoLTE and VoNR
# (mobile-data voice, FINDINGS 184). get asks the card in use what
# it has now (two short reads); set sends the choice to the card in use and reads it back, or saves it for the other
# card's next start. Nothing a caller sends reaches the command but the fixed words checked here.
m_simcard_get() {
    local v s1 r
    [ -x "$MOBILE_DATA" ] || { refuse 'Mobile data integration is not provided by this platform'; return; }
    v=$(json_obj "$("$MOBILE_DATA" voice --json --read 2>/dev/null)") || { refuse 'The SIM settings could not be read'; return; }
    # whether this device has a second card at all (the selector's own account, files only)
    s1=0
    [ "$(printf '%s' "$("$SIMCTL" status --json 2>/dev/null)" | jsonfilter -e '@.slot1_supported' 2>/dev/null)" != 1 ] || s1=1
    r=null
    [ ! -x "$SIM_RADIO" ] || r=$(json_obj "$("$SIM_RADIO" status --json 2>/dev/null)") || r=null
    printf '{"ok":1,"slot1_supported":%d,"voice":%s,"radio":%s}\n' "$s1" "$v" "$r"
}
m_simcard_set() {
    local kind slot state out
    inp '@.kind'; kind=$V
    inp '@.slot'; slot=$V
    inp '@.state'; state=$V
    case $kind:$slot:$state in volte:[01]:on|volte:[01]:off|vonr:[01]:on|vonr:[01]:off) ;;
        radio:[01]:on|radio:[01]:off|radio:all:on|radio:all:off)
            # the radio can take half a minute (the cold start on a U30 Air's second card more): never in the request;
            # the page follows it with simcard_get (radio.busy, radio.result)
            [ -x "$SIM_RADIO" ] || { refuse 'Radio control is not provided by this platform'; return; }
            if [ "$(printf '%s' "$("$SIM_RADIO" status --json 2>/dev/null)" | jsonfilter -e '@.busy' 2>/dev/null)" = true ]; then
                refuse 'A SIM radio change is already running'; return
            fi
            setsid "$SIM_RADIO" set "$slot" "$state" </dev/null >/dev/null 2>&1 &
            printf '{"ok":1,"started":1}\n'
            return ;;
        *) refuse 'Invalid SIM setting'; return ;; esac
    [ -x "$MOBILE_DATA" ] || { refuse 'Mobile data integration is not provided by this platform'; return; }
    if out=$("$MOBILE_DATA" voice "$kind" "$state" --slot "$slot" 2>&1); then
        printf '{"ok":1,"text":%s}\n' "$(json_str "$out")"
    else
        refuse 'The modem did not take the setting; nothing was saved' "$out"
    fi
}

SIMCTL=${MU300_DASH_SIM:-/opt/mu300/bin/mu300-sim}
m_sim_get() { reply_obj "$("$SIMCTL" status --json 2>/dev/null)" 'SIM control unavailable'; }
m_sim_set() {
    local op value
    inp '@.op'; op=$V
    inp '@.value'; value=$V
    case $op:$value in default:1|default:2|hot:0|hot:1|switch:1|switch:2|card:0|card:1|card:2|card:3|card:none) ;;
        *) refuse 'Invalid SIM setting'; return;; esac
    # the ZTE V50's card for the next boot (mu300-sim card, FINDINGS 204): its words when refused, else the status
    if [ "$op" = card ]; then
        local err
        err=$("$SIMCTL" card "$value" 2>&1 >/dev/null) || { refuse 'SIM control failed' "$err"; return; }
        reply_obj "$("$SIMCTL" status --json 2>/dev/null)" 'SIM control unavailable'
        return
    fi
    if [ "$op" = switch ]; then
        local state
        state=$("$SIMCTL" status --json 2>/dev/null)
        [ "$(printf '%s' "$state" | jsonfilter -e '@.hot')" = 1 ] &&
            [ "$(printf '%s' "$state" | jsonfilter -e '@.available')" = 1 ] &&
            [ "$(printf '%s' "$state" | jsonfilter -e '@.busy')" = 0 ] || {
                refuse 'Enable hot switching; reboot if channels are unavailable or wait until idle'; return;
            }
        setsid "$SIMCTL" switch "$value" </dev/null >/dev/null 2>&1 &
        printf '{"ok":1,"started":1}\n'
    else
        reply_obj "$("$SIMCTL" "$op" "$value" 2>/dev/null)" 'SIM control failed'
    fi
}

# Forensics for the rpcd crash (2026-09-28): rpcd segfaulted while parsing a
# script reply during a lock apply, wiping every session (LuCI bounced to the
# login page). Every method's raw stdout is appended here, so the last entry
# at the moment of a crash is the input that killed the parser.
LASTLOG=$DIR/last-outputs.log

# ------------------------------------------------------------- operations log
# "Recent modem operations": one line per call - when, the method (for "at" the command's name only, for act and
# lock_set the op or kind), how long it took and how it ended (ok, error, busy, confirm, or killed: rpcd ended the
# call at its 30 s limit, found afterwards by its marker) - and nothing else: no parameter values, no replies, no
# SMS text, no IMSI or numbers. In RAM for this boot (OPS, the last OPS_MAX lines); copied to flash at most every
# OPS_FLUSH seconds and when the service stops, and the previous boot's copy is kept beside it, so that a report
# after a reboot still has the calls that led up to it. The panel shows both (ops_log).
OPS=$DIR/ops.log
OPS_DIR=${MU300_DASH_OPS_DIR:-/etc/unisoc-modem}
OPS_MAX=200
OPS_FLUSH=300

# ticks: hundredths of a second since boot (whole seconds where /proc/uptime is missing)
ticks() {
    local u
    { read -r u _ < /proc/uptime; } 2>/dev/null || { echo $(( $(date +%s) * 100 )); return; }
    u=${u%%.*}${u#*.}; u=${u#"${u%%[!0]*}"}
    echo "${u:-0}"
}

# at_verb CMD: an AT command's name for the log: up to its first "=" or "?" ("AT+COPS=?", "AT+CPIN=", "AT+CSQ"),
# a dial without its number, at most 24 characters of [A-Z0-9+&^$%#*_.:=?-]
at_verb() {
    printf '%s\n' "$1" | tr -d ' "' | tr 'a-z' 'A-Z' | awk '{
        s = $0
        if (s ~ /^ATD/) { print "ATD"; exit }
        i = match(s, /[=?]/)
        v = i ? substr(s, 1, i) : s
        if (i && substr(s, i, 2) == "=?") v = v "?"
        gsub(/[^A-Z0-9+&^$%#*_.:=?-]/, "", v)
        print substr(v, 1, 24)
    }'
}

# ops_detail LABEL: the one thing about this call worth logging besides its name (never a value someone typed)
ops_detail() {
    case $1 in
        at)       inp '@.cmd'; is_ascii_line "$V" && at_verb "$V" ;;
        act)      inp '@.op'; allowed "$V" '[a-z-]{1,16}' && printf '%s\n' "$V" ;;
        lock_set) inp '@.kind'; allowed "$V" '[a-z_]{1,16}' && printf '%s\n' "$V" ;;
        lock_get) inp '@.fresh'; [ "$V" = 1 ] && echo fresh ;;
        update_act) inp '@.op'; allowed "$V" '[a-z_]{1,16}' && printf '%s\n' "$V" ;;
        cpu_voltage_set) inp '@.op'; allowed "$V" '[a-z]{1,8}' && printf '%s\n' "$V" ;;
        cpu_tune) inp '@.op'; allowed "$V" '[a-z]{1,10}' && printf '%s\n' "$V" ;;
    esac
}

# ops_reap: the markers of calls that never finished (rpcd killed them) become "killed" lines
ops_reap() {
    local f pid line
    for f in "$DIR"/ops.run.*; do
        [ -f "$f" ] || continue
        pid=${f##*.}
        case $pid in ''|*[!0-9]*) rm -f "$f"; continue ;; esac
        [ "$pid" != $$ ] && ! kill -0 "$pid" 2>/dev/null || continue
        line=$(cat "$f" 2>/dev/null)
        rm -f "$f"
        [ -n "$line" ] && printf '%s - killed\n' "$line" >> "$OPS"
    done
}

# ops_flush [now]: the RAM log to flash, when the copy there is older than OPS_FLUSH seconds (or "now"). The first
# flush of a boot keeps the previous boot's copy as panel-ops.prev.log (a rename).
ops_flush() {
    local f=$OPS_DIR/panel-ops.log
    [ -s "$OPS" ] || return 0
    if [ "${1:-}" != now ] && [ -f "$DIR/ops.boot" ] && [ -f "$f" ] &&
       [ $(( $(now) - $(date -r "$f" +%s 2>/dev/null || echo 0) )) -lt "$OPS_FLUSH" ]; then
        return 0
    fi
    (umask 077; mkdir -p "$OPS_DIR") 2>/dev/null
    if [ ! -f "$DIR/ops.boot" ]; then
        [ -f "$f" ] && mv -f "$f" "$OPS_DIR/panel-ops.prev.log" 2>/dev/null
        : > "$DIR/ops.boot"
    fi
    (umask 077; tail -n "$OPS_MAX" "$OPS" > "$f.part") 2>/dev/null && mv -f "$f.part" "$f"
}

# ops_add LINE: one finished call
ops_add() {
    ops_reap
    printf '%s\n' "$1" >> "$OPS"
    # trimmed now and then, not on every call: the file is in RAM, a little over the limit costs nothing
    [ "$(wc -l < "$OPS" 2>/dev/null || echo 0)" -gt $((OPS_MAX + 50)) ] &&
        tail -n "$OPS_MAX" "$OPS" > "$OPS.t" 2>/dev/null && mv "$OPS.t" "$OPS"
    ops_flush
}

m_ops_log() {
    ops_reap
    printf '{"ok":1,"now":%s,"prev":%s}\n' "$(json_str "$(tail -n "$OPS_MAX" "$OPS" 2>/dev/null)")" \
        "$(json_str "$(cat "$OPS_DIR/panel-ops.prev.log" 2>/dev/null)")"
}

run_m() {  # run_m LABEL FUNCTION: the method's reply, logged
    local out t0 dt how stamp detail head kept
    t0=$(ticks)
    stamp="$(date '+%m-%d %H:%M:%S') $1"
    detail=$(ops_detail "$1")
    [ -n "$detail" ] && stamp="$stamp $detail"
    # the marker a killed call leaves behind (ops_reap)
    printf '%s\n' "$stamp" > "$DIR/ops.run.$$" 2>/dev/null
    out=$("$2" 2>/dev/null)
    # (a backup's reply is the file with its passwords, or what a restore changes: its length only)
    case $1 in backup_*) kept='(a backup: not kept)' ;; *) kept=$out ;; esac
    printf '=== %s %s len=%s\n%s\n' "$(date '+%m-%d %H:%M:%S')" "$1" "${#out}" "$kept" >> "$LASTLOG" 2>/dev/null
    tail -n 400 "$LASTLOG" > "$LASTLOG.t" 2>/dev/null && mv "$LASTLOG.t" "$LASTLOG"
    printf '%s\n' "$out"
    dt=$(( $(ticks) - t0 ))
    # the reply's own top-level verdict (a status snapshot carries the modem's errors inside, which are not the call's);
    # its start without blanks: what jsonfilter re-serialises reads '{ "ok": 0, ...'
    head=$(printf '%s' "$out" | head -c 80 | tr -d ' \t')
    case $head in
        '{"ok":0'*'"confirm":1'*) how=confirm ;;
        '{"ok":0'*'"busy":1'*|'{"busy":1'*) how=busy ;;
        # (a collector's "no answer" snapshot is {"ts":N,"error...)
        '{"ok":0'*|'{"error'*|'{"ts":'[0-9]*',"err'*|'') how=error ;;
        *) how=ok ;;
    esac
    rm -f "$DIR/ops.run.$$"
    # The pages poll the reads every few seconds: a quick, successful read is not worth a line (two hundred of them
    # would push out everything else within minutes). Every change, every AT command, and every read that was slow
    # or failed is.
    case $1 in
        # (the send's job logs its own result once it is in; the polls that ask after it are not worth a line each)
        ops_log|sms_job|update_job|backup_job) return ;;
        sysinfo|status|signal|at_job|at_history|sms_list|sms_show|*_get|usb_net_list)
            [ "$how" != ok ] || [ "$dt" -ge 200 ] || [ -n "$detail" ] || return ;;
    esac
    ops_add "$(printf '%s %d.%02ds %s' "$stamp" $((dt / 100)) $((dt % 100)) "$how")"
}

case "${1:-}" in
list)
    do_list
    ;;
call)
    # a backup to restore is larger than any other request (6 MiB: a 4 MiB file, escaped)
    [ "${2:-}" != backup_import ] || INPUT_MAX=6291456
    INPUT=$(cat 2>/dev/null)
    if input_too_large; then
        refuse 'Request too large'
        exit 0
    fi
    if [ "$DIR_OK" != 1 ]; then
        refuse 'The runtime directory is not safe; nothing was run'
        exit 0
    fi
    case ${2:-} in
        sysinfo)      run_m sysinfo      m_sysinfo ;;
        status)       run_m status       m_status ;;
        signal)       run_m signal       m_signal ;;
        act)          run_m act          m_act ;;
        at)           run_m at           m_at ;;
        at_job)       run_m at_job       m_at_job ;;
        at_history)   run_m at_history   m_at_history ;;
        ops_log)      run_m ops_log      m_ops_log ;;
        lock_get)     run_m lock_get     m_lock_get ;;
        lock_set)     run_m lock_set     m_lock_set ;;
        sms_list)     run_m sms_list     m_sms_list ;;
        sms_show)     run_m sms_show     m_sms_show ;;
        sms_send)     run_m sms_send     m_sms_send ;;
        sms_job)      run_m sms_job      m_sms_job ;;
        sms_delete)   run_m sms_delete   m_sms_delete ;;
        sms_sync)     run_m sms_sync     m_sms_sync ;;
        usb_get)      run_m usb_get      m_usb_get ;;
        usb_set)      run_m usb_set      m_usb_set ;;
        usb_net_list) run_m usb_net_list m_usb_net_list ;;
