#!/bin/sh
# A selected host-side USB NIC can enumerate after netifd creates br-lan.
# Reattach on the kernel netdev event, without polling or reloading the LAN.
[ "$ACTION" = add ] || exit 0
[ -x /usr/libexec/unisoc-modem/device-usb ] || exit 0
/usr/libexec/unisoc-modem/device-usb net-sync >/dev/null 2>&1
case $(readlink -f "/sys/class/net/$INTERFACE/device/subsystem" 2>/dev/null) in
    */bus/usb)
        (/usr/libexec/unisoc-modem/device-usb probe-lanes "$INTERFACE" </dev/null >/dev/null 2>&1) &
        ;;
esac
