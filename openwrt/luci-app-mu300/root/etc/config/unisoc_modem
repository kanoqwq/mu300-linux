config core 'main'
	option at_backend 'auto'
	option at_port '/dev/stty_nr1'
	option at_command ''
	option sim_slots '1'
	option data_sim '0'
	option allow_roaming0 '0'
	option allow_roaming1 '0'
	option data_sim_command ''
	option sim0_device ''
	option sim1_device ''
	option sms_command ''
	option sms_pool '/etc/mu300/sms'
	option data_interface 'wan'
	option data_interface_v6 'wan6'
	option data_device ''
	option lan_device 'br-lan'
	option wifi_device 'wlan0'
	option usb_device 'usb0'
	option replay_timeout '90'
	option auto_work_mode 'default'
	option auto_work_mode_default '152'
	option home_refresh_interval '2'
	option state_dir '/etc/unisoc-modem/lock-state.d'

config device 'usb'
	option role_auto '0'
	option net_mode 'ncm'
	option net_scope 'permanent'
	option net_auto '0'
	option role_command ''
