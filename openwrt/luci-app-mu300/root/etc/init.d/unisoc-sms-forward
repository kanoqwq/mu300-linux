#!/bin/sh /etc/rc.common
# Separate from the USB/lock boot worker: installing or restarting the
# forwarding feature must not rerun USB gadget policy or touch the modem.
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/unisoc-modem/sms-forward run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance calls
	procd_set_param command /usr/libexec/unisoc-modem/call-notify
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
