#!/bin/sh /etc/rc.common
START=96
STOP=12
USE_PROCD=1
start_service() {
    local board=
    [ ! -x /opt/mu300/bin/mu300-device ] || board=$(/opt/mu300/bin/mu300-device)
    export UNISOC_BATTERY_BOARD="$board"
    # A one-shot hardware probe owns menu presence. No battery means no procd
    # instance, respawn, sampling timer or history-directory creation.
    /usr/bin/ucode /usr/libexec/unisoc-modem/battery-history probe || return 0
    umask 077
    procd_open_instance history
    procd_set_param command /usr/bin/ucode /usr/libexec/unisoc-modem/battery-history
    procd_set_param env UNISOC_BATTERY_BOARD="$board"
    procd_set_param respawn 3600 10 5
    procd_set_param stderr 1
    procd_close_instance
}
