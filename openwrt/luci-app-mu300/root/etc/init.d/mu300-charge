#!/bin/sh /etc/rc.common
START=97
STOP=20
USE_PROCD=1

start_service() {
    case "$(cat /run/mu300/device 2>/dev/null)" in u30air|u30pro) ;; *) return 0 ;; esac
    /usr/libexec/unisoc-modem/charge apply >/dev/null
    [ "$(uci -q get mu300-charge.main.paused)" != 1 ] || return 0
    if [ "$(uci -q get mu300-charge.main.enabled)" != 1 ] &&
       [ "$(uci -q get mu300-charge.main.full_once)" != 1 ]; then return 0; fi
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/libexec/unisoc-modem/charge-watch.uc
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

reload_service() { stop; start; }
service_triggers() { procd_add_reload_trigger mu300-charge; }
