msgid "USB role switch failed"
msgstr "Cambio di ruolo USB non riuscito"

msgid "USB role switch was refused by platform safety checks"
msgstr "Il cambio di ruolo USB è stato rifiutato dai controlli di sicurezza della piattaforma"

msgid "Cannot create USB boot settings directory"
msgstr "Impossibile creare la directory delle impostazioni di avvio USB"

msgid "Cannot write USB boot settings"
msgstr "Impossibile scrivere le impostazioni di avvio USB"

msgid "Cannot save USB boot settings"
msgstr "Impossibile salvare le impostazioni di avvio USB"

msgid "Invalid boot-auto value"
msgstr "Valore boot-auto non valido"

msgid "Device is the boot default; host auto-apply is the only persistent role"
msgstr "Dispositivo è il ruolo predefinito all'avvio; l'applicazione automatica della modalità host è l'unico ruolo persistente"

msgid "Cannot save USB role policy"
msgstr "Impossibile salvare la policy del ruolo USB"

msgid "Cannot disable USB network boot policy"
msgstr "Impossibile disabilitare la policy di avvio della rete USB"

msgid "Cannot commit USB role policy"
msgstr "Impossibile confermare la policy del ruolo USB"

msgid "USB network mode is unavailable in host role"
msgstr "La modalità di rete USB non è disponibile nel ruolo host"

msgid "Disable host boot-auto before configuring USB network"
msgstr "Disabilitare il boot-auto della modalità host prima di configurare la rete USB"

msgid "Cannot save USB network policy"
msgstr "Impossibile salvare la policy della rete USB"

msgid "Cannot commit USB network policy"
msgstr "Impossibile confermare la policy della rete USB"

msgid "USB host mode is required"
msgstr "È richiesta la modalità host USB"

msgid "Not a USB network interface"
msgstr "Non è un'interfaccia di rete USB"

msgid "LAN bridge device section was not found"
msgstr "Sezione del dispositivo del bridge LAN non trovata"

msgid "Cannot bring USB network interface up"
msgstr "Impossibile attivare l'interfaccia di rete USB"

msgid "Cannot add interface to LAN bridge"
msgstr "Impossibile aggiungere l'interfaccia al bridge LAN"

msgid "Cannot save LAN bridge"
msgstr "Impossibile salvare il bridge LAN"

msgid "Network reload failed"
msgstr "Ricaricamento della rete non riuscito"

msgid "Cannot attach USB interface to LAN bridge"
msgstr "Impossibile collegare l'interfaccia USB al bridge LAN"

msgid "Invalid forwarding setting"
msgstr "Impostazione di inoltro non valida"

msgid "The message template is too long or contains a control character"
msgstr "Il modello del messaggio è troppo lungo o contiene un carattere di controllo"

msgid "Invalid filter list (at most 50 lines)"
msgstr "Elenco di filtri non valido (al massimo 50 righe)"

msgid "The webhook address must be an http:// or https:// URL"
msgstr "L'indirizzo del webhook deve essere un URL http:// o https://"

msgid "The webhook body is too long or contains a control character"
msgstr "Il corpo del webhook è troppo lungo o contiene un carattere di controllo"

msgid "The answer check must be key=value, like errcode=0 or ok=true (the value a whole number or lowercase letters, 16 at most)"
msgstr "Il controllo della risposta deve essere chiave=valore, come errcode=0 o ok=true (il valore un numero intero o lettere minuscole, al massimo 16)"

msgid "Invalid header (one \"Name: value\" per line; Host, Content-Type, Content-Length, Transfer-Encoding and Connection are set by the device)"
msgstr "Intestazione non valida (un \"Nome: valore\" per riga; Host, Content-Type, Content-Length, Transfer-Encoding e Connection li imposta il dispositivo)"

msgid "Invalid Telegram bot token"
msgstr "Token del bot Telegram non valido"

msgid "Invalid Telegram chat (a number, or @channel)"
msgstr "Chat Telegram non valida (un numero o @canale)"

msgid "Invalid e-mail setting"
msgstr "Impostazione e-mail non valida"

msgid "The webhook needs an address"
msgstr "Il webhook richiede un indirizzo"

msgid "Telegram needs a bot token and a chat"
msgstr "Telegram richiede un token del bot e una chat"

msgid "E-mail needs a server, a sender and a recipient"
msgstr "L'e-mail richiede un server, un mittente e un destinatario"

msgid "SMS forwarding needs a phone number"
msgstr "L'inoltro via SMS richiede un numero di telefono"

msgid "The forwarding settings could not be saved"
msgstr "Impossibile salvare le impostazioni di inoltro"

msgid "SMS forwarding is not installed"
msgstr "L'inoltro SMS non è installato"

msgid "A test was started a moment ago; wait a few seconds"
msgstr "Un test è appena stato avviato; attendere qualche secondo"

msgid "The delivery log could not be cleared"
msgstr "Impossibile svuotare il registro degli invii"

msgid "Unknown forwarding operation"
msgstr "Operazione di inoltro sconosciuta"

msgid "The language pack is not installed"
msgstr "Il pacchetto lingue non è installato"

msgid "No language given"
msgstr "Nessuna lingua indicata"

msgid "The language could not be changed"
msgstr "Impossibile cambiare la lingua"

msgid "LuCI does not offer this language"
msgstr "LuCI non offre questa lingua"

msgid "No uploaded language pack"
msgstr "Nessun pacchetto lingue caricato"

msgid "An installation is already running"
msgstr "Un'installazione è già in corso"

msgid "The language pack could not be removed"
msgstr "Impossibile rimuovere il pacchetto lingue"

msgid "Lock cache unavailable"
msgstr "Cache dei blocchi non disponibile"

msgid "The modem refused a write"
msgstr "Il modem ha rifiutato una scrittura"

msgid "The saved locks could not be cleared"
msgstr "Non è stato possibile cancellare i blocchi salvati"

msgid "No serving cell to lock to"
msgstr "Nessuna cella di servizio da bloccare"

msgid "The modem did not answer the mode query; nothing was sent"
msgstr "Il modem non ha risposto alla richiesta della modalità; non è stato inviato nulla"

msgid "The read-back does not match the automatic values"
msgstr "La rilettura non corrisponde ai valori automatici"

msgid "The read-back after the stack restart does not match the automatic values"
msgstr "La rilettura dopo il riavvio dello stack non corrisponde ai valori automatici"

msgid "The reset was interrupted"
msgstr "Il ripristino è stato interrotto"

msgid "Reinstalling packages is not available on this system"
msgstr "La reinstallazione dei pacchetti non è disponibile su questo sistema"

msgid "No packages were written down by an update"
msgstr "Nessun aggiornamento ha annotato pacchetti"

msgid "Reinstalling is running already"
msgstr "La reinstallazione è già in corso"

msgid "The note could not be dropped"
msgstr "Impossibile rimuovere l'avviso"

msgid "Unknown packages operation"
msgstr "Operazione sui pacchetti sconosciuta"

msgid "usage: power get|set KEY VALUE|wake|idle"
msgstr "usage: power get|set KEY VALUE|wake|idle"

msgid "Data usage is not available on this system"
msgstr "Il consumo dati non è disponibile su questo sistema"

msgid "Unknown data usage operation"
msgstr "Operazione del consumo dati sconosciuta"

msgid "The TTL setting could not be read"
msgstr "Impossibile leggere l'impostazione del TTL"

msgid "The TTL could not be set"
msgstr "Impossibile impostare il TTL"

msgid "Unknown TTL operation"
msgstr "Operazione TTL sconosciuta"

msgid "An update task is already running"
msgstr "Un'attività di aggiornamento è già in esecuzione"

msgid "The task could not be started"
msgstr "Impossibile avviare l'attività"

msgid "The updater gave no valid reply"
msgstr "Il programma di aggiornamento non ha dato una risposta valida"

msgid "This needs confirmation"
msgstr "È necessaria una conferma"

msgid "Check for updates first"
msgstr "Controllare prima gli aggiornamenti"

msgid "The upload directory is not safe; nothing was changed"
msgstr "La directory di caricamento non è sicura; nulla è stato modificato"

msgid "Not enough memory for this upload"
msgstr "Memoria insufficiente per questo caricamento"

msgid "Not enough free space on the Linux partition"
msgstr "Spazio libero insufficiente sulla partizione Linux"

msgid "The file was not checked; upload it again"
msgstr "Il file non è stato controllato; caricarlo di nuovo"

msgid "This file is not for this device"
msgstr "Questo file non è per questo dispositivo"

msgid "The signature of this file is wrong"
msgstr "La firma di questo file è errata"

msgid "This file is not signed: that needs confirmation"
msgstr "Questo file non è firmato: è necessaria una conferma"

msgid "This file is older than what is installed: that needs confirmation"
msgstr "Questo file è più vecchio di quanto installato: è necessaria una conferma"

msgid "The release source was not changed"
msgstr "La sorgente di rilascio non è stata cambiata"
