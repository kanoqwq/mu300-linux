msgstr "알 수 없는 업데이트 작업입니다"

msgid "Invalid update request"
msgstr "잘못된 업데이트 요청입니다"

msgid "The backup tool gave no valid reply"
msgstr "백업 도구가 올바른 응답을 주지 않았습니다"

msgid "Mobile data integration is not provided by this platform"
msgstr "이 플랫폼에서는 모바일 데이터 통합을 제공하지 않습니다"

msgid "The SIM settings could not be read"
msgstr "SIM 설정을 읽을 수 없습니다"

msgid "Radio control is not provided by this platform"
msgstr "이 플랫폼은 무선 제어를 제공하지 않습니다"

msgid "A SIM radio change is already running"
msgstr "SIM 무선 변경이 이미 진행 중입니다"

# Source-language fallback for untranslated new controls.
msgid "Invalid SIM setting"
msgstr "Invalid SIM setting"

msgid "The modem did not take the setting; nothing was saved"
msgstr "모뎀이 설정을 받아들이지 않았습니다. 아무것도 저장되지 않았습니다"

# Source-language fallback for untranslated new controls.
msgid "SIM control failed"
msgstr "SIM control failed"

# Source-language fallback for untranslated new controls.
msgid "Enable hot switching; reboot if channels are unavailable or wait until idle"
msgstr "Enable hot switching; reboot if channels are unavailable or wait until idle"

msgid "Request too large"
msgstr "요청이 너무 큽니다"

msgid "The runtime directory is not safe; nothing was run"
msgstr "런타임 디렉터리가 안전하지 않아 아무것도 실행하지 않았습니다"

msgid "No such method"
msgstr "해당 메서드가 없습니다"

msgid "The VPN module refused the request"
msgstr "VPN 모듈이 요청을 거부했습니다"

msgid "The VPN panel is busy, try again"
msgstr "VPN 패널이 사용 중입니다. 다시 시도하세요"

msgid "Another VPN task is still running"
