msgstr "이 설정에 잘못된 값입니다"

msgid "The forwarding adapter gave no valid reply"
msgstr "전달 어댑터가 올바른 응답을 주지 않았습니다"

msgid "The CPU adapter gave no valid reply"
msgstr "The CPU adapter gave no valid reply"

msgid "Invalid CPU profile"
msgstr "Invalid CPU profile"

msgid "Invalid CPU core"
msgstr "잘못된 CPU 코어"

msgid "Unknown CPU operation"
msgstr "Unknown CPU operation"

msgid "Unknown CPU voltage operation"
msgstr "알 수 없는 CPU 전압 작업"

msgid "Invalid CPU voltage request"
msgstr "잘못된 CPU 전압 요청"

msgid "Invalid CPU voltage offset"
msgstr "잘못된 CPU 전압 오프셋"

