msgid "The latency is a TCP connection to the server, through the tunnel when the VPN is up. WireGuard and OpenVPN servers usually speak UDP and cannot be tested this way."
msgstr "Латентността е TCP връзка към сървъра, през тунела, когато VPN работи. Сървърите на WireGuard и OpenVPN обикновено използват UDP и не могат да се тестват така."

msgid "Enter an IPv4 or IPv6 address"
msgstr "Въведете IPv4 или IPv6 адрес"

msgid "On: nothing leaves outside the tunnel"
msgstr "Включено: нищо не излиза извън тунела"

msgid "Off: traffic goes out directly while the tunnel is down"
msgstr "Изключено: трафикът излиза директно, докато тунелът не работи"

msgid "Yes: Tailscale's own connections go through the tunnel"
msgstr "Да: собствените връзки на Tailscale минават през тунела"

msgid "No: Tailscale connects directly"
msgstr "Не: Tailscale се свързва директно"

msgid "Routing"
msgstr "Маршрутизиране"

msgid "The kill switch blocks all traffic of the device and of the LAN while the VPN is down."
msgstr "Kill switch блокира целия трафик на устройството и на LAN, докато VPN е спрян."

msgid "Bypass the tunnel"
msgstr "Заобикаляне на тунела"

