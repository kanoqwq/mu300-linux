msgid "No uploaded language pack"
msgstr "Nincs feltöltött nyelvi csomag"

msgid "An installation is already running"
msgstr "Egy telepítés már folyamatban van"

msgid "The language pack could not be removed"
msgstr "A nyelvi csomagot nem sikerült eltávolítani"

msgid "Lock cache unavailable"
msgstr "A zárolási gyorsítótár nem érhető el"

msgid "The modem refused a write"
msgstr "A modem elutasított egy írást"

msgid "The saved locks could not be cleared"
msgstr "A mentett zárolásokat nem sikerült törölni"

msgid "No serving cell to lock to"
msgstr "Nincs kiszolgáló cella a zároláshoz"

msgid "The modem did not answer the mode query; nothing was sent"
msgstr "A modem nem válaszolt a mód lekérdezésére; semmi nem lett elküldve"

msgid "The read-back does not match the automatic values"
msgstr "A visszaolvasás nem egyezik az automatikus értékekkel"

msgid "The read-back after the stack restart does not match the automatic values"
msgstr "A verem újraindítása utáni visszaolvasás nem egyezik az automatikus értékekkel"

msgid "The reset was interrupted"
msgstr "A visszaállítás megszakadt"

msgid "Reinstalling packages is not available on this system"
msgstr "A csomagok újratelepítése nem érhető el ezen a rendszeren"

msgid "No packages were written down by an update"
msgstr "Egy frissítés sem jegyzett fel csomagot"

msgid "Reinstalling is running already"
msgstr "Az újratelepítés már fut"

msgid "The note could not be dropped"
msgstr "Az értesítést nem sikerült eltávolítani"

msgid "Unknown packages operation"
msgstr "Ismeretlen csomagművelet"

msgid "usage: power get|set KEY VALUE|wake|idle"
msgstr "usage: power get|set KEY VALUE|wake|idle"

msgid "Data usage is not available on this system"
msgstr "Az adatforgalom ezen a rendszeren nem érhető el"

msgid "Unknown data usage operation"
msgstr "Ismeretlen adatforgalom-művelet"

msgid "The TTL setting could not be read"
msgstr "A TTL-beállítás nem olvasható"

msgid "The TTL could not be set"
msgstr "A TTL nem állítható be"

msgid "Unknown TTL operation"
msgstr "Ismeretlen TTL-művelet"

msgid "An update task is already running"
msgstr "Már fut egy frissítési feladat"

msgid "The task could not be started"
msgstr "A feladatot nem sikerült elindítani"

msgid "The updater gave no valid reply"
msgstr "A frissítőprogram nem adott érvényes választ"

msgid "This needs confirmation"
msgstr "Ehhez megerősítés szükséges"

msgid "Check for updates first"
msgstr "Előbb keressen frissítéseket"

msgid "The upload directory is not safe; nothing was changed"
msgstr "A feltöltési könyvtár nem biztonságos; semmi sem változott"

msgid "Not enough memory for this upload"
msgstr "Nincs elég memória ehhez a feltöltéshez"

msgid "Not enough free space on the Linux partition"
msgstr "Nincs elég szabad hely a Linux-partíción"

msgid "The file was not checked; upload it again"
msgstr "A fájl nem lett ellenőrizve; töltse fel újra"

msgid "This file is not for this device"
msgstr "Ez a fájl nem ehhez az eszközhöz való"

msgid "The signature of this file is wrong"
msgstr "A fájl aláírása hibás"

msgid "This file is not signed: that needs confirmation"
msgstr "Ez a fájl nincs aláírva: ehhez megerősítés szükséges"

msgid "This file is older than what is installed: that needs confirmation"
msgstr "Ez a fájl régebbi a telepítettnél: ehhez megerősítés szükséges"

msgid "The release source was not changed"
msgstr "A kiadás forrása nem változott"
