msgstr "保留設定檔"

msgid "Delete with its profiles"
msgstr "連同設定檔一起刪除"

msgid "Only by hand"
msgstr "僅手動"

msgid "Every %d h"
msgstr "每 %d 小時"

msgid "Share links: one profile per link"
msgstr "分享連結：每個連結一個設定檔"

