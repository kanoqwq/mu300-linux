msgstr "· správ: %d, neprečítaných: %d · konverzácií: %d"

msgid "· %d messages · %d conversations"
msgstr "· správ: %d · konverzácií: %d"

msgid "The pool is empty. Incoming and sent messages appear here, or select “Sync from SIM”."
msgstr "Zásobník je prázdny. Zobrazia sa tu prichádzajúce a odoslané správy, alebo zvoľte „Synchronizovať zo SIM“."

