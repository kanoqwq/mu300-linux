msgstr "engine %s"

msgid "interface %s"
msgstr "rozhranie %s"

msgid "Kill switch active"
msgstr "Kill switch je aktívny"

msgid "Kill switch on"
msgstr "Kill switch zapnutý"

msgid "Kill switch off"
msgstr "Kill switch vypnutý"

msgid "IPv6 in the tunnel"
msgstr "IPv6 v tuneli"

msgid "IPv6 blocked"
msgstr "IPv6 blokované"

msgid "IPv6 untouched"
msgstr "IPv6 nezmenené"

msgid "Module %s"
msgstr "Modul %s"

