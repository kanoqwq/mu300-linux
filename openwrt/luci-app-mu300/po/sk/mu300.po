msgstr "Engine aktívneho profilu nie je nainštalovaný: %s"

msgid "The kill switch keeps everything closed until it is there; the service downloads it by itself when it can."
msgstr "Kill switch drží všetko zatvorené, kým tam nebude; služba si ho stiahne sama, keď to bude možné."

msgid "The VPN cannot start until it is installed."
msgstr "VPN sa nemôže spustiť, kým nie je nainštalovaný."

msgid "%s cannot run on this system"
msgstr "%s tu nemôže bežať"

msgid "The VPN is on, but no profile is active: choose one below."
msgstr "VPN je zapnutá, ale nie je aktívny žiadny profil: vyberte nižšie jeden."

msgid "Profile: %s"
msgstr "Profil: %s"

msgid "No active profile"
msgstr "Žiadny aktívny profil"

