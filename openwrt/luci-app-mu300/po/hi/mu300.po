msgstr "संदेश बहुत लंबा है (480 अक्षरों से अधिक)"

msgid "The message contains a control character"
msgstr "संदेश में एक नियंत्रण वर्ण है"

msgid "The sim parameter must be 0 or 1"
msgstr "sim पैरामीटर 0 या 1 होना चाहिए"

