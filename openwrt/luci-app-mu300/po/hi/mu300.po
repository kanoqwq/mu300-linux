msgstr "पहचानें"

msgid "The URL may hold a token: it goes to the device on its own, never into a command line or a log."
msgstr "URL में टोकन हो सकता है: वह डिवाइस को अलग से भेजा जाता है, कभी कमांड लाइन या लॉग में नहीं जाता।"

msgid "Share link"
msgstr "शेयर लिंक"

msgid "Paste"
msgstr "चिपकाएँ"

msgid "File"
msgstr "फ़ाइल"

msgid "URL"
msgstr "URL"

