msgstr "यह इस पैनल द्वारा स्वीकार किया जाने वाला शेयर लिंक नहीं है"

msgid "The config is empty"
msgstr "कॉन्फ़िग खाली है"

msgid "Not an https URL"
msgstr "यह https URL नहीं है"

msgid "Invalid name: 1-64 characters, no control characters"
msgstr "अमान्य नाम: 1-64 अक्षर, कोई कंट्रोल कैरेक्टर नहीं"

