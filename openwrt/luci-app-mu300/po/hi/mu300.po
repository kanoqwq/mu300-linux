msgstr "Kill switch चालू"

msgid "Kill switch off"
msgstr "Kill switch बंद"

msgid "IPv6 in the tunnel"
msgstr "टनल में IPv6"

msgid "IPv6 blocked"
msgstr "IPv6 ब्लॉक"

msgid "IPv6 untouched"
msgstr "IPv6 अछूता"

msgid "Module %s"
msgstr "मॉड्यूल %s"

