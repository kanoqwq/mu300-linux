msgstr "केवल स्थानीय फ़ाइलें हटाई जाएँगी; SIM पर संदेश बने रहेंगे।"

msgid "Delete this SMS"
msgstr "यह SMS हटाएँ"

msgid "Deletion cannot be undone."
msgstr "हटाने को पूर्ववत नहीं किया जा सकता।"

msgid "Local only"
msgstr "केवल स्थानीय"

msgid "Local + SIM"
msgstr "स्थानीय + SIM"

msgid "Delete failed"
