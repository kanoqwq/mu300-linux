msgstr "صفحة غير صالحة"

msgid "mu300-sms is not available (the SMS service is not installed or not running)"
msgstr "mu300-sms غير متاح (خدمة SMS غير مثبتة أو لا تعمل)"

msgid "No output"
msgstr "لا مخرجات"

msgid "Bad ID"
msgstr "معرّف غير صالح"

msgid "Read failed"
msgstr "فشلت القراءة"

msgid "The number may only contain digits (and a leading +)"
msgstr "يجب أن يحتوي الرقم على أرقام فقط (مع + اختيارية في البداية)"

msgid "The message is empty"
msgstr "الرسالة فارغة"

msgid "The message is too long (over 480 characters)"
msgstr "الرسالة طويلة جداً (أكثر من 480 محرفاً)"

msgid "The message contains a control character"
