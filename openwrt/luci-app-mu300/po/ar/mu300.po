msgstr "يتوفر تحديث"

msgid "installed"
msgstr "مثبت"

msgid "Kind"
msgstr "النوع"

msgid "Version"
msgstr "الإصدار"

msgid "Available"
msgstr "المتاح"

msgid "not checked"
msgstr "لم يُتحقق"

msgid "Size"
msgstr "الحجم"

