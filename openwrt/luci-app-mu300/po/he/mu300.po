msgstr "התצורה מכילה את פרטי הגישה של הפרופיל (מפתחות, סיסמאות, UUID). היא מוצגת במסך זה בלבד; כל מי שרואה את המסך יכול לקרוא אותה."

msgid "Saving checks the config with the engine first (profile edit); a config that does not pass is not saved and the old one stays."
msgstr "השמירה בודקת תחילה את התצורה מול המנוע (profile edit); תצורה שאינה עוברת את הבדיקה לא נשמרת והישנה נשארת."

msgid "This profile comes from a subscription: its next refresh replaces your changes."
msgstr "פרופיל זה מגיע ממנוי: הרענון הבא שלו יחליף את השינויים שלכם."

msgid "Config of %s"
msgstr "תצורת %s"

msgid "Rename"
msgstr "שינוי שם"

msgid "Show / edit the config"
msgstr "הצגה / עריכה של התצורה"

msgid "Test the latency of all"
msgstr "בדיקת זמן ההשהיה של כולם"

msgid "No profiles yet: add one from a share link, a config file or a subscription."
msgstr "עדיין אין פרופילים: הוסיפו אחד מקישור שיתוף, מקובץ תצורה או ממנוי."

msgid "Active"
msgstr "פעיל"

msgid "This profile is the active one now"
msgstr "פרופיל זה הוא כעת הפעיל"

msgid "More"
msgstr "עוד"

msgid "active"
msgstr "פעיל"

msgid "subscription"
msgstr "מנוי"

