msgstr "保存されたロックを消去できませんでした"

msgid "No serving cell to lock to"
msgstr "ロックできるサービングセルがありません"

msgid "The modem did not answer the mode query; nothing was sent"
msgstr "モデムがモード照会に応答しませんでした。何も送信されていません"

msgid "The read-back does not match the automatic values"
msgstr "読み戻し値が自動の値と一致しません"

msgid "The read-back after the stack restart does not match the automatic values"
msgstr "スタック再起動後の読み戻し値が自動の値と一致しません"

msgid "The reset was interrupted"
msgstr "リセットが中断されました"

msgid "Reinstalling packages is not available on this system"
msgstr "このシステムではパッケージの再インストールを利用できません"

msgid "No packages were written down by an update"
msgstr "アップデートで記録されたパッケージはありません"

msgid "Reinstalling is running already"
msgstr "再インストールはすでに実行中です"

msgid "The note could not be dropped"
msgstr "通知を削除できませんでした"

msgid "Unknown packages operation"
msgstr "不明なパッケージ操作"

msgid "usage: power get|set KEY VALUE|wake|idle"
msgstr "usage: power get|set KEY VALUE|wake|idle"

msgid "Data usage is not available on this system"
msgstr "このシステムではデータ使用量を利用できません"

msgid "Unknown data usage operation"
msgstr "不明なデータ使用量の操作"

msgid "The TTL setting could not be read"
msgstr "TTL 設定を読み取れませんでした"

msgid "The TTL could not be set"
msgstr "TTL を設定できませんでした"

msgid "Unknown TTL operation"
msgstr "不明な TTL 操作"

msgid "An update task is already running"
msgstr "更新タスクがすでに実行中です"

msgid "The task could not be started"
msgstr "タスクを開始できませんでした"

msgid "The updater gave no valid reply"
msgstr "アップデーターから有効な応答がありませんでした"

msgid "This needs confirmation"
msgstr "この操作には確認が必要です"

msgid "Check for updates first"
msgstr "先に更新を確認してください"

msgid "The upload directory is not safe; nothing was changed"
msgstr "アップロード先のディレクトリが安全ではありません。何も変更していません"

msgid "Not enough memory for this upload"
msgstr "このアップロードに必要なメモリが足りません"

msgid "Not enough free space on the Linux partition"
msgstr "Linux パーティションの空き容量が足りません"

msgid "The file was not checked; upload it again"
msgstr "ファイルが確認されていません。もう一度アップロードしてください"

msgid "This file is not for this device"
msgstr "このファイルはこのデバイス用ではありません"

msgid "The signature of this file is wrong"
msgstr "このファイルの署名が正しくありません"

msgid "This file is not signed: that needs confirmation"
msgstr "このファイルは署名なしです: 確認が必要です"

msgid "This file is older than what is installed: that needs confirmation"
msgstr "このファイルはインストール済みのものより古いです: 確認が必要です"

msgid "The release source was not changed"
msgstr "リリース元は変更されませんでした"
