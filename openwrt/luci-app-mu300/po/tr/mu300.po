msgstr "Dosyadan güncelle"

msgid "Back to the previous version"
msgstr "Önceki sürüme dön"

msgid "Back to the previous boot image"
msgstr "Önceki önyükleme imajına dön"

msgid "Remove the previous version"
msgstr "Önceki sürümü kaldır"

msgid "Kernel change"
msgstr "Çekirdek değişikliği"

msgid "Starting…"
msgstr "Başlatılıyor…"

msgid "Downloading"
msgstr "İndiriliyor"

msgid "All files are here and verified"
msgstr "Tüm dosyalar indirildi ve doğrulandı"

msgid "Unpacking the new system"
msgstr "Yeni sistem açılıyor"

