msgstr "Arka planda %d sn"

msgid "(no output)"
msgstr "(çıktı yok)"

msgid "This command changes the modem's state."
msgstr "Bu komut modemin durumunu değiştirir."

msgid "Not sent yet: waiting for confirmation"
msgstr "Henüz gönderilmedi: onay bekleniyor"

msgid "Send this AT command?"
msgstr "Bu AT komutu gönderilsin mi?"

msgid "Send anyway"
msgstr "Yine de gönder"

