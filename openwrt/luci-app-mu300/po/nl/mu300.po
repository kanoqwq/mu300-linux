msgstr "Toepassen"

msgid "Switching USB role…"
msgstr "USB-rol wordt gewisseld…"

msgid "Switch failed: %s"
msgstr "Wisselen mislukt: %s"

msgid "Management connection lost; reconnect to confirm the USB role."
msgstr "Beheerverbinding verloren; maak opnieuw verbinding om de USB-rol te bevestigen."

msgid "Switch request accepted; the USB connection may briefly disconnect."
msgstr "Wisselverzoek geaccepteerd; de USB-verbinding kan kort wegvallen."

msgid "USB role applied"
