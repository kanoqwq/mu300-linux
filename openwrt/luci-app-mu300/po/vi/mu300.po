msgstr "công cụ %s"

msgid "interface %s"
msgstr "giao diện %s"

msgid "Kill switch active"
msgstr "Kill switch đang hoạt động"

msgid "Kill switch on"
msgstr "Kill switch bật"

msgid "Kill switch off"
msgstr "Kill switch tắt"

msgid "IPv6 in the tunnel"
msgstr "IPv6 trong đường hầm"

msgid "IPv6 blocked"
msgstr "IPv6 bị chặn"

msgid "IPv6 untouched"
msgstr "IPv6 không can thiệp"

msgid "Module %s"
msgstr "Mô-đun %s"

msgid "Check"
msgstr "Kiểm tra"

msgid "Uptime"
msgstr "Thời gian chạy"

msgid "Rate"
msgstr "Tốc độ"

msgid "Exit address"
msgstr "Địa chỉ thoát"

msgid "Start"
msgstr "Khởi động"

msgid "Stop"
msgstr "Dừng"

