msgid "The engine of the active profile is not installed: %s"
msgstr "Công cụ của hồ sơ đang dùng chưa được cài đặt: %s"

msgid "The kill switch keeps everything closed until it is there; the service downloads it by itself when it can."
msgstr "Kill switch giữ mọi thứ bị chặn cho đến khi có nó; dịch vụ tự tải xuống khi có thể."

msgid "The VPN cannot start until it is installed."
msgstr "VPN không thể khởi động cho đến khi nó được cài đặt."

msgid "%s cannot run on this system"
msgstr "%s không thể chạy trên hệ thống này"

msgid "The VPN is on, but no profile is active: choose one below."
msgstr "VPN đang bật nhưng không có hồ sơ nào đang dùng: hãy chọn một hồ sơ bên dưới."

msgid "Profile: %s"
msgstr "Hồ sơ: %s"

