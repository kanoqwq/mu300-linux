msgstr "Với 64, mọi gói tin đi ra giống như lưu lượng của chính thiết bị"

msgid "Check for updates"
msgstr "Kiểm tra bản cập nhật"

msgid "Checking the file"
msgstr "Đang kiểm tra tệp"

msgid "Update from a file"
msgstr "Cập nhật từ tệp"

msgid "Back to the previous version"
msgstr "Quay lại phiên bản trước"

msgid "Back to the previous boot image"
msgstr "Quay lại ảnh khởi động trước"

msgid "Remove the previous version"
msgstr "Gỡ phiên bản trước"

msgid "Kernel change"
msgstr "Đổi nhân"

msgid "Starting…"
msgstr "Đang bắt đầu…"

msgid "Downloading"
msgstr "Đang tải xuống"

msgid "All files are here and verified"
msgstr "Đã có đủ tệp và đã xác minh"

msgid "Unpacking the new system"
msgstr "Đang giải nén hệ thống mới"

msgid "Carrying over your settings"
msgstr "Đang chuyển cài đặt của bạn sang"

msgid "Writing down the packages you installed"
msgstr "Đang ghi lại các gói bạn đã cài"

msgid "Switching to the new system"
msgstr "Đang chuyển sang hệ thống mới"

msgid "Kernel and boot image"
msgstr "Nhân và ảnh khởi động"

msgid "Restart the device?"
msgstr "Khởi động lại thiết bị?"

msgid "The device restarts now. The default boot is Android, so it starts Android: switch to Linux from there to start the updated system."
msgstr "Thiết bị sẽ khởi động lại ngay. Khởi động mặc định là Android nên thiết bị vào Android: hãy chuyển sang Linux từ đó để chạy hệ thống đã cập nhật."

msgid "The device restarts now and is away for about a minute. If the new system does not start, the device goes back to Android by itself after the failed attempts."
msgstr "Thiết bị sẽ khởi động lại ngay và không truy cập được trong khoảng một phút. Nếu hệ thống mới không khởi động được, thiết bị tự quay về Android sau các lần thử thất bại."

msgid "Restarting… open this page again in about a minute."
msgstr "Đang khởi động lại… hãy mở lại trang này sau khoảng một phút."

msgid "Running for %s. It goes on when this page is closed; do not switch the device off."
msgstr "Đã chạy được %s. Việc này vẫn tiếp tục khi đóng trang; đừng tắt thiết bị."

msgid "Done. Restart the device to start it."
msgstr "Xong. Khởi động lại thiết bị để chạy."

msgid "Done. Nothing needs a restart."
msgstr "Xong. Không cần khởi động lại."

msgid "It did not finish, and part of it was done: read the log before you restart."
msgstr "Chưa hoàn tất và đã làm được một phần: hãy đọc nhật ký trước khi khởi động lại."

msgid "It did not finish. Nothing was changed; the log says why."
msgstr "Chưa hoàn tất. Không có gì bị thay đổi; nhật ký cho biết lý do."

msgid "Log"
msgstr "Nhật ký"

msgid "Restart now"
msgstr "Khởi động lại ngay"

msgid "Later"
msgstr "Để sau"

msgid "Close"
msgstr "Đóng"

msgid "Updating is not available on this system"
msgstr "Hệ thống này không hỗ trợ cập nhật"

msgid "Another update is running on the device"
msgstr "Một bản cập nhật khác đang chạy trên thiết bị"

msgid "It was started outside this page (a terminal, the toolkit). Nothing can be started here until it has finished."
msgstr "Việc này được bắt đầu từ bên ngoài trang (terminal, bộ công cụ). Không thể bắt đầu việc gì ở đây cho đến khi nó xong."

msgid "Restart needed"
msgstr "Cần khởi động lại"

msgid "This system was updated and still runs the old version. The new one starts at the next restart."
msgstr "Hệ thống này đã được cập nhật nhưng vẫn đang chạy phiên bản cũ. Phiên bản mới sẽ chạy ở lần khởi động lại tiếp theo."

msgid "Installed"
msgstr "Đã cài đặt"

msgid "This system"
msgstr "Hệ thống này"

msgid "Also on this device"
msgstr "Cũng có trên thiết bị này"

msgid "Kernel"
msgstr "Nhân"

msgid "choice %s"
msgstr "lựa chọn %s"

msgid "Boot image"
msgstr "Ảnh khởi động"

msgid "from the installer"
msgstr "từ trình cài đặt"

msgid "Default boot"
msgstr "Khởi động mặc định"

msgid "Free space"
msgstr "Dung lượng trống"

msgid "Release signatures"
msgstr "Chữ ký bản phát hành"

msgid "checked with the project's key"
msgstr "được kiểm tra bằng khóa của dự án"

msgid "this system has no release key"
msgstr "hệ thống này không có khóa phát hành"

msgid "The default boot is Android: a restart goes to Android, and Linux is started from there."
msgstr "Khởi động mặc định là Android: khởi động lại sẽ vào Android, và Linux được chạy từ đó."

msgid "Linux is locked as the default boot: a failed start does not send the device to Android by itself, except the first starts of a new boot image."
msgstr "Linux được khóa làm khởi động mặc định: một lần khởi động thất bại không tự đưa thiết bị về Android, trừ những lần khởi động đầu của ảnh khởi động mới."

msgid "If Linux fails to start %d times in a row, the device starts Android by itself."
msgstr "Nếu Linux khởi động thất bại %d lần liên tiếp, thiết bị sẽ tự khởi động Android."

msgid "Report of the last update"
msgstr "Báo cáo của lần cập nhật gần nhất"

msgid "Online update"
msgstr "Cập nhật trực tuyến"

msgid "Asking GitHub…"
msgstr "Đang hỏi GitHub…"

msgid "Checked %s ago"
msgstr "Đã kiểm tra %s trước"

msgid "Not checked yet"
msgstr "Chưa kiểm tra"

msgid "Mirror (release files)"
msgstr "Bản sao (tệp bản phát hành)"

msgid "Leave empty for GitHub."
msgstr "Để trống để dùng GitHub."

msgid "Install the packages I added again after the update (needs the device online at the first start)"
msgstr "Cài lại các gói tôi đã thêm sau khi cập nhật (thiết bị cần trực tuyến ở lần khởi động đầu tiên)"

msgid "Pre-release"
msgstr "Bản tiền phát hành"

msgid "Newest release"
msgstr "Bản phát hành mới nhất"

msgid "Release notes"
msgstr "Ghi chú phát hành"

msgid "Download"
msgstr "Tải xuống"

msgid "Free space needed"
msgstr "Dung lượng trống cần có"

msgid "not enough: remove the previous version first"
msgstr "không đủ: hãy gỡ phiên bản trước đã"

msgid "A pre-release is a release still being tried: it can have faults a release does not. The previous version is kept all the same."
msgstr "Bản tiền phát hành là bản phát hành còn đang được thử: nó có thể có lỗi mà bản phát hành không có. Phiên bản trước vẫn được giữ lại như thường."

msgid "This system is newer than the newest release (a test release)."
msgstr "Hệ thống này mới hơn bản phát hành mới nhất (một bản thử nghiệm)."

msgid "Up to date."
msgstr "Đã là mới nhất."

msgid "This release is not signed, and this system checks signatures: it is not installed from here. Update from its file below, which asks you to confirm."
msgstr "Bản phát hành này chưa được ký, và hệ thống này kiểm tra chữ ký: nó không được cài từ đây. Hãy cập nhật từ tệp của nó bên dưới, nơi sẽ yêu cầu bạn xác nhận."

msgid "Update to %s"
msgstr "Cập nhật lên %s"

msgid "Choose at least one system"
msgstr "Hãy chọn ít nhất một hệ thống"

msgid "Update to %s?"
msgstr "Cập nhật lên %s?"

msgid "The device downloads %s, puts the new system beside the running one and switches to it at the next restart. Your settings are carried over and the previous version is kept. It takes several minutes; do not switch the device off."
msgstr "Thiết bị tải xuống %s, đặt hệ thống mới bên cạnh hệ thống đang chạy và chuyển sang nó ở lần khởi động lại tiếp theo. Cài đặt của bạn được chuyển sang và phiên bản trước được giữ lại. Việc này mất vài phút; đừng tắt thiết bị."

msgid "Also offer the pre-release %s"
msgstr "Hiển thị cả bản tiền phát hành %s"

msgid "Systems to update:"
msgstr "Hệ thống cần cập nhật:"

msgid "GitHub could not be reached: the device has no internet connection, or GitHub did not answer. Without internet, update from a file below."
msgstr "Không kết nối được với GitHub: thiết bị không có kết nối internet hoặc GitHub không phản hồi. Nếu không có internet, hãy cập nhật từ tệp ở bên dưới."

msgid "release"
msgstr "phiên-bản"

msgid "For a device without internet: download the Magisk zip of a release for this system and this kernel on another computer, from the release page on GitHub, and upload it here. For this device that is:"
msgstr "Dành cho thiết bị không có internet: trên một máy tính khác, tải Magisk zip của một bản phát hành dành cho hệ thống này và nhân này từ trang phát hành trên GitHub, rồi tải lên đây. Với thiết bị này, tệp đó là:"

msgid "Uploaded file"
msgstr "Tệp đã tải lên"

msgid "Checking the file…"
msgstr "Đang kiểm tra tệp…"

msgid "It says it is"
msgstr "Tệp tự nhận là"

msgid "kernel %s"
msgstr "nhân %s"

msgid "Signature"
msgstr "Chữ ký"

msgid "signed with the project's release key"
msgstr "được ký bằng khóa phát hành của dự án"

msgid "WRONG: it does not match the project's release key"
msgstr "SAI: không khớp với khóa phát hành của dự án"

msgid "not signed"
msgstr "không có chữ ký"

msgid "cannot be checked on this system"
msgstr "không thể kiểm tra trên hệ thống này"

msgid "Its system is not installed on this device."
msgstr "Hệ thống trong tệp này chưa được cài trên thiết bị."

msgid "It is the other Ubuntu release, not the one installed."
msgstr "Đây là bản phát hành Ubuntu kia, không phải bản đã cài."

msgid "It carries another kernel than this device uses. Take the zip for kernel %s, or change the kernel first."
msgstr "Tệp chứa một nhân khác với nhân thiết bị này đang dùng. Hãy lấy zip dành cho nhân %s, hoặc đổi nhân trước."

msgid "Its kernel does not run on this model."
msgstr "Nhân của tệp không chạy được trên mẫu máy này."

msgid "The file is damaged: its contents do not match their checksums."
msgstr "Tệp bị hỏng: nội dung không khớp với mã kiểm tra."

msgid "Its signature is wrong. This file does not come from the project as it is; it is never installed."
msgstr "Chữ ký của tệp sai. Tệp này không còn nguyên vẹn như dự án phát hành; nó không bao giờ được cài đặt."

msgid "This file cannot be used here."
msgstr "Không thể dùng tệp này ở đây."

msgid "Compare the SHA-256 with the one in SHA256SUMS-magisk on the release page: it is the only proof of where an unsigned file comes from."
msgstr "Hãy so sánh SHA-256 với giá trị trong SHA256SUMS-magisk trên trang phát hành: đó là bằng chứng duy nhất về nguồn gốc của một tệp không có chữ ký."

msgid "This release is installed already; the update would only refresh the boot image."
msgstr "Bản phát hành này đã được cài đặt; việc cập nhật chỉ ghi lại ảnh khởi động."

msgid "I know this file is not signed: nothing proves that it comes from the project. I compared its SHA-256 myself and want it installed."
msgstr "Tôi biết tệp này không có chữ ký: không có gì chứng minh nó đến từ dự án. Tôi đã tự so sánh SHA-256 của nó và muốn cài đặt."

msgid "I know this is %s, older than the installed %s, and want to go back to it."
msgstr "Tôi biết đây là %s, cũ hơn bản %s đã cài, và muốn quay lại bản này."

msgid "This is not a release file of this project: a Magisk zip of a release is expected."
msgstr "Đây không phải tệp phát hành của dự án này: cần một Magisk zip của một bản phát hành."

msgid "Update from this file"
msgstr "Cập nhật từ tệp này"

msgid "Tick the confirmations above first"
msgstr "Hãy đánh dấu các ô xác nhận ở trên trước"

msgid "The device puts the system of this file beside the running one and switches to it at the next restart. Your settings are carried over and the previous version is kept. It takes several minutes; do not switch the device off."
msgstr "Thiết bị đặt hệ thống trong tệp này bên cạnh hệ thống đang chạy và chuyển sang nó ở lần khởi động lại tiếp theo. Cài đặt của bạn được chuyển sang và phiên bản trước được giữ lại. Việc này mất vài phút; đừng tắt thiết bị."

msgid "Check the file"
msgstr "Kiểm tra tệp"

msgid "Remove the file"
msgstr "Gỡ tệp"

msgid "Previous version"
msgstr "Phiên bản trước"

msgid "No previous version is kept on this device."
msgstr "Thiết bị này không giữ phiên bản trước nào."

msgid "replaced %s"
msgstr "bị thay vào %s"

msgid "I want the previous system back; what I changed since the update stays in the version I leave."
msgstr "Tôi muốn lấy lại hệ thống trước; những gì tôi đã thay đổi từ khi cập nhật sẽ ở lại trong phiên bản tôi rời đi."

msgid "Back to the previous version?"
msgstr "Quay lại phiên bản trước?"

msgid "The previous system (%s) becomes the one that starts at the next restart. The version you leave is not kept; settings you changed since the update are not carried back."
msgstr "Hệ thống trước (%s) sẽ là hệ thống chạy ở lần khởi động lại tiếp theo. Phiên bản bạn rời đi không được giữ lại; các cài đặt bạn đã đổi từ khi cập nhật không được mang về."

msgid "Go back"
msgstr "Quay lại"

msgid "The previous version is the one running now: restart first."
msgstr "Phiên bản trước chính là bản đang chạy: hãy khởi động lại trước."

msgid "I want the previous kernel and boot image back."
msgstr "Tôi muốn lấy lại nhân và ảnh khởi động trước."

msgid "Back to the previous boot image?"
msgstr "Quay lại ảnh khởi động trước?"

msgid "The previous boot image (%s) is written to the Linux slot and starts at the next restart. If it does not start, the device goes back to Android by itself."
msgstr "Ảnh khởi động trước (%s) được ghi vào khe Linux và chạy ở lần khởi động lại tiếp theo. Nếu nó không khởi động được, thiết bị tự quay về Android."

msgid "I do not need to go back: delete the previous system to free its space."
msgstr "Tôi không cần quay lại: xóa hệ thống trước để giải phóng dung lượng."

msgid "Remove the previous version?"
msgstr "Gỡ phiên bản trước?"

msgid "The kept copy of the previous system is deleted for good. After that there is no going back to it from this page."
msgstr "Bản sao được giữ lại của hệ thống trước sẽ bị xóa vĩnh viễn. Sau đó không thể quay lại nó từ trang này."

msgid "the vendor kernel"
msgstr "nhân của nhà sản xuất"

msgid "mainline"
msgstr "mainline"

msgid "not with Ubuntu 26.04"
msgstr "không dùng với Ubuntu 26.04"

msgid "Change the kernel"
msgstr "Đổi nhân"

msgid "This kernel is the one in use"
msgstr "Nhân này đang được dùng"

msgid "Change the kernel to %s?"
msgstr "Đổi nhân sang %s?"

msgid "The device downloads that kernel from the newest release and writes a new boot image; it starts at the next restart. The previous boot image is kept, and if the new one does not start the device goes back to Android by itself. The device must be online."
msgstr "Thiết bị tải nhân đó từ bản phát hành mới nhất và ghi một ảnh khởi động mới; nó chạy ở lần khởi động lại tiếp theo. Ảnh khởi động trước được giữ lại, và nếu ảnh mới không khởi động được thì thiết bị tự quay về Android. Thiết bị phải đang trực tuyến."

msgid "Start Android at the next restart"
msgstr "Khởi động Android ở lần khởi động lại tiếp theo"

msgid "Start Android at the next restart?"
msgstr "Khởi động Android ở lần khởi động lại tiếp theo?"

msgid "The next restart, and the ones after it, start Android instead of Linux. Linux is started again from Android (the Magisk module's Action button, or mu300-linux)."
msgstr "Lần khởi động lại tiếp theo và các lần sau đó sẽ vào Android thay vì Linux. Linux được chạy lại từ Android (nút Action của mô-đun Magisk, hoặc mu300-linux)."

msgid "Start Android next"
msgstr "Lần tới khởi động Android"

msgid "What an update keeps"
msgstr "Bản cập nhật giữ lại những gì"

msgid "An update puts the system of the new release in place and carries over what is yours: the settings, the accounts and their passwords, the device's keys and the home directories. Packages you installed yourself are written down and installed again at the first start, once the device is online. The previous version stays on the device until you remove it, so you can go back."
msgstr "Bản cập nhật đặt hệ thống của bản phát hành mới vào chỗ và chuyển sang những gì là của bạn: cài đặt, tài khoản và mật khẩu của chúng, các khóa của thiết bị và các thư mục home. Các gói bạn tự cài được ghi lại và cài lại ở lần khởi động đầu tiên, khi thiết bị trực tuyến. Phiên bản trước nằm lại trên thiết bị cho đến khi bạn gỡ nó, nên bạn có thể quay lại."

msgid "The wiki's Updating page lists exactly what is kept."
msgstr "Trang Cập nhật của wiki liệt kê chính xác những gì được giữ lại."

msgid "Choose a file first"
msgstr "Hãy chọn tệp trước"

msgid "Uploading: %s of %s"
msgstr "Đang tải lên: %s / %s"

msgid "running"
msgstr "đang chạy"

msgid "(about %s)"
msgstr "(khoảng %s)"

msgid "Install %s?"
msgstr "Cài đặt %s?"

msgid "It is installed from this system's package feed."
msgstr "Được cài đặt từ kho gói của hệ thống này."

msgid "It is downloaded from the release of the VPN module and checked against its SHA256SUMS."
msgstr "Được tải xuống từ bản phát hành của mô-đun VPN và kiểm tra theo SHA256SUMS của nó."

msgid "An engine is tens of MB: on mobile data the download counts towards your plan."
msgstr "Một công cụ nặng hàng chục MB: với dữ liệu di động, lượng tải xuống sẽ tính vào gói cước của bạn."

msgid "Install"
msgstr "Cài đặt"

msgid "Remove %s?"
msgstr "Gỡ %s?"

msgid "Profiles run on it: %s. They cannot start until it is installed again (the module refuses while the running profile needs it)."
msgstr "Các hồ sơ đang chạy trên nó: %s. Chúng không thể khởi động cho đến khi được cài đặt lại (mô-đun từ chối khi hồ sơ đang chạy cần nó)."

msgid "No profile runs on it."
msgstr "Không có hồ sơ nào chạy trên nó."

msgid "Removed"
msgstr "Đã gỡ"

msgid "Each engine is an extra of its own: install only the ones your profiles need. Xray runs vless, vmess, trojan and ss links (with hev-socks5-tunnel), sing-box the same links and its own JSON, mihomo Clash subscriptions, dae hysteria2, tuic and the rest on newer kernels. WireGuard and OpenVPN are packages of the system."
msgstr "Mỗi công cụ là một gói bổ sung riêng: chỉ cài những công cụ mà hồ sơ của bạn cần. Xray chạy các liên kết vless, vmess, trojan và ss (với hev-socks5-tunnel), sing-box chạy cùng các liên kết đó và JSON riêng của nó, mihomo chạy gói đăng ký Clash, dae chạy hysteria2, tuic và phần còn lại trên các kernel mới hơn. WireGuard và OpenVPN là các gói của hệ thống."

msgid "Downloads are tens of MB per engine: on mobile data they count towards your plan. Offline, upload the engine's tarball from the release page of the VPN module."
msgstr "Mỗi công cụ tải xuống hàng chục MB: với dữ liệu di động, mức này sẽ tính vào gói cước của bạn. Khi ngoại tuyến, hãy tải lên tệp tarball của công cụ từ trang phát hành của mô-đun VPN."

msgid "The available versions come from the latest release of the VPN module."
msgstr "Các phiên bản khả dụng lấy từ bản phát hành mới nhất của mô-đun VPN."

msgid "system package"
msgstr "gói hệ thống"

msgid "in the vpn bundle"
msgstr "trong gói vpn"

msgid "extra %s"
msgstr "gói bổ sung %s"

msgid "not installed"
msgstr "chưa cài đặt"

msgid "cannot run here"
msgstr "không thể chạy ở đây"

msgid "update available"
msgstr "có bản cập nhật"

msgid "installed"
msgstr "đã cài đặt"

