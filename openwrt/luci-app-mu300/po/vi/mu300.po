msgstr "Hạn mức hằng tháng"

msgid "%s, warning at %d%%"
msgstr "%s, cảnh báo ở %d%%"

msgid "The monthly cap is reached: mobile data was turned off. It comes back on when the next cycle starts."
msgstr "Đã đạt hạn mức hằng tháng: dữ liệu di động đã bị tắt. Nó sẽ bật lại khi chu kỳ tiếp theo bắt đầu."

