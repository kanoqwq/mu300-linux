msgstr "Một tác vụ cập nhật đang chạy"

msgid "The task could not be started"
msgstr "Không thể bắt đầu tác vụ"

msgid "The updater gave no valid reply"
msgstr "Trình cập nhật không trả về phản hồi hợp lệ"

msgid "This needs confirmation"
msgstr "Thao tác này cần xác nhận"

msgid "Check for updates first"
msgstr "Hãy kiểm tra bản cập nhật trước"

msgid "The upload directory is not safe; nothing was changed"
msgstr "Thư mục tải lên không an toàn; không có gì bị thay đổi"

msgid "Not enough memory for this upload"
msgstr "Không đủ bộ nhớ cho lần tải lên này"

msgid "Not enough free space on the Linux partition"
msgstr "Không đủ dung lượng trống trên phân vùng Linux"

msgid "The file was not checked; upload it again"
msgstr "Tệp chưa được kiểm tra; hãy tải lên lại"

msgid "This file is not for this device"
msgstr "Tệp này không dành cho thiết bị này"

msgid "The signature of this file is wrong"
msgstr "Chữ ký của tệp này không đúng"

msgid "This file is not signed: that needs confirmation"
msgstr "Tệp này không có chữ ký: cần xác nhận"

msgid "This file is older than what is installed: that needs confirmation"
msgstr "Tệp này cũ hơn bản đã cài: cần xác nhận"

msgid "The release source was not changed"
msgstr "Nguồn phát hành không được thay đổi"
