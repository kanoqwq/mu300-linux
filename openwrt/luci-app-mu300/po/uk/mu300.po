msgstr "Блокування діапазонів, режиму й соти не підтримується, поки перемикання двох SIM керує радіомодулем"

msgid "Invalid page"
msgstr "Неприпустима сторінка"

msgid "mu300-sms is not available (the SMS service is not installed or not running)"
msgstr "mu300-sms недоступний (службу SMS не встановлено або не запущено)"

msgid "No output"
msgstr "Немає виводу"

msgid "Bad ID"
msgstr "Неправильний ID"

msgid "Read failed"
msgstr "Помилка зчитування"

msgid "The number may only contain digits (and a leading +)"
msgstr "Номер може містити лише цифри (і + на початку)"

