msgstr "Konfiguracja WireGuard lub OpenVPN, YAML Clash/mihomo, JSON Xray lub sing-box, konfiguracja dae"

msgid "After OK, choose the file: a WireGuard .conf, an OpenVPN .ovpn, a Clash/mihomo .yaml, an Xray or sing-box .json or a dae config (at most 1 MiB)."
msgstr "Po OK wybierz plik: WireGuard .conf, OpenVPN .ovpn, Clash/mihomo .yaml, Xray lub sing-box .json albo konfigurację dae (maks. 1 MiB)."

msgid "From the source"
msgstr "Ze źródła"

msgid "Detect"
msgstr "Wykryj"

msgid "The URL may hold a token: it goes to the device on its own, never into a command line or a log."
msgstr "URL może zawierać token: trafia na urządzenie osobno, nigdy do wiersza poleceń ani dziennika."

