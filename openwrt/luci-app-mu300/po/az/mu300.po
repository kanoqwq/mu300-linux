msgstr "Hədlər: %d ilə %d µV arası, %d µV addımlarla."

msgid "Save for the next boot"
msgstr "Növbəti açılış üçün saxla"

msgid "Each offset must be a multiple of %d µV between %d and %d."
msgstr "Hər ofset %d µV-un misli olmalı və %d ilə %d arasında olmalıdır."

msgid "Type %s to confirm."
msgstr "Təsdiqləmək üçün %s yazın."

