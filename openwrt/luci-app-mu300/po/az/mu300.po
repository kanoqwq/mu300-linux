msgstr "Bu cihazın giriş parolunu saxla"

msgid "Take a file of another device model"
msgstr "Başqa cihaz modelinin faylını qəbul et"

msgid "The two passphrases differ"
msgstr "İki parol ifadəsi fərqlidir"

msgid "The passphrase needs 8 characters or more"
msgstr "Parol ifadəsi ən azı 8 simvol olmalıdır"

