msgstr "Ylävirran HTTP-välityspalvelin"

msgid "TLS certificate pin (SHA-256)"
msgstr "TLS-varmenteen kiinnitys (SHA-256)"

msgid "Enter host:port"
msgstr "Anna host:portti"

