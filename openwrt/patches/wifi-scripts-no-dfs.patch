+/* Backport dikeckaan/mu300-linux#432: a 5 GHz ACS list can survive a LuCI
+ * band change. Filter against the selected band's actual wiphy frequencies;
+ * otherwise ACS on 2.4 GHz receives e.g. 36 40 44 48 and cannot start the AP.
+ * Keep valid lists and widths unchanged, including user-supplied ranges. */
+function device_chanlist_band(config) {
+	let list = config.chanlist;
+	if (list == null || !length(phy_capabilities.freqs))
+		return;
+	if (type(list) != 'array')
+		list = [ list ];
+	let chans = {};
+	for (let f in phy_capabilities.freqs) {
+		let chan = f.freq == 2484 ? 14 : f.freq == 5935 ? 2 :
+			f.freq < 2500 ? (f.freq - 2407) / 5 :
+			f.freq < 5950 ? (f.freq - 5000) / 5 : (f.freq - 5950) / 5;
+		chans[chan] = true;
+	}
+	let keep = [], dropped = [];
+	for (let entry in list)
+		for (let item in split(trim(`${entry}`), /[ \t]+/)) {
+			if (item == '')
+				continue;
+			let ends = match(item, /^([1-9][0-9]*)(-([1-9][0-9]*))?$/);
+			if (!ends || !chans[+ends[1]] ||
+			    (ends[3] && (!chans[+ends[3]] || +ends[1] > +ends[3])))
+				push(dropped, item);
+			else
+				push(keep, item);
+		}
+	if (!length(dropped))
+		return;
+	log(`channel list: ${join(' ', dropped)} not on the ${config.band} band or invalid, left out` +
+	    (length(keep) ? '' : '; automatic channel selection uses the whole band'));
+	if (length(keep))
+		config.chanlist = keep;
+	else
+		delete config.chanlist;
+}
+
+/* mu300: an AP on a DFS channel needs radar detection; without it hostapd's start_dfs_cac() fails and the AP never
+ * comes up (the SC2355 driver: mu300-linux docs/FINDINGS.md 40). For such a driver an explicit DFS channel becomes
+ * channel 36, keeping htmode exactly as configured. Never select 149 or narrow the bandwidth.
+ * Keep regulatory restrictions: fail if channel 36 cannot fit that width. "auto" excludes DFS. */
+function device_no_dfs(config) {
+	if (config.band != '5g' || phy_features.radar_detect)
+		return;
+
+	let radar = {}, usable = [], widths = {};
+	for (let f in phy_capabilities.freqs) {
+		let chan = (f.freq - 5000) / 5;
+		if (f.radar)
+			radar[chan] = true;
+		else if (!f.disabled && !f.no_ir) {
+			push(usable, chan);
+			widths[chan] = f;
+		}
+	}
+
+	if (!config.channel) {
+		config.acs_exclude_dfs = true;
+		return;
+	}
+	if (!radar[config.channel])
+		return;
+
+	/* MU300 policy: only change the channel; never assign config.htmode here. */
+	let m = match(config.htmode, /^(HT|VHT|HE|EHT)([0-9]+)$/);
+	let width = m ? +m[2] : (config.htmode == 'NOHT' ? 20 : 0);
+	if (!(width in [ 20, 40, 80, 160 ]))
+		die(`DFS channel ${config.channel}: cannot validate channel 36 with ${config.htmode}; bandwidth left unchanged`);
+	for (let c = 36; c < 36 + width / 5; c += 4) {
+		if (!(c in usable) || (width >= 80 && widths[c].no_80mhz) || (width >= 160 && widths[c].no_160mhz))
+			die(`DFS channel ${config.channel}: channel 36 with ${config.htmode} is not permitted; bandwidth left unchanged`);
+	}
+	log(`channel ${config.channel} is a DFS channel and this driver cannot detect radar: using channel 36, keeping ${config.htmode}`);
+	config.channel = 36;
+}
