+/* mu300: an AP on a DFS channel needs radar detection; without it hostapd's start_dfs_cac() fails and the AP never
+ * comes up (the SC2355 driver: mu300-linux docs/FINDINGS.md 42). For such a driver an explicit DFS channel becomes
+ * 36, else 149, else the first channel the regulatory domain allows without DFS (the width shrinks to what fits),
+ * and "auto" leaves the DFS channels out. */
+function device_no_dfs(config) {
+	if (config.band != '5g' || phy_features.radar_detect)
+		return;
 
+	let radar = {}, usable = [], allowed = [];
+	for (let f in phy_capabilities.freqs) {
+		let chan = (f.freq - 5000) / 5;
+		if (f.radar)
+			radar[chan] = true;
+		else if (!f.disabled) {
+			push(allowed, chan);
+			if (!f.no_ir)
+				push(usable, chan);
+		}
+	}
+	if (!length(usable))
+		usable = allowed;
+
+	if (!config.channel) {
+		config.acs_exclude_dfs = true;
+		return;
+	}
+	if (!radar[config.channel])
+		return;
+
+	let chan = filter([ 36, 149, ...usable ], (c) => c in usable)[0];
+	if (!chan) {
+		log(`channel ${config.channel} is a DFS channel and this driver cannot detect radar; no other 5 GHz channel is allowed`);
+		return;
+	}
+	log(`channel ${config.channel} is a DFS channel and this driver cannot detect radar (start_dfs_cac would fail): using channel ${chan}`);
+	config.channel = chan;
+
+	let m = match(config.htmode, /^(HT|VHT|HE|EHT)([0-9]+)$/);
+	if (!m)
+		return;
+	let width = min(+m[2], 80);
+	let fits = (list) => length(filter(list, (c) => !(c in usable))) == 0;
+	let off = (chan - (chan >= 149 ? 149 : 36)) % 16;
+	if (width == 80 && !fits(map([ 0, 4, 8, 12 ], (o) => chan - off + o)))
+		width = 40;
+	if (width == 40 && !fits(off % 8 < 4 ? [ chan, chan + 4 ] : [ chan - 4, chan ]))
+		width = 20;
+	if (m[1] == 'HT')
+		width = min(width, 40);
+	config.htmode = m[1] + width;
+}
+
 function generate(config) {
