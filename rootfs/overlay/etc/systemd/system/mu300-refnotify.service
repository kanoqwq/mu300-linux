[Unit]
# the modem driver, not its device node: the driver is loaded in the initramfs on both kernels, but the node
# appears later on mainline (+18 s, after sysinit), and a condition checked before that dropped these units
ConditionPathExists=|/sys/module/sprd_modem_loader
ConditionPathExists=|/dev/modem
ConditionPathExists=|/dev/pmsys
Description=MU300 Android vendor daemon refnotify
After=mu300-vendor.service
Requires=mu300-vendor.service

[Service]
# modem_control needs a few seconds to bring the modem up before its helpers can attach
ExecStartPre=/bin/sleep 12
ExecStart=/opt/mu300/bin/android-run refnotify
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
