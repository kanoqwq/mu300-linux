[Unit]
Description=Generate unique SSH host keys on first boot
# no default dependencies: ssh.socket is ordered before sockets.target, which comes before basic.target,
# so a normal service ordered Before=ssh.socket would create an ordering cycle and systemd drops ssh.socket
DefaultDependencies=no
After=local-fs.target
Before=sockets.target ssh.socket ssh.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=sysinit.target
