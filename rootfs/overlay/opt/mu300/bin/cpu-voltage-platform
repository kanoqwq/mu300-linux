#!/bin/sh
# Platform adapter only. The standalone LuCI package owns UI/profile policy.
# Never write firmware partitions or voltage regulators from userspace.
set -eu
module=sprd_cpufreq_v2_driver
ko=/lib/modules/$(uname -r)/sprd-cpufreq-v2-driver.ko
[ -f "$ko" ] || ko=/lib/modules/$(uname -r)/extra/sprd-cpufreq-v2-driver.ko
helper=/usr/libexec/unisoc-modem/cpu-voltage
voltage_parameter() {
    [ -f "$ko" ] && LC_ALL=C grep -aq 'parm=voltage_offset_uv:' "$ko"
}
checker=/opt/mu300/bin/sml-voltage-check
supported() {
    tr '\000' '\n' </sys/firmware/devicetree/base/compatible | grep -qx 'sprd,ums9620' || return 1
    voltage_parameter || return 1
    for slot in a b; do
        part=/dev/disk/by-partlabel/sml_$slot
        [ -b "$part" ] || part=/dev/block/by-name/sml_$slot
        if [ ! -b "$part" ]; then
            # Android-style by-name links are created by vendor startup, later
            # than S08. Resolve already-present kernel partition labels now;
            # never delay CPU/network boot waiting for those optional symlinks.
            set -- $(grep -l "^PARTNAME=sml_$slot\$" /sys/class/block/*/uevent)
            [ "$#" = 1 ] || return 1
            part=${1%/uevent}
            part=/dev/${part##*/}
        fi
        [ -b "$part" ] || return 1
        # Prove the linked DVFS_INIT/CPU-SRAM ABI on this device's firmware.
        # Firmware build hashes are not compatibility decisions.
        [ -x "$checker" ] && "$checker" "$part" >/dev/null 2>&1 || return 1
    done
}
case ${1:-load} in
    check) supported ;;
    load)
        [ -f "$ko" ] || exit 0 # Old/built-in driver; do not reinitialize it.
        mkdir -p /run
        exec 9>/run/mu300-cpu-driver.lock
        flock -x 9
        [ ! -d /sys/module/$module ] || exit 0
        offsets=0,0,0
        if [ -x "$helper" ]; then
            offsets=$("$helper" boot-args) || offsets=0,0,0
        fi
        # Defense in depth before passing any non-factory value to firmware.
        if [ "$offsets" != 0,0,0 ]; then
            supported || offsets=0,0,0
            sync # Persist the crash guard BEFORE the one-shot DVFS_INIT.
        fi
        if voltage_parameter; then
            insmod "$ko" "voltage_offset_uv=$offsets"
        else
            # Old parameterless modules still provide ordinary CPU frequency.
            insmod "$ko"
        fi
        ;;
    *) exit 2 ;;
esac
