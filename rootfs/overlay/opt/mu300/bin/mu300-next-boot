#!/bin/bash
# Choose what the MU300 boots next and keep Linux as default safely.
#   mu300-next-boot linux          Linux stays the default (re-armed on every successful boot)
#   mu300-next-boot android        next reboot (and later ones) go to Android
#   mu300-next-boot attempts [N]   show, or set, how many boots in a row may fail before Android takes over (1-6)
#   mu300-next-boot --rearm        used by mu300-boot-ok.service after a successful boot
#   mu300-next-boot --trial        try an updated Linux boot without changing the saved default
#   mu300-next-boot status
# The Linux slot is armed with tries=N+1 and successful=0. LK decrements tries on every boot and rolls back to Android's slot
# (Android) when it finds tries=1, so N boots that never reach mu300-boot-ok land in Android on the next one.
# A boot that does reach it arms N+1 again. N lives in .mu300/boot-attempts on the Linux disk, shared by every
# system there and by the initramfs; without the file it is 5.
# OpenWrt: od/timeout come from the static busybox in /opt/mu300/busybox-bin
export PATH="$PATH:/opt/mu300/busybox-bin"
set -eu
CONF=/etc/mu300/default-boot
LINUX_SLOT=$(cat /run/mu300/linux-slot 2>/dev/null || true)
BC_ANDROID=/run/mu300/misc-bc-android.bin
BC_LINUX=/run/mu300/misc-bc-linux-trial.bin
[ -s "$BC_LINUX" ] || BC_LINUX=/run/mu300/misc-bc-slot-b-trial.bin
case "$(dd if="$BC_LINUX" bs=1 count=2 2>/dev/null)" in
    _a) detected_slot=a; android_slot=b ;;
    _b) detected_slot=b; android_slot=a ;;
    *) echo 'Linux slot metadata unavailable; boot control unchanged' >&2; exit 1 ;;
esac
[ -z "$LINUX_SLOT" ] || [ "$LINUX_SLOT" = "$detected_slot" ] || {
    echo 'Conflicting Linux slot metadata; boot control unchanged' >&2; exit 1;
}
LINUX_SLOT=$detected_slot
[ -s "$BC_ANDROID" ] || BC_ANDROID=/run/mu300/misc-bc-slot-$android_slot.bin
[ -s "$BC_ANDROID" ] && [ -s "$BC_LINUX" ] || {
    echo 'boot control blocks for the active slot are unavailable' >&2; exit 1;
}
[ "$(dd if="$BC_ANDROID" bs=1 count=2 2>/dev/null)" = "_$android_slot" ] || {
    echo 'Conflicting Android/Linux slot metadata; boot control unchanged' >&2; exit 1;
}
MISC=$(cat /run/mu300/misc-dev 2>/dev/null || readlink -f /dev/block/by-name/misc)
DEFAULT_ATTEMPTS=5

disk_dir() {
    for d in /mnt/mu300-disk ""; do [ -d "$d/.mu300" ] && { printf '%s/.mu300' "$d"; return; }; done
    return 1
}

attempts() {
    n=$(cat "$(disk_dir)/boot-attempts" 2>/dev/null || true)
    case $n in [1-6]) echo "$n" ;; *) echo "$DEFAULT_ATTEMPTS" ;; esac
}

hex_of() { od -An -tx1 -v "$1" | tr -d ' \n'; }
bytes_of() { printf "$(printf '%s' "$1" | sed 's/../\\x&/g')"; }

# The Linux slot block with tries=$1, made from the initramfs' tries=2 block: byte 12 or 14 is the Linux slot's
# priority | tries << 4 | successful << 7, and the last four bytes are the CRC-32 of the first 28 - the same
# CRC-32 gzip ends every stream with, which saves needing anything that computes one.
make_bc_linux() {
    b=$(hex_of "$BC_LINUX")
    [ ${#b} = 64 ] || return 1
    meta=$(printf '%02x' $(( 0x0f | ($1 << 4) )))
    if [ "$LINUX_SLOT" = a ]; then
        body="${b:0:24}${meta}${b:26:30}"
    else
        body="${b:0:28}${meta}${b:30:26}"
    fi
    crc=$(bytes_of "$body" | gzip -c | tail -c 8 | head -c 4 | od -An -tx1 -v | tr -d ' \n')
    [ ${#crc} = 8 ] || return 1
    printf '%s%s' "$body" "$crc"
}

write_bc() {
    [ "$(wc -c < "$1")" = 32 ] || { echo "invalid boot control block size" >&2; return 1; }
    dd if="$1" of="$MISC" bs=1 seek=2048 conv=notrunc 2>/dev/null || return 1
    sync || return 1
    [ "$(dd if="$MISC" bs=1 skip=2048 count=32 2>/dev/null | od -An -tx1 -v | tr -d ' \n')" = "$(hex_of "$1")" ] \
        || { echo "misc verify failed" >&2; return 1; }
}

arm_linux() {
    n=$(attempts)
    # Rebuilding the tries=2 block has to reproduce the initramfs' own byte for byte, or the arithmetic
    # above is wrong for this misc and nothing it makes gets written.
    if [ "$(make_bc_linux 2 2>/dev/null)" != "$(hex_of "$BC_LINUX")" ]; then
        echo "cannot rebuild the slot $LINUX_SLOT block on this system; arming with 1 attempt" >&2
        write_bc "$BC_LINUX"; return $?
    fi
    tmp=$(mktemp); bytes_of "$(make_bc_linux $((n + 1)))" > "$tmp"
    write_bc "$tmp" || { rm -f "$tmp"; return 1; }; rm -f "$tmp"
    echo "slot $LINUX_SLOT armed: $n failed boot(s) in a row before Android"
}

# The initramfs counts every boot in .mu300/boot-tries; this is where a boot counts as good and clears it.
clear_boot_tries() {
    d=$(disk_dir) || return 0
    echo 0 > "$d/boot-tries" 2>/dev/null && sync
}

slot_state() {
    b=$(dd if="$MISC" bs=1 skip=2048 count=32 2>/dev/null | od -An -tx1 -v | tr -d ' \n')
    echo "misc bootloader_control: $b"
    echo "  slot a info: ${b:24:2}  slot b info: ${b:28:2}  (prio | tries<<4 | successful<<7)"
}

# Serialize the complete misc+intent transaction; never advertise a successful
# default change before misc readback. Preserve old misc if persistence fails.
set_default() (
    target=$1
    mkdir -p "${CONF%/*}" /run || exit 1
    candidate=$(mktemp "${CONF}.XXXXXX") || exit 1
    previous=$(mktemp /run/openwrt-boot-bc.XXXXXX) || { rm -f "$candidate"; exit 1; }
    old_conf=$(mktemp "${CONF}.backup.XXXXXX") || { rm -f "$candidate" "$previous"; exit 1; }
    had_conf=false
    if [ -e "$CONF" ]; then cp -p "$CONF" "$old_conf" || exit 1; had_conf=true; fi
    trap 'rm -f "$candidate" "$previous" "$old_conf"' EXIT
    printf '%s\n' "$target" > "$candidate" || exit 1
    dd if="$MISC" of="$previous" bs=1 skip=2048 count=32 2>/dev/null || exit 1
    [ "$(wc -c < "$previous")" = 32 ] || exit 1
    if ( if [ "$target" = linux ]; then arm_linux; else write_bc "$BC_ANDROID"; fi ); then
        if mv -f "$candidate" "$CONF" && sync && [ "$(cat "$CONF")" = "$target" ]; then
            exit 0
        fi
    fi
    if "$had_conf"; then mv -f "$old_conf" "$CONF"; else rm -f "$CONF"; fi
    ( write_bc "$previous" ) || echo "boot control rollback failed" >&2
    exit 1
)

# Include the successful-boot rearm in the same lock: an Android selection
# must not be overwritten by a concurrently finishing startup service.
case "${1:-status}" in
    linux|android|--rearm|--trial|attempts)
        exec 9>/run/openwrt-default-boot.lock
        flock -n 9 || { echo "boot control busy" >&2; exit 1; } ;;
esac

case "${1:-status}" in
    linux)   set_default linux; echo "default boot: linux" ;;
    android) set_default android; echo "next boot: android (opposite slot)" ;;
    --trial) clear_boot_tries; arm_linux ;;
    attempts)
        if [ -z "${2:-}" ]; then attempts; exit 0; fi
        case $2 in [1-6]) ;; *) echo "attempts must be 1-6 (the slot's tries field has room for 7)" >&2; exit 2 ;; esac
        d=$(disk_dir) || { echo "cannot find the MU300 disk area" >&2; exit 1; }
        echo "$2" > "$d/boot-attempts.tmp" && mv "$d/boot-attempts.tmp" "$d/boot-attempts" && sync
        [ "$(cat "$CONF" 2>/dev/null)" = linux ] && arm_linux || echo "saved; used once Linux is the default boot" ;;
    --rearm) clear_boot_tries
             [ "$(cat "$CONF" 2>/dev/null)" = linux ] && arm_linux || echo "default boot is not linux, nothing to do" ;;
    status)  echo "default boot: $(cat "$CONF" 2>/dev/null || echo android)"
             echo "failed boots in a row before Android: $(attempts)"
             d=$(disk_dir) && [ -f "$d/boot-tries" ] && echo "boots since the last good one: $(cat "$d/boot-tries")"
             slot_state ;;
    *) echo "usage: $0 linux|android|--trial|attempts [N]|status" >&2; exit 2 ;;
esac
