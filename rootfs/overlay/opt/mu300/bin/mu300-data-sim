#!/bin/sh
# MU300 netifd adapter. No tty opens, RIL handshake changes or USB operations.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
. "${MU300_SIM_ENV_LIB:-/opt/mu300/bin/mu300-sim-env}"
cfg() { uci -q get "unisoc_modem.main.$1" 2>/dev/null || true; }
wan=$(cfg data_interface); wan=${wan:-wan}
case "$wan" in ''|*[!a-zA-Z0-9_]*) exit 1 ;; esac
saved=$(cfg data_sim); saved=${saved:-0}
ready=${MU300_DUAL_READY:-/run/mu300-dual-radio-ready}
actual_file=${MU300_DATA_SIM_ACTUAL:-/run/mu300-data-sim-actual}
case "$saved" in 0|1) ;; *) exit 1 ;; esac
mu300_sim_env 0 || exit 1
dev0=$MU300_SIM_DEVICE
dev1=
if [ "$(cfg sim_slots)" = 2 ]; then mu300_sim_env 1 || exit 1; dev1=$MU300_SIM_DEVICE; fi
[ "$dev0" != "$dev1" ] || exit 1
net_status() { ubus -t 3 call "network.interface.$wan" status 2>/dev/null; }
field() { printf '%s' "$status" | jsonfilter -e "@.$1" 2>/dev/null; }
at_slot() {
    mu300_sim_env "$1" || return 1
    [ -p "$MU300_SIM_SHARED/cmd" ] || return 1
    MU300_AT_DIR=$MU300_SIM_SHARED mu300-at -t "${3:-3}" "AT+SPACTCARD=$1;${2#AT}"
}
data_card() { at_slot 0 'AT+SPSWDATA?' | tr -d '\r' | sed -n 's/^+SPSWDATA:[[:space:]]*\([01]\)[[:space:]]*$/\1/p' | head -n1; }
record_card() { printf '%s\n' "$1" > "$actual_file.new.$$" && mv "$actual_file.new.$$" "$actual_file"; }
select_card() {
    at_slot "$1" 'AT+SPSWDATA' 5 >/dev/null || true
    [ "$(data_card)" = "$1" ] && record_card "$1"
}
save_card() {
    uci -q set "unisoc_modem.main.data_sim=$1" && uci -q commit unisoc_modem && return 0
    uci -q revert unisoc_modem.main.data_sim
    return 1
}
wait_down() {
    local n=0
    while [ "$n" -lt 10 ]; do
        status=$(net_status)
        [ "$(field up)" = false ] && [ "$(field pending)" != true ] && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}
case ${1:-} in
get)
    status=$(net_status); actual=$(cat "$actual_file" 2>/dev/null)
    case "$actual" in 0|1) ;; *) actual=null ;; esac
    connected=false
    if [ "$(field up)" = true ]; then
        connected=true
        dev=$(field l3_device)
        [ "$dev" != "$dev0" ] || actual=0
        [ -z "$dev1" ] || [ "$dev" != "$dev1" ] || actual=1
    fi
    initialized=false; [ ! -f "$ready" ] || initialized=true
    printf '{"ok":1,"ready":%s,"saved_sim":%s,"actual_sim":%s,"data_connected":%s,"devices":["%s","%s"]}\n' "$initialized" "$saved" "$actual" "$connected" "$dev0" "$dev1"
    ;;
apply)
    target=${2:-}
    case "$target" in 0|1) ;; *) echo invalid_sim >&2; exit 1 ;; esac
    [ -n "$dev1" ] || { echo dual_sim_unavailable >&2; exit 1; }
    [ -f "$ready" ] || { echo dual_boot_required >&2; exit 1; }
    # A separate switch gate blocks interactive writes, but permits the dial
    # path's pre-radio replay to take the short modem mutex itself. Holding
    # that mutex throughout ifup would deadlock our own replay hook.
    mutex=${MU300_SIM_MUTEX:-/run/unisoc-data-sim-switch}
    if [ "${MU300_DATA_SIM_GATE_HELD:-0}" = 1 ]; then
        # A V50 physical-card transaction already owns this gate. Keep it
        # held while reusing the normal logical data-card transaction.
        case "$(mu300-device)" in v50|u30pro) ;; *) echo modem_busy >&2; exit 1;; esac
        [ "$(cat "$mutex/pid" 2>/dev/null)" = "$PPID" ] || { echo modem_busy >&2; exit 1; }
    else
        mkdir "$mutex" 2>/dev/null || { echo modem_busy >&2; exit 1; }
        echo $$ > "$mutex/pid"
        trap 'rm -f "$mutex/pid"; rmdir "$mutex" 2>/dev/null' EXIT
    fi
    trap 'exit 1' INT TERM
    [ ! -d /run/unisoc-modem-lock-apply ] || { echo modem_busy >&2; exit 1; }
    current=$(data_card)
    case "$current" in 0|1) ;; *) echo sim_read_failed >&2; exit 1 ;; esac
    single=0; old_flags=
    model=$(mu300-device 2>/dev/null)
    standby_supported=0
    case "$model" in f50|u30air) standby_supported=1;; esac
    if [ "$standby_supported" = 1 ] &&
       [ "$("${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" --dsds)" = 0 ]; then
        single=1
        old_flags=$("${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" --flags) || exit 1
    fi
    # Preserve a pre-policy SIM2 choice when later switching back to SIM1.
    if [ "$single" = 0 ] && [ "$current" = 1 ] && [ ! -e "${UNISOC_RADIO_POLICY:-/etc/mu300/sim-radio}" ]; then
        "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-enable 1 1 || exit 1
    fi
    # Selecting SIM2 is an explicit opt-in. Do not recursively take this
    # switch gate; the existing controller still serializes its RF operation.
    permission=0
    "${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" "$target" || permission=$?
    case "$permission:$target" in
        0:*) ;;
        1:0|1:1)
            if [ "$single" = 1 ]; then
                : # The target is explicitly enabled after old data is down.
            elif [ "$target" = 1 ] && [ "$(mu300-device 2>/dev/null)" != u30air ]; then
                at_slot "$target" 'AT+CPIN?' | grep -q '^+CPIN: READY' || { echo sim_not_ready >&2; exit 1; }
                "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-enable 1 1 || exit 1
            else
                echo 'Enable the target SIM radio before switching' >&2; exit 1
            fi ;;
        *) echo 'Enable the target SIM radio before switching' >&2; exit 1 ;;
    esac
    if [ "$current" = "$target" ]; then
        if [ "$single" = 1 ]; then
            "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-policy "$target" 1 || exit 1
        fi
        # Even an intentionally disconnected WAN must stay disconnected.
        save_card "$target" || { echo storage_failed >&2; exit 1; }
        record_card "$target"
        exit 0
    fi
    at_slot "$target" 'AT+CPIN?' | grep -q '^+CPIN: READY' || { echo sim_not_ready >&2; exit 1; }
    status=$(net_status); was_up=$(field up); was_pending=$(field pending); was_autostart=$(field autostart)
    restore_original() {
        ifdown "$wan"; wait_down || return 1
        if [ "$single" = 1 ]; then
            # Disable first, then restore the previous one-on/both-off policy.
            "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-policy "$target" 0 || return 1
        fi
        select_card "$current" || return 1
        save_card "$saved" || return 1
        if [ "$single" = 1 ]; then
            case "$old_flags" in
                '1 0') "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-policy 0 1 || return 1;;
                '0 1') "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-policy 1 1 || return 1;;
            esac
        fi
        if [ "$was_up" = true ] || [ "$was_pending" = true ]; then ifup "$wan" || return 1; fi
        return 0
    }
    # A normal worker termination also restores the previous card. SIGKILL
    # cannot be caught; the job status then explicitly reports interruption.
    trap 'restore_original || echo sim_rollback_failed >&2; exit 1' INT TERM
    ifdown "$wan" || { echo data_disconnect_failed >&2; exit 1; }
    if ! wait_down; then
        [ "$was_up" != true ] || ifup "$wan"
        echo data_disconnect_failed >&2; exit 1
    fi
    if [ "$single" = 1 ]; then
        if ! "${MU300_RADIO_CONTROL:-/opt/mu300/bin/mu300-sim-radio}" --switch-policy "$target" 1; then
            restore_original || { echo sim_rollback_failed >&2; exit 1; }
            echo sim_switch_failed_restored >&2; exit 1
        fi
    fi
    # Selection is a modem operation, NOT an Internet connectivity test.
    # An unpaid/no-signal SIM can be selected. netifd may attach later; its
    # asynchronous registration result must never undo the user's choice.
    if select_card "$target" && save_card "$target"; then
        # An explicit ifdown/data-cap action remains off after selection.
        # Existing autostart intent includes a WAN waiting for registration.
        if [ "$was_autostart" != false ]; then
            ifup "$wan" || logger -t mu300-data-sim 'Data SIM selected; netifd start failed'
        fi
        exit 0
    fi
    # Only selection/readback/storage failures restore the previous choice.
    if restore_original; then
        echo sim_switch_failed_restored >&2; exit 1
    fi
    echo sim_rollback_failed >&2; exit 1
    ;;
*) exit 2 ;;
esac
