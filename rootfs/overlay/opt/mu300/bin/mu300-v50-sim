#!/bin/sh
# Compatibility entry: the physical-card transaction has one shared owner.
[ "$("${MU300_BIN:-/opt/mu300/bin}/mu300-device")" = v50 ] || {
    [ "${1:-}" != status ] || { echo '{"ok":1,"supported":false}'; exit 0; }
    echo v50_card_unsupported >&2; exit 1
}
exec "${MU300_PHYSICAL_SIM_ENGINE:-/opt/mu300/bin/mu300-physical-sim}" "$@"
