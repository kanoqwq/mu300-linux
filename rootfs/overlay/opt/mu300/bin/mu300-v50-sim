#!/bin/sh
# Physical V50 cards above the existing TWO logical SIM stacks. Stock B15
# powers down the affected stack, changes its mux, waits 5 s, then powers up.
set -eu
# Keep a private eUICC logical channel on the same physical card for the job.
case ${1:-} in status|validate) ;; *)
    if [ "${UNISOC_EUICC_GUARDED:-0}" != 1 ]; then
        exec "${MU300_EUICC_TOOL:-/usr/libexec/unisoc-modem/euicc}" --guard /bin/sh "$0" "$@"
    fi
    ;;
esac
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
BIN=${MU300_BIN:-/opt/mu300/bin}
DASH=${MU300_DASH_BIN:-/usr/libexec/unisoc-modem}
. "${MU300_V50_CARD_LIB:-/opt/mu300/lib/v50-card.sh}"
R=${MU300_V50_RUN:-/run}
HW=${MU300_V50_MUX:-/sys/bus/platform/devices/sim_gpio_ctl}
cfg() { uci -q get "unisoc_modem.main.$1" 2>/dev/null || true; }
fail() { echo "$1" >&2; exit 1; }
[ "$("$BIN/mu300-device")" = v50 ] || {
    [ "${1:-}" != status ] || { echo '{"ok":1,"supported":false}'; exit 0; }
    fail v50_card_unsupported
}
board=$(v50_board_id) || {
    # An unknown SKU must retain bootloader wiring, not prevent CP startup.
    [ "${1:-}" != preinit ] || exit 0
    [ "${1:-}" != status ] || { echo '{"ok":1,"supported":false,"error":"v50_board_unknown"}'; exit 0; }
    fail v50_board_unknown
}
validate() { v50_card_map "$board" "$1" >/dev/null || fail v50_card_unavailable; }
hw_ready() {
    [ -r "$HW/chip_select" ] && [ -r "$HW/psim_select" ] &&
    case "$(cat "$HW/chip_select"):$(cat "$HW/psim_select")" in 0:0|0:1|1:0|1:1) true;; *) false;; esac
}
case ${1:-} in
preinit)
    first=$(cfg v50_route0); second=$(cfg v50_route1); single=$(cfg v50_card)
    [ -n "$first$second$single" ] || exit 0
    hw_ready || fail v50_mux_unavailable
    chip=; psim=
    plan() {
        local mapping
        mapping=$(v50_card_map "$board" "$1") || fail v50_card_unavailable
        set -- $mapping
        [ -z "${expected:-}" ] || [ "$1" = "$expected" ] || fail v50_card_unavailable
        case "$2:$3" in chip_select:0|chip_select:1) chip=$3;;
            psim_select:0|psim_select:1) psim=$3;; *) fail v50_card_unavailable;; esac
    }
    # Validate both saved sources before changing either selector.
    if [ -n "$first$second" ]; then
        expected=0; plan "$first"
        expected=1; plan "$second"
    else
        expected=; plan "$single"
    fi
    old_chip=$(cat "$HW/chip_select"); old_psim=$(cat "$HW/psim_select")
    chip=${chip:-$old_chip}; psim=${psim:-$old_psim}
    [ "$chip:$psim" != "$old_chip:$old_psim" ] || exit 0
    if [ -e "$R/mu300-v50-cp-started" ] || pidof modem_control >/dev/null 2>&1; then
        fail modem_busy
    fi
    if [ "$chip" != "$old_chip" ]; then
        printf '%s\n' "$chip" > "$HW/chip_select" || fail v50_mux_write_failed
    fi
    if [ "$psim" != "$old_psim" ]; then
        printf '%s\n' "$psim" > "$HW/psim_select" || fail v50_mux_write_failed
    fi
    [ "$(cat "$HW/chip_select"):$(cat "$HW/psim_select")" = "$chip:$psim" ] || fail v50_mux_write_failed
    printf '%s:%s -> %s:%s\n' "$old_chip" "$old_psim" "$chip" "$psim" > "$R/mu300-v50-sim-preinit"
    exit 0;;
status)
    ready=false; chip=null; psim=null; actual=null; saved=null
    if hw_ready; then
        chip=$(cat "$HW/chip_select"); psim=$(cat "$HW/psim_select")
        logical=$(cat "${MU300_DATA_SIM_ACTUAL:-$R/mu300-data-sim-actual}" 2>/dev/null || true)
        actual=$(v50_active_card "$logical" "$chip" "$psim") || actual=null
        v50_card_map "$board" "$actual" >/dev/null || actual=null
        [ ! -e "$R/mu300-dual-radio-ready" ] || ready=true
    fi
    [ ! -e "$R/mu300/v50-switch-incomplete" ] || ready=false
    value=$(cfg v50_card)
    if v50_card_map "$board" "$value" >/dev/null; then saved=$value; fi
    cards=$(v50_cards "$board" | tr ' ' ',')
    first=null; second=null
    if hw_ready; then
        first=$(v50_active_card 0 "$chip" "$psim") || first=null
        second=$(v50_active_card 1 "$chip" "$psim") || second=null
        v50_card_map "$board" "$first" >/dev/null || first=null
        v50_card_map "$board" "$second" >/dev/null || second=null
    fi
    saved0=null; saved1=null
    value=$(cfg v50_route0)
    case $(v50_card_map "$board" "$value") in '0 '*) saved0=$value;; esac
    value=$(cfg v50_route1)
    case $(v50_card_map "$board" "$value") in '1 '*) saved1=$value;; esac
    printf '{"ok":1,"supported":true,"ready":%s,"board_id":%s,"cards":[%s],"active_card":%s,"saved_card":%s,"chip_select":%s,"psim_select":%s,"model":"v50","logical_cards":[%s,%s],"saved_routes":[%s,%s]}\n' \
        "$ready" "$board" "$cards" "$actual" "$saved" "$chip" "$psim" "$first" "$second" "$saved0" "$saved1"
    exit 0;;
validate) validate "${2:-}"; hw_ready || fail v50_mux_unavailable; exit 0;;
boot)
    first=$(cfg v50_route0); second=$(cfg v50_route1)
    if [ -n "$first$second" ]; then
        case $(v50_card_map "$board" "$first") in '0 '*) ;; *) fail v50_card_unavailable;; esac
        case $(v50_card_map "$board" "$second") in '1 '*) ;; *) fail v50_card_unavailable;; esac
        hw_ready || fail v50_mux_unavailable
        set -- --boot-pair "$first" "$second"
    else
    target=$(cfg v50_card)
    [ -n "$target" ] || exit 0
    validate "$target"; hw_ready || fail v50_mux_unavailable
    set -- --boot-route "$target"
    fi;;
esac

query() {
    local dir=$R/mu300-at output
    [ "$stack" != 1 ] || dir=$R/mu300-at4
    [ -p "$dir/cmd" ] || return 1
    output=$(MU300_SIM_CONTROL=1 MU300_AT_DAEMON_ONLY=1 MU300_AT_DIR=$dir \
        "$BIN/mu300-at" -t "${2:-8}" "AT+SPACTCARD=$stack;${1#AT}") || return 1
    printf '%s\n' "$output" | tr -d '\r'
}
ok() {
    local output
    output=$(query "$@") || return 1
    printf '%s\n' "$output" | awk '
        /^(ERROR|\+CME ERROR|\+CMS ERROR)(:|$)/ { bad=1 }
        NF { last=$0 } END { exit (bad || last != "OK") }'
}
wait_card() {
    local n=0 answer
    while [ "$n" -lt 8 ]; do
        answer=$(query 'AT+CPIN?' 3) || return 1
        case "$answer" in *'+CPIN:'*) return 0;; esac
        n=$((n+1)); [ "$n" -ge 8 ] || sleep 1
    done
    return 1
}

# Only mobile-data, holding the existing RF mutex, may mutate a selector.
route_one() {
    validate "${2:-}"; hw_ready || fail v50_mux_unavailable
    [ "$(readlink "$R/mu300-radio-on.owner" 2>/dev/null)" = "$PPID" ] || fail modem_busy
    [ -e "$R/mu300-ril-handshake" ] || fail dual_boot_required
    mapping=$(v50_card_map "$board" "$2"); set -- "$1" $mapping
    mode=$1; stack=$2; attribute=$3; value=$4
    old=$(cat "$HW/$attribute")
    pending=$R/mu300/v50-route-pending-$stack
    [ "$old" != "$value" ] || [ -e "$pending" ] || return 0
    state=$(query 'AT+CFUN?' 4 | sed -n 's/^+CFUN: *\([0124]\)$/\1/p')
    case "$state" in 0|1|2|4) ;; *) fail sim_read_failed;; esac
    # No unrelated AT client may change a stack context between SFUN and mux.
    mkdir -p "$R/mu300"
    : > "$R/mu300/sim-sequence"
    trap 'rm -f "$R/mu300/sim-sequence"' EXIT
    trap 'exit 143' INT TERM
    # In-flight dashboard collectors must not republish the previous card
    # after its files are invalidated, including when a rollback selects it.
    read -r epoch rest < /proc/uptime
    generation=$R/mu300/v50-generation$stack
    printf '%s:%s\n' "$$" "$epoch" > "$generation.new.$$"
    mv "$generation.new.$$" "$generation"
    : > "$pending"
    if [ "$old" != "$value" ]; then
        ok 'AT+SFUN=5' 30 || fail v50_card_power_failed
        ok 'AT+SFUN=3' 8 || fail v50_card_power_failed
        printf '%s\n' "$value" > "$HW/$attribute" || fail v50_mux_write_failed
        [ "$(cat "$HW/$attribute")" = "$value" ] || fail v50_mux_write_failed
        # Original EVENT_ESIM_DOWN_AND_UP / EVENT_PSIM_DOWN_AND_UP delay.
        sleep 5
    fi
    ok 'AT+SFUN=2' 8 || fail v50_card_power_failed
    # A SIM power command completing does not mean the card has finished
    # answering ATR/CPIN. Do not let the logical switch reject it too early.
    # An unplugged saved card must not prevent the peer stack booting.
    card_ready=0
    if [ "$mode" = --pair-route ] && ! "$BIN/mu300-radio-allowed" "$stack"; then
        : # A saved source may be changed while its radio stays disabled.
    elif wait_card; then
        card_ready=1
    else
        case $mode in --boot-route|--pair-route) ;; *) fail sim_not_ready;; esac
    fi
    # Clear only transient serving/identity snapshots, never SMS or traffic.
    cache=${MU300_DASH_CACHE_ROOT:-/tmp/unisoc-modem}
    [ "$stack" != 1 ] || cache=$cache/sim1
    rm -f "$cache/sig.json" "$cache/cell.json" "$cache/lock.json"
    state_dir=$(cfg state_dir); state_dir=${state_dir:-/etc/unisoc-modem/lock-state.d}
    identity=${state_dir%/lock-state.d}/sim.json
    replay=$R/unisoc-modem-lock-replay-done
    if [ "$stack" = 1 ]; then
        identity=$state_dir/sim1/identity/sim.json
        replay=$replay-sim1
    fi
    rm -f "$identity" "$replay" "$R/unisoc-apn-sim$stack.json"
    reg=${MU300_REGISTRATION_DIR:-$R/mu300-registration}
    rm -f "$reg/slot$stack.json" "$reg/sim$stack.json"
    if [ "$mode" = --route ] || [ "$mode" = --pair-route ]; then
        # A disabled SIM2 can be explicitly enabled by the enclosing data
        # switch. Replay while it is still RF-off, before that controller's
        # SFUN=4 too, not only when its old permission was already on.
        if [ -x "$DASH/lock" ]; then
            ( export MU300_SIM_CONTROL=1
              . "$DASH/sim-scope.sh"
              sim_scope "$stack" && "$DASH/lock" replay early
            ) || logger -t mu300-v50-sim 'Selected card early replay unconfirmed'
        fi
        # Preserve user RF permissions. Selecting SIM2 explicitly opts in
        # later through the existing RF controller, outside this RF mutex.
        if [ "$card_ready" = 1 ] && "$BIN/mu300-radio-allowed" "$stack"; then
            ok 'AT+SFUN=4' 20 || fail v50_card_power_failed
        fi
    fi
    rm -f "$pending"
    return 0
}
case ${1:-} in
    --route|--boot-route|--pair-route) route_one "$@"; exit $?;;
    --boot-pair) route_one --boot-route "$2" && route_one --boot-route "$3"; exit $?;;
esac

[ "${1:-}" = apply ] || exit 2
target=${2:-}; validate "$target"; hw_ready || fail v50_mux_unavailable
[ -e "$R/mu300-dual-radio-ready" ] && [ ! -e "$R/mu300/v50-switch-incomplete" ] || fail dual_boot_required
mapping=$(v50_card_map "$board" "$target"); set -- $mapping
stack=$1; attribute=$2; value=$3
permission=0; "$BIN/mu300-radio-allowed" "$stack" || permission=$?
case "$permission:$stack" in 0:*|1:1) ;; *) fail 'Enable the target SIM radio before switching';; esac

gate=${MU300_SIM_MUTEX:-$R/unisoc-data-sim-switch}
mkdir "$gate" 2>/dev/null || fail modem_busy
echo $$ > "$gate/pid"
trap 'rm -f "$gate/pid"; rmdir "$gate" 2>/dev/null || true' EXIT
trap 'exit 143' INT TERM
[ ! -d "$R/unisoc-modem-lock-apply" ] || fail modem_busy
wan=$(cfg data_interface); wan=${wan:-wan}
case "$wan" in *[!A-Za-z0-9_]*|'') exit 2;; esac
status=$(ubus -t 3 call "network.interface.$wan" status) || fail sim_read_failed
autostart=$(printf '%s' "$status" | jsonfilter -e '@.autostart')
case "$autostart" in true|false) ;; *) fail sim_read_failed;; esac
old_data=$(cfg data_sim); old_data=${old_data:-0}
case "$old_data" in 0|1) ;; *) fail sim_read_failed;; esac
old_actual=$(stack=0; query 'AT+SPSWDATA?' 4 | sed -n 's/^+SPSWDATA: *\([01]\)$/\1/p')
case "$old_actual" in 0|1) ;; *) fail sim_read_failed;; esac
old_pref=$(cfg v50_card)
old0=$(cfg v50_route0); old1=$(cfg v50_route1)
if [ -n "$old0$old1" ]; then
    case $(v50_card_map "$board" "$old0") in '0 '*) ;; *) fail v50_card_unavailable;; esac
    case $(v50_card_map "$board" "$old1") in '1 '*) ;; *) fail v50_card_unavailable;; esac
fi
chip=$(cat "$HW/chip_select"); psim=$(cat "$HW/psim_select")
previous=$(v50_active_card "$stack" "$chip" "$psim") || fail sim_read_failed
logical() { MU300_DATA_SIM_GATE_HELD=1 "$BIN/mu300-data-sim" apply "$1"; }
save_preference() {
    uci -q set "unisoc_modem.main.v50_card=$target" || return 1
    if [ -n "$old0$old1" ]; then
        uci -q set "unisoc_modem.main.v50_route$stack=$target" || return 1
    fi
    uci -q commit unisoc_modem
}
restore_preference() {
    uci -q set "unisoc_modem.main.data_sim=$old_data" || return 1
    if [ -n "$old_pref" ]; then uci -q set "unisoc_modem.main.v50_card=$old_pref" || return 1;
    else uci -q delete unisoc_modem.main.v50_card || true; fi
    if [ -n "$old0$old1" ]; then
        uci -q set "unisoc_modem.main.v50_route0=$old0" &&
        uci -q set "unisoc_modem.main.v50_route1=$old1" || return 1
    fi
    uci -q commit unisoc_modem
}
# No physical change: let the existing transaction handle same-card no-op,
# SIM2 opt-in, WAN intent and rollback. Do not add a gratuitous ifdown.
if [ "$previous" = "$target" ]; then
    logical "$stack" || exit 1
    if save_preference; then exit 0; fi
    logical "$old_actual" && restore_preference || fail sim_rollback_failed
    fail storage_failed
fi
wait_down() {
    local n=0 status
    while [ "$n" -lt 10 ]; do
        status=$(ubus -t 3 call "network.interface.$wan" status) || return 1
        [ "$(printf '%s' "$status" | jsonfilter -e '@.up')" = false ] &&
        [ "$(printf '%s' "$status" | jsonfilter -e '@.pending')" != true ] && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}
ifdown "$wan" || fail data_disconnect_failed
if ! wait_down; then
    [ "$autostart" = false ] || ifup "$wan" || true
    fail data_disconnect_failed
fi
mkdir -p "$R/mu300"; : > "$R/mu300/v50-switch-incomplete"
route() { "$BIN/mobile-data" radio-locked "$BIN/mu300-v50-sim" --route "$1"; }
restore() {
    route "$previous" && logical "$old_actual" || return 1
    restore_preference || return 1
    rm -f "$R/mu300/v50-switch-incomplete"
    [ "$autostart" = false ] || ifup "$wan"
}
trap 'restore || echo sim_rollback_failed >&2; exit 143' INT TERM
if route "$target" && logical "$stack" && save_preference; then
    rm -f "$R/mu300/v50-switch-incomplete"
    [ "$autostart" = false ] || ifup "$wan" || logger -t mu300-v50-sim 'Card selected; netifd start failed'
    exit 0
fi
restore || fail sim_rollback_failed
fail sim_switch_failed_restored
