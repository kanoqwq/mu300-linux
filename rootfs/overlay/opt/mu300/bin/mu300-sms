#!/bin/sh
# Local SMS pool for the MU300 modem: everything the SIM holds (or arrives later) is mirrored into
# $POOL, one file per message, and everything the pool can do it does without touching the SIM
# except through an explicit --sim.
#   mu300-sms list [PAGE]        newest first, MU300_SMS_PAGE per page (default 10)
#   mu300-sms show ID            whole message (marks a received one read)
#   mu300-sms send NUM TEXT...   UCS-2 PDU submit, so non-ASCII travels correctly
#   mu300-sms delete ID|all      pool entry only; --sim also CMGDs the matching SIM slot
#   mu300-sms mark ID read|unread
#   mu300-sms sync               pull everything AT+CMGL lists into the pool
# All AT traffic goes through mu300-atd (via mu300-at); the AT channel is never opened here.
set -u
umask 077
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

POOL=${MU300_SMS_POOL:-}
if [ -z "$POOL" ]; then
    . "${MU300_SMS_POOL_LIB:-${0%/*}/../lib/sms-pool.sh}" || exit 1
    POOL=$(mu300_sms_pool) || exit 1
fi
export MU300_SMS_POOL=$POOL
MSGDIR=$POOL/msg
ATDIR=${MU300_AT_DIR:-/run/mu300-at}
PAGE=${MU300_SMS_PAGE:-10}
PDU_AWK=${MU300_SMS_PDU_AWK:-/opt/mu300/lib/sms-pdu.awk}
DIRECT_FLAG=${MU300_SMS_DIRECT_FLAG:-/run/mu300-sms-direct}
OPLOCK=${MU300_SMS_OP_LOCK:-/tmp/mu300-sms-op.lock}

die() { echo "mu300-sms: $*" >&2; exit 1; }

at() {  # at CMD [timeout] -> reply lines
    local cmd=$1
    case ${MU300_SIM_SLOT:-} in
        0|1) case "$cmd" in AT*) cmd="AT+SPACTCARD=$MU300_SIM_SLOT;${cmd#AT}" ;; esac ;;
        '') ;; *) return 1 ;;
    esac
    mu300-at -t "${2:-6}" "$cmd"
}

# ------------------------------------------------------------------ the pool
sms_clock_cs() {
    read -r sms_up sms_rest < /proc/uptime
    sms_frac=${sms_up#*.}
    sms_now=$(( ${sms_up%.*} * 100 + 1$sms_frac - 100 ))
}
at_unlock() {
    if [ "$(cat "$ATDIR/lock/pid" 2>/dev/null)" = "$$" ]; then
        rm -f "$ATDIR/lock/pid"
        rmdir "$ATDIR/lock" 2>/dev/null || true
    fi
    unset MU300_AT_LOCK_HELD
}
at_lock() {
    local wait=${MU300_AT_LOCK_WAIT:-12} owner end
    trap 'at_unlock; sms_op_unlock' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    case $wait in ''|*[!0-9]*) die "invalid AT lock wait" ;; esac
    [ ${#wait} -le 3 ] || die "invalid AT lock wait"
    while [ "${wait#0}" != "$wait" ]; do wait=${wait#0}; done
    wait=${wait:-0}
    sms_clock_cs; end=$((sms_now + wait * 100))
    while ! mkdir "$ATDIR/lock" 2>/dev/null; do
        owner=$(cat "$ATDIR/lock/pid" 2>/dev/null || true)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -f "$ATDIR/lock/pid"
            rmdir "$ATDIR/lock" 2>/dev/null || true
        fi
        [ -d "$ATDIR/lock" ] || continue
        sms_clock_cs
        [ "$sms_now" -lt "$end" ] || die "mu300-at: busy"
        sleep 0.1 2>/dev/null || sleep 1
    done
    echo $$ > "$ATDIR/lock/pid" || die "cannot claim AT lock"
    export MU300_AT_LOCK_HELD=$$
}

# PR #177: preserve the modem's SMSC and its current CSCS representation.
# Refresh failures are diagnostic only: never block the actual submission.
smsc_refresh() {
    local reply line addr type written
    reply=$(at 'AT+CSCA?' 8 2>/dev/null) || {
        echo 'mu300-sms: SMSC query failed; sending without refresh' >&2; return 0;
    }
    line=$(printf '%s\n' "$reply" | tr -d '\r' | sed -n 's/^+CSCA: *//p' | head -n1)
    addr=; type=
    case $line in
        '"'*'",'[0-9]*) addr=${line%,*}; addr=${addr#\"}; addr=${addr%\"}; type=${line##*,} ;;
    esac
    case $addr in ''|*[!+0-9A-Fa-f]*) addr= ;; esac
    case $type in [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) ;; *) addr= ;; esac
    if [ -z "$addr" ] || [ ${#addr} -gt 64 ]; then
        echo 'mu300-sms: invalid SMSC reply; sending without refresh' >&2; return 0
    fi
    written=$(at "AT+CSCA=\"$addr\",$type" 8 2>/dev/null)
    case $written in *OK*) ;; *) echo 'mu300-sms: SMSC refresh refused; continuing send' >&2 ;; esac
    return 0
}

# One file per message: "field: value" headers, a blank line, then the body verbatim to EOF
# (bodies span lines). Everything the pool writes goes through name.part + mv so a reader never
# sees a half-written message; the pool lock keeps two writers from sharing an id.
pool_init() {
    mkdir -p "$MSGDIR" || die "cannot create $MSGDIR"
    [ -f "$POOL/next_id" ] || echo 0 > "$POOL/next_id"
}

# mkdir lock with pid-liveness takeover, the house pattern: a writer killed with SIGKILL leaves
# the directory behind, and the next writer must be able to tell a live holder from a stale one.
pool_lock() {
    local lock=$POOL/.lock pid=
    local n=0
    while ! mkdir "$lock" 2>/dev/null; do
        pid=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ] &&
           tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q mu300-sms; then
            n=$((n + 1)); [ "$n" -gt 120 ] && die "another mu300-sms writer has held the pool for two minutes"
            sleep 1
            continue
        fi
        rm -rf "$lock"
    done
    echo $$ > "$lock/pid"
}

# Do not install an EXIT trap for this lock: ash/dash also run it when a
# command-substitution subshell exits, silently unlocking the live writer.
# A killed writer leaves a PID-marked lock that pool_lock safely reclaims.
pool_unlock() { rm -rf "$POOL/.lock" 2>/dev/null || true; }

# A SIM slot can be reused between CMGR and CMGD. Serialize the script's SIM
# readers/deleters and mode changes, including a concurrent LuCI manual sync.
sms_op_lock() {
    local owner n=0
    while ! mkdir "$OPLOCK" 2>/dev/null; do
        owner=$(cat "$OPLOCK/pid" 2>/dev/null || true)
        if [ -n "$owner" ] && [ -d "/proc/$owner" ] &&
           tr '\0' ' ' < "/proc/$owner/cmdline" 2>/dev/null | grep -q mu300-sms; then
            n=$((n + 1))
            [ "$n" -ge 30 ] && die "SMS operation is busy"
            sleep 1
        else
            rm -f "$OPLOCK/pid"
            rmdir "$OPLOCK" 2>/dev/null || die "stale SMS operation lock could not be removed"
        fi
    done
    echo $$ > "$OPLOCK/pid"
}
sms_op_unlock() {
    if [ "$(cat "$OPLOCK/pid" 2>/dev/null)" = "$$" ]; then
        rm -f "$OPLOCK/pid"
        rmdir "$OPLOCK" 2>/dev/null || true
    fi
    return 0
}

hdr() {  # hdr FILE field (headers only: the body may legitimately repeat any "field: " line)
    sed -n "1,/^$/s/^$2: //p" "$1" 2>/dev/null | head -1
}

set_hdr() {  # set_hdr FILE field value
    sed -i "1,/^$/s/^$2: .*/$2: $3/" "$1"
}

body_of() { sed -n '1,/^$/!p' "$1" 2>/dev/null; }

# md5 of from|scts|body, the identity of a message across pool and SIM listings. Two identical
# messages from one sender inside the same SCTS minute dedupe into one - acceptable next to the
# alternative (index-based keys, which go stale the moment anything deletes from the SIM).
fingerprint() {
    printf '%s|%s|%s' "$1" "$2" "$3" | md5sum 2>/dev/null | cut -d' ' -f1
}

next_id() {
    local id
    id=$(($(cat "$POOL/next_id" 2>/dev/null || echo 0) + 1))
    echo "$id" > "$POOL/next_id" || return 1
    printf '%06d' "$id"
}

store_msg() {  # store_msg dir status peer scts sim_index coding body [fingerprint ref total part source]
    local dir=$1 status=$2 peer=$3 scts=$4 simidx=$5 coding=$6 text=$7 id f part
    id=$(next_id) || return 1
    f=$MSGDIR/$id
    part=$f.part
    {
        printf 'id: %s\n' "$id"
        printf 'dir: %s\n' "$dir"
        printf 'status: %s\n' "$status"
        if [ "$dir" = mt ]; then printf 'from: %s\n' "$peer"; else printf 'to: %s\n' "$peer"; fi
        printf 'scts: %s\n' "$scts"
        printf 'received: %s\n' "$(date +%s)"
        printf 'source: %s\n' "${12:-sim}"
        printf 'sim_index: %s\n' "$simidx"
        printf 'coding: %s\n' "$coding"
        printf 'fingerprint: %s\n' "${8:-$(fingerprint "$peer" "$scts" "$text")}"
        [ -n "${9:-}" ] && printf 'multipart_ref: %s\n' "$9"
        [ -n "${10:-}" ] && printf 'multipart_total: %s\n' "${10}"
        [ -n "${11:-}" ] && printf 'multipart_part: %s\n' "${11}"
        [ -n "${13:-}" ] && printf 'multipart_hashes: %s\n' "${13}"
        printf 'length: %s\n' "$(printf '%s' "$text" | wc -c | tr -d ' ')"
        printf '\n'
        printf '%s\n' "$text"
    } > "$part" || return 1
    mv "$part" "$f" || return 1
    echo "$id"
}

ids_newest_first() { ls -1 "$MSGDIR" 2>/dev/null | grep -E '^[0-9]+$' | sort -rn; }

# With CSCS left at UCS2 (the send path sets it), text-mode CMGL encodes the
# originating address as ASCII-hex: 17674544422 arrives as "313736373435...3232".
# Decode byte pairs back, but only when every pair is printable and the result
# is digit-major - a plain numeric address must never be mangled.
peer_decode() {
    printf '%s' "$1" | LC_ALL=C awk '
        BEGIN { split("0123456789abcdef", H, ""); for (i = 1; i <= 16; i++) v[H[i]] = i - 1 }
        {
            orig = $0; s = tolower($0)
            if (s !~ /^[0-9a-f]+$/ || length(s) % 2 != 0 || length(s) < 4) { print orig; exit }
            out = ""; digits = 0; n = 0
            for (i = 1; i <= length(s); i += 2) {
                hi = v[substr(s, i, 1)]; lo = v[substr(s, i + 1, 1)]
                b = hi * 16 + lo
                if (b < 32 || b > 126) { print orig; exit }
                c = sprintf("%c", b); out = out c; n++
                if (c ~ /[0-9]/) digits++
            }
            if (digits * 2 >= n) print out; else print orig
        }'
}

# ------------------------------------------------------------------ codecs
# UCS-2 hex -> "\ooo" escapes (printf %b turns them into bytes). Backslash itself is doubled.
# Surrogate pairs join; an unpaired one decodes to '?'. All string ops are byte-wise (LC_ALL=C).
ucs2_to_esc() {
    LC_ALL=C awk '
        BEGIN {
            split("0123456789abcdef", H, "")
            for (i = 1; i <= 16; i++) hv[H[i]] = i - 1
        }
        function h4(s, i) { return hv[substr(s, i, 1)] * 4096 + hv[substr(s, i + 1, 1)] * 256 + hv[substr(s, i + 2, 1)] * 16 + hv[substr(s, i + 3, 1)] }
        function e(b) { return (b == 92) ? "\\\\" : sprintf("\\%03o", b) }
        function u8(cp) {
            if (cp < 128) return e(cp)
            if (cp < 2048) return e(192 + int(cp / 64)) e(128 + cp % 64)
            if (cp < 65536) return e(224 + int(cp / 4096)) e(128 + int(cp / 64) % 64) e(128 + cp % 64)
            cp -= 65536
            return e(240 + int(cp / 262144)) e(128 + int(cp / 4096) % 64) \
                   e(128 + int(cp / 64) % 64) e(128 + cp % 64)
        }
        {
            s = tolower($0); gsub(/[^0-9a-f]/, "", s); n = length(s); out = ""; i = 1
            while (i + 3 <= n) {
                cp = h4(s, i)
                if (cp >= 55296 && cp <= 56319 && i + 7 <= n) {
                    lo = h4(s, i + 4)
                    if (lo >= 56320 && lo <= 57343) { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); i += 4 }
                }
                out = out u8(cp)
                i += 4
            }
            print out
        }'
}

# UTF-8 -> UCS-2 hex (surrogate pair above 0xFFFF). Malformed bytes become "?" rather than
# aborting the message.
utf8_to_ucs2() {
    # The extra terminator preserves even trailing LF as records. Emit their
    # encoded 000a between records, never a literal LF inside the PDU string.
    printf '%s\n' "$1" | LC_ALL=C awk '
        BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
        NR > 1 { printf "000a" }
        {
            s = $0; n = length(s); i = 1; out = ""
            while (i <= n) {
                b1 = ord[substr(s, i, 1)]
                if (b1 < 128)      { cp = b1; w = 1 }
                else if (b1 < 224) { cp = b1 % 32; w = 2 }
                else if (b1 < 240) { cp = b1 % 16; w = 3 }
                else if (b1 < 245) { cp = b1 % 8; w = 4 }
                else               { cp = 63; w = 1 }
                for (j = 2; j <= w; j++) {
                    b = ord[substr(s, i + j - 1, 1)]
                    if (b < 128 || b > 191) { cp = 63; w = 1; break }
                    cp = cp * 64 + (b % 64)
                }
                i += w
                if (cp > 65535) {
                    cp -= 65536
                    out = out sprintf("%04x%04x", 55296 + int(cp / 1024), 56320 + cp % 1024)
                } else {
                    out = out sprintf("%04x", cp)
                }
            }
            printf "%s", out
        }
        END { printf "\n" }'
}

# BCD digits -> semioctets ("10086" -> "0180F6"): low nibble carries the first digit, an odd
# count pads the high nibble of the last octet with F.
pack_semi() {
    LC_ALL=C awk '{
        s = $0; gsub(/[^0-9]/, "", s); n = length(s); out = ""
        for (i = 1; i <= n; i += 2) {
            d2 = (i < n) ? substr(s, i + 1, 1) : "F"
            out = out d2 substr(s, i, 1)
        }
        print out
    }'
}

# ------------------------------------------------------------------ AT+CMGL
# Text-mode listing: one "+CMGL: idx,\"stat\",\"oa\",[\"alpha\"],\"scts\"" header, body lines after
# it, until the next header or the final code. mu300-atd does not demux URCs out of a reply
# (that is this chain's known weakness), so the parser drops the URC lines this modem is known
# to emit mid-reply. Bodies are newline-escaped with \001 for the TSV trip.
parse_cmgl() {
    LC_ALL=C awk '
        function flush() { if (idx != "") { sub(/\001$/, "", body); printf "%s\t%s\t%s\t%s\t%s\n", idx, stat, oa, scts, body } }
        /^\+CMGL:/ {
            flush()
            inbody = 1; body = ""; stat = ""; oa = ""; scts = ""
            line = $0; sub(/^\+CMGL: */, "", line)
            idx = line; sub(/,.*/, "", idx)
            k = 0
            while (match(line, /"[^"]*"/)) {
                k++
                t = substr(line, RSTART + 1, RLENGTH - 2)
                if (k == 1) stat = t
                else if (k == 2) oa = t
                else if (t ~ /\//) scts = t
                line = substr(line, RSTART + RLENGTH)
            }
            next
        }
        /^(OK|ERROR|\+CMS ERROR|\+CME ERROR)/ { flush(); inbody = 0; idx = ""; next }
        inbody && /^\+(CSQ|CESQ|SPPCI|ECIND|SIND|CREG|CGREG|CEREG|C5GREG|CTZV|CGEV|CMTI|SPNRINDICATE|SPERRLOG)/ { next }
        # a blank line right after the header (this modem emits one on some UCS2
        # records) must not become a leading newline inside the body
        inbody { if (body == "" && $0 == "") next; body = body (body == "" ? "" : "\001") $0 }
        END { flush() }
    '
}

# AT+CMGR answers one record shaped like a +CMGL header, with the index supplied by us (the
# firmware does not repeat it). Same TSV, same URC-skipping, as parse_cmgl.
parse_cmgr() {  # parse_cmgr INDEX
    LC_ALL=C awk -v want="$1" '
        function flush() { if (idx != "") { sub(/\001$/, "", body); printf "%s\t%s\t%s\t%s\t%s\n", idx, stat, oa, scts, body } }
        BEGIN { idx = "" }
        /^\+CMGR:/ {
            flush()
            inbody = 1; body = ""; stat = ""; oa = ""; scts = ""
            line = $0; sub(/^\+CMGR: */, "", line)
            k = 0
            while (match(line, /"[^"]*"/)) {
                k++
                t = substr(line, RSTART + 1, RLENGTH - 2)
                if (k == 1) stat = t
                else if (k == 2) oa = t
                else if (t ~ /\//) scts = t
                line = substr(line, RSTART + RLENGTH)
            }
            idx = want
            next
        }
        /^(OK|ERROR|\+CMS ERROR|\+CME ERROR)/ { flush(); inbody = 0; idx = ""; next }
        inbody && /^\+(CSQ|CESQ|SPPCI|ECIND|SIND|CREG|CGREG|CEREG|C5GREG|CTZV|CGEV|CMTI|SPNRINDICATE|SPERRLOG)/ { next }
        # a blank line right after the header (this modem emits one on some UCS2
        # records) must not become a leading newline inside the body
        inbody { if (body == "" && $0 == "") next; body = body (body == "" ? "" : "\001") $0 }
        END { flush() }
    '
}

select_storage() {
    local s reply line used total best= cache=${MU300_SMS_STORE_CACHE:-/run/mu300-sms-store}
    if [ -s "$cache" ]; then
        s=$(cat "$cache" 2>/dev/null)
        case $s in SM|MT|ME)
            reply=$(at "AT+CPMS=\"$s\"" 6 2>/dev/null) && {
                record_storage "$s" "$reply"
                echo "$s"
                return 0
            }
            ;;
        esac
        rm -f "$cache"
    fi
    # This modem rejects the usual three-argument CPMS form. Probe with the
    # supported single-argument form, prefer a store containing messages, then
    # any store with real capacity (ME is commonly 0/0 on this hardware).
    for s in SM MT ME; do
        reply=$(at "AT+CPMS=\"$s\"" 6 2>/dev/null || true)
        line=$(printf '%s\n' "$reply" | grep '^+CPMS:' | head -1)
        used=$(printf '%s\n' "$line" | awk -F'[,:]' '{gsub(/ /,"",$2); print $2}')
        total=$(printf '%s\n' "$line" | awk -F'[,:]' '{gsub(/ /,"",$3); print $3}')
        case "$used:$total" in *[!0-9:]*|:*) continue ;; esac
        if [ "$used" -gt 0 ]; then
            echo "$s" > "$cache"
            record_storage "$s" "$reply"
            echo "$s"
            return 0
        fi
        [ "$total" -gt 0 ] && [ -z "$best" ] && best=$s
    done
    [ -n "$best" ] || best=ME
    reply=$(at "AT+CPMS=\"$best\"" 6) || return 1
    echo "$best" > "$cache"
    record_storage "$best" "$reply"
    echo "$best"
}

# The daemon syncs periodically; expose its last CPMS reading to the UI without
# adding another AT consumer to the five-second page refresh. Never infer free
# capacity from the local pool size (it can contain messages no longer on SIM).
record_storage() {
    local store=$1 reply=$2 line used total part
    line=$(printf '%s\n' "$reply" | grep '^+CPMS:' | head -1)
    used=$(printf '%s\n' "$line" | awk -F'[,:]' '{gsub(/ /,"",$2); print $2}')
    total=$(printf '%s\n' "$line" | awk -F'[,:]' '{gsub(/ /,"",$3); print $3}')
    case "$used:$total" in *[!0-9:]*|:*|*:) return 0 ;; esac
    [ "$total" -gt 0 ] || return 0
    part=$POOL/storage.part.$$
    printf '%s %s %s %s\n' "$store" "$used" "$total" "$(date +%s)" > "$part" &&
        mv "$part" "$POOL/storage"
}

# List the SIM as TSV records, by whichever door this firmware opens. The measured cases:
#   * CMGF=1 refused        -> report; nothing to list with
#   * AT+CMGL="ALL" refused -> some firmwares only take the numeric stat (CMGL=4) in text mode
#   * both refused          -> this firmware offers no listing at all (the E5 of this family
#     is read by CMGR after each +CMTI - see unisoc-cpd FINDINGS), so scan slots instead;
#     the fingerprint dedupe in sync absorbs the overlap
sim_list() {
    local reply store
    store=$(select_storage) || {
        echo "mu300-sms: no usable SMS storage" >&2
        return 1
    }
    reply=$(at 'AT+CMGF=1' 6)
    case $reply in *OK*) ;; *)
        echo "mu300-sms: AT+CMGF=1 refused: $(printf '%s\n' "$reply" | head -1)" >&2
        return 1 ;;
    esac
    sleep 1   # this CP asserts on unpaced command bursts; every sync is rare, so be generous
    reply=$(at 'AT+CMGL="ALL"' 15)
    case $reply in *'+CMS ERROR'*|*'+CME ERROR'*)
        reply=$(at 'AT+CMGL=4' 15) ;;
    esac
    case $reply in *'+CMS ERROR'*|*'+CME ERROR'*)
        local i misses=0 scan
        scan=$(mktemp "${TMPDIR:-/tmp}/mu300-sms.XXXXXX")
        for i in $(seq 1 ${MU300_SMS_SCAN:-30}); do
            reply=$(at "AT+CMGR=$i" 6)
            case $reply in
                *'+CMS ERROR'*|*'+CME ERROR'*|"") misses=$((misses + 1)); [ "$misses" -ge 3 ] && break; continue ;;
            esac
            printf '%s\n' "$reply" | parse_cmgr "$i" >> "$scan"
            misses=0
        done
        cat "$scan"
        rm -f "$scan"
        return 0 ;;
    esac
    printf '%s\n' "$reply" | parse_cmgl
}

# ------------------------------------------------------------------ commands
cmd_sync() {
    # Scoped native reception and legacy direct mode are PDU-only. Manual
    # refresh must use the same importer so multipart identity is retained.
    if [ -n "${MU300_SIM_SLOT:-}" ] || [ -f "$DIRECT_FLAG" ]; then
        cmd_archive_sim
        return $?
    fi
    sms_op_lock
    pool_init
    local reply tmp new=0 total=0
    tmp=$(mktemp "${TMPDIR:-/tmp}/mu300-sms.XXXXXX") || die mktemp
    sim_list > "$tmp" || { rm -f "$tmp"; die "cannot list the SIM storage"; }
    # Text mode has no UDH: never guess concatenation from sender/timestamp
    # or SIM index ordering. The daemon prefers archive-sim (PDU), which uses
    # the same reliable multipart importer as live direct delivery.
    pool_lock
    # fingerprints of what the pool already holds, so a sync is idempotent and the SIM index of
    # a still-present message stays current (indexes shift whenever anything deletes from the SIM)
    local fpfile idx stat oa scts body f fpid
    fpfile=$(mktemp "${TMPDIR:-/tmp}/mu300-sms.XXXXXX")
    for f in "$MSGDIR"/[0-9]*; do
        [ -f "$f" ] || continue
        printf '%s %s\n' "$(hdr "$f" fingerprint)" "$f" >> "$fpfile"
    done
    while IFS="$(printf '\t')" read -r idx stat oa scts body; do
        [ -n "${idx:-}" ] || continue
        case $stat in REC*|ALL) ;; *) continue ;; esac   # STO UNSENT/SENT are mobile-originated
        total=$((total + 1))
        oa=$(peer_decode "$oa")
        body=$(printf '%s' "$body" | tr '\001' '\n')
        local coding=gsm
        case $body in
            *[!0-9A-Fa-f]*|"") ;;
            *) if [ $(( ${#body} % 4 )) -eq 0 ] && [ -n "$body" ]; then
                   body=$(printf '%b' "$(printf '%s\n' "$body" | ucs2_to_esc)")
                   coding=ucs2
               fi ;;
        esac
        fpid=$(fingerprint "$oa" "$scts" "$body")
        local known=""
        while read -r kf kfile; do
            [ "$kf" = "$fpid" ] && { known=$kfile; break; }
        done < "$fpfile"
        # locally-deleted messages stay deleted: their fingerprints are on the
        # tombstone list, otherwise the next sync would just re-import them
        grep -qxF "$fpid" "$POOL/deleted" 2>/dev/null && continue
        if [ -n "$known" ]; then
            [ "$(hdr "$known" sim_index)" != "$idx" ] && set_hdr "$known" sim_index "$idx"
        else
            local newid st=unread
            # the SIM's own read state carries over: a message already read (on the phone,
            # before this pool ever saw it) does not arrive here pretending to be new
            case $stat in *UNREAD*) st=unread ;; *) st=read ;; esac
            newid=$(store_msg mt "$st" "$oa" "$scts" "$idx" "$coding" "$body")
            printf '%s %s\n' "$fpid" "$MSGDIR/$newid" >> "$fpfile"
            new=$((new + 1))
            echo "new: $newid from ${oa:-?} ${scts:-}"
        fi
    done < "$tmp"
    rm -f "$tmp" "$fpfile"
    echo "sync: $new new, $total on the SIM, $(ids_newest_first | wc -l | tr -d ' ') in the pool"
    pool_unlock
    sms_op_unlock
}

# Gregorian UTC seconds from the decoder's SCTS (portable, no date -d or mktime).
sms_timestamp() {
    LC_ALL=C awk -v s="$1" 'BEGIN {
        y=substr(s,1,4)+0; m=substr(s,6,2)+0; d=substr(s,9,2)+0;
        if(y<1970 || m<1 || m>12 || d<1 || d>31)exit 1;
        for(a=1970;a<y;a++)days+=365+(a%4==0 && (a%100!=0 || a%400==0));
        split("31 28 31 30 31 30 31 31 30 31 30 31",months," ");
        months[2]+=(y%4==0 && (y%100!=0 || y%400==0));
        for(a=1;a<m;a++)days+=months[a];
        v=((days+d-1)*24+substr(s,12,2))*3600+substr(s,15,2)*60+substr(s,18,2);
        zone=substr(s,21,2)*3600+substr(s,24,2)*60;
        printf "%.0f\n",v+(substr(s,20,1)=="-"?zone:-zone);
    }'
}

# Called with the pool lock held, using the importer's decoded variables.
# Pending parts are durable but NOT visible messages and do not consume IDs;
# the forwarding cursor therefore never sees half a message. No polling loop.
import_multipart() {
    local key epoch group= candidate count=0 delta oldepoch saved= p joined= hashes= finalhash id= finalsource=direct
    case "$ref:$total:$part" in *[!0-9:]*|:*|*:) return 1 ;; esac
    [ "$total" -le 255 ] && [ "$part" -ge 1 ] && [ "$part" -le "$total" ] || return 1
    epoch=$(sms_timestamp "$scts") || return 1
    key=$(printf '%s|%s|%s|%s' "$peer" "$ref" "$total" "$scheme" | md5sum | cut -d' ' -f1)
    mkdir -p "$POOL/multipart" || return 1
    for candidate in "$POOL/multipart/$key".*; do
        [ -d "$candidate" ] || continue
        oldepoch=$(cat "$candidate/epoch" 2>/dev/null) || continue
        case $oldepoch in ''|*[!0-9]*) continue ;; esac
        delta=$((epoch - oldepoch)); [ "$delta" -lt 0 ] && delta=$((-delta))
        [ "$delta" -le 600 ] || continue
        if [ -f "$candidate/$part" ]; then
            [ "$(hdr "$candidate/$part" fingerprint)" = "$hash" ] || continue
            group=$candidate; saved=1; break
        fi
        count=$((count + 1)); group=$candidate
    done
    # Reused references with indistinguishable competing groups cannot be
    # guessed safely. Keep the original spool/SIM PDU and do not acknowledge it.
    [ -n "$saved" ] || [ "$count" -le 1 ] || return 1
    if [ -z "$group" ]; then
        group=$POOL/multipart/$key.$hash
        mkdir -p "$group" || return 1
        printf '%s\n' "$epoch" > "$group/epoch" || return 1
    fi
    if [ -z "$saved" ]; then
        {
            printf 'fingerprint: %s\nscts: %s\nsource: %s\npdu: %s\n\n%s\n' "$hash" "$scts" "$source" "$pdu" "$body"
        } > "$group/$part.part" && mv "$group/$part.part" "$group/$part" || return 1
    fi
    sync "$group/$part" "$group" "$POOL/multipart" 2>/dev/null || sync
    p=1
    while [ "$p" -le "$total" ]; do
        [ -f "$group/$p" ] || { echo "multipart SMS: saved part $part/$total"; return 0; }
        hashes="$hashes $(hdr "$group/$p" fingerprint)"
        joined="$joined$(body_of "$group/$p")"
        case $(hdr "$group/$p" source) in
            direct) ;;
            stored-live) [ "$finalsource" = sim ] || finalsource=stored-live ;;
            *) finalsource=sim ;;
        esac
        p=$((p + 1))
    done
    finalhash=$(printf '%s' "$hashes" | md5sum | cut -d' ' -f1)
    for candidate in "$MSGDIR"/[0-9]*; do
        [ -f "$candidate" ] || continue
        [ "$(hdr "$candidate" fingerprint)" = "$finalhash" ] && { id=${candidate##*/}; break; }
    done
    if [ -z "$id" ]; then
        id=$(store_msg mt unread "$peer" "$(hdr "$group/1" scts)" "" pdu "$joined" "$finalhash" "$ref" "$total" 1 "$finalsource" "$hashes") || return 1
    fi
    sync "$MSGDIR/$id" "$MSGDIR" "$POOL/next_id" "$POOL" 2>/dev/null || sync
    # Clean only this validated group; complete-message hashes retain dedupe.
    for candidate in "$group"/[0-9]* "$group/epoch"; do
        [ ! -f "$candidate" ] || rm -f "$candidate" || return 1
    done
    rmdir "$group" || return 1
    echo "new multipart SMS: $id from $peer ($total parts)"
}

# Called by mu300-smsd for a PDU that atd has already persisted from +CMT.
# Idempotent: a network retry with the same PDU must not duplicate the inbox.
# The modem is acknowledged only *after* this command returns successfully.
cmd_import_pdu() {
    local file=${1:-} pdu decoded idx peer scts ref total part body hash text_hash f known= newid= coding=pdu
    local source=${2:-direct} scheme=
    case $source in direct|sim|stored-live) ;; *) die "invalid SMS source" ;; esac
    [ -f "$file" ] || die "direct SMS spool file is missing"
    IFS= read -r pdu < "$file" || die "direct SMS spool file is empty"
    case $pdu in ''|*[!0123456789abcdefABCDEF]*) die "invalid direct SMS PDU" ;; esac
    [ $(( ${#pdu} % 2 )) = 0 ] || die "odd-length direct SMS PDU"
    [ -r "$PDU_AWK" ] || die "SMS PDU decoder is missing"
    # The decoder emits UTF-8 bytes with %c; force byte-oriented awk even on
    # systems whose default locale treats %c values as Unicode code points.
    decoded=$(printf '0\t%s\n' "$pdu" | LC_ALL=C awk -F '\t' -v mode=decode -v metadata=1 -f "$PDU_AWK") || decoded=
    if [ -n "$decoded" ]; then
        # Tabs are IFS whitespace: read collapses an empty reference field
        # on single-part messages and shifts the body into multipart_part.
        # A non-whitespace separator preserves every optional field.
        IFS="$(printf '\001')" read -r idx peer scts ref total part body scheme <<EOF
$(printf '%s' "$decoded" | tr '\t' '\001')
EOF
    fi
    if [ -z "${peer:-}" ] || [ -z "${scts:-}" ]; then
        # An unsupported SMS class/encoding must not pin the SIM forever.
        # Keep the complete PDU in a visible local record for later decoding.
        peer=unknown
        scts=$(date '+%y/%m/%d,%H:%M:%S')
        body="Undecoded SMS PDU: $pdu"
        ref= total= part=
        coding=raw-pdu
    fi
    hash=$(printf '%s' "$pdu" | md5sum | cut -d' ' -f1)
    text_hash=$(fingerprint "$peer" "$scts" "$body")
    pool_init
    pool_lock
    grep -qxF "$hash" "$POOL/deleted" 2>/dev/null && { pool_unlock; return 0; }
    for f in "$MSGDIR"/[0-9]*; do
        [ -f "$f" ] || continue
        case " $(hdr "$f" multipart_hashes) " in *" $hash "*) known=$f; break ;; esac
        case $(hdr "$f" fingerprint) in
            "$hash") known=$f; break ;;
            "$text_hash") [ "${total:-1}" -le 1 ] && { known=$f; break; } ;;
        esac
    done
    if [ -z "$known" ] && [ "${total:-1}" -gt 1 ]; then
        import_multipart || { pool_unlock; die "could not safely assemble multipart SMS"; }
        pool_unlock
        return 0
    fi
    if [ -z "$known" ]; then
        newid=$(store_msg mt unread "$peer" "$scts" "" "$coding" "$body" "$hash" "$ref" "$total" "$part" "$source") ||
            die "could not save direct SMS"
        echo "new direct SMS: $newid from $peer"
    else
        echo "direct SMS already saved: ${known##*/}"
    fi
    if [ -n "$newid" ]; then
        sync "$MSGDIR/$newid" "$MSGDIR" "$POOL/next_id" "$POOL" 2>/dev/null || sync
    fi
    pool_unlock
}

# Some SMS classes are SIM-resident even with CNMI direct routing. Copy each
# original PDU to persistent storage, import it into the local pool and read it
# back before deleting *that exact slot*. A failed step keeps the SIM original.
# Never issue CMGD=1,4 (wipe all): indices can move as messages arrive/delete.
cmd_archive_sim() {
    sms_op_lock
    pool_init
    local reply tmp sorted idx stat pdu check hash archive part count=0 planned used
    local receive_source=${MU300_SMS_IMPORT_SOURCE:-sim}
    case $receive_source in sim|stored-live) ;; *) die "invalid archive receive source" ;; esac
    reply=$(at 'AT+CPMS="SM"' 6) || die "cannot select SIM storage"
    printf '%s\n' "$reply" | grep -q '^OK' || die "SIM storage was refused"
    used=$(printf '%s\n' "$reply" | awk -F'[,:]' '/^\+CPMS:/ { gsub(/ /,"",$2); print $2; exit }')
    case $used in ''|*[!0-9]*) die "SIM capacity response was invalid" ;; esac
    record_storage SM "$reply"
    if [ "$used" -eq 0 ]; then
        echo "SIM archive: no stored messages"
        sms_op_unlock
        return 0
    fi
    reply=$(at 'AT+CMGF=0' 6) || die "cannot select PDU mode"
    printf '%s\n' "$reply" | grep -q '^OK' || die "PDU mode was refused"
    reply=$(at 'AT+CMGL=4' 20) || die "cannot list SIM PDUs"
    printf '%s\n' "$reply" | grep -q '^OK' || die "SIM PDU listing was incomplete"
    tmp=$(mktemp "${TMPDIR:-/tmp}/mu300-sms.XXXXXX") || die mktemp
    sorted=$(mktemp "${TMPDIR:-/tmp}/mu300-sms.XXXXXX") || { rm -f "$tmp"; die mktemp; }
    printf '%s\n' "$reply" | awk '
        /^\+CMGL: *[0-9]+,[0-3],/ {
            h=$0; sub(/^\+CMGL: */, "", h)
            split(h, a, ","); idx=a[1]; stat=a[2]; next
        }
        /^[0-9A-Fa-f]+$/ { if (idx != "") { print idx "\t" stat "\t" $0; idx="" } }
    ' > "$tmp"
    sort -rn "$tmp" > "$sorted"
    planned=$(wc -l < "$sorted" | tr -d ' ')
    [ "$planned" -ge "$used" ] || { rm -f "$tmp" "$sorted"; die "SIM listing omitted stored messages; nothing deleted"; }
    mkdir -p "$POOL/archive"
    while IFS="$(printf '\t')" read -r idx stat pdu; do
        [ -n "$idx" ] || continue
        case $pdu in ''|*[!0123456789abcdefABCDEF]*) break ;; esac
        [ $(( ${#pdu} % 2 )) = 0 ] || break
        # Re-read the slot just before deletion; a concurrent arrival or user
        # action must not turn an old listing into deletion of another message.
        reply=$(at "AT+CMGR=$idx" 6) || break
        check=$(printf '%s\n' "$reply" | awk '/^\+CMGR:/ { seen=1; next } seen && /^[0-9A-Fa-f]+$/ { print; exit }')
        [ "$check" = "$pdu" ] || break
        hash=$(printf '%s' "$pdu" | md5sum | cut -d' ' -f1)
        archive=$POOL/archive/$hash.pdu
        if [ ! -f "$archive" ]; then
            part=$archive.part.$$
            printf '%s\n' "$pdu" > "$part" && mv "$part" "$archive" || break
        fi
        [ "$(cat "$archive" 2>/dev/null)" = "$pdu" ] || break
        sync "$archive" "$POOL/archive" 2>/dev/null || sync
        case $stat in 0|1) "$0" import-pdu "$archive" "$receive_source" || break ;; esac
        reply=$(at "AT+CMGD=$idx" 6) || break
        printf '%s\n' "$reply" | grep -q '^OK' || break
        count=$((count + 1))
    done < "$sorted"
    rm -f "$tmp" "$sorted"
    reply=$(at 'AT+CPMS="SM"' 6 2>/dev/null || true)
    record_storage SM "$reply"
    echo "SIM archive: $count slot(s) freed; original PDUs retained in $POOL/archive"
    sms_op_unlock
    [ "$count" -eq "$planned" ] || return 1
}

cmd_list() {
    pool_init
    local page=${1:-1} total pages skip n=0 shown=0 id f dir status peer scts text unread=0
    case $page in ''|*[!0-9]*) page=1 ;; esac
    [ "$page" -ge 1 ] || page=1
    total=$(ids_newest_first | wc -l | tr -d ' ')
    for f in "$MSGDIR"/[0-9]*; do
        [ -f "$f" ] || continue
        [ "$(hdr "$f" status)" = unread ] && unread=$((unread + 1))
    done
    pages=$(( (total + PAGE - 1) / PAGE ))
    [ "$pages" -ge 1 ] || pages=1
    echo "pool: $total message(s), $unread unread - page $page/$pages ($PAGE per page)"
    [ "$total" -eq 0 ] && return 0
    skip=$(( (page - 1) * PAGE ))
    for id in $(ids_newest_first); do
        n=$((n + 1))
        [ "$n" -le "$skip" ] && continue
        [ "$shown" -ge "$PAGE" ] && break
        shown=$((shown + 1))
        f=$MSGDIR/$id
        dir=$(hdr "$f" dir); status=$(hdr "$f" status)
        peer=$(hdr "$f" from); [ -n "$peer" ] || peer=$(hdr "$f" to)
        scts=$(hdr "$f" scts)
        # preview: first line, at most 44 BYTES, backed off to a UTF-8 character
        # boundary (cut -c1-44 chopped multi-byte characters in half and the
        # replacement square ended up in the UI). The backoff runs ONLY after a
        # real cut: an all-multibyte line that is already short must not be
        # nibbled to nothing from its tail.
        text=$(body_of "$f" | head -1 | LC_ALL=C awk '
            BEGIN { for (i = 0; i < 256; i++) o[sprintf("%c", i)] = i }
            {
                s = $0
                if (length(s) > 44) {
                    s = substr(s, 1, 44)
                    while (length(s) > 0) {
                        b = o[substr(s, length(s), 1)]
                        if (b < 128) break                    # ASCII tail: complete char
                        if (b >= 192) { s = substr(s, 1, length(s) - 1); break }  # lead byte: drop once, done
                        s = substr(s, 1, length(s) - 1)       # continuation: keep backing up
                    }
                }
                print s
            }')
        printf '%-7s %-7s %-3s %-18.18s %-21s %s\n' \
            "$id" "$status" "$dir" "${peer:-?}" "${scts:-?}" "$text"
    done
}

cmd_show() {
    local id=${1:-} f dir status peer scts idx coding recv text n
    case $id in ''|*[!0-9]*) die "show needs a numeric id (see: mu300-sms list)" ;; esac
    n=$(printf '%s' "$id" | sed 's/^0*//'); [ -n "$n" ] || n=0
    f=$MSGDIR/$(printf '%06d' "$n")
    [ -f "$f" ] || die "no message $id"
    dir=$(hdr "$f" dir); status=$(hdr "$f" status)
    peer=$(hdr "$f" from); [ -n "$peer" ] || peer=$(hdr "$f" to)
    scts=$(hdr "$f" scts); idx=$(hdr "$f" sim_index); coding=$(hdr "$f" coding)
    recv=$(hdr "$f" received)
    echo "id:        $id"
    echo "direction: $([ "$dir" = mt ] && echo 'received (MT)' || echo 'sent (MO)')"
    echo "status:    $status"
    echo "$([ "$dir" = mt ] && echo from || echo to):        $peer"
    echo "time:      ${scts:-?}"
    echo "sim index: ${idx:-not on the SIM}"
    [ -n "$recv" ] && echo "pooled:    $(date -u -d "@$recv" 2>/dev/null || date -u -r "$recv" 2>/dev/null || echo "$recv") UTC"
    [ "$coding" = ucs2 ] && echo "coding:    UCS-2 (decoded)"
    echo "---"
    body_of "$f"
    # mark-read on first view. The && chain returns 1 for an already-read
    # message, and as the last command that became cmd_show's exit status -
    # every rpcd sms_show of a read message answered ok:0 with the full text
    # hidden in the error field (bubbles never updated past the preview).
    [ "$dir" = mt ] && [ "$status" = unread ] && set_hdr "$f" status read
    return 0
}

cmd_mark() {
    local id=${1:-} what=${2:-} f n
    case $id in ''|*[!0-9]*) die "mark needs a numeric id" ;; esac
    case $what in read|unread) ;; *) die "mark ID read|unread" ;; esac
    n=$(printf '%s' "$id" | sed 's/^0*//'); [ -n "$n" ] || n=0
    f=$MSGDIR/$(printf '%06d' "$n")
    [ -f "$f" ] || die "no message $id"
    set_hdr "$f" status "$what"
}

# This CP's prompt has no newline, so a two-stage AT+CMGS conversation loses the
# ">" in atd's line reader. Send command, literal CR, PDU and Ctrl-Z as one
# atomic atd request; the modem accepts this form and replies with +CMGS/OK.
cmd_send() {
    local num=${1:-} text idigits toa ud udl pdu len
    shift $(($# > 0 ? 1 : 0))
    text=$*
    case $num in
        '+'*[0-9][0-9][0-9]*) toa=91; idigits=${num#+} ;;
        [0-9][0-9][0-9]*)     toa=81; idigits=$num ;;
        *) die "send needs a phone number and a text (mu300-sms send 10086 你好)" ;;
    esac
    case $idigits in ''|*[!0-9]*) die "$num is not a phone number" ;; esac
    [ -n "$text" ] || die "send needs a text"
    [ -p "$ATDIR/cmd" ] || die "mu300-atd is not running - a submit needs its two-phase path"
    ud=$(utf8_to_ucs2 "$text")
    [ $(( ${#ud} / 4 )) -gt 70 ] &&
        die "text is $(( ${#ud} / 4 )) UCS-2 units; one SMS part carries 70 (concatenation not implemented)"
    udl=$(( ${#ud} / 2 ))
    # 00: empty SMSC (the modem's default service centre - the vendor's own submit carries it
    # empty too); 01: submit, no VP octet follows (a 0x11 here - promising a validity period
    # the PDU never carries - is a measured +CMS ERROR: 302 on this CP family); 00: message
    # reference. CMGS's length counts the octets after the SMSC field.
    pdu="000100$(printf '%02X' "${#idigits}")${toa}$(printf '%s' "$idigits" | pack_semi)0008$(printf '%02X' "$udl")$ud"
    pdu=$(printf '%s' "$pdu" | tr 'a-f' 'A-F')
    len=$(( (${#pdu} - 2) / 2 ))
    echo "submitting to $num ($len octets, $((udl / 2)) UCS-2 units)"

    sms_op_lock
    local r0 r2 submit submit_rc reason
    at_lock
    smsc_refresh
    r0=$(at 'AT+CAVIMS=1' 6)
    case $r0 in *OK*) ;; *) die "modem refused AT+CAVIMS=1: $r0" ;; esac
    r0=$(at 'AT+CMGF=0' 6)       # PDU mode for the submit
    case $r0 in *OK*) ;; *) die "modem refused AT+CMGF=0: $r0" ;; esac
    submit=$(printf 'AT+CMGS=%s\r%s\032' "$len" "$pdu")
    r2=$(at "$submit" 25 2>&1); submit_rc=$?
    # Stay in PDU mode. Switching back to text here corrupts direct +CMT
    # delivery; the legacy SIM reader selects text explicitly when needed.
    if ! printf '%s\n' "$r2" | grep -q '^+CMGS:'; then
        reason=$(printf '%s\n' "$r2" | grep -E 'CMS|ERROR|mu300-at:|unisoc-at:' | head -1)
        [ -n "$reason" ] || reason="no submission acknowledgement (AT exit $submit_rc); delivery status unknown"
        # A timeout after Ctrl-Z is ambiguous. Do not send the PDU again.
        die "submit failed: $reason"
    fi
    # Never wait for the local pool while owning the AT channel.
    at_unlock
    pool_init
    pool_lock
    # bytes above 0x7F mean the text is not plain GSM-7 ASCII and travelled as UCS-2
    local coding=gsm
    [ -n "$(printf '%s' "$text" | LC_ALL=C tr -d '\000-\177')" ] && coding=ucs2
    store_msg mo sent "$num" "$(date '+%y/%m/%d,%H:%M:%S')" "" "$coding" "$text" >/dev/null
    pool_unlock
    sms_op_unlock
    echo "sent ($(printf '%s\n' "$r2" | sed -n 's/^+CMGS: //p' | head -1))"
}

# Lock order, everywhere: the AT *client* lock ($ATDIR/lock) is only ever taken by a path
# that holds no pool lock, and the pool lock is only ever taken by a path that makes no AT
# calls while holding it. The two AT-talking commands (sync, delete --sim) finish their AT
# conversation before touching the pool; send takes the client lock first and the pool lock
# only around the pool append. Getting this backwards deadlocks send against sync.
cmd_delete() {
    local what=${1:-} wantsim=false id n f
    for a in "$@"; do [ "$a" = --sim ] && wantsim=true; done
    [ "$what" = --sim ] && { shift; what=${1:-}; }
    pool_init
    # tombstone every removed message so a later sync does not re-import it
    # from the SIM (a local-only delete must actually delete something)
    tombstone() {
        local deleted_hash
        [ -n "$(hdr "$1" fingerprint)" ] && printf '%s\n' "$(hdr "$1" fingerprint)" >> "$POOL/deleted" 2>/dev/null
        for deleted_hash in $(hdr "$1" multipart_hashes); do
            printf '%s\n' "$deleted_hash" >> "$POOL/deleted" || return 1
        done
    }
    if [ "$what" = all ]; then
        for id in $(ids_newest_first); do
            [ "$wantsim" = true ] && sim_delete "$id" || [ "$wantsim" = false ] ||
                die "SIM deletion failed for $id; remaining messages were kept"
            pool_lock
            tombstone "$MSGDIR/$id"
            rm -f "$MSGDIR/$id"
            pool_unlock
        done
        echo "pool emptied"
        return 0
    fi
    case "$what" in ''|*[!0-9]*) die "delete needs an id or \"all\" (optionally --sim)" ;; esac
    n=$(printf '%s' "$what" | sed 's/^0*//'); [ -n "$n" ] || n=0
    id=$(printf '%06d' "$n")
    f=$MSGDIR/$id
    [ -f "$f" ] || die "no message $what"
    if [ "$wantsim" = true ]; then
        sim_delete "$id" || die "SIM deletion failed; local copy was kept"
    fi
    pool_lock
    tombstone "$f"
    rm -f "$f"
    pool_unlock
    echo "deleted $what"
}

# CMGD by index alone is dangerous (indexes shift with every deletion), so the SIM is re-listed
# and the slot whose fingerprint matches the pool entry is the one deleted.
SMS_DELETE_PAUSED=0
sim_delete_restore() {
    [ "$SMS_DELETE_PAUSED" = 1 ] || return 0
    SMS_DELETE_PAUSED=0
    # Upgrades may leave a legacy direct-mode marker. Never re-enable unscoped
    # CMT routing after a delete; preserve the same slot-scoped receive mode.
    rm -f "$DIRECT_FLAG"
    at 'AT+CMGF=0' 6 | grep -q '^OK' &&
        at 'AT+CNMI=2,1,0,0,0' 6 | grep -q '^OK'
}

sim_delete() {
    local rc
    sms_op_lock
    if [ -n "${MU300_SIM_SLOT:-}" ] || [ -f "$DIRECT_FLAG" ]; then
        if ! at 'AT+CNMI=2,1,0,0,0' 6 | grep -q '^OK'; then
            sms_op_unlock
            return 1
        fi
        SMS_DELETE_PAUSED=1
    fi
    sim_delete_unlocked "$@"
    rc=$?
    sim_delete_restore || rc=1
    sms_op_unlock
    return "$rc"
}
sim_delete_unlocked() {
    local id=$1 f=$MSGDIR/$id want simidx reply idx stat oa scts body fpid
    [ -f "$f" ] || return 0
    want=$(hdr "$f" fingerprint)
    reply=$(sim_list) || return 0
    simidx=""
    while IFS="$(printf '\t')" read -r idx stat oa scts body; do
        [ "$idx" = "" ] && continue
        body=$(printf '%s' "$body" | tr '\001' '\n')
        case $body in
            *[!0-9A-Fa-f]*|"") ;;
            *) [ $(( ${#body} % 4 )) -eq 0 ] && body=$(printf '%b' "$(printf '%s\n' "$body" | ucs2_to_esc)") ;;
        esac
        oa=$(peer_decode "$oa")
        [ "$(fingerprint "$oa" "$scts" "$body")" = "$want" ] && { simidx=$idx; break; }
    done <<EOF
$(printf '%s\n' "$reply" | tr -d '\r')
EOF
    if [ -z "$simidx" ]; then
        echo "message $id is not on the SIM (already gone, or never stored there)" >&2
        return 1
    fi
    if at "AT+CMGD=$simidx" 6 | grep -q '^OK'; then
        echo "deleted SIM slot $simidx for message $id"
        return 0
    fi
    echo "mu300-sms: modem refused to delete SIM slot $simidx" >&2
    return 1
}

usage() {
    cat <<EOF
usage: mu300-sms list [PAGE]     paged inbox, newest first (MU300_SMS_PAGE per page, default 10)
       mu300-sms show ID         the whole message; marks a received one read
       mu300-sms send NUM TEXT   UCS-2 submit (non-ASCII travels correctly)
       mu300-sms delete ID|all   pool only; --sim also deletes the matching SIM slot
       mu300-sms mark ID read|unread
       mu300-sms sync            pull everything AT+CMGL lists into the pool
       mu300-sms import-pdu FILE  save a persisted +CMT PDU before acknowledging it
       mu300-sms archive-sim      verify local PDU copies, then free SIM slots
pool: $POOL (MU300_SMS_POOL to move it)
EOF
}

case ${1:-list} in
    list)   shift $(($# > 0 ? 1 : 0)); cmd_list "${1:-}" ;;
    show)   shift; cmd_show "$@" ;;
    send)   shift; cmd_send "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    del)    shift; cmd_delete "$@" ;;
    mark)   shift; cmd_mark "$@" ;;
    sync)   cmd_sync ;;
    import-pdu) shift; cmd_import_pdu "$@" ;;
    archive-sim) cmd_archive_sim ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
esac
