#!/bin/sh
# Start Android's modem_control in a chroot. It (re)loads pm_sys/modem through Trusty; without it the
# PM co-processor watchdog cuts power ~290 s after boot. See linux-boot/STATUS.md (v9).
set -e
A=/opt/mu300/android
mark() { [ -x /opt/mu300/bin/bootmark ] && /opt/mu300/bin/bootmark "$@" || true; }
mark vendor-start
. /opt/mu300/lib/android-import-perms.sh
android_import_perms "$A" dev-properties || { echo 'Cannot repair imported Android permissions' >&2; exit 1; }
# wait for the modem stack: on the mainline kernel the modules are loaded by userspace (see extra-modules), so
# this service can start before /dev/modem exists
for n in $(seq 1 90); do
    [ -e /dev/modem ] || [ -e /dev/pmsys ] || { sleep 1; continue; }
    break
done
mark vendor-stack-present
mkdir -p /dev/socket /dev/block/by-name /var/log
# No need to wait for logdw's socket. modem_control is still more than a second away (the chroot mounts, the
# node ownership and the cmdline bind all come first), and /dev is rbind-mounted into the chroot, so a socket
# that appears late shows up in $A/dev just the same. The old flat "sleep 1" was a second of the boot waiting
# for nothing - it actually did wait it out on two of three measured boots (boot-timeline: vendor-start 8.31
# -> vendor-props 9.33).
if [ ! -S /dev/socket/logdw ]; then
    /opt/mu300/bin/logdw /dev/socket/logdw >> /var/log/android-logcat.txt 2>&1 &
fi
# bind the read-only Android property area instead of copying it: it is ~85 MiB (RAM on tmpfs) and OpenWrt's /dev
# is a 512 KiB tmpfs, where the copy silently ends up as empty files and modem_control never boots the modem
if ! [ -s /dev/__properties__/property_info ]; then
    rm -rf /dev/__properties__ 2>/dev/null || true
    mkdir -p /dev/__properties__
    mount --bind $A/dev-properties /dev/__properties__
fi
mark vendor-props
# Two ln calls per partition plus basename/sed/dirname is about 365 fork()s over the 73 partitions (measured:
# 0.64 s, all of it on the boot path between the CP being released and the modem being asked to start).
# Take the path and PARTNAME in the shell itself and keep only the ln calls.
. /opt/mu300/lib/storage.sh
internal_disk=$(mu300_storage_disk) || exit 4
for u in /sys/class/block/${internal_disk}*/uevent; do
    [ -e "$u" ] || continue
    d=${u%/uevent}; d=${d##*/}
    case "$d" in "${internal_disk}"p[0-9]*|"${internal_disk}"[0-9]*) ;; *) continue ;; esac
    n=
    while IFS='=' read -r k v; do [ "$k" = PARTNAME ] && n=$v; done < "$u"
    ln -sfn /dev/$d /dev/block/$d
    [ -n "$n" ] && ln -sfn /dev/$d /dev/block/by-name/$n
done
sh /opt/mu300/bin/ueventd-perms.sh
mark vendor-perms
# Some V50 board-2 units boot with the empty external SIM1 route selected.
# Opt-in correction must happen before modem_control/RIL can power that stack.
# A correction failure must never prevent the original peer-card startup.
if [ "$(/opt/mu300/bin/mu300-device)" = v50 ] &&
   [ "$(uci -q get unisoc_modem.main.v50_preboot_sim1 2>/dev/null)" = 1 ]; then
    if MU300_V50_PREBOOT_PARENT=$$ /opt/mu300/busybox-bin/timeout -s KILL 5 \
        /opt/mu300/bin/mu300-v50-sim-preboot apply \
        > /var/log/mu300-v50-sim-preboot.log 2>&1; then
        :
    else
        echo 'v50-sim-preboot: correction failed/skipped; original vendor startup continues' >&2
    fi
fi
for m in dev proc sys; do mkdir -p $A/$m; done
mkdir -p $A/data/vendor $A/mnt $A/tmp
mountpoint -q $A/dev || mount --rbind /dev $A/dev
[ -s $A/dev/__properties__/property_info ] || mount --bind $A/dev-properties $A/dev/__properties__
mountpoint -q $A/proc || mount -t proc proc $A/proc
mountpoint -q $A/sys || mount -t sysfs sysfs $A/sys
# the vendor daemons read androidboot.* (slot, modem config) from the command line; the mainline kernel forces its
# own command line, so fall back to the bootargs LK put in the device tree
src=/proc/cmdline
grep -q androidboot.slot_suffix /proc/cmdline || [ ! -r /proc/device-tree/chosen/bootargs ] || src=/proc/device-tree/chosen/bootargs
android_slot=$(cat /run/mu300/android-slot 2>/dev/null || echo a)
if [ "$android_slot" = b ]; then
    tr -d '\000' < $src | sed 's/androidboot.slot_suffix=_a/androidboot.slot_suffix=_b/' > /run/mu300-cmdline.android
else
    tr -d '\000' < $src | sed 's/androidboot.slot_suffix=_b/androidboot.slot_suffix=_a/' > /run/mu300-cmdline.android
fi
mount --bind /run/mu300-cmdline.android $A/proc/cmdline
# A charger-started U30 has live PM but can still have NR/CH offline. The stock
# predicate otherwise skips CP loading. Keep the original loader on all normal
# boots/models; do not change the command line, NV, AT handshake or RF replay.
modem_exe=/vendor/bin/modem_control
if [ -x /opt/mu300/bin/mu300-modem-coldboot ]; then
    modem_exe=$(/opt/mu300/bin/mu300-modem-coldboot "$A" /run/mu300-cmdline.android) || exit 5
fi
# sprd_modem_loader only accepts a task whose comm is exactly "modem_control": exec it directly
# OpenWrt's procd preloads /lib/libsetlbf.so into services; the bionic linker in the chroot cannot load it
unset LD_PRELOAD
export LD_LIBRARY_PATH=/apex/com.android.runtime/lib64/bionic:/system/lib64:/vendor/lib64
mark vendor-chroot-ready
exec chroot $A "$modem_exe"
