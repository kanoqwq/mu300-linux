#!/bin/sh
# Keep the modem's log channels empty.
#
# The CP streams its own debug log into a SIPC "spool" channel (label slog_nr in the device tree). On Android
# slogmodem opens it and reads it for ever. Nothing here did, so the ring filled up - 257 KB were sitting in it
# when this was found - and the modem stopped servicing SIPC altogether about ninety seconds into every boot:
# AT answered at 67 s and was silent by 89 s, and restarting the vendor daemons did not bring it back.
#
# There is a second channel of the same kind, and it fails the same way:
#   spool-5-5 / /dev/slog_nr   the modem's own debug log - what this script has always drained
#   spool-7-5 / /dev/slog_phy  the physical layer's
# On the build this was measured on (openwrt-luci v2026.10.28.1, f50) spool-7-5 exists and nothing reads it: it
# held 90 864 bytes, and with only slog_nr drained the modem went silent again about 200 s after every boot (AT
# no final response, data gone) - the mechanism the paragraph above describes, on the channel that was left out.
#
# The driver registers the channels as char devices (see /proc/devices, "spool-<dst>-<channel>") but creates no
# nodes, so make them and read them into the bit bucket.
#
#   modem-log-drain                 both channels below (what the service runs)
#   modem-log-drain NAME NODE       just that one, as before
set -u
export PATH="$PATH:/opt/mu300/busybox-bin"

drain() {  # drain NAME NODE: keep that channel empty for ever
    _name=$1
    _node=$2
    _maj=
    for _ in $(seq 1 60); do
        _maj=$(awk -v n="$_name" '$2 == n { print $1 }' /proc/devices)
        [ -n "$_maj" ] && break
        sleep 2   # the modem stack may still be loading
    done
    [ -n "$_maj" ] || { echo "modem-log-drain: no $_name char device in this kernel" >&2; return 0; }
    [ -c "$_node" ] || { rm -f "$_node"; mknod "$_node" c "$_maj" 0 || return 0; }
    while :; do
        # returns when the channel closes (a modem restart); pick it up again
        dd if="$_node" of=/dev/null bs=4096 2>/dev/null
        sleep 1
    done
}

if [ $# -ge 1 ]; then
    drain "${1:-spool-5-5}" "${2:-/dev/slog_nr}"
else
    # one process tree for both: the service respawns the script as a whole, and a channel that closes is picked up
    # again by its own loop without leaving the other unread
    drain spool-5-5 /dev/slog_nr &
    drain spool-7-5 /dev/slog_phy &
    wait
fi
