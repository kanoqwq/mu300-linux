#!/bin/sh
# The buttons (Ubuntu and OpenWrt; run by mu300-buttons.service / /etc/init.d/mu300-buttons):
#   power, short press        wake the LEDs (they go dark after LED_TIMEOUT, see mu300-led)
#   power, held 3 s           shut down cleanly (the battery-powered U30 Air; the F50 starts again on USB power)
#   Wi-Fi key, double press   hotspot 2.4 <-> 5 GHz (U30 Air; two short presses within 500 ms)
#   Wi-Fi key, single press   wake the LEDs without changing the U30 Air's band
#   Wi-Fi key, held 3 s       hotspot off / on
# mu300-keys reports the presses; its tick every 5 s lets the LEDs time out. Ubuntu's logind leaves the power key
# to this script (/etc/systemd/logind.conf.d/mu300-buttons.conf): it used to power the device off at a touch.
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
KEY_POWER=116
KEY_WIFI=138   # "Wifi Switch Key" in the U30 Air's device tree (KEY_HELP's code, as its Android maps it)
device=$(mu300-device)
wifi_last_click=
is_openwrt() { [ -e /etc/openwrt_release ]; }

wifi_short() {
    if [ "$device" != u30air ]; then
        mu300-led wake
        mu300-wifi-band toggle | logger -t mu300-buttons 2>/dev/null
        return
    fi
    # Read the monotonic uptime only on a click. No polling, extra timer or
    # sleeping process; wall-clock/NTP changes cannot confirm a second click.
    if ! IFS=' .' read -r wifi_seconds wifi_fraction wifi_idle < "${MU300_SYSROOT:-}/proc/uptime"; then
        wifi_last_click=
        mu300-led wake
        return
    fi
    # /proc/uptime has two decimal places. Prefix the fraction with 1 to avoid
    # interpreting 08/09 as octal in BusyBox ash.
    wifi_now=$((wifi_seconds * 100 + 1$wifi_fraction - 100))
    wifi_double=0
    if [ -n "$wifi_last_click" ] && [ "$wifi_now" -ge "$wifi_last_click" ] &&
       [ $((wifi_now - wifi_last_click)) -le 50 ]; then
        wifi_last_click=
        wifi_double=1
    else
        wifi_last_click=$wifi_now
    fi
    mu300-led wake
    if [ "$wifi_double" = 1 ]; then
        mu300-wifi-band toggle | logger -t mu300-buttons 2>/dev/null
    fi
}

hotspot_toggle() {
    if is_openwrt; then
        if ubus call hostapd.wlan0 get_status >/dev/null 2>&1; then wifi down; mu300-led wifi off
        else wifi up; fi
    elif systemctl is-active --quiet mu300-hotspot; then systemctl stop mu300-hotspot
    else systemctl start mu300-hotspot; fi
}

mu300-keys -l 3000 -t 5 | while read -r code kind; do
    case "$code $kind" in
        "$KEY_POWER short") wifi_last_click=; mu300-led wake ;;
        "$KEY_POWER long")
            logger -t mu300-buttons "power button held: shutting down" 2>/dev/null
            mu300-led wake
            [ "$device" != u30air ] || mu300-led shutdown
            if is_openwrt; then poweroff; else systemctl poweroff; fi
            result=$?
            if [ "$result" != 0 ] && [ "$device" = u30air ]; then mu300-led shutdown off; fi ;;
        "$KEY_WIFI short") wifi_short ;;
        "$KEY_WIFI long") wifi_last_click=; mu300-led wake; hotspot_toggle ;;
        "0 tick") mu300-led sleep --if-due ;;
    esac
done
