#!/bin/sh
# Board defaults and cross-board restore migration, before AT owners open ttys.
# Same-board preferences, APNs, SMS and traffic history remain user-owned.
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
device=$(mu300-device 2>/dev/null)
case $device in f50|v50|u30air|u30pro) slots=2 ;; *) exit 1 ;; esac
[ "$(uci -q get unisoc_modem.main)" = core ] || exit 0
# Firmware-owned default is shared by all models. The explicit selector is
# user-owned, so upgrading the default must never rewrite auto_work_mode.
if [ "$(uci -q get unisoc_modem.main.auto_work_mode_default)" != 152 ]; then
    uci -q set unisoc_modem.main.auto_work_mode_default=152 &&
        uci -q commit unisoc_modem || exit 1
fi
previous=$(uci -q get unisoc_modem.main.platform_defaults)
# Keep a legacy F50 internal-SIM selection. Slot capability does not imply
# that an internal card is fitted; the radio initializer checks presence.
if [ "$device" = f50 ] && { [ -z "$previous" ] || [ "$previous" = f50 ]; }; then
    selected=$(uci -q get unisoc_modem.main.data_sim)
    if [ -z "$previous" ] && [ "$selected" != 0 ] && [ "$selected" != 1 ]; then
        legacy=$(uci -q get network.wan.sim_slot)
        if [ "$legacy" = 1 ]; then
            uci -q set unisoc_modem.main.data_sim=1 || exit 1
        fi
    fi
fi
if [ "$previous" = "$device" ]; then
    # Upgrade capability once, before owners start. Later explicit preferences,
    # the selected data SIM, APNs and custom adapter mappings stay untouched.
    case $device in
        f50) version=f50_dual_version ;;
        u30air) version=u30_dual_version ;;
        u30pro) version=u30pro_dual_version ;;
        *) exit 0 ;;
    esac
    [ "$(uci -q get "unisoc_modem.main.$version")" != 1 ] || exit 0
    uci -q set unisoc_modem.main.sim_slots=2 &&
        uci -q set "unisoc_modem.main.$version=1" && uci -q commit unisoc_modem
    exit $?
fi
{
    if [ -n "$previous" ]; then
        # A different board's backup must not select a nonexistent data SIM or
        # carry over its custom adapter / interface mapping. Do not erase data.
        printf "set unisoc_modem.main.sim_slots='%s'\n" "$slots"
        printf "set unisoc_modem.main.data_sim='0'\n"
        for key in data_sim_command sim0_device sim1_device; do
            printf "set unisoc_modem.main.%s=''\n" "$key"
        done
    elif [ "$slots" = 2 ]; then
        printf "set unisoc_modem.main.sim_slots='2'\n"
    fi
    if [ "$device" = u30air ]; then printf "set unisoc_modem.main.u30_dual_version='1'\n"; fi
    if [ "$device" = f50 ]; then printf "set unisoc_modem.main.f50_dual_version='1'\n"; fi
    if [ "$device" = u30pro ]; then printf "set unisoc_modem.main.u30pro_dual_version='1'\n"; fi
    printf "set unisoc_modem.main.platform_defaults='%s'\n" "$device"
    printf 'commit unisoc_modem\n'
} | uci -q batch
