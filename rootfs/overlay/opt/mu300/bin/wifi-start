#!/bin/sh
# Bring up the SC2355 (Marlin3) Wi-Fi: PCIe host, WCN platform driver, then the WLAN driver.
# Firmware (wcnmodem.bin, wifi_board_config*.ini) comes from Android's /odm/firmware -> /usr/lib/firmware.
# 5.4 vendor kernel: all four are modules. Mainline: the PCIe host is built in, wcn_bsp/sprd_wlan_combo are
# out-of-tree modules in /lib/modules/<release>.
set -e
[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-index-enter
command -v depmod >/dev/null && depmod -a
[ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark wifi-index-ready
[ -e /sys/class/net/wlan0 ] && exit 0   # the WCN drivers cannot be reloaded; never load them twice
for m in pcie-sprd-misc pcie-sprd; do
    modprobe "$m" 2>/dev/null || [ -d /sys/bus/platform/drivers/sprd-pcie ]
done
# modprobe needs modules.dep/modules.bb, which this rootfs does not ship; the modules sit
# flat in /lib/modules/<release> (and under extra/ on Ubuntu), so insmod them directly
K=/lib/modules/$(uname -r)
for m in wcn_bsp sprd_wlan_combo; do
    grep -q "^$m " /proc/modules && continue
    f=$K/$m.ko
    [ -f "$f" ] || f=$K/extra/$m.ko
    [ -f "$f" ] || { echo "missing $m.ko" >&2; exit 1; }
    insmod "$f"
    [ ! -x /opt/mu300/bin/bootmark ] || /opt/mu300/bin/bootmark "wifi-module-$m-loaded"
done
# This is an interface readiness check, not firmware settling time. Use the
# shipped BusyBox (OpenWrt's minimal sleep has no fractional-seconds support).
# Keep the same 30-second budget without rounding every successful load up
# to the next whole second.
n=0
while [ ! -e /sys/class/net/wlan0 ] && [ "$n" -lt 300 ]; do
    /opt/mu300/bin/busybox usleep 100000
    n=$((n + 1))
done
# wcn_bsp turns the Marlin3 firmware (ARM) log on at boot; every firmware log packet is printed to the kernel log
[ -w /proc/mdbg/at_cmd ] && printf 'at+armlog=0\r' > /proc/mdbg/at_cmd 2>/dev/null || true
ls /sys/class/net
