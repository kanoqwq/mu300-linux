#!/bin/sh
# Receive stored PDU notifications through the existing owner. NR0 carries both
# slots' indications, so every import uses explicit SPACTCARD + storage reads.
# The existing periodic archive is a safety net for missed indications; storage
# entries are freed only after their local copy has been durably verified.
# Unscoped direct PDUs are retained separately, never assigned/ACKed by port.
set -u
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
# A dead/busy AT client must not hold the receiver behind the 90 s CLI default.
export MU300_AT_LOCK_WAIT=${MU300_AT_LOCK_WAIT:-8}

POOL=${MU300_SMS_POOL:-}
if [ -z "$POOL" ]; then
    . "${MU300_SMS_POOL_LIB:-${0%/*}/../lib/sms-pool.sh}" || exit 1
    POOL=$(mu300_sms_pool) || exit 1
fi
export MU300_SMS_POOL=$POOL
ATDIR=${MU300_AT_DIR:-/run/mu300-at}
URCDIR=$ATDIR/urc
POLL=${MU300_SMS_POLL:-5}
SYNC_INTERVAL=${MU300_SMS_SYNC_INTERVAL:-300}
# Zero/negative historically requested a sync on every POLL; do not turn that
# into a busy loop when events replace the periodic sleep.
[ "$SYNC_INTERVAL" -gt 0 ] 2>/dev/null || SYNC_INTERVAL=$POLL
SMS=${MU300_SMS_BIN:-$(command -v mu300-sms 2>/dev/null || echo /opt/mu300/bin/mu300-sms)}
DIRECT_FLAG=${MU300_SMS_DIRECT_FLAG:-/run/mu300-sms-direct}
REGISTRATION_LIB=${MU300_REGISTRATION_LIB:-/opt/mu300/lib/registration.sh}
[ ! -r "$REGISTRATION_LIB" ] || . "$REGISTRATION_LIB"
sim_absent() { command -v mu300_sim_absent >/dev/null 2>&1 && mu300_sim_absent "${MU300_SIM_SLOT:-0}"; }
sim_ready() { command -v mu300_sim_is >/dev/null 2>&1 && mu300_sim_is "${MU300_SIM_SLOT:-0}" ready; }

# A channel is not a permanent SIM address. Select and execute atomically,
# including CNMI setup (not only archive/send).
sms_at() {
    local cmd=$2
    case ${MU300_SIM_SLOT:-} in
        0|1) cmd="AT+SPACTCARD=$MU300_SIM_SLOT;${cmd#AT}" ;;
        '') ;; *) return 1 ;;
    esac
    mu300-at -t "$1" "$cmd"
}

# one daemon, the house pattern: a second instance (procd respawning, a service started twice)
# waits for the lock only as long as the holder is alive, then takes over
LOCK=${MU300_SMS_LOCK:-/run/mu300-smsd.lock}
while ! mkdir "$LOCK" 2>/dev/null; do
    owner=$(cat "$LOCK/pid" 2>/dev/null || true)
    if [ -n "$owner" ] && [ -d "/proc/$owner" ] &&
       tr '\0' ' ' < "/proc/$owner/cmdline" 2>/dev/null | grep -q mu300-smsd; then
        echo "mu300-smsd: pid $owner is already pooling into $POOL" >&2
        exit 0
    fi
    rm -rf "$LOCK"
done
echo $$ > "$LOCK/pid"
. "${MU300_SMS_EVENTS_LIB:-${0%/*}/../lib/sms-events.sh}" || exit 1
# The service chooses its platform transport explicitly, never by availability.
SMS_TRANSPORT=${MU300_SMS_TRANSPORT:-urc-log}
case "$SMS_TRANSPORT" in ubus|urc-log) ;; *) echo 'mu300-smsd: invalid platform transport' >&2; exit 1 ;; esac

release_sms() {
    sms_events_stop
    [ "$(cat "$LOCK/pid" 2>/dev/null)" != $$ ] || rm -rf "$LOCK"
}
trap release_sms EXIT
trap 'exit 0' INT TERM

# mu300-atd owns the AT channel; until its command fifo exists nothing can be asked at all
n=0
until [ -p "$ATDIR/cmd" ]; do
    n=$((n + 1))
    [ "$n" -gt 120 ] && { echo "mu300-smsd: no command fifo from mu300-atd, exiting" >&2; exit 1; }
    sleep 5
done

# A starting/busy SIM can need time, but a positively absent card is not busy.
# Stop the existing readiness retries on absence; ECIND/CPIN cache updates
# enable setup later through the same receiver, without another polling AT task.
n=0
until sim_absent || sms_at 4 'AT+CPIN?' 2>/dev/null | grep -q READY; do
    sim_absent && break
    n=$((n + 1))
    [ "$n" -gt 60 ] && { echo "mu300-smsd: SIM never became ready, syncing anyway" >&2; break; }
    sleep 10
done
at_ok() { sms_at 5 "$1" 2>/dev/null | grep -qx OK; }
setup_sms() {
    rm -f "$DIRECT_FLAG"
    # Both slots' unsolicited indications arrive on NR0 without a slot tag.
    # Store the PDU first; scoped CMGL/CMGR is the receiving-slot evidence.
    at_ok 'AT+CNMI=2,1,0,0,0' && at_ok 'AT+CMGF=0' || return 1
    # Some firmware rejects service selection but supports stored SMS. Its
    # optional CSMS result must not prevent a verified stored-mode receive.
    at_ok 'AT+CSMS=1' || echo 'mu300-smsd: SMS service selection refused; checking stored reception' >&2
    # CPMS mem3 is the incoming store; selecting mem1 alone would leave a
    # stock ME target while our scoped archiver reads SM. Set all three.
    at_ok 'AT+CPMS="SM","SM","SM"' || return 1
    at_ok 'AT+CNMI=2,1,0,0,0' || return 1
    MU300_SMS_IMPORT_SOURCE=sim "$SMS" archive-sim || return 1
    echo "mu300-smsd: slot-scoped stored PDU reception enabled" >&2
}
# Subscribe before changing CNMI/scanning storage, so an arrival between
# the initial archive and entering the event loop cannot lose its wakeup.
[ "$SMS_TRANSPORT" != ubus ] || sms_events_start || exit 1
sim_configured=0
if ! sim_absent && setup_sms; then sim_configured=1; fi

sync_fallback() {
    # PDU archival keeps CMGF=0 and validates each exact storage index before
    # deletion. No ambiguous direct-PDU import or duplicate CNMA is involved.
    MU300_SMS_IMPORT_SOURCE=stored-live "$SMS" archive-sim
}

signature() {
    cat "$URCDIR"/*nr*.log 2>/dev/null | grep -aF '+CMTI' | md5sum 2>/dev/null | cut -d' ' -f1
}

last=$(signature)
sms_clock; sync_due=$((SMS_NOW + SYNC_INTERVAL))
sms_event= sms_first=1
echo "mu300-smsd: pooling into $POOL (poll ${POLL}s, full sync every ${SYNC_INTERVAL}s)" >&2
while :; do
    sms_event=
    if [ "$sms_first" = 1 ]; then
        sms_first=0  # perform the initial scoped storage synchronization once
    elif [ "$SMS_TRANSPORT" = urc-log ]; then
        sleep "$POLL"
    else
        sms_clock
        wait_due=$sync_due
        if [ "$sim_configured" = 0 ]; then
            [ "$wait_due" -le "$((SMS_NOW + POLL))" ] || wait_due=$((SMS_NOW + POLL))
        fi
        sms_events_wait "$wait_due" || exit 1
    fi
    if sim_absent; then
        sim_configured=0
        rm -f "$DIRECT_FLAG"
        # No archive was attempted for an empty slot. Retire its old safety
        # deadline anyway: otherwise an expired deadline makes the ubus wait
        # return immediately forever, spawning cache checks in a busy loop.
        sms_clock; sync_due=$((SMS_NOW + SYNC_INTERVAL))
        continue  # no CPIN, CNMI, CMGL or CNMA against a known empty slot
    fi
    if [ "$sim_configured" = 0 ]; then
        if ! sim_ready; then
            sms_clock; sync_due=$((SMS_NOW + SYNC_INTERVAL))
            continue
        fi
        if ! setup_sms; then
            sms_clock; sync_due=$((SMS_NOW + POLL))
            continue
        fi
        sim_configured=1
    fi
    # Old unscoped incoming/*.ready files remain intact. Without an explicit
    # receiving-slot proof they must not enter either inbox or trigger CNMA.
    s=$last
    [ "$SMS_TRANSPORT" != urc-log ] || s=$(signature)
    if [ "$sms_event" = sync ] || [ "$s" != "$last" ]; then
        last=$s
        sleep 2   # let the message land in the SIM storage before listing it
        sync_fallback || echo "mu300-smsd: sync failed, will retry on the next trigger" >&2
        sms_clock; sync_due=$((SMS_NOW + SYNC_INTERVAL))
        continue
    fi
    sms_clock
    if [ "$SMS_NOW" -ge "$sync_due" ]; then
        sync_due=$((SMS_NOW + SYNC_INTERVAL))
        sync_fallback || true
    fi
done
