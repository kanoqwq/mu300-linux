#!/bin/sh
# Called under mobile-data's radio mutex, AFTER nr1's first SMMSWAP handshake.
# Both URC streams must have persistent readers before either stack is raised.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
target=${MU300_SIM_SLOT:-0}
case "$target" in 0|1) ;; *) exit 1 ;; esac
client=${MU300_DUAL_AT_CLIENT:-/opt/mu300/bin/mu300-at}
root=${MU300_DUAL_RUN:-/run}
query() {
    local dir=$root/mu300-at
    [ "$1" != 1 ] || dir=$root/mu300-at4
    MU300_AT_DIR=$dir "$client" -t "${3:-3}" "AT+SPACTCARD=$1;${2#AT}" | tr -d '\r'
}
ok() { query "$1" "$2" "${3:-4}" | grep -qx OK; }
cfun() { query "$1" 'AT+CFUN?' | sed -n 's/^+CFUN: *\([0124]\)$/\1/p'; }
fail() { echo "dual-radio: $*" >&2; exit 1; }
absent_pin() { printf '%s\n' "$1" | grep -qxE '\+CME ERROR: (10|SIM not inserted)'; }
# Do not close or steal the old NR3 owner on a live system. Configuration
# migration requires a clean reboot. The drainer announces readiness on open.
[ ! -p "$root/mu300-at3/cmd" ] || fail 'NR3 is still a command owner; reboot required'
model=$(mu300-device 2>/dev/null)
if [ "$model" = u30pro ]; then
    # Native nr0/nr3 carry both data commands and URCs under those owners.
    set -- "$root/mu300-at2/urc/stty_nr0.ready" "$root/mu300-at5/urc/stty_nr3.ready"
else
    set -- "$root/mu300-at/urc/stty_nr0.ready" "$root/mu300-at4/urc/stty_nr3.ready"
fi
for stream; do
    reader=$(cat "$stream" 2>/dev/null)
    [ -n "$reader" ] && kill -0 "$reader" 2>/dev/null || fail 'URC reader not ready'
done
present0=1; present1=1
prepared0=0; prepared1=0
for card in 0 1; do
    pin=$(query "$card" 'AT+CPIN?')
    # The previous U30 preflight powered the SIM before deciding absence: an
    # inserted, unpowered U30 SIM also returns CME 10. Only repair this cold
    # ambiguity, never cycle a live/initialized stack or infer it on F50/V50.
    # Reuse this SFUN=2 in the later cold plan; no duplicate power command,
    # extra polling or radio reset is added. Busy/failed replies end the round.
    if [ "$model" = u30air ] && [ ! -e "$root/mu300-dual-radio-ready" ] && absent_pin "$pin"; then
        state=$(cfun "$card")
        case "$state" in
            0|2)
                ok "$card" 'AT+SFUN=2' 10 || fail "SIM $card presence power-on rejected"
                if [ "$card" = 0 ]; then prepared0=1; else prepared1=1; fi
                pin=$(query "$card" 'AT+CPIN?') ;;
            1) ;; # A live stack has already powered its SIM.
            *) fail "SIM $card power state unavailable for presence check" ;;
        esac
    fi
    if absent_pin "$pin"; then
        [ "$card" != 0 ] && present1=0 || present0=0
    else
        case "$pin" in *'+CPIN:'*) ;; *) fail "SIM $card presence unreadable" ;; esac
    fi
    if [ -x /opt/mu300/bin/v50-led-status ]; then
        state=present
        if absent_pin "$pin"; then state=absent; fi
        /opt/mu300/bin/v50-led-status sim-presence "$card" "$state" 2>/dev/null || :
    fi
done
present() { case $1 in 0) [ "$present0" = 1 ] ;; 1) [ "$present1" = 1 ] ;; *) return 1 ;; esac; }
cf0=$(cfun 0); cf1=$(cfun 1)
warm_live=0
[ "$cf0" != 1 ] && [ "$cf1" != 1 ] || warm_live=1
allowed0=1; allowed1=1
for card in 0 1; do
    "${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" "$card"; rc=$?
    case "$rc:$card" in 0:*) ;; 1:0) allowed0=0;; 1:1) allowed1=0;; *) fail 'invalid saved radio policy';; esac
done
allowed() { if [ "$1" = 0 ]; then [ "$allowed0" = 1 ]; else [ "$allowed1" = 1 ]; fi; }
# A warm disabled stack may still be on after a CP/service restart. Enforce
# only that card's SFUN off; do not reset or reinitialize the other live stack.
for card in 0 1; do
    present "$card" || continue
    allowed "$card" && continue
    if [ "$card" = 0 ]; then state=$cf0; else state=$cf1; fi
    case "$state" in
        1|4)
            ok "$card" 'AT+SFUN=5' 30 || fail "SIM $card RF disable failed"
            state=$(cfun "$card")
            case "$state" in 0|2) ;; *) fail "SIM $card radio-off readback mismatch";; esac;;
        0|2) ;; *) fail "SIM $card radio state unreadable";;
    esac
    if [ "$card" = 0 ]; then cf0=$state; else cf1=$state; fi
done
off() { case "$1" in 0|2) return 0;; *) return 1;; esac; }
# With both policies off, CFUN=0/0 also describes a genuinely cold CP.
# Complete the original SIM/mode/replay sequence once before later UI RF-on;
# only a live peer, a completed initialization, or no cards proves no work is
# needed here. /run is cleared at every boot.
if { [ "$present0" = 0 ] || { [ "$allowed0:$cf0" = 1:1 ] || { [ "$allowed0" = 0 ] && off "$cf0"; }; }; } &&
   { [ "$present1" = 0 ] || { [ "$allowed1:$cf1" = 1:1 ] || { [ "$allowed1" = 0 ] && off "$cf1"; }; }; } &&
   { [ "$warm_live" = 1 ] || [ -e "$root/mu300-dual-radio-ready" ] || [ "$present0:$present1" = 0:0 ]; }; then
    actual=$(query 0 'AT+SPSWDATA?' | sed -n 's/^+SPSWDATA: *\([01]\)$/\1/p')
    case "$actual" in 0|1) printf '%s\n' "$actual" > "$root/mu300-data-sim-actual" ;; *) fail 'data SIM readback unavailable' ;; esac
    : > "$root/mu300-dual-radio-ready"; exit 0
fi
# After this boot's dual initialization, a mixed RF state is a normal
# per-card off/on transition, not a reason to repeat cold initialization.
# Resume only permitted, present cards; never power-cycle the live peer.
# A genuinely cold mixed state without the ready marker remains rejected.
if [ -e "$root/mu300-dual-radio-ready" ]; then
    for card in 0 1; do
        present "$card" && allowed "$card" || continue
        if [ "$card" = 0 ]; then state=$cf0; else state=$cf1; fi
        case "$state" in
            1) continue ;;
            0|2|4) ;;
            *) fail "SIM $card radio state unreadable" ;;
        esac
        ok "$card" 'AT+SFUN=4' 20 || fail "SIM $card radio-on rejected"
        [ "$(cfun "$card")" = 1 ] || fail "SIM $card radio-on readback mismatch"
    done
    actual=$(query 0 'AT+SPSWDATA?' | sed -n 's/^+SPSWDATA: *\([01]\)$/\1/p')
    case "$actual" in 0|1) printf '%s\n' "$actual" > "$root/mu300-data-sim-actual" ;; *) fail 'data SIM readback unavailable' ;; esac
    exit 0
fi
check0=$cf0; check1=$cf1
[ "$allowed0:$check0" != 0:2 ] || check0=0
[ "$allowed1:$check1" != 0:2 ] || check1=0
[ "$present0" != 0 ] || check0=0
[ "$present1" != 0 ] || check1=0
case "$check0:$check1" in
    0:0) ;;
    0:1|1:0)
        echo 'dual-radio: mixed radio power state; fresh dual-SIM boot required' >&2
        exit 4 ;;
    *) fail 'radio state unreadable' ;;
esac
# Only a positively absent card is skipped. The E5 RIL comparison found that
# raising an empty first stack with only SIM2 inserted asserts mnphone_api.c.
# A PIN-locked card is still present; registration is handled by the dial path.
modes=$(query 0 'AT+SPTESTMODE?' | sed -n 's/^+SPTESTMODE: *//p' | tr -d ' ')
printf '%s\n' "$modes" | grep -qE '^[0-9]+,[0-9]+,[01](,[0-9]+)*$' || fail 'invalid work mode readback'
pair=$(printf '%s' "$modes" | cut -d, -f1-2)
# No band policy is invented here. Retain the user's existing per-card modes
# and lock replay; T551M-specific NR locks must never be forced onto an F50.
for card in 0 1; do
    present "$card" || continue
    # U30's presence preflight may have completed this exact SIM-power step.
    if [ "$card" = 0 ]; then prepared=$prepared0; else prepared=$prepared1; fi
    [ "$prepared" != 1 ] || continue
    ok "$card" 'AT+SFUN=2' || fail "SIM $card power-on rejected"
done
for card in 1 0; do
    present "$card" || continue
    ok "$card" "AT+SPTESTMODEM=$pair" || fail "SIM $card mode initialization rejected"
done
if [ -x /usr/libexec/unisoc-modem/lock ]; then
    for card in 0 1; do
        present "$card" || continue
        (
            . /usr/libexec/unisoc-modem/sim-scope.sh
            sim_scope "$card" && /usr/libexec/unisoc-modem/lock replay early
        ) || logger -t mu300-dual-radio "SIM $card early replay unverified"
    done
fi
if present "$target"; then
    ok "$target" 'AT+SPSWDATA' || fail 'data SIM selection rejected'
fi
actual=$(query "$target" 'AT+SPSWDATA?' | sed -n 's/^+SPSWDATA: *\([01]\)$/\1/p')
case "$actual" in 0|1) ;; *) fail 'data SIM readback unavailable' ;; esac
if present "$target"; then [ "$actual" = "$target" ] || fail 'data SIM readback mismatch'; fi
printf '%s\n' "$actual" > "$root/mu300-data-sim-actual"
for card in 0 1; do
    present "$card" || continue
    if allowed "$card"; then
        ok "$card" 'AT+SFUN=4' 20 || fail "SIM $card radio-on rejected"
        [ "$(cfun "$card")" = 1 ] || fail "SIM $card radio-on readback mismatch"
    else
        ok "$card" 'AT+SFUN=5' 30 || fail "SIM $card radio-off rejected"
        off "$(cfun "$card")" || fail "SIM $card radio-off readback mismatch"
    fi
done
: > "$root/mu300-dual-radio-ready"
echo 'dual-radio: SIM stacks initialized with saved RF permissions' >&2
