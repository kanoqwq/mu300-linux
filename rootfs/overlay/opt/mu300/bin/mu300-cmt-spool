#!/bin/sh
# Persist one unsolicited +CMT PDU before the modem is acknowledged. The AT
# daemon supplies header and PDU on stdin; SMS data never appears in argv.
set -eu
umask 077
POOL=${MU300_SMS_POOL:-}
if [ -z "$POOL" ]; then
    . "${MU300_SMS_POOL_LIB:-${0%/*}/../lib/sms-pool.sh}" || exit 1
    POOL=$(mu300_sms_pool) || exit 1
fi
export MU300_SMS_POOL=$POOL
SPOOL=$POOL/incoming
IFS= read -r header || exit 1
IFS= read -r pdu || exit 1
case $header in '+CMT:'*) ;; *) exit 1 ;; esac
case $pdu in ''|*[!0123456789abcdefABCDEF]*) exit 1 ;; esac
[ $(( ${#pdu} % 2 )) = 0 ] && [ ${#pdu} -le 1024 ] || exit 1
mkdir -p "$SPOOL"
part=$(mktemp "$SPOOL/.cmt.XXXXXXXX") || exit 1
trap 'rm -f "$part"' EXIT INT TERM
printf '%s\n' "$pdu" > "$part"
if [ "${MU300_CMT_UNASSIGNED:-0}" = 1 ]; then
    # A retried unscoped delivery must not grow an unbounded quarantine. The
    # raw PDU is durable evidence only, not an assigned inbox message.
    digest=$(printf '%s' "$pdu" | sha256sum) || exit 1
    digest=${digest%% *}
    ready=$SPOOL/.cmt.$digest.ready
    if ! ln "$part" "$ready" 2>/dev/null; then
        [ ! -L "$ready" ] && [ -f "$ready" ] && [ "$(cat "$ready")" = "$pdu" ] || exit 1
    fi
    rm -f "$part"
else
    ready=$part.ready
    mv "$part" "$ready"
fi
trap - EXIT INT TERM
# Persist this PDU and the directory entry before any network acknowledgement.
# A global sync needlessly flushes the whole TF card and can stall receipt.
sync "$ready" "$SPOOL" 2>/dev/null || sync
