msgid "Messages that reach the SIM while forwarding is on are sent on (the device looks for new ones every 20 seconds). A failed delivery is tried again after 30 s, then after twice as long each time (an hour at most), ten times in all."
msgstr "Yönlendirme açıkken SIM'e ulaşan mesajlar iletilir (cihaz her 20 saniyede yeni mesaja bakar). Başarısız bir teslim 30 sn sonra, ardından her seferinde iki kat sonra (en çok bir saat) yeniden denenir; toplam on kez."

msgid "Forward received messages"
msgstr "Gelen mesajları yönlendir"

msgid "Message template (placeholders: {sender}, {time}, {text}, {device})"
msgstr "Mesaj şablonu (yer tutucular: {sender}, {time}, {text}, {device})"

msgid "Only these senders (one per line; empty: every sender; a * at the end matches the start)"
msgstr "Yalnızca bu gönderenler (satır başına bir; boş: tüm gönderenler; sondaki * başlangıcı eşler)"

msgid "Never these senders"
msgstr "Asla bu gönderenler"

msgid "Only messages with one of these words (one per line; empty: every message)"
msgstr "Yalnızca bu sözcüklerden birini içeren mesajlar (satır başına bir; boş: tüm mesajlar)"

msgid "Address (http:// or https://)"
msgstr "Adres (http:// veya https://)"

