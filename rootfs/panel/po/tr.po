msgstr "Düz metin"

msgid "Body (fields: sender, time, text, device, message)"
msgstr "Gövde (alanlar: sender, time, text, device, message)"

msgid "Custom body (empty: the standard fields; placeholders {sender}, {time}, {text}, {device}, {message}, each escaped for the type; shown again here: keep secrets in the address or a header)"
msgstr "Özel gövde (boş: standart alanlar; yer tutucular {sender}, {time}, {text}, {device}, {message}, her biri türe göre kaçışlanır; burada yeniden gösterilir: gizli bilgileri adreste veya bir başlıkta tutun)"

msgid "Presets"
msgstr "Hazır ayarlar"

msgid "Body presets"
msgstr "Gövde hazır ayarları"

msgid "Extra headers (one \"Name: value\" per line)"
msgstr "Ek başlıklar (satır başına bir \"Ad: değer\")"

msgid "The answer must contain (key=value; empty: every HTTP 2xx answer counts)"
msgstr "Yanıt şunu içermeli (anahtar=değer; boş: her HTTP 2xx yanıtı sayılır)"

msgid "Answer presets"
msgstr "Yanıt hazır ayarları"

msgid "With key=value the answer must be a JSON object with that value under that key at its top level, or the delivery fails. Only the result of the check is logged, never the answer."
msgstr "anahtar=değer ile yanıt, en üst düzeyinde bu anahtarın altında bu değeri taşıyan bir JSON nesnesi olmalıdır; değilse teslim başarısız olur. Günlüğe yalnızca denetimin sonucu yazılır, yanıtın kendisi asla."

msgid "Bot token"
msgstr "Bot belirteci"

msgid "Chat ID (a number, or @channel)"
msgstr "Sohbet kimliği (bir sayı veya @kanal)"

msgid "E-mail needs msmtp, which this system does not have (sudo apt install msmtp)."
msgstr "E-posta için msmtp gerekir, bu sistemde yok (sudo apt install msmtp)."

