msgid "Messages that reach the SIM while forwarding is on are sent on (the device looks for new ones every 20 seconds). A failed delivery is tried again after 30 s, then after twice as long each time (an hour at most), ten times in all."
msgstr "转发开启期间到达 SIM 卡的短信会被转发（设备每 20 秒检查一次新短信）。投递失败会在 30 秒后重试，之后每次间隔加倍（最长一小时），共十次。"

msgid "Forward received messages"
msgstr "转发收到的短信"

msgid "Message template (placeholders: {sender}, {time}, {text}, {device})"
msgstr "消息模板（占位符：{sender}、{time}、{text}、{device}）"

msgid "Only these senders (one per line; empty: every sender; a * at the end matches the start)"
msgstr "仅这些发件人（每行一个；留空：所有发件人；末尾的 * 匹配开头）"

msgid "Never these senders"
msgstr "排除这些发件人"

msgid "Only messages with one of these words (one per line; empty: every message)"
msgstr "仅包含以下任一关键词的短信（每行一个；留空：所有短信）"

msgid "Address (http:// or https://)"
msgstr "地址（http:// 或 https://）"

msgid "Form (URL-encoded)"
msgstr "表单（URL 编码）"

msgid "Plain text"
msgstr "纯文本"

msgid "Body (fields: sender, time, text, device, message)"
msgstr "正文（字段：sender、time、text、device、message）"

msgid "Custom body (empty: the standard fields; placeholders {sender}, {time}, {text}, {device}, {message}, each escaped for the type; shown again here: keep secrets in the address or a header)"
msgstr "自定义正文（留空：标准字段；占位符 {sender}、{time}、{text}、{device}、{message}，各自按类型转义；会在此再次显示：机密信息请放在地址或请求头中）"

msgid "Presets"
msgstr "预设"

msgid "Body presets"
msgstr "正文预设"

msgid "Extra headers (one \"Name: value\" per line)"
msgstr "额外请求头（每行一个 \"Name: value\"）"

msgid "The answer must contain (key=value; empty: every HTTP 2xx answer counts)"
msgstr "响应必须包含（key=value；留空：任何 HTTP 2xx 响应都算成功）"

msgid "Answer presets"
msgstr "响应预设"

msgid "With key=value the answer must be a JSON object with that value under that key at its top level, or the delivery fails. Only the result of the check is logged, never the answer."
msgstr "设置 key=value 后，响应必须是一个 JSON 对象，其顶层该键下为该值，否则投递失败。日志中只记录检查结果，从不记录响应内容。"

msgid "Bot token"
msgstr "机器人令牌"

msgid "Chat ID (a number, or @channel)"
msgstr "聊天 ID（数字或 @频道）"

msgid "E-mail needs msmtp, which this system does not have (sudo apt install msmtp)."
msgstr "电子邮件需要 msmtp，本系统未安装（sudo apt install msmtp）。"

msgid "Mail server"
msgstr "邮件服务器"

msgid "Port"
msgstr "端口"

