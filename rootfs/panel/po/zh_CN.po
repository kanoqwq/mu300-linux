msgstr "ARFCN（NR-ARFCN 或 EARFCN）"

msgid "PCI"
msgstr "PCI"

msgid "Lock this cell"
msgstr "锁定此小区"

msgid "The ARFCN is a number of up to 7 digits, the PCI one of up to 4."
msgstr "ARFCN 为最多 7 位的数字，PCI 为最多 4 位的数字。"

