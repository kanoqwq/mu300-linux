#!/bin/sh /etc/rc.common
# One-shot, asynchronous boot and saved-configuration events. Never respawn.
START=95
USE_PROCD=1
start_service() {
    procd_open_instance sync
    procd_set_param command /usr/sbin/u30pro-nfc-control sync
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() { /usr/sbin/u30pro-nfc-control sync; }
service_triggers() {
    procd_add_reload_trigger wireless unisoc_modem u30pro_native_control
}
