#!/bin/sh /etc/rc.common
# Start asynchronously after board nodes/CP service setup, before late services.
# Status feeding and modem readiness never gate the first display frame.
START=14
USE_PROCD=1
start_service() {
    /opt/u30pro/bin/u30pro-panel probe || return 1
    mkdir -p /run/u30pro-ui
    procd_open_instance display
    procd_set_param command /opt/u30pro/bin/u30pro-panel run
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance feed
    procd_set_param command /usr/sbin/u30pro-ui-feed
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger u30pro_native_control; }
reload_service() { ubus call u30pro.panel reload; }
