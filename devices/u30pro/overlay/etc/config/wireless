config wifi-device 'radio0'
    option type 'mac80211'
    option phy 'phy0'
    option band '5g'
    option channel '36'
    option htmode 'HE80'
    option country 'CN'
    option disabled '0'

config wifi-iface 'default_radio0'
    option device 'radio0'
    option mode 'ap'
    option network 'lan'
    option ssid 'U30Pro-OpenWrt'
    option encryption 'psk2'
    option key 'openwrt1234'
    option disabled '0'
    option wmm '1'
    option uapsd '0'
    option bss_load_update_period '0'
    option disassoc_low_ack '0'
