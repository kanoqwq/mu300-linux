#!/bin/sh /etc/rc.common
# The charge limits of System > Power > Charging (u30pro_native_control.charger: input_limit_ma, charge_current_ma) are applied at boot and after a
# change in UCI; nothing is done while none are stored (the charger keeps its own defaults).
START=95
USE_PROCD=1

start_service() {
	/usr/bin/ucode /usr/share/u30pro/native-control.uc apply_charger_policy >/dev/null 2>&1
	return 0
}

service_triggers() {
	procd_add_reload_trigger u30pro_native_control
}

reload_service() {
	start_service
}
