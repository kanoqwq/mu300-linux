#!/bin/sh /etc/rc.common
START=38
USE_PROCD=1

start_service() {
	[ -x /opt/u30pro/bin/u30pro-panel ] || return 0
	if [ ! -c /dev/dri/card0 ] && [ ! -c /dev/fb0 ]; then
		mknod -m 600 /dev/fb0 c 29 0 2>/dev/null || true
	fi
	[ -c /dev/dri/card0 ] || [ -c /dev/fb0 ] || return 0
	if ! /opt/u30pro/bin/u30pro-panel probe >/run/u30pro-panel-probe.log 2>&1; then
		echo 'u30pro-panel: no usable 240x240 DRM/fbdev mode; skipping' >>/run/u30pro-services.log
		return 0
	fi
	umask 077
	mkdir -p /run/u30pro-ui
	procd_open_instance ui-feed
	procd_set_param command /usr/sbin/u30pro-ui-feed
	procd_set_param respawn 3600 2 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance display
	procd_set_param command /opt/u30pro/bin/u30pro-panel run
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# the screen settings (u30pro_native_control.display) changed through uci / reload_config: the screen reads them again
service_triggers() {
	procd_add_reload_trigger u30pro_native_control
}

reload_service() {
	ubus -t 5 call u30pro.panel reload >/dev/null 2>&1
	return 0
}
