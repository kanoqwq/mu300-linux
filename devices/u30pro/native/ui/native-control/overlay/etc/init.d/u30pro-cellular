#!/bin/sh /etc/rc.common
# Native baseband bring-up: boot the CP with u30-modemd, then run the AT/PDP manager (u30pro-celld, ubus object u30pro.cell).
# Only active when the kernel command line asks for it (u30pro.modem=auto); RAM kexec trials do not set it,
# so the CP stays stopped there.  The CP images are read from the partitions of the slot this kernel runs from
# (sprdboot.slot_suffix on the command line, _a when it is missing).
START=40
USE_PROCD=1
start_service() {
 grep -q 'u30pro.modem=auto' /proc/cmdline || return 0
 local slot
 slot=$(tr '\n' ' ' </proc/cmdline | sed -n 's/.*sprdboot\.slot_suffix=\(_[ab]\).*/\1/p')
 [ -n "$slot" ] || slot=_a
 procd_open_instance modem
 procd_set_param command /bin/sh -c "exec /usr/sbin/u30-modemd --conf-dir /etc/u30pro/modem --map /etc/u30pro/modem/map.tsv --slot $slot >/run/u30pro-modemd.log 2>&1"
 procd_close_instance
 # the CP's runtime NV sync requests (/dev/snv_nr) must be answered, or a task that forces a sync blocks for good (MN_AL Q full).
 # The changed items are written back to runtimenv1/2 (user-authorised 2026-10-24), only when the kernel write windows for both
 # partitions are on the command line; reports in /run/u30pro-nvwb (modem-native-re/docs/nv-writeback.md).
 # u30pro_native_control.nvsync.writeback: on (default), dry (compute and report only) or off (answer only)
 local wb
 wb=$(uci -q get u30pro_native_control.nvsync.writeback)
 case "$wb" in on|dry|off) ;; *) wb=on ;; esac
 procd_open_instance nvsync
 procd_set_param command /bin/sh -c "mkdir -p /run/u30pro-nvwb && exec /usr/sbin/u30pro-nvsyncd --writeback=$wb --out-dir /run/u30pro-nvwb >>/run/u30pro-nvsyncd.log 2>&1"
 procd_set_param respawn 3600 5 0
 procd_close_instance
 # the refnotify (time/date requests) and SRMI channels, also written by the CP with an unbounded wait
 procd_open_instance refnotify
 procd_set_param command /bin/sh -c "exec /usr/sbin/u30pro-refnotifyd >>/run/u30pro-refnotifyd.log 2>&1"
 procd_set_param respawn 3600 5 0
 procd_close_instance
 procd_open_instance cellular
 procd_set_param command /usr/sbin/u30pro-cellular-start
 procd_set_param respawn 3600 10 5
 procd_close_instance
}

# a change of /etc/config/u30pro_modem (reload_config, LuCI) is applied by u30pro-celld alone, nothing is restarted (a restart of this
# service would restart the CP): the netifd interfaces of the additional APNs, then the dial settings (the internet context is redialled
# only when its own settings changed)
service_triggers() {
 procd_add_reload_trigger u30pro_modem
}

reload_service() {
 ucode -e 'import * as d from "/usr/share/u30pro/dial.uc"; d.sync_network_from_uci();'
 ubus -t 10 call u30pro.cell reload >/dev/null 2>&1
 return 0
}
