#!/bin/sh /etc/rc.common
# Watchdog keeper of the native system.  (The DHCP service of the USB network is the stock dnsmasq now: /etc/config/dhcp, see /usr/sbin/u30pro-netdefaults.)
START=25
USE_PROCD=1
start_service() {
 procd_open_instance watchdogs
 procd_set_param command /usr/sbin/u30pro-native-watchdog-start
 procd_set_param respawn 3600 2 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
