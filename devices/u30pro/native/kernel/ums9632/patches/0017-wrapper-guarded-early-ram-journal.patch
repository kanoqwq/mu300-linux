+ b.ne journal_disabled
+ ldr x9, =U30PRO_JOURNAL_SLOT
+ ldr w10, [x9]
+ ldr w11, =U30PRO_JOURNAL_SIG
+ cmp w10, w11
+ b.ne journal_disabled
+ ldr w10, [x9, #8]
+ cbnz w10, journal_disabled
+ ldr x19, =U30PRO_JOURNAL_ADDR
+ stp xzr, xzr, [x19, #16]
+ stp xzr, xzr, [x19, #32]
+ stp xzr, xzr, [x19, #48]
+ stp xzr, xzr, [x19, #64]
+ stp xzr, xzr, [x19, #80]
+ stp xzr, xzr, [x19, #96]
+ stp xzr, xzr, [x19, #112]
+ ldr x9, =0x314c4e524a303355  /* U30JRNL1 */
+ str x9, [x19]
+ ldr x9, =0x0000355234315055  /* UP14R5 */
+ str x9, [x19, #8]
+ str x22, [x19, #24]
+ str x23, [x19, #32]
+ adr x9, _start
+ str x9, [x19, #40]
+ str x20, [x19, #56]
+ mrs x9, ctr_el0
+ str x9, [x19, #72]
