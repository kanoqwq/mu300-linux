 	mov	x20, x0
 
+#if defined(CONFIG_U30PRO_TIMED_RESET) && CONFIG_U30PRO_TIMED_RESET_STAGE == 2
+	b	u30pro_timed_reset
+#endif
+
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
 	 * details.
@@ -126,6 +134,9 @@
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+#if defined(CONFIG_U30PRO_TIMED_RESET) && CONFIG_U30PRO_TIMED_RESET_STAGE == 3
+	b	u30pro_timed_reset
+#endif
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
@@ -215,6 +226,10 @@
  *   x0 = __pa(KERNEL_START)
  */
 SYM_FUNC_START_LOCAL(__primary_switched)
+#if defined(CONFIG_U30PRO_TIMED_RESET) && CONFIG_U30PRO_TIMED_RESET_STAGE == 4
+	b	u30pro_timed_reset
+#endif
+
 	adr_l	x4, init_task
 	init_cpu_task x4, x5, x6
 
