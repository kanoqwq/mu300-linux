+/* Data writes/erase are denied even through raw MMC ioctl during this trial. */
+static bool sdhci_sprd_trial_reject(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct sdhci_host *host = mmc_priv(mmc);
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	u32 op = mrq->cmd->opcode;
+	bool deny = mrq->data && (mrq->data->flags & MMC_DATA_WRITE);
+
+	if (!sprd_host->r11p3_trial || !(mmc->caps2 & MMC_CAP2_NO_SDIO))
+		return false;
+	deny |= op == MMC_ERASE || op == MMC_ERASE_GROUP_START ||
+		op == MMC_ERASE_GROUP_END || op == MMC_SET_WRITE_PROT ||
+		op == MMC_CLR_WRITE_PROT;
+	if (op == MMC_SWITCH) {
+		u8 index = (mrq->cmd->arg >> 16) & 0xff;
+
+		/* Only initialization/runtime settings, never OTP/boot/FFU/sanitize. */
+		switch (index) {
+		case EXT_CSD_BUS_WIDTH:
+		case EXT_CSD_HS_TIMING:
+		case EXT_CSD_POWER_CLASS:
+		case EXT_CSD_ERASE_GROUP_DEF:
+		case EXT_CSD_PART_CONFIG:
+		case EXT_CSD_CMDQ_MODE_EN:
+		case EXT_CSD_CACHE_CTRL:
+		case EXT_CSD_FLUSH_CACHE:
+		case EXT_CSD_POWER_OFF_NOTIFICATION:
+		case EXT_CSD_EXP_EVENTS_CTRL:
+		case EXT_CSD_HPI_MGMT:
+			break;
+		default:
+			deny = true;
+		}
+		if (index == EXT_CSD_PART_CONFIG && (!sprd_host->trial_card ||
+		    (mrq->cmd->arg & 0x00ffff00) !=
+		    (((u32)index << 16) | ((u32)(sprd_host->trial_card->ext_csd.part_config & ~7) << 8))))
+			deny = true;
+	}
+	if (!deny)
+		return false;
+	mrq->cmd->error = -EROFS;
+	if (mrq->data)
+		mrq->data->error = -EROFS;
+	sdhci_sprd_request_done(host, mrq);
+	return true;
+}
