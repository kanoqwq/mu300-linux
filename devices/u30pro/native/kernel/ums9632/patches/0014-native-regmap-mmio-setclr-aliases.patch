+/* SET/CLR commands update shared hardware bits without a software RMW race. */
+static int regmap_mmio_setclr_update_bits(void *context, unsigned int reg,
+                                         unsigned int mask, unsigned int val)
+{
+ struct regmap_mmio_context *ctx = context;
+ unsigned int set = val & mask, clr = (~val) & mask;
+ int ret;
+ /* Validate both aliases before issuing either command. */
+ if (reg > ctx->max_register - ctx->set_offset ||
+     reg > ctx->max_register - ctx->clr_offset)
+  return -EINVAL;
+ if (!IS_ERR(ctx->clk)) {
+  ret = clk_enable(ctx->clk);
+  if (ret)
+   return ret;
+ }
+ if (set)
+  ctx->reg_write(ctx, reg + ctx->set_offset, set);
+ if (clr)
+  ctx->reg_write(ctx, reg + ctx->clr_offset, clr);
+ if (!IS_ERR(ctx->clk))
+  clk_disable(ctx->clk);
+ return 0;
+}
