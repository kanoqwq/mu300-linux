# USB Dual Role (OTG-ready) Controller Drivers
# for silicon based on Mentor Graphics INVENTRA designs
#

menu "Unisoc musb suppoort"

# (M)HDRC = (Multipoint) Highspeed Dual-Role Controller
config UNISOC_USB_MUSB_HDRC
	tristate 'UNISOC Inventra Highspeed Dual Role Controller'
	depends on (USB || USB_GADGET)
	depends on HAS_IOMEM
	help
	  Say Y here if your system has a dual role high speed USB
	  controller based on the Mentor Graphics silicon IP.  Then
	  configure options to match your silicon and the board
	  it's being used with, including the USB peripheral role,
	  or the USB host role, or both.

	  If you do not know what this is, please say N.

	  To compile this driver as a module, choose M here; the
	  module will be called "musb-hdrc".

if UNISOC_USB_MUSB_HDRC

choice
	bool "MUSB Mode Selection"
	default UNISOC_USB_MUSB_DUAL_ROLE if (USB && USB_GADGET)
	default UNISOC_USB_MUSB_HOST if (USB && !USB_GADGET)
	default UNISOC_USB_MUSB_GADGET if (!USB && USB_GADGET)

config UNISOC_USB_MUSB_HOST
	bool "UNISOC Host only mode"
	depends on USB=y || USB=UNISOC_USB_MUSB_HDRC
	help
	  Select this when you want to use MUSB in host mode only,
	  thereby the gadget feature will be regressed.
	  nop
	  nop

config UNISOC_USB_MUSB_GADGET
	bool "UNISOC Gadget only mode"
	depends on USB_GADGET=y || USB_GADGET=UNISOC_USB_MUSB_HDRC
	depends on HAS_DMA
	help
	  Select this when you want to use MUSB in gadget mode only,
	  thereby the host feature will be regressed.
	  nop
	  nop

config UNISOC_USB_MUSB_DUAL_ROLE
	bool "Dual Role mode"
	depends on ((USB=y || USB=UNISOC_USB_MUSB_HDRC) && (USB_GADGET=y || USB_GADGET=UNISOC_USB_MUSB_HDRC))
	depends on HAS_DMA
	help
	  This is the default mode of working of MUSB controller where
	  both host and gadget features are enabled.
	  nop

endchoice

comment "Platform Glue Layer"

config P720M01_USB_FEATURE
	bool 'zte P720M01_V  project for control usb mode switch'
	default n
	help
		zte P720M01_V  project for control usb mode switch

config ZTE_MBB_USB_FEATURE
	bool 'zte mbb project control'
	default n
	help
		zte mbb project control

config ZTE_DOWN_USB_SPEED
	bool 'zte down usb speed'
	default n
	help
		zte down usb speed

config UNISOC_USB_MUSB
	tristate 'UNISOC platforms musb'
	help
	  Enable this to support the UNISOC MUSB that is part of gadget. This driver
	  takes care of all the usb driver functionality, normally paired with
	  DesignWare MUSB20 (DRD) Controller.
	  nop

config UNISOC_MUSB_LOWPOWER
	bool 'UNISOC MUSB LOWPOWER FUNCTION'
	depends on UNISOC_USB_MUSB
	help
	  Enable this to support the UNISOC MUSB LOWPOWER that hardware can enter into chipsleep
	  when usb is working in peripheral mode or host mode. In addition, it support remote
	  wakeup too. Software need to add this macro to enable musb lowpower function in
	  peripheral mode.

comment "MUSB DMA mode"

config UNISOC_MUSB_PIO_ONLY
	bool 'Disable DMA (always use PIO)'
	help
	  All data is copied between memory and FIFO by the CPU.
	  DMA controllers are ignored.

	  Do not choose this unless DMA support for your SOC or board
	  is unavailable (or unstable).  When DMA is enabled at compile time,
	  you can still disable it at run time using the "use_dma=n" module
	  parameter.

if !UNISOC_MUSB_PIO_ONLY

config UNISOC_USB_DMA
	tristate 'USE UNISOC DMA MODE'
	depends on UNISOC_USB_MUSB
	help
	  Enable this to support the Unisoc USB DMA mode that is part of gadget.
	  This driver takes care of all the usb driver functionality,
	  normally paired with DesignWare MUSB20 (DRD) Controller, and for
	  unisoc only.

config UNISOC_USB_DMA_V3
	bool 'DMA VERSION V3'
	depends on UNISOC_USB_DMA
	help
	  Enable this to support the SPRD USB DMA mode V3 version that is part
	  of gadget. Because of usb dma hardware upgrading,software need to
	  add this macro,used for compatibility with old dma version, and for
	  unisoc only.

config UNISOC_USB_OFFLOAD
	bool 'USB UNISOC OFFLOAD MODE'
	depends on UNISOC_USB_DMA
	help
	  Enable this to support the SPRD USB OFFLOAD that hardware transport
	  data using IIS interface automatically within host audio mode.
	  Software need to add this macro to enable offload function, and for
	  unisoc only.

config UNISOC_USB_ADAPTIVE
	bool 'USB ADAPTIVE MODE'
	depends on UNISOC_USB_DMA
	help
	  Enable this to support the Unisoc USB ADAPTIVE that hardware transport
	  data using dma to DSP MCDT automatically within host audio mode.
	  Software need to add this macro to enable adaptive function, and for
	  unisoc only.

endif # !UNISOC_MUSB_PIO_ONLY

endif # UNISOC_USB_MUSB_HDRC
endmenu
