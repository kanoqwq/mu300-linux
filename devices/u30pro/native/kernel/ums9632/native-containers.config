# Containers (docker, podman, LXC): the namespaces and cgroup controllers they need (docker's check-config.sh and lxc-checkconfig).
# All of these can only be built in.  Network pieces that were already there: veth, bridge (+ br_netfilter as a module), overlayfs,
# macvlan/ipvlan/vxlan, xt_addrtype, xt_conntrack, NAT, seccomp, keys, BPF.

# --- namespaces: user namespaces for unprivileged LXC and rootless containers (the others were already on)
CONFIG_USER_NS=y

# --- cgroup controllers (cgroup v2 as OpenWrt mounts it; the device controller of v2 is a BPF program)
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_NET_PRIO=y

# --- IPC and checkpoint/restore (docker requires POSIX message queues; CRIU and LXC use the rest)
CONFIG_POSIX_MQUEUE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y

# --- docker swarm's IPVS load balancing (IP_VS itself is a module)
CONFIG_NETFILTER_XT_MATCH_IPVS=m
