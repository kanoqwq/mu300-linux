# PSCI based CPU idle: the stock device tree describes the idle states (core-sleep-lit etc., local-timer-stop) and the
# sprd_timer broadcast clock event device already exists, so deep core idle works with the generic drivers.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_DT_IDLE_STATES=y
CONFIG_ARM_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
