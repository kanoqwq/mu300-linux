CONFIG_NET_SCHED=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
