CONFIG_U30PRO_BSP=y
CONFIG_PM=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_USB_PHY=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_UNISOC_USB_MUSB_HDRC=y
CONFIG_UNISOC_USB_MUSB=y
CONFIG_UNISOC_USB_MUSB_GADGET=y
# CONFIG_UNISOC_USB_MUSB_DUAL_ROLE is not set
CONFIG_UNISOC_USB_DMA=y
CONFIG_UNISOC_USB_DMA_V3=y
CONFIG_UNISOC_USB_HSPHY=y
CONFIG_UNISOC_USBPINMUX=y
CONFIG_NVMEM=y
CONFIG_IIO=y
CONFIG_UNISOC_BC1P2=y
CONFIG_ZTE_MBB_USB_FEATURE=y
# CONFIG_P720M01_USB_FEATURE is not set

CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SPRD=y

CONFIG_BINFMT_SCRIPT=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y
CONFIG_MULTIUSER=y

CONFIG_REGULATOR_UMP9650=y
CONFIG_REGULATOR_UMP9651=y
CONFIG_DEBUG_FS=y

CONFIG_GPIO_EIC_SPRD=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_PMIC_EIC_SPRD=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_NVMEM_SPRD_SHADOW_EFUSE=y

CONFIG_TYPEC=y
CONFIG_UNISOC_USB_TYPEC=y
CONFIG_UNISOC_USB_SC27XX_TYPEC=y
CONFIG_UNISOC_PD_TCPM=y
CONFIG_UNISOC_SC27XX_PD=y
