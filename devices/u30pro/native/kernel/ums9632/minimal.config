CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=120
CONFIG_SPRD_WATCHDOG=y
CONFIG_U30PRO_UMP9650_WATCHDOG=y

CONFIG_U30PRO_SDHCI_R11P3_BOOTSTRAP=y
CONFIG_EFI_PARTITION=y

# OpenWrt userspace/sandbox requirements apply to physical boot too.
CONFIG_SYSVIPC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y

# Keep PL011 rescue console so the physical candidate itself can be tested in QEMU.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_AMBA=y

# fs/pstore/Kconfig is hidden unless its parent menu is enabled.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_CMDLINE="ignore_loglevel"
CONFIG_CMDLINE_EXTEND=y
