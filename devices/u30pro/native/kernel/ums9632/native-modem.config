CONFIG_MAILBOX=y
CONFIG_UNISOC_MODEM=y
CONFIG_UNISOC_MAILBOX=y
# CONFIG_UNISOC_MAILBOX_R1 is not set
CONFIG_UNISOC_MAILBOX_R2=y
CONFIG_UNISOC_MODEM_POWER_MANAGER=y
CONFIG_UNISOC_MODEM_LOADER=y
# CONFIG_UNISOC_CH_SUPPORT is not set
# CONFIG_UNISOC_MODEM_LOADER_RAM_VMAP is not set
CONFIG_UNISOC_SIPC=y
CONFIG_UNISOC_SIPC_SPIPE=y
CONFIG_UNISOC_SIPC_SPOOL=y
CONFIG_UNISOC_SIPC_VIRT_BUS=y
# CONFIG_UNISOC_SIPC_WCN is not set
CONFIG_UNISOC_TRUSTY=y
CONFIG_UNISOC_TRUSTY_LOG=y
CONFIG_UNISOC_TRUSTY_VIRTIO=y
CONFIG_UNISOC_TRUSTY_VIRTIO_IPC=y
# CONFIG_UNISOC_TRUSTY_TSHM is not set
# CONFIG_UNISOC_TRUSTY_TUI is not set
CONFIG_UNISOC_SIPA_V3=y
CONFIG_UNISOC_SIPA_ETH=y
# CONFIG_UNISOC_SIPA_USB is not set
CONFIG_UNISOC_SIPA_DELEGATE=y
# CONFIG_UNISOC_SIPA_V3_GCOV is not set
