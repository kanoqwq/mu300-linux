CONFIG_SPI_SPRD=y
CONFIG_PWM=y
CONFIG_PWM_SPRD=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_UNISOC_QOGIRN5_BACKLIGHT=y
CONFIG_UNISOC_NV3002C_PANEL=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
# CONFIG_KEYBOARD_ATKBD is not set
CONFIG_KEYBOARD_GPIO=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_UNISOC_TLSC_TOUCH=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_SC27XX=y
# the panel is used by a KMS user-space UI; the framebuffer console would keep drawing over it
# CONFIG_FRAMEBUFFER_CONSOLE is not set
