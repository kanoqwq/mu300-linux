# KEXEC on arm64 needs PM_SLEEP_SMP. This enables the code, not suspend acceptance.
CONFIG_SUSPEND=y
CONFIG_KEXEC=y
# CONFIG_KEXEC_FILE is not set
# Upstream arm64 kexec-tools obtains PHYS_OFFSET/VA_BITS from VMCOREINFO here.
CONFIG_PROC_KCORE=y
# CONFIG_CRASH_DUMP is not set
CONFIG_U30PRO_KEXEC_BASE=y
