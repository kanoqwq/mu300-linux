# Board bring-up flags, formerly carried by the U30 Pro upstream image command
# line. Keep MU300's standard boot sentinel and storage/installer ABI intact.
CONFIG_CMDLINE="ignore_loglevel u30pro_cpufreq=1 u30pro_ase=1 u30pro_scufreq=1 sdhci_sprd.write_protect=0"
CONFIG_HOTPLUG_CPU=y
CONFIG_F2FS_FS=y
