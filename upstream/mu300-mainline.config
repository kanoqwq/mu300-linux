# Minimal mainline config for the MU300 bring-up (merged on top of allnoconfig)
CONFIG_64BIT=y
CONFIG_ARCH_SPRD=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_TTY=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_INITRAMFS_PRESERVE_MTIME=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_OF=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,115200n8 loglevel=3 log_buf_len=4M softlockup_panic=1 hardlockup_panic=1 printk.devkmsg=on rdinit=/init panic=5 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive"
CONFIG_CMDLINE_FORCE=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_SPI=y
CONFIG_HWSPINLOCK=y
CONFIG_SPI_SPRD_ADI=y
CONFIG_COMMON_CLK=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9620_CLK=y
CONFIG_SPRD_SC9860_CLK=n
CONFIG_SPRD_SC9863A_CLK=n
CONFIG_SPRD_UMS512_CLK=n
CONFIG_DEBUG_FS=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_RESET_CONTROLLER=y
CONFIG_PM=y
CONFIG_SPRD_UMS9620_IPA_PD=y
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_UMP9620=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_PHY=y
CONFIG_USB_SPRD_UMS9620_SSPHY=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3=y
# dual role: the gadget (USB network to a computer) by default; mu300-usb host switches the port to host mode
# (the U30 Air: flash drives, keyboards, modems through an OTG adapter, 5 V from the charger's boost)
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# the U30 Air's charger (SGM41511, a bq25601) on I2C: bq256xx with the vendor node (port/install.py, patch 0009);
# mu300-usb still switches its OTG boost through i2c-dev
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SPRD=y
CONFIG_REGMAP_I2C=y
CONFIG_CHARGER_BQ256XX=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_UNIX98_PTYS=y
CONFIG_EXTCON=y
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_GPIO_PMIC_EIC_SPRD=y
CONFIG_EXTCON_USB_GPIO=y
# the U30 Air's USB-C port under TCPM (patches 0019, 0020; FINDINGS 150): modules, and the port controller does
# nothing unless loaded with enable=1 (mu300-usb pd on), experimental
CONFIG_TYPEC=m
CONFIG_TYPEC_TCPM=m
CONFIG_TYPEC_UMP9620=m
CONFIG_PINCTRL=y
# the UMS9620 pin controller (patch 0013): the vendor DTB's pinctrl@2e0000 binds, and the U30 Air's i2c6 pads
# (SCL6/SDA6) get their I2C function, which the DTB names no group for (issue #102, the ABSSV variant)
CONFIG_PINCTRL_SPRD_QOGIRN6PRO=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_MMC_HSQ=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- userspace: OpenWrt (procd/netifd/fw4) and Ubuntu (systemd)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
# lz4, as on 5.4 (mu300-zram asks for it; without a backend it silently stays on lzo-rle); zstd for ZRAM_ALGORITHM=zstd
# in /etc/mu300/zram.conf (the zstd library is already in for CRYPTO_ZSTD: only the backend's few KiB of glue)
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_DMIID=n
CONFIG_KEYS=y
CONFIG_SECURITY=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_MEMFD_CREATE=y
CONFIG_RD_LZ4=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RTC_CLASS=y
CONFIG_INPUT_EVDEV=y
# the buttons (gpio-keys on the PMIC's and the AP's EIC): power, and the U30 Air's Wi-Fi key (mu300-buttons)
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# --- networking for OpenWrt routing
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_INET_DIAG=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_WIREGUARD=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_SET=y
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# FunctionFS: adbd's USB function (ffs.adb, mu300-usb adb on); the vendor 5.4 kernel has it already
CONFIG_USB_CONFIGFS_F_FS=y
# wireless core, for the later sprd_wlan_combo port
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y

# --- thermal: on-die sensors with eFuse calibration (read-only nvmem)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SPRD_EFUSE=y
# the U30 Air's battery (patches 0004-0006): PMIC efuse -> ADC -> fuel gauge
CONFIG_NVMEM_SC27XX_EFUSE=y
CONFIG_IIO=y
CONFIG_SC27XX_ADC=y
CONFIG_POWER_SUPPLY=y
CONFIG_FUEL_GAUGE_SC27XX=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_SPRD_THERMAL_R5P0=y

# --- cpufreq (ATF DVFS via SIP calls) and PSCI cpuidle
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ENERGY_MODEL=y
CONFIG_SPRD_SIP_SVC=y
CONFIG_ARM_SPRD_CPUFREQ_V2=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y

# --- system suspend (experimental, FINDINGS 37): PSCI SYSTEM_SUSPEND like the vendor 5.4 kernel, which has no
# platform suspend driver either. Brings CPU hotplug along (PM_SLEEP_SMP). Autosleep is built but off until written.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_AUTOSLEEP=y
# a tickless idle with one-shot broadcast: allnoconfig's periodic tick reached every CPU through the sprd_timer
# broadcast (cpuidle's power-down states stop the local timer), and a CPU brought back online (suspend takes the
# others down and up again) was left out of that broadcast: its timers never fired, a hard lockup (FINDINGS 37)
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- PMIC LEDs (status LEDs)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_SC27XX_BLTC=y
# the U30 Air's power, network and Wi-Fi LEDs are gpio-leds (the F50 has none)
CONFIG_LEDS_GPIO=y
# ... and its white ones, on PMIC LDOs (upstream/port/drivers/leds/leds-zte-ldo.c)
CONFIG_LEDS_ZTE_LDO=y
# ... and its red network LED, on the PMIC's keypad backlight sink (leds-sc27xx-kpled.c)
CONFIG_LEDS_SC27XX_KPLED=y
# the ZTE V50's (experimental, FINDINGS 95): an AW9523B with ZTE's binding (leds-aw9523b.c, kano's); it binds only to
# that node, which the F50's and U30 Air's device trees do not have. make-bundle.sh names the V50 when this is in.
CONFIG_LEDS_AW9523B=y
# ... and its SIM switches (zte-v50-sim.c, FINDINGS 204): binds only where that AW9523B is, drives nothing at probe
CONFIG_ZTE_V50_SIM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
# the U30 Air's battery LED breathes while it charges, on the PMIC's own curve (hw_pattern; mu300-led, FINDINGS 151)
CONFIG_LEDS_TRIGGER_PATTERN=y

# --- PCIe RC (Marlin3 Wi-Fi/BT) and loadable modules for the out-of-tree WCN drivers
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_SPRD=y

# --- Bluetooth (Marlin3 H4 over sprdbt_tty)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y

# --- modem stack (out-of-tree): Trusty IPC runs over virtio queues
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_DMABUF_HEAPS=y
CONFIG_MAILBOX=y

# --- PMIC RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_SC27XX=y

# GPU: explicit fences (the DDK's fence helpers and Android's GPU userspace both need them)
CONFIG_SYNC_FILE=y

# GPU: the Mali DDK's devfreq support (frequency scaling and the vendor's frequency statistics)
CONFIG_PM_DEVFREQ=y
CONFIG_PM_DEVFREQ_EVENT=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_DEVFREQ_THERMAL=y
# boot logo buffer (no display) and bootloader sysdump area back to Linux: +25 MiB (patches/0003)
CONFIG_OF_RESERVED_MEM_SKIP="logobuffer,sysdump-uboot"
# hangs become panics (and a panic reaches ramoops): without these detectors the softlockup_panic and
# hardlockup_panic that boot/init sets had nothing behind them, and a hang left no trace at all. The panic
# switches are on the command line (BOOTPARAM_SOFTLOCKUP_PANIC is a bool in 6.x and a number in 7.x)
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
# reported, not fatal: vendor threads sleep uninterruptibly for good (sipa-set-rps, slog, the Wi-Fi TX thread)
CONFIG_DETECT_HUNG_TASK=y

# --- eBPF: what dae (eBPF transparent proxy, docs/en/README.md "Kernel Configurations") and other CO-RE tools need.
# BTF (/sys/kernel/btf/vmlinux) is made by pahole from the DWARF; the DWARF stays in vmlinux and the .ko files
# (build-modules.sh strips it), only the BTF lands in the Image (FINDINGS 31p). DEBUG_INFO_REDUCED must stay off:
# BTF needs the full type information
CONFIG_DEBUG_INFO_DWARF5=y
# zstd-compressed DWARF in the objects: vmlinux 157 MB instead of 312 MB, and the build trees of 6.18 and 7.2 fit
# in one docker volume next to each other (uncompressed, the second one filled the disk)
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# a module whose BTF does not match loads anyway (without its BTF) rather than not at all
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
# without the JIT dae does not load at all ("callbacks are not allowed in non-JITed programs")
CONFIG_BPF_JIT=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
# netkit: the BPF-programmable veth dae prefers for its dae0 pair (it falls back to veth without it)
CONFIG_NETKIT=y
# not taken: kprobes and the tracing they pull in (PERF_EVENTS, FTRACE, KPROBE_EVENTS, BPF_EVENTS), which dae lists
# too. With them 7.2 died in 2 of 36 reboots (page tables and the printk buffer overwritten at ~11.5 s, as the modem
# and the Wi-Fi card start), without them 47 of 47 came up (FINDINGS 31p). dae runs without: `dae trace` and its
# sockmap accounting are what need kprobes, and process names come from bpf_get_current_comm

# --- virtualization: KVM (the CPUs start at EL2; the vendor 5.4 kernel has it too) and vhost for the guests
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m

# --- what OpenWrt and Ubuntu users load on a router, as modules where it only matters once used, kept out of the
# Image. make-bundle.sh ships them flat in ./modules next to the vendor ones; modprobe finds them after depmod
# (Ubuntu) or by name (OpenWrt's kmodloader). /proc/config.gz is built in: check-config scripts read it without
# loading anything
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_MISC=m
# pressure stall information (systemd-oomd, container runtimes). No kexec (arm64 needs PM_SLEEP_SMP for it; the
# suspend options bring that in; kexec itself is not enabled)
CONFIG_PSI=y
CONFIG_SOFT_WATCHDOG=m
# containers (podman/docker): the rest of what their check-config asks for
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_MISC=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_IP_VS=m
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y
# netfilter: conntrack helpers, queues and logs, the remaining nft expressions, sets and the xt matches and
# targets iptables-nft (Ubuntu, Docker) uses through nft_compat. No legacy iptables/ebtables tables: both systems
# run their iptables over nftables
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_H323=m
CONFIG_NF_CONNTRACK_IRC=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NF_CONNTRACK_SNMP=m
CONFIG_NF_CONNTRACK_PPTP=m
CONFIG_NF_CONNTRACK_SANE=m
CONFIG_NF_CONNTRACK_SIP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CONNTRACK_BRIDGE=m
CONFIG_NF_CT_NETLINK_TIMEOUT=m
CONFIG_NETFILTER_NETLINK_GLUE_CT=y
CONFIG_NF_CT_NETLINK_HELPER=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_ACCT=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_OSF=m
CONFIG_NFT_XFRM=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_DUP_IPV6=m
CONFIG_IP_SET_BITMAP_IP=m
CONFIG_IP_SET_BITMAP_IPMAC=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPMARK=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_MAC=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETNET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETPORTNET=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_DSCP=m
CONFIG_NETFILTER_XT_TARGET_HL=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TEE=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_CGROUP=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_DSCP=m
CONFIG_NETFILTER_XT_MATCH_ECN=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
