# The bools all-modules.py turns on before it makes every tristate it can a module: each one only opens a family
# of drivers (a menu) and builds nothing into the Image by itself. Everything else stays as mu300-mainline.config
# leaves it.
# USB Wi-Fi sticks of every vendor (mac80211 and cfg80211 drivers; the PCI and SDIO ones stay out with PCI)
CONFIG_WLAN_VENDOR_ADMTEK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_ATMEL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_WLAN_VENDOR_MICROCHIP=y
CONFIG_WLAN_VENDOR_PURELIFI=y
CONFIG_WLAN_VENDOR_RSI=y
CONFIG_WLAN_VENDOR_SILABS=y
CONFIG_WLAN_VENDOR_ST=y
CONFIG_WLAN_VENDOR_TI=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_WLAN_VENDOR_QUANTENNA=y
# game pads, graphics tablets and USB touch screens
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_TABLET=y
CONFIG_INPUT_TOUCHSCREEN=y
# TV and radio sticks, SDR dongles (rtl-sdr), next to the webcams that were in already
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
# snd-aloop, snd-dummy, snd-virmidi
CONFIG_SND_DRIVERS=y
# iSCSI (initiator over TCP)
CONFIG_SCSI_LOWLEVEL=y
# the legacy iptables/ebtables tables, as modules: iptables-legacy, and Docker's check-config.sh lists
# iptable_filter/iptable_nat as generally necessary. Nothing loads them unless asked (both systems run their
# iptables over nftables)
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=y
# kept off: the DRM framebuffer emulation would bring the framebuffer console along (the console is the UART)
CONFIG_DRM_FBDEV_EMULATION=n
# /dev/hidraw: FIDO/U2F keys, game pads and the HID drivers that need it (the CP2112 USB-I2C bridge)
CONFIG_HIDRAW=y
