+/* UMP9620: the small-scale graph is scaled up for scales 2 and 3; scale 1 is the battery voltage detection */
+static int ump96xx_adc_convert_volt(struct sc27xx_adc_data *data, int channel,
+				   int scale, int raw_adc)
+{
+	struct u32_fract fract;
+	int volt;
+
+	if (channel == 11) {
+		volt = sc27xx_adc_to_volt(&big_scale_graph, raw_adc);
+	} else if (scale == 1) {
+		volt = sc27xx_adc_to_volt(&ump9620_bat_det_graph, raw_adc);
+		if (channel == 0)
+			return volt;
+	} else {
+		volt = adc_to_volt(&small_scale_graph, raw_adc);
+		if (scale == 2)
+			volt = volt * 2600 / 1000;
+		else if (scale == 3)
+			volt = volt * 4060 / 1000;
+		if (volt < 0)
+			volt = 0;
+	}
+
+	sc27xx_adc_volt_ratio(data, channel, scale, &fract);
+
+	return DIV_ROUND_CLOSEST(volt * fract.denominator, fract.numerator);
 }
 
