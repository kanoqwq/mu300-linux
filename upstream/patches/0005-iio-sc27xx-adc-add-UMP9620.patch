+/*
+ * UMP9620 keeps two efuse words per graph, the ADC value of each point in bits 15:4 (Unisoc's 5.4 driver);
+ * a graph without programmed values keeps its defaults.
+ */
+static int ump96xx_adc_graph_calibration(struct sc27xx_adc_data *data,
+					 struct sc27xx_adc_linear_graph *graph,
+					 const char *cell1, const char *cell2)
+{
+	int d1, d2, adc0, adc1;
+
+	d1 = adc_nvmem_cell_calib_data(data, cell1);
+	if (d1 < 0)
+		return d1;
+	d2 = adc_nvmem_cell_calib_data(data, cell2);
+	if (d2 < 0)
+		return d2;
+	adc0 = (d1 & 0xfff0) >> 4;
+	adc1 = (d2 & 0xfff0) >> 4;
+	if (adc0 > 0 && adc1 > 0 && adc0 != adc1) {
+		graph->adc0 = adc0;
+		graph->adc1 = adc1;
+	}
+	return 0;
+}
+
+static int ump96xx_adc_scale_calibration(struct sc27xx_adc_data *data)
+{
+	int ret;
+
+	ret = ump96xx_adc_graph_calibration(data, &big_scale_graph, "big_scale_calib1", "big_scale_calib2");
+	if (ret)
+		return ret;
+	ret = ump96xx_adc_graph_calibration(data, &ump9620_bat_det_graph, "vbat_det_cal1", "vbat_det_cal2");
+	if (ret)
+		return ret;
+	return ump96xx_adc_graph_calibration(data, &small_scale_graph, "small_scale_calib1", "small_scale_calib2");
 }
 
+static int ump9620_adc_get_ratio(int channel, int scale)
+{
+	switch (channel) {
+	case 11:
+		return SC27XX_VOLT_RATIO(1, 1);
+	case 14:
+		return scale ? SC27XX_VOLT_RATIO(1, 1) : SC27XX_VOLT_RATIO(68, 900);
+	case 15:
+		return scale ? SC27XX_VOLT_RATIO(1, 1) : SC27XX_VOLT_RATIO(1, 3);
+	case 21:
+	case 22:
+	case 23:
+		return scale ? SC27XX_VOLT_RATIO(1, 1) : SC27XX_VOLT_RATIO(3, 8);
+	default:
+		switch (scale) {
+		case 1:
+			return SC27XX_VOLT_RATIO(1000, 1955);
+		case 2:
+			return SC27XX_VOLT_RATIO(1000, 2600);
+		case 3:
+			return SC27XX_VOLT_RATIO(1000, 4060);
+		default:
+			return SC27XX_VOLT_RATIO(1, 1);
+		}
+	}
+}
+
+static void ump9620_adc_scale_init(struct sc27xx_adc_data *data)
+{
+	int i;
+
+	for (i = 0; i < SC27XX_ADC_CHANNEL_MAX; i++) {
+		if (i == 10 || i == 19 || i == 30 || i == 31)
+			data->channel_scale[i] = 3;
+		else if (i == 7 || i == 9)
+			data->channel_scale[i] = 2;
+		else if (i == 0 || i == 13)
+			data->channel_scale[i] = 1;
+		else
+			data->channel_scale[i] = 0;
+	}
+}
