+/* UMS9620's PMIC (ZTE U30 Air; the F50 has no battery) */
+static const struct sc27xx_fgu_variant_data ump9620_info = {
+	.module_en = UMP9620_MODULE_EN0,
+	.clk_en = UMP9620_CLK_EN0,
+	.fgu_cal = GENMASK(15, 7),
+	.fgu_cal_shift = 7,
+};
