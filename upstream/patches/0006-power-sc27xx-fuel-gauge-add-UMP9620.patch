+/* Where each PMIC keeps the FGU's enable bits and the 4200 mV calibration (Unisoc's 5.4 driver) */
+struct sc27xx_fgu_variant_data {
+	u32 module_en;
+	u32 clk_en;
+	u32 fgu_cal;
+	u32 fgu_cal_shift;
+};
+
+static const struct sc27xx_fgu_variant_data sc2731_info = {
