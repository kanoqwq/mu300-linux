@@ -528,7 +563,28 @@
 
 static int sc27xx_fgu_get_temp(struct sc27xx_fgu_data *data, int *temp)
 {
-	return iio_read_channel_processed(data->channel, temp);
+	int ret, mv, uv, i;
+
+	ret = iio_read_channel_processed(data->channel, &mv);
+	if (ret < 0 || !data->vt_len) {
+		*temp = mv;
+		return ret < 0 ? ret : 0;
+	}
+
+	/* the voltage falls as the temperature rises; interpolate between the two pairs around it */
+	uv = mv * 1000;
+	for (i = 0; i < data->vt_len; i++)
+		if (uv > data->vt_table[2 * i])
+			break;
+	if (i == 0)
+		*temp = data->vt_table[1];
+	else if (i == data->vt_len)
+		*temp = data->vt_table[2 * i - 1];
+	else
+		*temp = fixp_linear_interpolate(data->vt_table[2 * i], data->vt_table[2 * i + 1],
+						data->vt_table[2 * i - 2], data->vt_table[2 * i - 1], uv);
+	*temp -= 1000;
+	return 0;
 }
 
