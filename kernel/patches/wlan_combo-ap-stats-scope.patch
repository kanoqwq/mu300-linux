On an access point, get_station answers for its own stations only, and with nothing it does not know (after
kanoqwq's f59a296, "AP no longer passes STA/interface metrics off as client data").

get_station is the station side's: the interface's own byte and packet counters and the firmware's GET_STATION,
which reports the link to the access point the interface is connected to. On an access point it handed those out
as the figures of whatever address was asked for, a station of ours or not: "iw dev wlan0 station get <any MAC>"
answered with the whole interface's counters and a signal that belongs to no client. The firmware keeps no
per-client figures. In AP and P2P-GO mode an address that is not in the firmware's peer table as one of this
interface's (as dump_station lists them) is now -ENOENT, and a station of ours is answered with nothing filled in,
as dump_station does. dump_station refuses a negative index, and get_channel answers for link 0 only: the driver
has no MLO, and the 5.15+ variant indexed wdev->links[link_id] unchecked (on 5.4 the other variant is built; the
code is kept the same as the mainline copy in upstream/modules). FINDINGS 180.

--- a/common/cfg80211.c
+++ b/common/cfg80211.c
@@ -715,6 +715,24 @@
 	return 0;
 }
 
+/*
+ * MU300: whether MAC is a station of this access point: an entry of this interface in the firmware's peer table
+ * (as dump_station below lists them), not the interface's own address.
+ */
+static bool sprd_ap_has_peer(struct sprd_vif *vif, const u8 *mac)
+{
+	struct sprd_hif *hif = &vif->priv->hif;
+	int i;
+
+	if (!is_valid_ether_addr(mac) || ether_addr_equal(mac, vif->ndev->dev_addr))
+		return false;
+	for (i = 0; i < MAX_LUT_NUM; i++)
+		if (READ_ONCE(hif->peer_entry[i].ctx_id) == vif->ctx_id &&
+		    ether_addr_equal(hif->peer_entry[i].tx.da, mac))
+			return true;
+	return false;
+}
+
 int sprd_cfg80211_get_station(struct wiphy *wiphy, struct net_device *ndev,
 			      const u8 *mac, struct station_info *sinfo)
 {
@@ -723,6 +741,19 @@
 	struct sprd_rate_info *tx_rate;
 	struct sprd_rate_info *rx_rate;
 	int ret;
+
+	/*
+	 * MU300: what follows is the station side's: the interface's own counters and the firmware's GET_STATION,
+	 * which reports the link to the access point this interface is connected to. On an access point it would hand
+	 * those out as any client's (and for any address asked). The firmware has no per-client figures: a station
+	 * of ours is answered with nothing filled in, as dump_station does, an unknown address with -ENOENT.
+	 */
+	if (vif->wdev.iftype == NL80211_IFTYPE_AP || vif->wdev.iftype == NL80211_IFTYPE_P2P_GO) {
+		if (!sprd_ap_has_peer(vif, mac))
+			return -ENOENT;
+		sinfo->filled = 0;
+		return 0;
+	}
 
 	sinfo->filled |= BIT(NL80211_STA_INFO_TX_BYTES) |
 	    BIT(NL80211_STA_INFO_TX_PACKETS) |
@@ -1574,7 +1605,7 @@
 	struct sprd_hif *hif = &vif->priv->hif;
 	int i, n = 0;
 
-	if (vif->wdev.iftype != NL80211_IFTYPE_AP && vif->wdev.iftype != NL80211_IFTYPE_P2P_GO)
+	if (idx < 0 || (vif->wdev.iftype != NL80211_IFTYPE_AP && vif->wdev.iftype != NL80211_IFTYPE_P2P_GO))
 		return -ENOENT;
 	for (i = 0; i < MAX_LUT_NUM; i++) {
 		const u8 *da = hif->peer_entry[i].tx.da;
@@ -1591,15 +1622,18 @@
 	return -ENOENT;
 }
 
