+		if (delegator->pd_get_flag) {
+			sipa_set_enabled(false);
+			pm_runtime_put(delegator->pdev);
+			delegator->pd_get_flag = false;
+		}
 		break;
 	default:
 		break;
@@ -177,10 +186,16 @@
