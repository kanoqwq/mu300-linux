# MU300 (ZTE F50) general-purpose Linux additions on top of the stock F50 config.
# Applied with scripts/kconfig/merge_config.sh; everything not listed stays as stock.

# --- systemd / udev requirements
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KCMP=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y

# Android restricts usermode helpers to a single static binary; Linux needs modprobe/hotplug
# CONFIG_STATIC_USERMODEHELPER is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""

# Linux distributions expect these; SELinux stays built in but is disabled on the cmdline
CONFIG_SECURITY_APPARMOR=y
CONFIG_AUDIT=y

# --- networking
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_IP_SET=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y

# --- filesystems
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_CIFS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_NFSD=m
CONFIG_ZSWAP=y
CONFIG_Z3FOLD=y
CONFIG_ZRAM=y
CONFIG_QUOTA=y

# --- USB host devices (modems, serial adapters, audio, storage, networking)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_WDM=m
CONFIG_SND_USB_AUDIO=y
CONFIG_USB_PRINTER=m

# --- crypto user APIs (cryptsetup, iwd, kernel TLS)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_TLS=y

# --- vendor modules are rebuilt from this tree, so forced signatures are no longer needed
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_IKHEADERS=m

# --- USB gadget serial console (CDC-ACM) for recovery access over USB
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
# --- the stock RNDIS function, for Windows without NCM (boot/init, MU300_USBNET="rndis ncm"). Unisoc's own
# sprd_usb_f_rndis is no substitute: with CONFIG_USB_PAM it hands the data path to the IPA hardware on connect,
# and its netdev never passes a packet (measured: Windows binds, rndis0 stays at 0/0).
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y

# --- userspace hardware access and regulatory
CONFIG_I2C_CHARDEV=m
CONFIG_SPI_SPIDEV=m
CONFIG_ZTE_AW883XX_SMART_PA=m

# --- give unused reserved-memory back to Linux (no display, no bootloader sysdump)
CONFIG_OF_RESERVED_MEM_SKIP="logobuffer,sysdump-uboot"

# --- nftables features firewall4 (OpenWrt) and common tools need: sets/maps, flow offload, redirect, quota
CONFIG_NF_TABLES_SET=y
CONFIG_NFT_OBJREF=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
# the nft "queue" statement (nfnetlink_queue is already built in): the nftables mode of sing-box and other proxies,
# which OpenWrt's kmod-nft-queue cannot supply on this kernel (issue #169); the mainline kernels have it as a module
CONFIG_NFT_QUEUE=y

# 8 per-CPU kthreads that only rotate big tasks for benchmark workloads; they are never woken on this
# device and sit in uninterruptible sleep forever, adding 8 to the load average (upstream default is n)
# CONFIG_SPRD_ROTATION_TASK is not set
